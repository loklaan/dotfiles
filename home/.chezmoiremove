{{/* Targets chezmoi installed and no longer manages. Deleting a file from the
     source stops chezmoi managing it; it does NOT remove the copy already on
     disk, so a removed script lingers in $HOME on every machine forever.

     Claude Code session tracking was removed along with its hooks (see
     $deadPathSubstrings in home/dot_claude/modify_settings.json, which prunes
     the matching hook entries). Keep these lines for one release cycle after
     every machine has applied, then delete them. */}}
.local/lib/tmux-resurrect-code-agents/track.sh
.local/lib/tmux-resurrect-code-agents/cleanup.sh
.local/lib/tmux-resurrect-code-agents/agents/claude.sh
.local/bin/df-prewarm
.local/bin/df-llm-shim
{{- /* Removing Codex support missed its agent module and the hook chezmoi
       rendered into ~/.codex/hooks.json, which kept calling the track.sh above
       on every Codex session start. chezmoi wrote that whole file, so remove
       it only while it still matches the legacy render (whitespace aside); if
       anyone has since added hooks of their own, leave the file alone. */}}
.local/lib/tmux-resurrect-code-agents/agents/codex.sh
{{- $codexHooks := joinPath .chezmoi.homeDir ".codex/hooks.json" }}
{{- if stat $codexHooks }}
{{-   $legacy := printf `{"hooks":{"SessionStart":[{"matcher":"startup|resume","hooks":[{"type":"command","command":"bash %s/.local/lib/tmux-resurrect-code-agents/track.sh codex"}]}]}}` .chezmoi.homeDir }}
{{-   if eq (include $codexHooks | nospace) (nospace $legacy) }}
.codex/hooks.json
{{-   end }}
{{- end }}
{{- /* opencode-tokenizer-check only checked the context-usage plugin's
       tokenizer pins. */}}
.local/bin/opencode-tokenizer-check
{{- /* The context-usage plugin (/context and its tokenizers) was removed: the
       files its external unpacked, and the files and ~400 MB npm tree its
       setup script generated. chezmoi removes a listed directory with
       everything in it. */}}
.config/opencode/command/context.md
.config/opencode/plugin/context-usage.ts
.config/opencode/plugin/tokenizer-aliases.json
.config/opencode/plugin/tokenizer-registry.mjs
.config/opencode/plugin/vendor
.config/opencode/tokenizer-resolution.test.mjs
{{- /* The /changes TUI plugin moved into the shared package at
       ~/.local/share/dotfiles/opencode-tui-plugins/. OpenCode 2's old copy
       needs no entry: its directory target is now a symlink, and chezmoi
       replaces the directory when it writes the symlink. */}}
.config/opencode/tui-plugins/changed-files.tsx
{{- /* OMO config moved to the unified ~/.omo/omo.jsonc (rendered by
       home/dot_omo/modify_omo.jsonc). These are the orphaned legacy config,
       its migration ledger, and the backup directories OMO's own
       config-unification migration left behind. Replaces the deleted
       run_once_after_install-069-cleanup-legacy-omo-config.sh. */}}
.config/opencode/oh-my-openagent.json
.config/opencode/oh-my-openagent.json.migrations.json
.omo/migration-backup-*-opencode-config
{{- /* The work plugin used to be delivered as a self-managed on-disk bundle;
       it is now an npm-managed plugin[] entry, and a leftover bundle loads as
       a stale duplicate. Moved here from run_after_install-067. */}}
.config/opencode/plugins/canva-llmproxy.js
.config/opencode/plugins/canva-llmproxy.js.version
