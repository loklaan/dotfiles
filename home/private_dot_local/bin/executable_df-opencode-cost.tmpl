    ) {
      throw new Error(
        `unexpected stderr failure: ${JSON.stringify(stderrFailure)}`,
      );
    }

    const exitFailure = await Effect.runPromise(
      collectHost("exit-box", "query").pipe(
        Effect.flip,
        Effect.provide(transportFor({
          stdout: "ignored",
          stderr: "",
          exitCode: 23,
        })),
      ),
    );
    if (exitFailure.host !== "exit-box" || exitFailure.detail !== "exited 23") {
      throw new Error(
        `unexpected exit failure: ${JSON.stringify(exitFailure)}`,
      );
    }
  });

  Deno.test("collectHost: spawn failures retain their BoxFailure cause", async () => {
    const cause = PlatformError.systemError({
      _tag: "NotFound",
      module: "ChildProcess",
      method: "spawn",
      pathOrDescriptor: "missing-command",
    });
    const layer = HostTransport.spawned({}).pipe(Layer.provide(
      Layer.succeed(
        ChildProcessSpawner.ChildProcessSpawner,
        ChildProcessSpawner.make(() => Effect.fail(cause)),
      ),
    ));
    const failure = await Effect.runPromise(
      collectHost("missing-box", "query").pipe(
        Effect.flip,
        Effect.provide(layer),
      ),
    );
    const expected = `spawn failed: ${String(cause)}`;
    if (failure.host !== "missing-box" || failure.detail !== expected) {
      throw new Error(`unexpected spawn failure: ${JSON.stringify(failure)}`);
    }
  });

  Deno.test("collectHost: interruption closes the spawned process scope", async () => {
    let released = false;
    await Effect.runPromise(
      Effect.gen(function* () {
        const acquired = yield* Deferred.make<void>();
        const fiber = yield* collectHost("slow-box", "query").pipe(
          Effect.provide(transportFor(
            {
              stdout: "",
              stderr: "",
              exitCode: 0,
              hangs: true,
              acquired,
            },
            [],
            () => {
              released = true;
            },
          )),
          Effect.forkChild,
        );
        yield* Deferred.await(acquired);
        yield* Fiber.interrupt(fiber);
      }),
    );
    if (!released) {
      throw new Error("interruption did not close the spawned process scope");
    }
  });
}
