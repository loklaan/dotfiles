#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --no-prompt --allow-run --allow-env=HOME,PATH,SSH_AUTH_SOCK,NODE_V8_COVERAGE --allow-read

// df-opencode-cost — opencode spend, grouped by PROJECT, aggregated ACROSS hosts
// and ACROSS opencode generations (v1 = opencode.db, v2 = opencode2.db).
// Single-file Deno + Effect v4 tool. Import paths pinned to effect@4.0.0
// (repo-wide canonical version; the frozen deno.lock projected into ~/.local/bin
// resolves it — no --minimum-dependency-age needed, unlike a standalone script).
//
// Each (host × source) runs a node:sqlite snippet over `zsh -lc` (login shell
// surfaces the mise-activated deno on Coder boxes). Each source is one
// `UsageSource` service with two layers that differ only in DB file + SQL; both
// emit the same normalized UsageRow. A missing DB file on a host is "absent"
// (source skipped for that host), not a failure. The coordinator normalizes
// paths, folds worktrees into their parent repo, folds devbox ~/work/<repo> into
// ~/dev/canva/<repo>, and renders a heatmap table with per-host, per-source and
// per-worktree granularity.

import {
  Console,
  Context,
  Deferred,
  Effect,
  Fiber,
  Layer,
  Option,
  PlatformError,
  Result,
  Schema,
  Sink,
  Stream,
} from "npm:effect@4.0.0";
import { Command, Flag } from "npm:effect@4.0.0/cli";
import {
  ChildProcess,
  ChildProcessSpawner,
} from "npm:effect@4.0.0/process";
import { TestClock } from "npm:effect@4.0.0/testing";
// @effect/platform-node is imported in import.meta.main only.

// Hosts baked in from chezmoi data at apply time. Empty on machines that did not
// answer the prompt — the tool prints guidance instead of silently doing nothing.
// Pre-wrapped deliberately: the rendered host list decides whether `deno fmt`
// wants this joined or split, so neither form is clean on every machine. See the
// note on lint:tmpl in .mise.toml — fmt is not gated on rendered templates.
const CONFIGURED_HOSTS_RAW =
  "{{ dig "openCodeCostHosts" "" . }}";
const CONFIGURED_HOSTS = CONFIGURED_HOSTS_RAW
  .split(",").map((h) => h.trim()).filter((h) => h.length > 0);

// --- Domain --------------------------------------------------------------
class BoxFailure extends Schema.TaggedError<BoxFailure>()("BoxFailure", {
  host: Schema.String,
  detail: Schema.String,
}) {}

const SOURCE_IDS = ["v1", "v2"] as const;
type SourceId = (typeof SOURCE_IDS)[number];
type SourceSelection = SourceId | "all";

type Basis = "created" | "updated";
type Window = {
  readonly sinceMs: number;
  readonly untilMs: number;
  readonly basis: Basis;
};

// The one normalized row every source produces. Token counts follow opencode's
// convention: input EXCLUDES cache; cacheRead/cacheWrite are separate.
const UsageRow = Schema.Struct({
  dir: Schema.String,
  cost: Schema.Number,
  input: Schema.Number,
  output: Schema.Number,
  reasoning: Schema.Number,
  cacheRead: Schema.Number,
  cacheWrite: Schema.Number,
});
type UsageRow = typeof UsageRow.Type;

// Snippet payload. `absent: true` means this host has no DB file for the source.
const SourcePayload = Schema.Struct({
  absent: Schema.Boolean,
  rows: Schema.Array(UsageRow),
});
const decodePayload = Schema.decodeUnknownEffect(SourcePayload);

const HOST_QUERY_TIMEOUT_SECONDS = 60;
const MAX_STDOUT_BYTES = 1024 * 1024;
const MAX_STDERR_BYTES = 64 * 1024;

class OutputOverflow extends Schema.TaggedError<OutputOverflow>()(
  "OutputOverflow",
  {
    stream: Schema.Literals(["stdout", "stderr"]),
    limitBytes: Schema.Number,
  },
) {}

type ChildEnvironment = Record<string, string | undefined>;
const childEnvironment = Effect.sync(() => {
  const environment: ChildEnvironment = {};
  for (const key of ["HOME", "PATH", "SSH_AUTH_SOCK"] as const) {
    const value = Deno.env.get(key);
    if (value !== undefined) environment[key] = value;
  }
  return environment;
});

// --- Window parsing ------------------------------------------------------
// Absolute date (YYYY-MM-DD / ISO) or relative span N[dwm] back from now.
const parseWhen = (raw: string, now: number): number | null => {
  const rel = raw.match(/^(\d+)\s*([dwm])$/i);
  if (rel) {
    const n = Number(rel[1]);
    const unit = rel[2].toLowerCase();
    const ms = unit === "d"
      ? 86400000
      : unit === "w"
      ? 7 * 86400000
      : 30 * 86400000;
    return now - n * ms;
  }
  const t = Date.parse(raw);
  return Number.isNaN(t) ? null : t;
};

// --- Path normalization --------------------------------------------------
const homeRel = (dir: string): string => {
  const m = dir.match(/^\/(?:Users|home)\/[^/]+\/(.+)$/);
  return m ? m[1] : dir;
};
// Coder devboxes use ~/work/<repo>; the same repo on macbook lives at
// ~/dev/canva/<repo>. Rewrite the leading work/ segment so both fold into one.
const canonProject = (rel: string): string =>
  rel.startsWith("work/") ? "dev/canva/" + rel.slice("work/".length) : rel;
const splitWorktree = (
  rel: string,
): { project: string; worktree: string | null } => {
  const m = rel.match(/^(.*?)\/\.agents\/worktrees\/([^/]+)(?:\/.*)?$/);
  return m
    ? { project: m[1], worktree: m[2] }
    : { project: rel, worktree: null };
};

// --- Sources: SQL + DB path (the only per-source differences) ------------
type SourceSpec = {
  readonly id: SourceId;
  readonly label: string;
  // File name under $HOME/.local/share/opencode/.
  readonly dbFile: string;
  // SELECT grouped by directory, with two `?` placeholders for the window on
  // the chosen time column (`col` is the bare column name).
  readonly select: (col: string) => string;
};

const V1_SPEC: SourceSpec = {
  id: "v1",
  label: "OpenCode 1",
  dbFile: "opencode.db",
  select: (col) =>
    "SELECT directory AS dir, " +
    "COALESCE(SUM(cost), 0) AS cost, " +
    "COALESCE(SUM(tokens_input), 0) AS input, " +
    "COALESCE(SUM(tokens_output), 0) AS output, " +
    "COALESCE(SUM(tokens_reasoning), 0) AS reasoning, " +
    "COALESCE(SUM(tokens_cache_read), 0) AS cacheRead, " +
    "COALESCE(SUM(tokens_cache_write), 0) AS cacheWrite " +
    "FROM session WHERE directory IS NOT NULL AND " +
    col + " >= ? AND " + col + " <= ? " +
    "GROUP BY directory",
};

// session_v2 token rollups are unreliable, so sum the authoritative per-message
// assistant rows instead. Window is on the owning session's time column.
const V2_SPEC: SourceSpec = {
  id: "v2",
  label: "OpenCode 2",
  dbFile: "opencode2.db",
  select: (col) => {
    const t = "s." + col;
    const sum = (path: string) =>
      "COALESCE(SUM(json_extract(m.data, '" + path + "')), 0)";
    return "SELECT s.directory AS dir, " +
      sum("$.cost") + " AS cost, " +
      sum("$.tokens.input") + " AS input, " +
      sum("$.tokens.output") + " AS output, " +
      sum("$.tokens.reasoning") + " AS reasoning, " +
      sum("$.tokens.cache.read") + " AS cacheRead, " +
      sum("$.tokens.cache.write") + " AS cacheWrite " +
      "FROM session_message m JOIN session_v2 s ON s.id = m.session_id " +
      "WHERE m.type = 'assistant' AND s.directory IS NOT NULL AND " +
      t + " >= ? AND " + t + " <= ? " +
      "GROUP BY s.directory";
  },
};

const timeColumn = (basis: Basis): string =>
  basis === "updated" ? "time_updated" : "time_created";

// Shared snippet builder. Missing DB → {"absent":true}; never creates the file.
const usageScript = (spec: SourceSpec, window: Window): string => {
  const sql = spec.select(timeColumn(window.basis));
  const snippet = `import { DatabaseSync } from "node:sqlite"; ` +
    `import { existsSync } from "node:fs"; ` +
    `const path = Deno.env.get("HOME") + "/.local/share/opencode/${spec.dbFile}"; ` +
    `if (!existsSync(path)) { console.log(JSON.stringify({ absent: true, rows: [] })); } else { ` +
    `const db = new DatabaseSync(path, { readOnly: true }); ` +
    `const rows = db.prepare(${JSON.stringify(sql)}).all(${window.sinceMs}, ${window.untilMs}); ` +
    `console.log(JSON.stringify({ absent: false, rows })); }`;
  return `deno eval ${JSON.stringify(snippet)}`;
};

const hostCommand = (
  host: string,
  script: string,
  environment: ChildEnvironment = {},
): ChildProcess.Command => {
  const [cmd, args] = host === "local" ? ["zsh", ["-lc", script]] : ["ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=15",
    host,
    `zsh -lc ${JSON.stringify(script)}`,
  ]];
  return ChildProcess.make(cmd, args, {
    env: environment,
    extendEnv: false,
    stdin: "inherit",
    stdout: "pipe",
    stderr: "pipe",
    forceKillAfter: "5 seconds",
  });
};

type CommandOutput = {
  readonly success: boolean;
  readonly code: number;
  readonly stdout: string;
  readonly stderr: string;
};

type OutputBuffer = {
  readonly last: OutputChunk | null;
  readonly bytes: number;
};
type OutputChunk = {
  readonly value: Uint8Array;
  readonly previous: OutputChunk | null;
};
const decoder = new TextDecoder();
const collectOutput = (
  stream: Stream.Stream<Uint8Array, PlatformError.PlatformError>,
  streamName: "stdout" | "stderr",
  limitBytes: number,
): Effect.Effect<string, PlatformError.PlatformError | OutputOverflow> =>
  stream.pipe(
    Stream.runFoldEffect(
      (): OutputBuffer => ({ last: null, bytes: 0 }),
      (buffer, chunk) => {
        const bytes = buffer.bytes + chunk.byteLength;
        return bytes > limitBytes
          ? Effect.fail(new OutputOverflow({ stream: streamName, limitBytes }))
          : Effect.succeed(
            chunk.byteLength === 0 ? buffer : {
              last: { value: chunk, previous: buffer.last },
              bytes,
            },
          );
      },
    ),
    Effect.map((buffer) => {
      const bytes = new Uint8Array(buffer.bytes);
      let chunk = buffer.last;
      let offset = buffer.bytes;
      while (chunk !== null) {
        offset -= chunk.value.byteLength;
        bytes.set(chunk.value, offset);
        chunk = chunk.previous;
      }
      return decoder.decode(bytes);
    }),
  );

const runHostCommand = (
  host: string,
  script: string,
  environment: ChildEnvironment = {},
): Effect.Effect<
  CommandOutput,
  BoxFailure,
  ChildProcessSpawner.ChildProcessSpawner
> =>
  Effect.gen(function* () {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const handle = yield* spawner.spawn(
      hostCommand(host, script, environment),
    );
    const output = yield* Effect.all({
      stdout: collectOutput(handle.stdout, "stdout", MAX_STDOUT_BYTES),
      stderr: collectOutput(handle.stderr, "stderr", MAX_STDERR_BYTES),
      code: handle.exitCode,
    }, { concurrency: "unbounded" });
    const code = Number(output.code);
    return {
      success: code === 0,
      code,
      stdout: output.stdout,
      stderr: output.stderr,
    };
  }).pipe(
    Effect.scoped,
    Effect.mapError((cause) => {
      if (cause instanceof OutputOverflow) {
        const action = cause.stream === "stdout"
          ? "; narrow the date window"
          : "; inspect host shell or SSH diagnostics";
        return new BoxFailure({
          host,
          detail:
            `${cause.stream} exceeded ${cause.limitBytes}-byte limit${action}`,
        });
      }
      return new BoxFailure({ host, detail: `spawn failed: ${String(cause)}` });
    }),
    Effect.timeoutOrElse({
      duration: `${HOST_QUERY_TIMEOUT_SECONDS} seconds`,
      orElse: () =>
        Effect.fail(
          new BoxFailure({
            host,
            detail:
              `query timed out after ${HOST_QUERY_TIMEOUT_SECONDS} seconds; retry or narrow the date window`,
          }),
        ),
    }),
  );

// Transport: runs one script on one host. Live = spawner + allowlisted env;
// tests build the same service over a mock spawner and a fixed env record, so
// no test reads Deno.env.
class HostTransport extends Context.Service<HostTransport, {
  readonly run: (
    host: string,
    script: string,
  ) => Effect.Effect<CommandOutput, BoxFailure>;
}>()("df-opencode-cost/HostTransport") {
  // Binds the spawner to an explicit environment record. Tests use this, so no
  // test ever reads Deno.env.
  static readonly spawned = (environment: ChildEnvironment) =>
    Layer.effect(
      HostTransport,
      Effect.gen(function* () {
        const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
        return HostTransport.of({
          run: (host, script) =>
            runHostCommand(host, script, environment).pipe(
              Effect.provideService(
                ChildProcessSpawner.ChildProcessSpawner,
                spawner,
              ),
            ),
        });
      }),
    );
  // Live: reads the allowlisted env when the layer builds (CLI path only).
  static readonly live = Layer.effect(
    HostTransport,
    Effect.gen(function* () {
      const environment = yield* childEnvironment;
      const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
      return HostTransport.of({
        run: (host, script) =>
          runHostCommand(host, script, environment).pipe(
            Effect.provideService(
              ChildProcessSpawner.ChildProcessSpawner,
              spawner,
            ),
          ),
      });
    }),
  );
}

// Last JSON-object line of stdout. Deno may print diagnostics before it.
const payloadLine = (stdout: string): string => {
  const objects = stdout.split("\n").map((l) => l.trim()).filter((l) =>
    l.startsWith("{")
  );
  return objects.at(-1) ?? stdout.trim();
};

// Returns None when the host has no DB file for this source (skipped, not failed).
const collectHost = Effect.fn("collectHost")(
  function* (host: string, script: string) {
    const transport = yield* HostTransport;
    const out = yield* transport.run(host, script);
    const stderr = out.stderr.trim();
    if (!out.success) {
      return yield* new BoxFailure({
        host,
        detail: stderr || `exited ${out.code}`,
      });
    }
    const raw = payloadLine(out.stdout);
    const parsed = yield* Effect.try({
      try: () => JSON.parse(raw) as unknown,
      catch: () =>
        new BoxFailure({
          host,
          detail: `non-JSON output: ${raw.slice(0, 120)}`,
        }),
    });
    const payload = yield* decodePayload(parsed).pipe(
      Effect.mapError((e) =>
        new BoxFailure({ host, detail: `schema mismatch: ${e}` })
      ),
    );
    return payload.absent
      ? Option.none<readonly UsageRow[]>()
      : Option.some<readonly UsageRow[]>(payload.rows);
  },
);

// --- UsageSource service: one interface, two layers (v1 / v2) -----------
type UsageSourceService = {
  readonly id: SourceId;
  readonly label: string;
  readonly script: (window: Window) => string;
  readonly query: (
    host: string,
    window: Window,
  ) => Effect.Effect<
    Option.Option<readonly UsageRow[]>,
    BoxFailure,
    HostTransport
  >;
};

const makeUsageSource = (spec: SourceSpec): UsageSourceService => ({
  id: spec.id,
  label: spec.label,
  script: (window) => usageScript(spec, window),
  query: (host, window) => collectHost(host, usageScript(spec, window)),
});

class UsageSource extends Context.Service<UsageSource, UsageSourceService>()(
  "df-opencode-cost/UsageSource",
) {
  static readonly v1 = Layer.succeed(
    UsageSource,
    UsageSource.of(makeUsageSource(V1_SPEC)),
  );
  static readonly v2 = Layer.succeed(
    UsageSource,
    UsageSource.of(makeUsageSource(V2_SPEC)),
  );
}

const sourceLayer = (id: SourceId) =>
  id === "v1" ? UsageSource.v1 : UsageSource.v2;

const queryPair = (source: SourceId, host: string, window: Window) =>
  Effect.gen(function* () {
    const usage = yield* UsageSource;
    return yield* usage.query(host, window);
  }).pipe(Effect.provide(sourceLayer(source)));

const selectedSources = (
  selection: SourceSelection,
): readonly SourceId[] => selection === "all" ? SOURCE_IDS : [selection];

// --- Settlement: partition per-(host × source) outcomes ------------------
type PairOutcome = {
  readonly host: string;
  readonly source: SourceId;
  readonly result: Result.Result<
    Option.Option<readonly UsageRow[]>,
    BoxFailure
  >;
};
type SourceRows = {
  readonly host: string;
  readonly source: SourceId;
  readonly rows: readonly UsageRow[];
};
type Failure = { readonly host: string; readonly source: SourceId; readonly detail: string };

const settle = (outcomes: readonly PairOutcome[]) => {
  const rows: SourceRows[] = [];
  const answered: string[] = [];
  const failed: Failure[] = [];
  for (const o of outcomes) {
    if (!Result.isSuccess(o.result)) {
      failed.push({
        host: o.host,
        source: o.source,
        detail: o.result.failure.detail,
      });
      continue;
    }
    if (!answered.includes(o.host)) answered.push(o.host);
    if (Option.isSome(o.result.success)) {
      rows.push({ host: o.host, source: o.source, rows: o.result.success.value });
    }
  }
  const sources = SOURCE_IDS.filter((s) => rows.some((r) => r.source === s));
  return { rows, answered, sources, failed };
};

// --- Aggregation ---------------------------------------------------------
type Bucket = {
  cost: number;
  input: number;
  output: number;
  reasoning: number;
  cacheRead: number;
  cacheWrite: number;
};
const emptyBucket = (): Bucket => ({
  cost: 0,
  input: 0,
  output: 0,
  reasoning: 0,
  cacheRead: 0,
  cacheWrite: 0,
});
const addTo = (b: Bucket, r: UsageRow): void => {
  b.cost += r.cost;
  b.input += r.input;
  b.output += r.output;
  b.reasoning += r.reasoning;
  b.cacheRead += r.cacheRead;
  b.cacheWrite += r.cacheWrite;
};
type ProjectAgg = {
  project: string;
  total: Bucket;
  bySource: Map<SourceId, Bucket>;
  byHost: Map<string, Bucket>;
  byWorktree: Map<string, Bucket>;
};

const aggregate = (
  sourceRows: readonly SourceRows[],
): { projects: ProjectAgg[]; grand: Bucket } => {
  const projects = new Map<string, ProjectAgg>();
  const grand = emptyBucket();
  for (const { host, source, rows } of sourceRows) {
    for (const row of rows) {
      const { project, worktree } = splitWorktree(
        canonProject(homeRel(row.dir)),
      );
      let agg = projects.get(project);
      if (!agg) {
        agg = {
          project,
          total: emptyBucket(),
          bySource: new Map(),
          byHost: new Map(),
          byWorktree: new Map(),
        };
        projects.set(project, agg);
      }
      addTo(agg.total, row);
      addTo(grand, row);
      if (!agg.bySource.has(source)) agg.bySource.set(source, emptyBucket());
      addTo(agg.bySource.get(source)!, row);
      if (!agg.byHost.has(host)) agg.byHost.set(host, emptyBucket());
      addTo(agg.byHost.get(host)!, row);
      if (worktree) {
        if (!agg.byWorktree.has(worktree)) {
          agg.byWorktree.set(worktree, emptyBucket());
        }
        addTo(agg.byWorktree.get(worktree)!, row);
      }
    }
  }
  return {
    projects: [...projects.values()].sort((a, b) =>
      b.total.cost - a.total.cost
    ),
    grand,
  };
};

// --- Rendering (composite heatmap: grid + rails + spark + footnote) ------
const ESC = "\x1b";
const tfg = (r: number, g: number, b: number) => `${ESC}[38;2;${r};${g};${b}m`;
const tbg = (r: number, g: number, b: number) => `${ESC}[48;2;${r};${g};${b}m`;
const RESET = `${ESC}[0m`;
const BOLD = `${ESC}[1m`;
const IT = `${ESC}[3m`;
const DIM = `${ESC}[2m`;

// display-width pad (multibyte glyphs count 1 col; String length is codepoints)
const padL = (s: string, w: number) =>
  " ".repeat(Math.max(0, w - [...s].length)) + s;
const padR = (s: string, w: number) =>
  s + " ".repeat(Math.max(0, w - [...s].length));

const PBG = tbg(247, 243, 233);
const RULEC = tfg(200, 186, 158);
const BLOCKS = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"];

const heatBg = (v: number): string =>
  v >= 500
    ? tbg(198, 40, 42)
    : v >= 100
    ? tbg(214, 118, 38)
    : v >= 10
    ? tbg(176, 168, 54)
    : v > 0
    ? tbg(58, 108, 84)
    : tbg(34, 36, 44);
const heatFg = (
  v: number,
): string => (v >= 100 ? tfg(255, 255, 255) : tfg(20, 20, 24));

const usd = (n: number) => `$${n.toFixed(2)}`;
const num = (n: number) => n.toLocaleString("en-US");
const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);

const render = (
  projects: readonly ProjectAgg[],
  grand: Bucket,
  hosts: readonly string[],
  sources: readonly SourceId[],
  window: Window,
): string[] => {
  const PW = Math.max(24, ...projects.map((p) => [...p.project].length)) + 2;
  // Cell width adapts to the widest hostname header (e.g. for-tasks-1.coder) so
  // column heads never overflow into the rail; floor of 12 keeps money readable.
  const CW = Math.max(12, ...hosts.map((h) => [...h].length + 1));
  const rule = `${PBG}${RULEC}│${RESET}`;
  const maxCost = Math.max(1, ...projects.map((p) => p.total.cost));
  const spark = (v: number) =>
    BLOCKS[Math.min(7, Math.max(0, Math.round((v / maxCost) * 7)))];
  // Source split is only worth a row when more than one generation contributes.
  const multi = sources.length > 1;
  const sourceLine = (costOf: (s: SourceId) => number | undefined): string =>
    sources
      .flatMap((s) => {
        const c = costOf(s);
        return c === undefined ? [] : [`${s} ${usd(c)}`];
      })
      .join(" · ");
  const lines: string[] = [];

  lines.push(
    `\n${PBG}${tfg(40, 30, 20)}${BOLD}  ◈ opencode spend  ${RESET}` +
      `${PBG}${tfg(120, 100, 80)}${IT}${day(window.sinceMs)} → ${
        day(window.untilMs)
      }${RESET}` +
      `${PBG}${
        tfg(170, 150, 120)
      }${IT}  · by ${window.basis} · sources ${
        sources.join("+") || "none"
      } · ${hosts.length} host(s) ${RESET}`,
  );

  if (projects.length === 0) {
    lines.push(
      `${DIM}${tfg(150, 135, 112)}${IT}  no session rows in window on answering hosts${RESET}`,
    );
    return lines;
  }

  let head = `${PBG}${tfg(150, 130, 105)}${IT}  ${
    padR("project", PW)
  }${RESET}${rule}`;
  for (const h of hosts) {
    head += `${PBG}${tfg(150, 130, 105)}${IT}${padL(h, CW)} ${RESET}${rule}`;
  }
  head +=
    `${PBG}${tfg(90, 70, 50)}${BOLD}${padL("Σ row", 10)} ${RESET}${rule}` +
    `${PBG}${tfg(90, 70, 50)}${IT} trend${RESET}`;
  lines.push(head);

  const cell = (v: number) => {
    const s = v === 0 ? "·" : v.toFixed(2);
    return `${heatBg(v)}${heatFg(v)}${padL(s, CW)} ${RESET}${rule}`;
  };
  for (const p of projects) {
    let ln = `${PBG}${tfg(40, 30, 20)}  ${padR(p.project, PW)}${RESET}${rule}`;
    for (const h of hosts) ln += cell(p.byHost.get(h)?.cost ?? 0);
    ln +=
      `${PBG}${tfg(150, 40, 30)}${BOLD}${
        padL(usd(p.total.cost), 10)
      } ${RESET}${rule}` +
      `${PBG}${tfg(150, 40, 30)} ${spark(p.total.cost)} ${RESET}`;
    lines.push(ln);
    if (multi) {
      lines.push(
        `${PBG}${tfg(150, 135, 112)}${IT}${DIM}  ⇢ ${
          sourceLine((s) => p.bySource.get(s)?.cost)
        }${RESET}`,
      );
    }
    for (
      const [wt, b] of [...p.byWorktree.entries()].sort((a, b) =>
        b[1].cost - a[1].cost
      )
    ) {
      lines.push(
        `${PBG}${tfg(150, 135, 112)}${IT}${DIM}  ⌥ ${
          padR(wt, PW - 2)
        }${RESET}` +
          `${PBG}${tfg(150, 135, 112)}${IT}${
            padL(usd(b.cost), CW * hosts.length + 2)
          }${RESET}`,
      );
    }
  }

  let foot = `${PBG}${tfg(90, 70, 50)}${BOLD}  ${
    padR("Σ host", PW)
  }${RESET}${rule}`;
  for (const h of hosts) {
    const c = projects.reduce((s, p) => s + (p.byHost.get(h)?.cost ?? 0), 0);
    foot += `${PBG}${tfg(90, 70, 50)}${BOLD}${
      padL(usd(c), CW)
    } ${RESET}${rule}`;
  }
  foot +=
    `${PBG}${tfg(150, 40, 30)}${BOLD}${
      padL(usd(grand.cost), 10)
    } ${RESET}${rule}` +
    `${PBG}${tfg(150, 40, 30)} ${spark(maxCost)} ${RESET}`;
  lines.push(foot);
  if (multi) {
    lines.push(
      `${PBG}${tfg(90, 70, 50)}${BOLD}  ${padR("Σ source", PW)}${RESET}` +
        `${PBG}${tfg(90, 70, 50)}${IT}${
          sourceLine((s) =>
            projects.reduce((t, p) => t + (p.bySource.get(s)?.cost ?? 0), 0)
          )
        }${RESET}`,
    );
  }

  lines.push(
    `${DIM}${tfg(150, 135, 112)}${IT}  · unused   ${
      tfg(120, 105, 85)
    }░ <10  ▒ <100  ▓ <500  █ 500+ (heat)  ` +
      `${tfg(150, 135, 112)}│ trend = row total vs top spend${RESET}`,
  );
  lines.push(
    `${DIM}${tfg(150, 135, 112)}${IT}  · tokens in ${num(grand.input)} · out ${
      num(grand.output)
    } · cache-read ${num(grand.cacheRead)} · cache-write ${
      num(grand.cacheWrite)
    }${RESET}`,
  );
  lines.push(
    `${DIM}${
      tfg(150, 135, 112)
    }${IT}  ↪ devbox ~/work/<repo> folded into ~/dev/canva/<repo>${RESET}`,
  );
  return lines;
};

// --- CLI -----------------------------------------------------------------
const hostsFlag = Flag.String("host").pipe(
  Flag.withAlias("H"),
  Flag.withDescription(
    `Comma-delimited hosts. 'local' runs here; others are ssh targets. [default: configured / ${
      CONFIGURED_HOSTS.join(",") || "none"
    }]`,
  ),
  Flag.withDefault(""),
);
const sinceFlag = Flag.String("since").pipe(
  Flag.withAlias("s"),
  Flag.withDescription(
    "Window start: date (2026-01-01) or span (30d/2w/3m). [default: 30d]",
  ),
  Flag.withDefault("30d"),
);
const untilFlag = Flag.String("until").pipe(
  Flag.withAlias("u"),
  Flag.withDescription("Window end: date or span. [default: now]"),
  Flag.withDefault(""),
);
const concurrencyFlag = Flag.Int("concurrency").pipe(
  Flag.withAlias("c"),
  Flag.withDescription(
    "Max host×source queries in parallel. [default: 4]",
  ),
  Flag.withDefault(4),
);
const basisFlag = Flag.Literals("time-basis", ["created", "updated"]).pipe(
  Flag.withDescription(
    "Filter by session start (created) or last activity (updated). [default: created]",
  ),
  Flag.withDefault("created" as Basis),
);
const sourceFlag = Flag.Literals("source", ["v1", "v2", "all"]).pipe(
  Flag.withDescription(
    "OpenCode generation: v1 (opencode.db), v2 (opencode2.db), or all. [default: all]",
  ),
  Flag.withDefault("all" as SourceSelection),
);

const costCommand = Command.make(
  "df-opencode-cost",
  {
    host: hostsFlag,
    since: sinceFlag,
    until: untilFlag,
    concurrency: concurrencyFlag,
    "time-basis": basisFlag,
    source: sourceFlag,
  },
  (opts) =>
    Effect.gen(function* () {
      const now = Date.now();
      const cliHosts = opts.host.split(",").map((h) => h.trim()).filter((h) =>
        h.length > 0
      );
      const hosts = cliHosts.length > 0 ? cliHosts : CONFIGURED_HOSTS;
      const basis = opts["time-basis"];

      if (hosts.length === 0) {
        yield* Console.error(
          "No hosts configured. Set openCodeCostHosts via `chezmoi edit-config` " +
            "(e.g. local,for-tasks-1.coder), or pass --host local,box.coder.",
        );
        return yield* Effect.sync(() => Deno.exit(2));
      }

      const sinceMs = parseWhen(opts.since, now);
      if (sinceMs === null) {
        yield* Console.error(
          `--since: cannot parse "${opts.since}" (use 2026-01-01 or 30d)`,
        );
        return yield* Effect.sync(() => Deno.exit(2));
      }
      const untilMs = opts.until === "" ? now : parseWhen(opts.until, now);
      if (untilMs === null) {
        yield* Console.error(`--until: cannot parse "${opts.until}"`);
        return yield* Effect.sync(() => Deno.exit(2));
      }

      const window: Window = { sinceMs, untilMs, basis };
      const sources = selectedSources(opts.source);
      // Host-major so answered hosts keep their configured order.
      const pairs = hosts.flatMap((host) =>
        sources.map((source) => ({ host, source }))
      );
      const outcomes = yield* Effect.forEach(
        pairs,
        ({ host, source }) =>
          queryPair(source, host, window).pipe(
            Effect.result,
            Effect.map((result): PairOutcome => ({ host, source, result })),
          ),
        { concurrency: opts.concurrency },
      );

      const settled = settle(outcomes);
      const { projects, grand } = aggregate(settled.rows);
      for (
        const line of render(
          projects,
          grand,
          settled.answered,
          settled.sources,
          window,
        )
      ) {
        yield* Console.log(line);
      }
      for (const f of settled.failed) {
        yield* Console.error(`  ! ${f.host}[${f.source}]: ${f.detail}`);
      }
    }).pipe(Effect.provide(HostTransport.live)),
);

// --- Entry point ---------------------------------------------------------
if (import.meta.main) {
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });

  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0/NodeServices"
  );
  Command.run(costCommand, { version: "2.0.0" }).pipe(
    Effect.provide(NodeServices.layer),
    NodeRuntime.runMain,
  );
}

