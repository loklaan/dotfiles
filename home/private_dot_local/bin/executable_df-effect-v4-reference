// deno test --config deno.json --allow-read --allow-write --allow-env --allow-sys=uid --allow-run=deno,/usr/bin/tar,/bin/kill,/bin/ln,/bin/rmdir --allow-net=codeload.github.com home/private_dot_local/bin/executable_df-effect-v4-reference

import { strict as assert } from "node:assert";

Deno.test("status contract preserves every lifecycle field and state", () => {
  assert.deepEqual(statusDocument("current", "/reference/current"), {
    schema: 1,
    state: "current",
    path: "/reference/current",
    version: EFFECT_VERSION,
    commit: EFFECT_COMMIT,
    checksum: ARCHIVE_SHA256,
    url: ARCHIVE_URL,
  });
});

Deno.test("archive inspection rejects escaping and non-regular entries", () => {
  assert.deepEqual([
    archiveEntrySafe("effect/file.ts", "-"),
    archiveEntrySafe("/etc/passwd", "-"),
    archiveEntrySafe("effect/../escape", "-"),
    archiveEntrySafe("effect/link", "l"),
  ], [true, false, false, false]);
});

Deno.test("ledger decoder upgrades the historical pending commit", () => {
  const wire = Schema.decodeUnknownSync(LedgerWire)({
    schema: 1,
    versions: [],
    pending: EFFECT_COMMIT,
  });
  assert.deepEqual(normalizeLedger(wire), {
    schema: 1,
    versions: [],
    pending: { operation: "publish", commit: EFFECT_COMMIT },
  });
});

Deno.test("ledger rejects duplicate ownership", () => {
  assert.equal(
    Schema.is(Ledger)({
      schema: 1,
      versions: [EFFECT_COMMIT, EFFECT_COMMIT],
      pending: null,
    }),
    false,
  );
});

Deno.test("legacy help bytes remain exact", () => {
  assert.equal(
    usage,
    `Usage:
  df-effect-v4-reference install
  df-effect-v4-reference remove
  df-effect-v4-reference status
  df-effect-v4-reference path

Description:
  Reconciles the immutable Effect v4 source reference owned by the
  \`effect-v4:install\` mise task. The corpus stays outside skill and OpenCode
  config trees and is never added to PATH.\n`,
  );
});

Deno.test("permission phases grant only command capabilities", () => {
  assert.deepEqual(
    operationGrants({
      schema: 1,
      command: "status",
      root: "/physical/reference",
    }),
    [
      `--allow-env=${OPERATION_ENV},${NODE_COVERAGE_ENV}`,
      "--allow-read=/physical,/physical/reference",
      "--allow-sys=uid",
    ],
  );
  assert.deepEqual(
    operationGrants({
      schema: 1,
      command: "install",
      root: "/physical/reference",
    }),
    [
      `--allow-env=${OPERATION_ENV},${NODE_COVERAGE_ENV}`,
      "--allow-read=/physical,/physical/reference",
      "--allow-write=/physical/reference",
      "--allow-sys=uid",
      `--allow-run=${TAR},${KILL},${LN},${RMDIR}`,
      "--allow-net=codeload.github.com",
    ],
  );
});

Deno.test("archive modes ignore umask while preserving executable files", () => {
  assert.deepEqual([
    canonicalArchiveMode("directory", 0o755),
    canonicalArchiveMode("directory", 0o700),
    canonicalArchiveMode("file", 0o644),
    canonicalArchiveMode("file", 0o600),
    canonicalArchiveMode("file", 0o755),
    canonicalArchiveMode("file", 0o700),
  ], [0o555, 0o555, 0o444, 0o444, 0o555, 0o555]);
});

const integrationPermissions = [
  Deno.permissions.querySync({ name: "read" }).state,
  Deno.permissions.querySync({ name: "write" }).state,
  Deno.permissions.querySync({ name: "env" }).state,
  Deno.permissions.querySync({ name: "sys", kind: "uid" }).state,
  Deno.permissions.querySync({ name: "run", command: TAR }).state,
  Deno.permissions.querySync({ name: "run", command: KILL }).state,
  Deno.permissions.querySync({ name: "run", command: LN }).state,
  Deno.permissions.querySync({ name: "run", command: RMDIR }).state,
  Deno.permissions.querySync({ name: "run", command: Deno.execPath() }).state,
  Deno.permissions.querySync({
    name: "net",
    host: "codeload.github.com",
  }).state,
].every((state) => state === "granted");

const runGoldenCli = async (
  args: readonly string[],
  root: string,
): Promise<
  { readonly code: number; readonly stdout: string; readonly stderr: string }
> => {
  const output = await new Deno.Command(Deno.execPath(), {
    args: [
      "run",
      "--no-prompt",
      "--allow-env=HOME,MISE_DATA_DIR,EFFECT_V4_REFERENCE_ROOT,DF_EFFECT_V4_OPERATION",
      "--allow-run=deno",
      fileURLToPath(import.meta.url),
      ...args,
    ],
    env: { EFFECT_V4_REFERENCE_ROOT: root },
    stdout: "piped",
    stderr: "piped",
  }).output();
  return {
    code: output.code,
    stdout: new TextDecoder().decode(output.stdout),
    stderr: new TextDecoder().decode(output.stderr),
  };
};

Deno.test({
  name: "integration: legacy CLI stdout, stderr and exits remain golden",
  ignore: !integrationPermissions,
  fn: async () => {
    const temporary = await Deno.makeTempDir({ prefix: "df-effect-cli-" });
    const root = `${await Deno.realPath(temporary)}/reference`;
    try {
      assert.deepEqual(await runGoldenCli(["--help"], root), {
        code: 0,
        stdout: usage,
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli([], root), {
        code: 2,
        stdout: "",
        stderr: usage,
      });
      assert.deepEqual(await runGoldenCli(["status"], root), {
        code: 1,
        stdout: `${
          JSON.stringify(statusDocument("missing", `${root}/current`))
        }\n`,
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli(["path"], root), {
        code: 1,
        stdout: "",
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli(["remove"], root), {
        code: 0,
        stdout: `${
          JSON.stringify(statusDocument("removed", `${root}/current`))
        }\n`,
        stderr: "",
      });
    } finally {
      await Deno.remove(temporary, { recursive: true });
    }
  },
});

Deno.test({
  name:
    "integration: scoped launcher repairs a missing pointer, reapplies and removes the reference",
  ignore: !integrationPermissions,
  sanitizeOps: false,
  sanitizeResources: false,
  fn: async () => {
    const temporary = await Deno.makeTempDir({ prefix: "df-effect-cli-" });
    const root = `${await Deno.realPath(temporary)}/reference`;
    try {
      const current = JSON.stringify(
        statusDocument("current", `${root}/current`),
      );
      assert.deepEqual(await runGoldenCli(["install"], root), {
        code: 0,
        stdout: `${current}\n`,
        stderr: "",
      });
      await Deno.remove(`${root}/current`);
      assert.equal(
        (await Deno.stat(`${root}/versions/${EFFECT_COMMIT}`)).isDirectory,
        true,
      );
      assert.deepEqual(await runGoldenCli(["install"], root), {
        code: 0,
        stdout: `${current}\n`,
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli(["install"], root), {
        code: 0,
        stdout: `${current}\n`,
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli(["status"], root), {
        code: 0,
        stdout: `${current}\n`,
        stderr: "",
      });
      assert.deepEqual(await runGoldenCli(["remove"], root), {
        code: 0,
        stdout: `${
          JSON.stringify(statusDocument("removed", `${root}/current`))
        }\n`,
        stderr: "",
      });
    } finally {
      await runGoldenCli(["remove"], root);
      await Deno.remove(temporary, { recursive: true });
    }
  },
});

Deno.test({
  name:
    "integration: disposable install, recovery, ownership, status, path and remove matrix",
  ignore: !integrationPermissions,
  sanitizeOps: false,
  sanitizeResources: false,
  fn: async () => {
    const NodeServices = await import(
      "npm:@effect/platform-node@4.0.0-rc.117/NodeServices"
    );
    const program = Effect.scoped(Effect.gen(function* () {
      const fs = yield* FileSystem;
      const temporary = yield* fs.makeTempDirectoryScoped({
        prefix: "df-effect-v4-reference-",
      });
      const root = `${yield* fs.realPath(temporary)}/reference`;
      const paths = pathsFor(root);
      yield* fs.makeDirectory(root);
      const staleToken = "99999999.stale-owner";
      const preOwnerToken = "99999998.pre-owner";
      const malformedToken = "99999997.malformed";
      yield* fs.makeDirectory(
        `${root}/.install-lock-candidate.${preOwnerToken}`,
      );
      yield* fs.makeDirectory(
        `${root}/.install-lock-candidate.${malformedToken}`,
      );
      yield* fs.writeFileString(
        `${root}/.install-lock-candidate.${malformedToken}/owner.json`,
        "",
      );
      yield* fs.makeDirectory(paths.lock);
      yield* fs.writeFileString(
        `${paths.lock}/owner.json`,
        `${
          JSON.stringify({
            schema: 1,
            pid: 99999999,
            token: staleToken,
            commit: EFFECT_COMMIT,
          })
        }\n`,
        { mode: 0o600 },
      );
      yield* fs.chmod(`${paths.lock}/owner.json`, 0o600);
      yield* fs.makeDirectory(`${root}/.install.${staleToken}`);
      yield* fs.writeFileString(
        `${root}/.install.${staleToken}/${STAGE_MARKER}`,
        `${staleToken}\n`,
      );
      yield* fs.writeFileString(`${root}/.archive.${staleToken}`, "partial");
      yield* fs.symlink(
        `versions/${EFFECT_COMMIT}`,
        `${root}/.current.${staleToken}`,
      );

      assert.equal((yield* observeStatus(paths)).state, "missing");
      assert.equal((yield* install(paths)).state, "current");
      assert.equal((yield* observeStatus(paths)).state, "current");
      assert.equal(paths.current, `${root}/current`);
      const installed = yield* validateTree(paths.version, EFFECT_COMMIT);
      assert.equal(installed.receipt.schema, 2);
      if (installed.receipt.schema !== 2) {
        return yield* Effect.fail(
          failure("Expected installed inventory receipt"),
        );
      }
      assert.equal(installed.receipt.contentDigest, EXPECTED_INVENTORY_DIGEST);
      const executableEntry = installed.receipt.entries.find((entry) =>
        entry.kind === "file" && entry.mode === 0o555
      );
      assert.ok(executableEntry);
      assert.equal(
        (yield* fs.stat(`${paths.version}/${executableEntry.relative}`)).mode &
          0o7777,
        0o555,
      );
      const modeDriftPath = `${paths.version}/LLMS.md`;
      yield* fs.chmod(modeDriftPath, 0o400);
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      yield* fs.chmod(modeDriftPath, 0o444);
      assert.equal((yield* observeStatus(paths)).state, "current");
      const legacy: typeof LegacyReceipt.Type = {
        schema: 1,
        version: installed.receipt.version,
        commit: installed.receipt.commit,
        checksum: installed.receipt.checksum,
        url: installed.receipt.url,
        contentDigest: yield* legacyTreeDigest(installed.inventory.files),
      };
      const installedRootMode = (yield* fs.stat(paths.version)).mode & 0o7777;
      const installedReceiptPath = `${paths.version}/${RECEIPT_NAME}`;
      yield* fs.chmod(paths.version, installedRootMode | 0o200);
      yield* fs.chmod(installedReceiptPath, 0o644);
      yield* fs.writeFileString(
        installedReceiptPath,
        `${JSON.stringify(legacy)}\n`,
      );
      yield* fs.chmod(installedReceiptPath, 0o444);
      const legacyUnknown = `${paths.version}/legacy-unknown-empty`;
      yield* fs.makeDirectory(legacyUnknown, { mode: 0o555 });
      yield* fs.chmod(paths.version, installedRootMode);
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      assert.equal((yield* install(paths).pipe(Effect.result))._tag, "Failure");
      assert.equal((yield* fs.stat(legacyUnknown)).type, "Directory");
      assert.equal(
        JSON.parse(yield* fs.readFileString(installedReceiptPath)).schema,
        1,
      );
      yield* fs.chmod(paths.version, installedRootMode | 0o200);
      yield* removeEmptyDirectory(legacyUnknown);
      for (const entry of [...installed.receipt.entries].reverse()) {
        const target = entry.relative === "."
          ? paths.version
          : `${paths.version}/${entry.relative}`;
        yield* fs.chmod(
          target,
          entry.kind === "directory"
            ? 0o500
            : entry.mode === 0o555
            ? 0o500
            : 0o400,
        );
      }
      yield* fs.chmod(installedReceiptPath, 0o400);
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      assert.equal((yield* install(paths)).state, "current");
      assert.equal(
        JSON.parse(yield* fs.readFileString(installedReceiptPath)).schema,
        2,
      );
      assert.equal((yield* install(paths)).state, "current");
      assert.equal(
        (yield* fs.readDirectory(root)).some((name) =>
          name.includes(staleToken) || name.includes(preOwnerToken)
        ),
        false,
      );
      assert.equal(
        (yield* fs.stat(`${root}/.install-lock-candidate.${malformedToken}`))
          .type,
        "Directory",
      );

      const ledger = yield* readLedger(paths);
      yield* writeLedger(paths, {
        schema: 1,
        versions: [],
        pending: { operation: "publish", commit: EFFECT_COMMIT },
      }, "test-recovery");
      yield* fs.chmod(paths.version, installedRootMode | 0o200);
      assert.equal((yield* install(paths)).state, "current");
      assert.deepEqual(yield* readLedger(paths), ledger);

      const originalLedger = yield* fs.readFile(paths.ledger);
      yield* fs.writeFileString(paths.ledger, "{malformed\n");
      yield* fs.chmod(paths.ledger, 0o600);
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      yield* fs.writeFile(paths.ledger, originalLedger);
      yield* fs.chmod(paths.ledger, 0o600);

      const llms = `${paths.version}/LLMS.md`;
      const originalLlms = yield* fs.readFile(llms);
      const originalMode = (yield* fs.stat(llms)).mode & 0o7777;
      yield* fs.chmod(llms, originalMode | 0o200);
      yield* fs.writeFileString(llms, "changed\n");
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      assert.equal(
        (yield* removeReference(paths).pipe(Effect.result))._tag,
        "Failure",
      );
      yield* fs.writeFile(llms, originalLlms);
      yield* fs.chmod(llms, originalMode);
      assert.equal((yield* observeStatus(paths)).state, "current");

      const oldCommit = "1111111111111111111111111111111111111111";
      const oldPath = `${paths.versions}/${oldCommit}`;
      yield* fs.copy(paths.version, oldPath, { preserveTimestamps: true });
      yield* chmodTree(oldPath, true);
      const oldReceiptPath = `${oldPath}/${RECEIPT_NAME}`;
      const oldReceipt = yield* parseJson(
        Receipt,
        yield* fs.readFileString(oldReceiptPath),
        "fixture receipt",
      );
      yield* fs.writeFileString(
        oldReceiptPath,
        `${
          JSON.stringify({
            ...oldReceipt,
            commit: oldCommit,
            url:
              `https://codeload.github.com/Effect-TS/effect/tar.gz/${oldCommit}`,
          })
        }\n`,
      );
      yield* chmodTree(oldPath, false);
      const oldValidated = yield* validateTree(oldPath, oldCommit);
      assert.equal(oldValidated.receipt.schema, 2);
      if (oldValidated.receipt.schema !== 2) {
        return yield* Effect.fail(failure("Expected current receipt fixture"));
      }
      const oldPending: typeof RemovePending.Type = {
        operation: "remove",
        commit: oldCommit,
        tombstone: `.remove.${oldCommit}.test-prune-recovery`,
        contentDigest: oldValidated.receipt.contentDigest,
        entries: [...oldValidated.inventory.entries],
      };
      yield* writeLedger(paths, {
        schema: 1,
        versions: [EFFECT_COMMIT, oldCommit].sort(),
        pending: oldPending,
      }, "test-prune-recovery");
      const oldTombstone = `${paths.versions}/${oldPending.tombstone}`;
      yield* fs.rename(oldPath, oldTombstone);
      const removed = oldPending.entries.find((entry) => entry.kind === "file");
      assert.ok(removed);
      const removedParent = removed.relative.includes("/")
        ? removed.relative.slice(0, removed.relative.lastIndexOf("/"))
        : ".";
      const parentEntry = oldPending.entries.find((entry) =>
        entry.relative === removedParent && entry.kind === "directory"
      );
      assert.ok(parentEntry);
      yield* fs.chmod(
        removedParent === "."
          ? oldTombstone
          : `${oldTombstone}/${removedParent}`,
        parentEntry.mode | 0o200,
      );
      yield* fs.remove(`${oldTombstone}/${removed.relative}`);
      assert.equal((yield* install(paths)).state, "current");
      assert.equal(yield* physicalInfo(oldPath), null);

      const versionMode = (yield* fs.stat(paths.version)).mode & 0o7777;
      const unexpected = `${paths.version}/unexpected-empty`;
      yield* fs.chmod(paths.version, versionMode | 0o200);
      yield* fs.makeDirectory(unexpected, { mode: 0o555 });
      yield* fs.chmod(paths.version, versionMode);
      assert.equal((yield* observeStatus(paths)).state, "invalid");
      assert.equal(
        (yield* removeReference(paths).pipe(Effect.result))._tag,
        "Failure",
      );
      assert.equal((yield* fs.stat(unexpected)).type, "Directory");
      yield* fs.chmod(paths.version, versionMode | 0o200);
      yield* removeEmptyDirectory(unexpected);
      yield* fs.chmod(paths.version, versionMode);

      yield* fs.writeFileString(`${root}/foreign`, "preserve\n");
      assert.equal((yield* removeReference(paths)).state, "removed");
      assert.equal(yield* fs.readFileString(`${root}/foreign`), "preserve\n");
    }));
    await Effect.runPromise(program.pipe(
      Effect.provide(Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer)),
    ));
  },
});
