#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --allow-run=ps,tmux --allow-read --allow-write --allow-env --allow-sys=uid

// df-agent-state — survey and (gated) reap per-pane code-agent session state.
//
//   df-agent-state survey [--json]   Classify every state file. Read-only.
//   df-agent-state reap --confirm <checksum> [--delete] [--keep a,b] [--dry-run]
//
// WHY this exists: the state dir holds one file per tmux pane, each a CLAIM that
// "pane %N is hosting session X". Claims written before the liveness contract
// carry no proof, so they outlived their agents and — because tmux reassigns
// pane ids from %0 in every new server — were re-attributed to unrelated panes.
// This is the repair tool for that backlog. The normative definition of a claim
// lives in ~/.local/lib/tmux-resurrect-code-agents/state-dir.sh (LIVENESS
// CONTRACT); the `classify` function below MUST agree with tcsa_claim_is_live.
//
// AGE IS NEVER A REAP CRITERION. Writers only rewrite a file when the tracked
// session CHANGES, so a session held open for weeks has a weeks-old mtime and is
// perfectly live. `ageDays` is reporting metadata for the human reviewer only.
//
// THE GATE: `reap` re-surveys, recomputes the checksum, and refuses unless it
// matches --confirm. A report reviewed an hour ago must not authorise deleting
// state that changed since. The checksum deliberately excludes mtime/timestamps
// so it is stable across time and sensitive only to what a reviewer judged.
//
// Effect v4 import paths verified against effect@4.0.0-rc.112.

import {
  Console,
  Context,
  Effect,
  Layer,
  Option,
  PlatformError,
  Schema,
} from "npm:effect@4.0.0-rc.112";
import * as FileSystem from "npm:effect@4.0.0-rc.112/FileSystem";
import * as Path from "npm:effect@4.0.0-rc.112/Path";
import { Command, Flag } from "npm:effect@4.0.0-rc.112/unstable/cli";
import { createHash } from "node:crypto";
import { DatabaseSync } from "node:sqlite";
// NOTE: @effect/platform-node is imported DYNAMICALLY in import.meta.main only.
// It transitively loads msgpackr, which reads process.env at module load and
// throws NotCapable under zero-flag `deno test`. Same pattern as df-drift.
import { fileExists, hasCommand, parseJson, run } from "../lib/df-cache.ts";
import type * as Process from "npm:effect@4.0.0-rc.112/unstable/process";

type ToolEnv =
  | FileSystem.FileSystem
  | Path.Path
  | PhysicalFileSystem
  | Process.ChildProcessSpawner.ChildProcessSpawner;

interface PhysicalEntry {
  readonly name: string;
  readonly isFile: boolean;
  readonly isSymlink: boolean;
}

interface PhysicalIdentity {
  readonly device: number;
  readonly inode: number;
}

// rc.112 FileSystem exposes only stat, which follows symlinks. This narrow
// adapter retains Deno DirEntry.isFile and lstat identity without moving normal
// reads, metadata, paths, rename, or remove out of Effect platform services.
class PhysicalFileSystem extends Context.Service<PhysicalFileSystem, {
  readonly readDirectory: (
    path: string,
  ) => Effect.Effect<readonly PhysicalEntry[], PlatformError.PlatformError>;
  readonly identity: (
    path: string,
  ) => Effect.Effect<PhysicalIdentity | null, PlatformError.PlatformError>;
}>()("df-agent-state/PhysicalFileSystem") {
  static readonly layer = Layer.succeed(
    PhysicalFileSystem,
    PhysicalFileSystem.of({
      readDirectory: (directory) =>
        Effect.tryPromise({
          try: async () => {
            const entries: PhysicalEntry[] = [];
            for await (const entry of Deno.readDir(directory)) {
              entries.push({
                name: entry.name,
                isFile: entry.isFile,
                isSymlink: entry.isSymlink,
              });
            }
            return entries;
          },
          catch: (cause) =>
            PlatformError.systemError({
              _tag: "Unknown",
              module: "PhysicalFileSystem",
              method: "readDirectory",
              pathOrDescriptor: directory,
              cause,
            }),
        }),
      identity: (filePath) =>
        Effect.tryPromise({
          try: async () => {
            const info = await Deno.lstat(filePath);
            if (
              !info.isFile || info.isSymlink || info.dev === null ||
              info.ino === null
            ) return null;
            return { device: info.dev, inode: info.ino };
          },
          catch: (cause) =>
            PlatformError.systemError({
              _tag: "Unknown",
              module: "PhysicalFileSystem",
              method: "identity",
              pathOrDescriptor: filePath,
              cause,
            }),
        }),
    }),
  );
}

const DESCRIPTION =
  "Survey and gated-reap per-pane code-agent session state files";

const USAGE = `df-agent-state — ${DESCRIPTION}

  df-agent-state survey [--json]
      Classify every state file. Read-only; changes nothing.

  df-agent-state reap --confirm <checksum> [--delete] [--keep <pane>,...] [--dry-run]
      Reap everything the survey did not classify 'live'.
      Refuses unless --confirm matches the CURRENT survey checksum, so a stale
      report can never authorise reaping state that changed since review.
      Archives to <stateDir>/archive/<timestamp>/ unless --delete is given.

Statuses:
  live       claim's pid is alive, start time matches, pane matches  (never reaped)
  dead       claim present but its process is gone or was replaced
  legacy     written before the liveness contract; carries no claim
  malformed  unparseable, or missing a session id
`;

// ===========================================================================
// Schema
// ===========================================================================

const Status = Schema.Literals(["malformed", "legacy", "dead", "live"]);

const Entry = Schema.Struct({
  pane: Schema.String,
  agent: Schema.NullOr(Schema.String),
  sessionId: Schema.NullOr(Schema.String),
  status: Status,
  claimPid: Schema.NullOr(Schema.Number),
  claimStart: Schema.NullOr(Schema.String),
  paneOrphaned: Schema.NullOr(Schema.Boolean),
  isSubagent: Schema.NullOr(Schema.Boolean),
  title: Schema.NullOr(Schema.String),
  mtime: Schema.String,
  ageDays: Schema.Number,
});
type Entry = typeof Entry.Type;

// ===========================================================================
// Pure logic — everything below takes its world as arguments so the offline
// suite can exercise it with zero permissions and zero subprocesses.
// ===========================================================================

// The ONE normal form for claim.start, mirroring tcsa_normalise_ws in
// state-dir.sh. `ps -o lstart=` pads differently across platforms, so writer and
// reader agree on a normal form rather than on raw bytes.
export const normaliseWhitespace = (text: string): string =>
  text.replace(/\s+/g, " ").trim();

// Session ids reach SQL by interpolation, so anything outside the known shape is
// refused rather than escaped. A file is attacker-writable in principle and this
// is the only place its contents would reach a query.
const SESSION_ID = /^ses_[A-Za-z0-9]+$/;
export const isQueryableSessionId = (id: string): boolean =>
  SESSION_ID.test(id);

export interface RawFile {
  readonly pane: string;
  readonly text: string | null;
  readonly mtimeMs: number;
}

interface StateFileSnapshot {
  readonly raw: RawFile;
  readonly identity: PhysicalIdentity;
  readonly digest: string;
}

interface ObservedStateFile {
  readonly entry: Entry;
  readonly snapshot: StateFileSnapshot;
}

export interface World {
  /** pid -> normalised start time, for every process visible on this host. */
  readonly processStarts: ReadonlyMap<number, string>;
  /** Live pane ids, or null when no tmux server is running (unknowable). */
  readonly livePanes: ReadonlySet<string> | null;
  /** session id -> row, or null when OpenCode's db could not be read. */
  readonly sessions:
    | ReadonlyMap<string, {
      readonly parentId: string | null;
      readonly title: string | null;
    }>
    | null;
  readonly nowMs: number;
}

export const classify = (raw: RawFile, world: World): Entry => {
  const mtime = new Date(raw.mtimeMs).toISOString();
  const ageDays = Math.max(
    0,
    Math.round(((world.nowMs - raw.mtimeMs) / 86_400_000) * 10) / 10,
  );
  const paneOrphaned = world.livePanes === null
    ? null
    : !world.livePanes.has(raw.pane);

  const base = {
    pane: raw.pane,
    agent: null,
    sessionId: null,
    claimPid: null,
    claimStart: null,
    paneOrphaned,
    isSubagent: null,
    title: null,
    mtime,
    ageDays,
  } satisfies Omit<Entry, "status">;

  const parsed = raw.text === null ? null : parseJson(raw.text);
  if (parsed === null || typeof parsed !== "object") {
    return { ...base, status: "malformed" };
  }
  const record = parsed as Record<string, unknown>;

  const sessionId = typeof record.session_id === "string" && record.session_id
    ? record.session_id
    : null;
  const agent = typeof record.agent === "string" ? record.agent : null;
  if (sessionId === null) return { ...base, agent, status: "malformed" };

  const row = world.sessions === null
    ? undefined
    : world.sessions.get(sessionId);
  const isSubagent = world.sessions === null
    ? null
    : row === undefined
    ? null
    : Boolean(row.parentId && row.parentId.length > 0);
  const title = row?.title ?? null;

  const identified = { ...base, agent, sessionId, isSubagent, title };

  const claim = record.claim as Record<string, unknown> | undefined;
  const pid = typeof claim?.pid === "number" && Number.isInteger(claim.pid)
    ? claim.pid
    : null;
  const start = typeof claim?.start === "string" && claim.start
    ? claim.start
    : null;
  const claimPane = typeof claim?.pane === "string" && claim.pane
    ? claim.pane
    : null;

  // Hard cut: an incomplete claim cannot prove liveness and is never aged out.
  if (pid === null || start === null || claimPane === null) {
    return { ...identified, status: "legacy" };
  }

  const withClaim = { ...identified, claimPid: pid, claimStart: start };

  if (claimPane !== raw.pane) return { ...withClaim, status: "dead" };
  const liveStart = world.processStarts.get(pid);
  // pids are recycled, so pid-alive alone is not identity — the start time is
  // what distinguishes our agent from an unrelated process reusing its pid.
  if (liveStart === undefined || liveStart !== start) {
    return { ...withClaim, status: "dead" };
  }
  return { ...withClaim, status: "live" };
};

// Reduced to exactly the fields a reviewer's decision rests on, so the checksum
// is stable across time yet changes whenever a verdict could change.
export const reportChecksum = (entries: readonly Entry[]): string => {
  const reduced = [...entries]
    .sort((a, b) => (a.pane < b.pane ? -1 : a.pane > b.pane ? 1 : 0))
    .map((e) => [e.pane, e.sessionId, e.status, e.claimPid, e.claimStart]);
  return createHash("sha256").update(JSON.stringify(reduced)).digest("hex");
};

export const reapable = (
  entries: readonly Entry[],
  keep: ReadonlySet<string>,
): readonly Entry[] =>
  entries.filter((e) => e.status !== "live" && !keep.has(e.pane));

export const parsePsTable = (stdout: string): Map<number, string> => {
  const out = new Map<number, string>();
  for (const line of stdout.split("\n")) {
    const trimmed = line.trim();
    if (trimmed.length === 0) continue;
    const match = trimmed.match(/^(\d+)\s+(.*)$/);
    if (match === null) continue;
    out.set(Number(match[1]), normaliseWhitespace(match[2]));
  }
  return out;
};

export const formatTable = (entries: readonly Entry[]): string => {
  if (entries.length === 0) return "  (no state files)";
  const rows = entries.map((e) => [
    e.pane,
    e.status,
    `${e.ageDays}d`,
    e.isSubagent === true
      ? "subagent"
      : e.paneOrphaned === true
      ? "no-pane"
      : "",
    e.title ?? e.sessionId ?? "",
  ]);
  const headers = ["PANE", "STATUS", "AGE", "FLAGS", "SESSION"];
  const widths = headers.map((h, i) =>
    Math.max(h.length, ...rows.map((r) => r[i].length))
  );
  const line = (cells: readonly string[]) =>
    "  " + cells.map((c, i) => c.padEnd(widths[i])).join("  ").trimEnd();
  return [line(headers), ...rows.map(line)].join("\n");
};

export const summarise = (entries: readonly Entry[]): string => {
  const counts = new Map<string, number>();
  for (const e of entries) {
    counts.set(e.status, (counts.get(e.status) ?? 0) + 1);
  }
  const order = ["live", "dead", "legacy", "malformed"];
  return order
    .filter((s) => counts.has(s))
    .map((s) => `${counts.get(s)} ${s}`)
    .join(", ");
};

// ===========================================================================
// Effectful edges
// ===========================================================================

const stateDirPath = Effect.gen(function* () {
  const path = yield* Path.Path;
  const xdg = yield* Effect.sync(() => Deno.env.get("XDG_STATE_HOME"));
  const home = yield* Effect.sync(() => Deno.env.get("HOME") ?? "");
  const base = xdg && xdg.length > 0 ? xdg : path.join(home, ".local", "state");
  return path.join(base, "tmux-code-agents");
});

const opencodeDbPath = Effect.gen(function* () {
  const path = yield* Path.Path;
  const xdg = yield* Effect.sync(() => Deno.env.get("XDG_DATA_HOME"));
  const home = yield* Effect.sync(() => Deno.env.get("HOME") ?? "");
  const base = xdg && xdg.length > 0 ? xdg : path.join(home, ".local", "share");
  return path.join(base, "opencode", "opencode.db");
});

// Reads OpenCode's session table through node:sqlite rather than shelling out to
// the sqlite3 CLI. The CLI is a mise shim that has no version pinned on most
// Coder boxes, so it resolves on PATH — `command -v` succeeds — and then fails
// at runtime, which silently cost every box its session titles. In-process also
// means no --allow-run=sqlite3 in the shebang.
//
// The busy timeout is load-bearing, not defensive: the database is multi-GB WAL
// and a live OpenCode is writing it, so a bare open intermittently loses the
// lock and returns nothing. That failure is invisible in the output — titles
// just quietly go missing, and titles are what make the reap review possible.
//
// Ids are bound as parameters, so their content can never be interpreted as
// SQL; isQueryableSessionId remains only to avoid querying obvious junk.
const readSessions = (
  db: string,
  ids: readonly string[],
): Effect.Effect<World["sessions"], never, never> =>
  Effect.try(() => {
    const conn = new DatabaseSync(db, { readOnly: true });
    try {
      conn.exec("PRAGMA busy_timeout = 10000");
      const marks = ids.map(() => "?").join(",");
      const rows = conn.prepare(
        `select id,
                coalesce(nullif(parent_id,''), '') as parentId,
                coalesce(title,'') as title
           from session where id in (${marks})`,
      ).all(...ids) as Array<
        { id: string; parentId: string; title: string }
      >;
      const out = new Map<
        string,
        { parentId: string | null; title: string | null }
      >();
      for (const row of rows) {
        out.set(row.id, {
          parentId: row.parentId.length > 0 ? row.parentId : null,
          title: row.title.length > 0 ? row.title : null,
        });
      }
      return out as World["sessions"];
    } finally {
      conn.close();
    }
  }).pipe(Effect.orElseSucceed(() => null));

const readStateFile = (
  filePath: string,
  pane: string,
): Effect.Effect<
  StateFileSnapshot | null,
  never,
  FileSystem.FileSystem | PhysicalFileSystem
> =>
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    const physical = yield* PhysicalFileSystem;
    const before = yield* physical.identity(filePath);
    if (before === null) return null;
    const info = yield* fs.stat(filePath);
    if (info.type !== "File") return null;
    const text = yield* fs.readFileString(filePath);
    const after = yield* physical.identity(filePath);
    if (
      after === null || before.device !== after.device ||
      before.inode !== after.inode
    ) return null;
    return {
      raw: {
        pane,
        text,
        mtimeMs: info.mtime._tag === "Some" ? info.mtime.value.getTime() : 0,
      },
      identity: after,
      digest: createHash("sha256").update(text).digest("hex"),
    } satisfies StateFileSnapshot;
  }).pipe(Effect.orElseSucceed(() => null));

const readStateFiles = (
  stateDir: string,
): Effect.Effect<
  readonly StateFileSnapshot[],
  never,
  FileSystem.FileSystem | Path.Path | PhysicalFileSystem
> =>
  Effect.gen(function* () {
    const path = yield* Path.Path;
    const physical = yield* PhysicalFileSystem;
    const present = yield* fileExists(stateDir);
    if (!present) return [];
    const names = yield* physical.readDirectory(stateDir).pipe(
      Effect.map((entries) =>
        entries.filter((entry) =>
          entry.isFile && !entry.isSymlink && entry.name.startsWith("%")
        ).map((entry) => entry.name)
      ),
      Effect.orElseSucceed(() => [] as string[]),
    );

    const files: StateFileSnapshot[] = [];
    for (const pane of names.sort()) {
      const filePath = path.join(stateDir, pane);
      const snapshot = yield* readStateFile(filePath, pane);
      if (snapshot !== null) files.push(snapshot);
    }
    return files;
  });

const sessionIds = (files: readonly RawFile[]): readonly string[] => {
  const ids: string[] = [];
  for (const raw of files) {
    const parsed = raw.text === null ? null : parseJson(raw.text);
    const id = (parsed as Record<string, unknown> | null)?.session_id;
    if (typeof id === "string" && id.length > 0) ids.push(id);
  }
  return ids;
};

const observeWorld = (
  sessionIds: readonly string[],
): Effect.Effect<World, never, ToolEnv> =>
  Effect.gen(function* () {
    // One `ps` for the whole host rather than one per file: 49 files would
    // otherwise mean ~150 subprocesses via the shared `run` primitive.
    const ps = yield* run("ps", ["-Ao", "pid=,lstart="]);
    const processStarts = ps.ok
      ? parsePsTable(ps.stdout)
      : new Map<number, string>();

    let livePanes: ReadonlySet<string> | null = null;
    if (yield* hasCommand("tmux")) {
      const panes = yield* run("tmux", [
        "list-panes",
        "-a",
        "-F",
        "#{pane_id}",
      ]);
      // A failed call means no server is running, which makes orphanhood
      // unknowable — reporting every pane as orphaned would be a lie.
      if (panes.ok) {
        livePanes = new Set(
          panes.stdout.split("\n").map((l) => l.trim()).filter((l) =>
            l.length > 0
          ),
        );
      }
    }

    let sessions: World["sessions"] = null;
    const db = yield* opencodeDbPath;
    const queryable = sessionIds.filter(isQueryableSessionId);
    if (queryable.length > 0 && (yield* fileExists(db))) {
      sessions = yield* readSessions(db, queryable);
    }

    const nowMs = yield* Effect.sync(() => Date.now());
    return { processStarts, livePanes, sessions, nowMs };
  });

const survey = Effect.gen(function* () {
  const stateDir = yield* stateDirPath;
  const files = yield* readStateFiles(stateDir);
  const world = yield* observeWorld(sessionIds(files.map(({ raw }) => raw)));
  const observed = files.map((snapshot) => ({
    entry: classify(snapshot.raw, world),
    snapshot,
  } satisfies ObservedStateFile));
  const entries = observed.map(({ entry }) => entry);
  return { stateDir, entries, observed, checksum: reportChecksum(entries) };
});

const runSurvey = (asJson: boolean) =>
  Effect.gen(function* () {
    const { stateDir, entries, checksum } = yield* survey;
    if (asJson) {
      yield* Console.log(JSON.stringify(
        {
          stateDir,
          generatedAt: new Date().toISOString(),
          reportChecksum: checksum,
          entries,
        },
        null,
        2,
      ));
      return;
    }
    yield* Console.log(`\n  ${stateDir}\n`);
    yield* Console.log(formatTable(entries));
    yield* Console.log(
      `\n  ${entries.length} file(s): ${summarise(entries) || "none"}`,
    );
    yield* Console.log(`  checksum ${checksum}\n`);
    if (entries.some((e) => e.status !== "live")) {
      yield* Console.log(
        `  Review the table, then reap with:\n    df-agent-state reap --confirm ${checksum} --dry-run\n`,
      );
    }
  });

interface ReapPlan<R> {
  readonly stateDir: string;
  readonly archiveDir: string;
  readonly targets: readonly ObservedStateFile[];
  readonly classifyCurrent: (
    raw: RawFile,
  ) => Effect.Effect<Entry, never, R>;
  readonly destructive: boolean;
}

interface ReapResult {
  readonly completed: number;
  readonly failed: number;
}

const reapExitCode = (result: ReapResult): 0 | 1 => result.failed === 0 ? 0 : 1;

const executeReap = <R>(
  plan: ReapPlan<R>,
): Effect.Effect<
  ReapResult,
  never,
  FileSystem.FileSystem | Path.Path | PhysicalFileSystem | R
> =>
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    const path = yield* Path.Path;
    const verb = plan.destructive ? "delete" : "archive";
    if (!plan.destructive) {
      const prepared = yield* fs.makeDirectory(plan.archiveDir, {
        recursive: true,
      }).pipe(
        Effect.as(true),
        Effect.orElseSucceed(() => false),
      );
      if (!prepared) {
        yield* Console.error(
          `error could not create archive directory ${plan.archiveDir}`,
        );
        return { completed: 0, failed: plan.targets.length };
      }
    }

    let completed = 0;
    let failed = 0;
    for (const target of plan.targets) {
      const from = path.join(plan.stateDir, target.entry.pane);
      const classified = yield* readStateFile(from, target.entry.pane);
      if (classified === null) {
        failed++;
        yield* Console.error(
          `error skipped ${from}: current state could not be revalidated`,
        );
        continue;
      }
      const currentEntry = yield* plan.classifyCurrent(classified.raw);
      const current = yield* readStateFile(from, target.entry.pane);
      if (
        current === null ||
        current.identity.device !== classified.identity.device ||
        current.identity.inode !== classified.identity.inode ||
        current.digest !== classified.digest ||
        current.identity.device !== target.snapshot.identity.device ||
        current.identity.inode !== target.snapshot.identity.inode ||
        current.digest !== target.snapshot.digest ||
        reportChecksum([currentEntry]) !== reportChecksum([target.entry])
      ) {
        failed++;
        yield* Console.error(
          `error skipped ${from}: state changed since the confirmed survey`,
        );
        continue;
      }
      const operation = plan.destructive
        ? fs.remove(from)
        : fs.rename(from, path.join(plan.archiveDir, target.entry.pane));
      const outcome = yield* operation.pipe(
        Effect.as(true),
        Effect.orElseSucceed(() => false),
      );
      if (outcome) {
        completed++;
        yield* Console.log(
          `  ${plan.destructive ? "deleted" : "archived"} ${target.entry.pane}`,
        );
      } else {
        failed++;
        yield* Console.error(`error could not ${verb} ${from}`);
      }
    }
    return { completed, failed };
  });

const runReap = (
  confirm: string,
  keepRaw: string,
  destructive: boolean,
  dryRun: boolean,
) =>
  Effect.gen(function* () {
    if (confirm.length === 0) {
      yield* Console.error(
        "error --confirm is required. Run `df-agent-state survey` and pass the checksum it prints.",
      );
      return 1;
    }
    const { stateDir, entries, observed, checksum } = yield* survey;
    if (confirm !== checksum) {
      yield* Console.error(
        `error the state has changed since that survey (expected checksum ${checksum}, got ${confirm}). Re-run \`df-agent-state survey\` and review the new report before reaping.`,
      );
      return 1;
    }

    const keep = new Set(
      keepRaw.split(",").map((s) => s.trim()).filter((s) => s.length > 0),
    );
    const targetPanes = new Set(
      reapable(entries, keep).map(({ pane }) => pane),
    );
    const targets = observed.filter(({ entry }) => targetPanes.has(entry.pane));
    if (targets.length === 0) {
      yield* Console.log("  Nothing to reap.");
      return 0;
    }

    const stamp = new Date().toISOString().replace(/[:.]/g, "-");
    const path = yield* Path.Path;
    // Archived claims live beside the live ones, under the same subsystem that
    // owns them, and deliberately NOT as a hidden directory — a reap you cannot
    // see is a reap you will not remember you can undo. `readStateFiles` only
    // ever reads regular files whose name starts with "%", so a subdirectory
    // here can never be mistaken for a claim.
    const archiveDir = path.join(stateDir, "archive", stamp);
    const verb = destructive ? "delete" : "archive";

    if (dryRun) {
      yield* Console.log(`\n  Would ${verb} ${targets.length} file(s):`);
      for (const { entry } of targets) {
        yield* Console.log(
          `    ${entry.pane}  (${entry.status})  ${
            entry.title ?? entry.sessionId ?? ""
          }`,
        );
      }
      if (!destructive) yield* Console.log(`  into ${archiveDir}`);
      yield* Console.log("");
      return 0;
    }

    const result = yield* executeReap({
      stateDir,
      archiveDir,
      targets,
      classifyCurrent: (raw) =>
        Effect.gen(function* () {
          const currentWorld = yield* observeWorld(sessionIds([raw]));
          return classify(raw, currentWorld);
        }),
      destructive,
    });
    yield* Console.log(
      destructive
        ? `\n  Deleted ${result.completed} file(s).\n`
        : `\n  Archived ${result.completed} file(s) into ${archiveDir}\n`,
    );
    return reapExitCode(result);
  });

// ===========================================================================
// CLI
// ===========================================================================

const exitAfter = <E>(
  effect: Effect.Effect<number, E, ToolEnv>,
): Effect.Effect<never, never, ToolEnv> =>
  effect.pipe(
    Effect.orElseSucceed(() => 1),
    Effect.flatMap((code) => Effect.sync(() => Deno.exit(code))),
  ) as Effect.Effect<never, never, ToolEnv>;

const jsonFlag = Flag.boolean("json").pipe(
  Flag.withDescription("emit machine-readable JSON including the checksum"),
  Flag.withDefault(false),
);
const confirmFlag = Flag.string("confirm").pipe(
  Flag.withDescription("checksum from the survey being acted on"),
  Flag.withDefault(""),
);
const keepFlag = Flag.string("keep").pipe(
  Flag.withDescription("comma-separated pane ids to spare"),
  Flag.withDefault(""),
);
const deleteFlag = Flag.boolean("delete").pipe(
  Flag.withDescription("unlink instead of archiving"),
  Flag.withDefault(false),
);
const dryRunFlag = Flag.boolean("dry-run").pipe(
  Flag.withDescription("print what would happen and change nothing"),
  Flag.withDefault(false),
);

const surveyCli = Command.make(
  "survey",
  { json: jsonFlag },
  ({ json }) => exitAfter(runSurvey(json).pipe(Effect.as(0))),
).pipe(Command.withDescription("Classify every state file (read-only)"));

const reapCli = Command.make(
  "reap",
  {
    confirm: confirmFlag,
    keep: keepFlag,
    delete: deleteFlag,
    "dry-run": dryRunFlag,
  },
  (args) =>
    exitAfter(
      runReap(args.confirm, args.keep, args.delete, args["dry-run"]),
    ),
).pipe(
  Command.withDescription("Reap non-live state files behind a checksum gate"),
);

const agentStateCommand = Command.make(
  "df-agent-state",
  {},
  () =>
    Console.error(USAGE).pipe(
      Effect.flatMap(() => Effect.sync(() => Deno.exit(1))),
    ),
).pipe(
  Command.withDescription(DESCRIPTION),
  Command.withSubcommands([surveyCli, reapCli]),
);

if (import.meta.main) {
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(`error uncaught: ${event.message}`);
    Deno.exit(1);
  });

  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeServices"
  );
  Command.run(agentStateCommand, { version: "0.0.0" }).pipe(
    Effect.provide(PhysicalFileSystem.layer),
    Effect.provide(NodeServices.layer),
    NodeRuntime.runMain,
  );
}

// ===========================================================================
// Tests — pure logic only. Must pass OFFLINE with ZERO permission flags:
//   deno test home/private_dot_local/bin/executable_df-agent-state
// ===========================================================================

const LIVE_START = "Sat Aug 29 10:00:00 2026";
const NOW = Date.UTC(2026, 7, 29, 12, 0, 0);

const world = (over: Partial<World> = {}): World => ({
  processStarts: new Map([[4242, LIVE_START]]),
  livePanes: new Set(["%1"]),
  sessions: new Map([
    ["ses_root", { parentId: null, title: "A root session" }],
    ["ses_kid", { parentId: "ses_root", title: "A subagent" }],
  ]),
  nowMs: NOW,
  ...over,
});

const file = (pane: string, body: unknown, mtimeMs = NOW): RawFile => ({
  pane,
  text: typeof body === "string" ? body : JSON.stringify(body),
  mtimeMs,
});

const claimed = (pane: string, over: Record<string, unknown> = {}) => ({
  agent: "opencode",
  session_id: "ses_root",
  claim: { pid: 4242, start: LIVE_START, pane, ...over },
});

const expect = (cond: boolean, msg: string) => {
  if (!cond) throw new Error(msg);
};

const systemError = (method: string, path: string) =>
  PlatformError.systemError({
    _tag: "NotFound",
    module: "FileSystem",
    method,
    description: "test fixture failure",
    pathOrDescriptor: path,
  });

const fileInfo = (
  type: FileSystem.File.Type,
  mtime: Option.Option<Date>,
): FileSystem.File.Info => ({
  type,
  mtime,
  atime: Option.none(),
  birthtime: Option.none(),
  dev: 1,
  ino: Option.none(),
  mode: type === "Directory" ? 0o700 : 0o600,
  nlink: Option.none(),
  uid: Option.none(),
  gid: Option.none(),
  rdev: Option.none(),
  size: FileSystem.Size(0),
  blksize: Option.none(),
  blocks: Option.none(),
});

const physicalLayer = (
  entries: readonly PhysicalEntry[],
  identity: (path: string) => PhysicalIdentity | null = () => ({
    device: 1,
    inode: 1,
  }),
): Layer.Layer<PhysicalFileSystem> =>
  Layer.succeed(
    PhysicalFileSystem,
    PhysicalFileSystem.of({
      readDirectory: () => Effect.succeed(entries),
      identity: (path) => Effect.succeed(identity(path)),
    }),
  );

const observedTarget = (pane: string): ObservedStateFile => {
  const raw = file(pane, claimed(pane, { pid: 9999 }));
  return {
    entry: classify(raw, world()),
    snapshot: {
      raw,
      identity: { device: 1, inode: 1 },
      digest: createHash("sha256").update(raw.text ?? "").digest("hex"),
    },
  };
};

const paneFromPath = (filePath: string): string =>
  filePath.slice(filePath.lastIndexOf("/") + 1);

const reapFileSystem = (
  targets: readonly ObservedStateFile[],
  overrides: Partial<FileSystem.FileSystem> = {},
): Layer.Layer<FileSystem.FileSystem> => {
  const textByPane = new Map(
    targets.map(({ snapshot }) => [
      snapshot.raw.pane,
      snapshot.raw.text ?? "",
    ]),
  );
  return FileSystem.layerNoop({
    makeDirectory: () => Effect.void,
    stat: () => Effect.succeed(fileInfo("File", Option.some(new Date(NOW)))),
    readFileString: (filePath) => {
      const text = textByPane.get(paneFromPath(filePath));
      return text === undefined
        ? Effect.fail(systemError("readFileString", filePath))
        : Effect.succeed(text);
    },
    ...overrides,
  });
};

const expectReapCounts = (
  result: ReapResult,
  completed: number,
  failed: number,
): void => {
  expect(
    result.completed === completed && result.failed === failed,
    `expected ${completed} completed and ${failed} failed, got ${
      JSON.stringify(result)
    }`,
  );
};

Deno.test("unit: incomplete reap outcomes return nonzero", () => {
  expect(
    reapExitCode({ completed: 2, failed: 0 }) === 0,
    "success was nonzero",
  );
  expect(
    reapExitCode({ completed: 2, failed: 1 }) === 1,
    "partial failure was zero",
  );
  expect(
    reapExitCode({ completed: 0, failed: 2 }) === 1,
    "setup failure was zero",
  );
});

Deno.test("filesystem: survey excludes entries whose stat or read fails", async () => {
  const stateDir = "/state";
  const fixture = FileSystem.layerNoop({
    exists: () => Effect.succeed(true),
    readFileString: (path) =>
      path.endsWith("/%2")
        ? Effect.fail(systemError("readFileString", path))
        : Effect.succeed(`claim:${path}`),
    stat: (path) => {
      if (path.endsWith("/archive")) {
        return Effect.succeed(fileInfo("Directory", Option.none()));
      }
      if (path.endsWith("/%3")) {
        return Effect.fail(systemError("stat", path));
      }
      const day = path.endsWith("/%1") ? 1 : 2;
      return Effect.succeed(
        fileInfo("File", Option.some(new Date(Date.UTC(2026, 0, day)))),
      );
    },
  });

  const files = await Effect.runPromise(
    readStateFiles(stateDir).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer(
        ["%3", "%1", "%2"].map((name) => ({
          name,
          isFile: true,
          isSymlink: false,
        })),
      )),
    ),
  );

  expect(
    files.map(({ raw }) => raw.pane).join(",") === "%1",
    `unexpected panes: ${files.map(({ raw }) => raw.pane).join(",")}`,
  );
  expect(
    files[0]?.raw.mtimeMs === Date.UTC(2026, 0, 1),
    "mtime was not preserved",
  );
});

Deno.test("filesystem: survey excludes a symlink whose target is a file", async () => {
  const fixture = FileSystem.layerNoop({
    exists: () => Effect.succeed(true),
    readFileString: () => Effect.succeed(JSON.stringify(claimed("%link"))),
    stat: () => Effect.succeed(fileInfo("File", Option.some(new Date(NOW)))),
  });

  const files = await Effect.runPromise(
    readStateFiles("/state").pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([{
        name: "%link",
        isFile: false,
        isSymlink: true,
      }])),
    ),
  );

  expect(
    files.length === 0,
    "symlink target was admitted as a physical state file",
  );
});

Deno.test("filesystem: archive reap is sequential and continues after failure", async () => {
  const operations: string[] = [];
  let inFlight = false;
  const targets = ["%1", "%2", "%3"].map(observedTarget);
  const fixture = reapFileSystem(targets, {
    rename: (from, to) =>
      Effect.gen(function* () {
        expect(!inFlight, "rename operations overlapped");
        inFlight = true;
        operations.push(`${from}->${to}`);
        yield* Effect.yieldNow;
        inFlight = false;
        if (from.endsWith("/%2")) {
          return yield* Effect.fail(systemError("rename", from));
        }
      }),
  });

  const result = await Effect.runPromise(
    executeReap({
      stateDir: "/state",
      archiveDir: "/state/archive/stamp",
      targets,
      classifyCurrent: (raw) => Effect.succeed(classify(raw, world())),
      destructive: false,
    }).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([])),
    ),
  );

  expectReapCounts(result, 2, 1);
  expect(
    operations.join(",") ===
      "/state/%1->/state/archive/stamp/%1,/state/%2->/state/archive/stamp/%2,/state/%3->/state/archive/stamp/%3",
    `unexpected rename order: ${operations.join(",")}`,
  );
});

Deno.test("filesystem: destructive reap removes through the injected service", async () => {
  const removals: string[] = [];
  let inFlight = false;
  const targets = ["%4", "%5"].map(observedTarget);
  const fixture = reapFileSystem(targets, {
    remove: (path) =>
      Effect.gen(function* () {
        expect(!inFlight, "remove operations overlapped");
        inFlight = true;
        removals.push(path);
        yield* Effect.yieldNow;
        inFlight = false;
        if (path.endsWith("/%5")) {
          return yield* Effect.fail(systemError("remove", path));
        }
      }),
  });

  const result = await Effect.runPromise(
    executeReap({
      stateDir: "/state",
      archiveDir: "/unused",
      targets,
      classifyCurrent: (raw) => Effect.succeed(classify(raw, world())),
      destructive: true,
    }).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([])),
    ),
  );

  expectReapCounts(result, 1, 1);
  expect(
    removals.join(",") === "/state/%4,/state/%5",
    "unexpected remove order",
  );
});

Deno.test("filesystem: reap skips content, identity, and symlink replacements", async () => {
  const operations: string[] = [];
  const targets = ["%1", "%2", "%3", "%4"].map(observedTarget);
  const fixture = reapFileSystem(targets, {
    readFileString: (filePath) => {
      const pane = paneFromPath(filePath);
      const expected = targets.find(({ entry }) => entry.pane === pane);
      if (expected === undefined) {
        return Effect.fail(systemError("readFileString", filePath));
      }
      return Effect.succeed(
        pane === "%2"
          ? `${expected.snapshot.raw.text}\n`
          : expected.snapshot.raw.text ?? "",
      );
    },
    rename: (from) =>
      Effect.sync(() => {
        operations.push(from);
      }),
  });

  const result = await Effect.runPromise(
    executeReap({
      stateDir: "/state",
      archiveDir: "/state/archive/stamp",
      targets,
      classifyCurrent: (raw) => Effect.succeed(classify(raw, world())),
      destructive: false,
    }).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([], (filePath) => {
        const pane = paneFromPath(filePath);
        if (pane === "%3") return { device: 2, inode: 2 };
        if (pane === "%4") return null;
        return { device: 1, inode: 1 };
      })),
    ),
  );

  expectReapCounts(result, 1, 3);
  expect(
    operations.join(",") === "/state/%1",
    `replaced claims were mutated: ${operations.join(",")}`,
  );
});

Deno.test("filesystem: archive setup failure prevents every mutation", async () => {
  const operations: string[] = [];
  const targets = ["%6", "%7"].map(observedTarget);
  const fixture = reapFileSystem(targets, {
    makeDirectory: (path) => Effect.fail(systemError("makeDirectory", path)),
    rename: (from) =>
      Effect.sync(() => {
        operations.push(from);
      }),
  });

  const result = await Effect.runPromise(
    executeReap({
      stateDir: "/state",
      archiveDir: "/state/archive/stamp",
      targets,
      classifyCurrent: (raw) => Effect.succeed(classify(raw, world())),
      destructive: false,
    }).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([])),
    ),
  );

  expectReapCounts(result, 0, 2);
  expect(operations.length === 0, "archive mutation ran without a directory");
});

Deno.test("filesystem: reap skips a claim that became live after survey", async () => {
  const operations: string[] = [];
  const targets = [observedTarget("%8")];
  const fixture = reapFileSystem(targets, {
    remove: (filePath) =>
      Effect.sync(() => {
        operations.push(filePath);
      }),
  });

  const result = await Effect.runPromise(
    executeReap({
      stateDir: "/state",
      archiveDir: "/unused",
      targets,
      classifyCurrent: (raw) =>
        Effect.succeed(classify(
          raw,
          world({
            processStarts: new Map([[9999, LIVE_START]]),
          }),
        )),
      destructive: true,
    }).pipe(
      Effect.provide(fixture),
      Effect.provide(Path.layer),
      Effect.provide(physicalLayer([])),
    ),
  );

  expectReapCounts(result, 0, 1);
  expect(operations.length === 0, "claim was removed after becoming live");
});

Deno.test("unit: a claim backed by a live process is live", () => {
  const e = classify(file("%1", claimed("%1")), world());
  expect(e.status === "live", `got ${e.status}`);
  expect(e.claimPid === 4242, "pid not surfaced");
});

Deno.test("unit: a pre-contract file is legacy, never aged out", () => {
  const old = classify(
    file(
      "%1",
      { agent: "opencode", session_id: "ses_root" },
      NOW - 90 * 86_400_000,
    ),
    world(),
  );
  expect(old.status === "legacy", `got ${old.status}`);
  expect(old.ageDays > 89, "age should still be reported");
});

Deno.test("unit: a dead pid, a replaced pid, and a pane mismatch are all dead", () => {
  expect(
    classify(file("%9", claimed("%9", { pid: 9999 })), world()).status ===
      "dead",
    "gone pid",
  );
  expect(
    classify(
      file("%1", claimed("%1", { start: "Mon Jan 01 00:00:00 2001" })),
      world(),
    )
      .status === "dead",
    "recycled pid",
  );
  expect(
    classify(file("%1", claimed("%42")), world()).status === "dead",
    "pane mismatch",
  );
});

Deno.test("unit: status precedence is malformed > legacy > dead > live", () => {
  expect(
    classify(file("%1", "{not json"), world()).status === "malformed",
    "bad json",
  );
  expect(
    classify(file("%1", { agent: "opencode" }), world()).status === "malformed",
    "missing session id outranks legacy",
  );
  expect(
    classify(
      file("%1", { session_id: "ses_root", claim: { pid: 4242 } }),
      world(),
    )
      .status === "legacy",
    "partial claim outranks dead",
  );
});

Deno.test("unit: subagent and orphan-pane are reported as flags, not statuses", () => {
  const kid = classify(
    file("%1", { ...claimed("%1"), session_id: "ses_kid" }),
    world(),
  );
  expect(kid.isSubagent === true, "subagent not flagged");
  expect(kid.status === "live", "flagging must not change status");

  const orphan = classify(file("%7", claimed("%7", { pid: 9999 })), world());
  expect(orphan.paneOrphaned === true, "orphan pane not flagged");
});

Deno.test("unit: orphanhood is unknown, not true, when tmux is not running", () => {
  const e = classify(file("%1", claimed("%1")), world({ livePanes: null }));
  expect(
    e.paneOrphaned === null,
    "must not claim orphaned with no tmux server",
  );
});

Deno.test("unit: subagent status is unknown when the db is unreadable", () => {
  const e = classify(file("%1", claimed("%1")), world({ sessions: null }));
  expect(e.isSubagent === null, "must not guess subagent without the db");
  expect(e.title === null, "no title without the db");
});

Deno.test("unit: checksum is stable across time but tracks verdicts", () => {
  const a = classify(file("%1", claimed("%1"), NOW - 5_000), world());
  const later = classify(
    file("%1", claimed("%1"), NOW - 900_000),
    world({ nowMs: NOW + 7 * 86_400_000 }),
  );
  expect(
    reportChecksum([a]) === reportChecksum([later]),
    "checksum must not drift with mtime or clock",
  );

  const died = classify(file("%1", claimed("%1", { pid: 9999 })), world());
  expect(
    reportChecksum([a]) !== reportChecksum([died]),
    "checksum must change when a status changes",
  );
});

Deno.test("unit: checksum ignores file ordering", () => {
  const a = classify(file("%1", claimed("%1")), world());
  const b = classify(file("%9", claimed("%9", { pid: 9999 })), world());
  expect(
    reportChecksum([a, b]) === reportChecksum([b, a]),
    "order must not matter",
  );
});

Deno.test("unit: live entries are never reapable, even if not kept", () => {
  const live = classify(file("%1", claimed("%1")), world());
  const dead = classify(file("%9", claimed("%9", { pid: 9999 })), world());
  const picked = reapable([live, dead], new Set());
  expect(
    picked.length === 1 && picked[0].pane === "%9",
    "live must be excluded",
  );
});

Deno.test("unit: --keep spares a non-live entry", () => {
  const dead = classify(file("%9", claimed("%9", { pid: 9999 })), world());
  expect(reapable([dead], new Set(["%9"])).length === 0, "keep not honoured");
});

Deno.test("unit: ps output parses into pid -> normalised start", () => {
  const table = parsePsTable(
    "  4242   Sat Aug 29 10:00:00 2026\n 17   Fri Jul  3 09:00:00 2026\n\n",
  );
  expect(table.get(4242) === LIVE_START, `got ${table.get(4242)}`);
  expect(
    table.get(17) === "Fri Jul 3 09:00:00 2026",
    `inner padding not collapsed: ${table.get(17)}`,
  );
});

Deno.test("unit: only well-formed session ids may reach SQL", () => {
  expect(isQueryableSessionId("ses_abc123") === true, "valid id rejected");
  expect(
    isQueryableSessionId("ses_a' or 1=1--") === false,
    "injection admitted",
  );
  expect(isQueryableSessionId("nope") === false, "foreign shape admitted");
});

Deno.test("unit: an empty survey renders without throwing", () => {
  expect(formatTable([]).includes("no state files"), "empty table");
  expect(summarise([]) === "", "empty summary");
});
