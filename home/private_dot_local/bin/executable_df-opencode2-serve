#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

#/ Usage:
#/   df-opencode2-serve
#/
#/ Description:
#/   Stable `run` command of the df-opencode2-serve Pitchfork daemon. Reads the
#/   bind address and port from ~/.config/dotfiles/opencode2-serve.env (rendered
#/   by chezmoi), so changing them never changes the command Pitchfork stored;
#/   Pitchfork watches the env file and restarts this wrapper instead.
#/
#/   Goes through ~/.local/bin/opencode2 so V2 keeps its isolated config dir and
#/   database. The port is OpenCode 2's own (ports.yaml opencode2.internal),
#/   never OpenCode 1's 4097, which df-opencode-serve still holds.
#/
#/   Before starting, it stops any orphaned `opencode2 serve` still holding the
#/   port. The supervisor can lose track of its child (VM resume, kill) while
#/   the child keeps serving; without this the restart fails with EADDRINUSE
#/   and, with retry=true, crash-loops forever.
#/
#/ Options:
#/   --help:      Display this help message
usage() { grep '^#/' "$0" | cut -c4-; }

ENV_FILE="${HOME}/.config/dotfiles/opencode2-serve.env"

# PIDs listening on TCP port $1 (empty when none or no tool to ask).
listeners() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
  elif command -v ss >/dev/null 2>&1; then
    ss -ltnpH "sport = :${port}" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 || true
  fi
}

# Stop orphaned `opencode2 serve` processes on the port. Anything else holding
# it is left alone: opencode2 then fails to bind and Pitchfork reports it.
reap_orphans() {
  local port="$1" pid cmd
  for pid in $(listeners "$port" | sort -u); do
    [ "$pid" != "$$" ] || continue
    cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
    case "$cmd" in
      *opencode2*serve*)
        echo "df-opencode2-serve: stopping orphaned opencode2 serve (pid ${pid}) on port ${port}" >&2
        kill "$pid" 2>/dev/null || true
        ;;
    esac
  done
  # Give the kernel a moment to release the socket.
  [ -z "$(listeners "$port")" ] || sleep 1
}

main() {
  if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
  fi

  if [ ! -r "$ENV_FILE" ]; then
    echo "df-opencode2-serve: missing ${ENV_FILE} (is openCode2Server enabled?)" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  : "${OPENCODE2_SERVE_HOSTNAME:?not set in ${ENV_FILE}}"
  : "${OPENCODE2_SERVE_PORT:?not set in ${ENV_FILE}}"

  reap_orphans "$OPENCODE2_SERVE_PORT"
  # --service makes this process the shared background server that
  # `opencode2 pair` discovers and mints links for. Without it, Pitchfork would
  # supervise a second, unrelated server and `pair` would keep talking to a
  # loopback-only service on a random port.
  exec opencode2 serve --service --hostname "$OPENCODE2_SERVE_HOSTNAME" --port "$OPENCODE2_SERVE_PORT"
}

main "$@"
