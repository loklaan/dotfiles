const mergeConfig = (
  base: Configuration,
  file: ConfigInput,
  flags: ConfigInput,
): Configuration => {
  const stateDir = flags.stateDir ?? file.stateDir ?? base.stateDir;
  return {
    ...base,
    ...file,
    ...flags,
    stateDir,
    stagingDir: flags.stagingDir ?? file.stagingDir ?? `${stateDir}/staging`,
    destination: {
      ...base.destination,
      ...file.destination,
      ...flags.destination,
    },
    encryption: { ...base.encryption, ...file.encryption, ...flags.encryption },
    recipe: { ...base.recipe, ...file.recipe, ...flags.recipe },
  };
};
const requireEncryption = (config: Configuration, allowed: boolean) =>
  config.encryption.recipients.length || allowed ? Effect.void : Effect.fail(
    new ConfigError({
      key: "encryption.recipients",
      message:
        "no age recipients configured; set home/.chezmoidata/dictation-archive.yaml or --recipient, or explicitly accept unencrypted objects with --allow-plaintext",
    }),
  );
const desiredObjects = (
  id: string,
  config: Configuration,
): readonly string[] => {
  const prefix = `entries/${id.toLowerCase()}`,
    recipe = recipeId(config.recipe.bitrate);
  const suffix = config.encryption.recipients.length ? ".age" : "";
  return [
    `${prefix}/source.json`,
    `${prefix}/projections/hex-capture.json`,
    `${prefix}/recordings/${recipe}.opus`,
    `${prefix}/recordings/${recipe}.json`,
  ].map((p) => p + suffix);
};
const newObjects = (
  desired: readonly string[],
  ledger: ReadonlySet<string>,
  staged: ReadonlySet<string>,
) => desired.filter((p) => !ledger.has(p) && !staged.has(p));
