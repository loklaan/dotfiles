    Deno.test(`text renderer keeps count-only hygiene for ${fixture.name}`, () => {
      // Given: fixed label vocabulary, never derived from renderer output.
      const labels = new Set(
        ("Up to date new recordings Exported recording sent destination file files " +
          "already at adopted Remaining still export nothing left Processed staged " +
          "not no-ship for previously Dictation found source sources Waiting Staged but " +
          "Recordings with missing audio Setup encryption set on off " +
          "allow-plaintext needed ffmpeg age rsync Work remaining exit " +
          "Dry run written Would create Checked against all match of would be by " +
          "delivered and verified encoded in this the rest were an earlier")
          .split(" "),
      );
      // When
      const output = fixture.render();
      // Then: reject path separators, filename-like tokens and unknown words.
      assert(!/[/\\]|\b[\w-]+\.[\w-]+/.test(output));
      assert(/^[A-Za-z0-9\s:().,\-]+$/.test(output));
      assert(
        (output.match(/[A-Za-z]+(?:-[A-Za-z]+)*/g) ?? []).every((word) =>
          labels.has(word)
        ),
      );
