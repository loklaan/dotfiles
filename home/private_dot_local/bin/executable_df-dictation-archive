  Deno.test("recording ids include adopted entries and collapse duplicate receipts", () => {
    // Given: one delivered entry, a distinct adopted entry, duplicate paths.
    const receipts = runReceipts(2, 1).map((r, i) =>
      i === 1 ? { path: r.path, adopted: true as const } : r
    );
    // When
    const ids = recordingIds([...receipts, ...receipts]);
    // Then
    assert(
      ids.size === 2 && ids.has("00000000-0000-0000-0000-000000000000") &&
        ids.has("00000000-0000-0000-0000-000000000001"),
    );
  });
  Deno.test("run summary counts entries touched by a two-object recipe change", () => {
    // Given: only recording objects, with no source or projection receipt.
    const receipts = runReceipts(3).filter((r) =>
      r.path.includes("/recordings/")
    );
    // When
    const summary = runSummary(receipts, 1, 0);
    // Then
    assert(
      summary.recordings === 3 && summary.filesDelivered === 6 &&
        summary.recordingsEncodedThisRun === 1,
    );
  });
  Deno.test("dry-run JSON adds only the planned-file count to the status whitelist", () => {
    // Given
    const counts = { ...readyCounts, new: 2, ...privateFields };
    // When
    const output = statusJson(counts, 6);
    // Then
    const parsed = Schema.decodeUnknownSync(
      Schema.Record(
        Schema.String,
        Schema.Union([Schema.Number, Schema.Boolean]),
      ),
    )(JSON.parse(output));
    assert(
      Object.keys(parsed).sort().join(",") ===
        "ageFound,destinationConfigured,encryptionConfigured,entriesTotal,ffmpegFound,missingSource,new,newObjects,rsyncFound,shipped,sourcesScanned,stagedNotShipped",
    );
    assert(parsed.newObjects === 6);
  });
  Deno.test("verify JSON reports counts without leaking adoptable paths", () => {
    // Given
    const verification = classifyVerification(
      `>fc.T....... ${adoptedPath}\n`,
      new Set([adoptedPath]),
    );
    // When
    const output = JSON.stringify(verifySummary(4, verification));
    // Then
    assert(
      output ===
        '{"stagedObjects":4,"differences":1,"wouldAdopt":1,"blocking":0}',
    );
  });
  Deno.test("canonical JSON is byte-stable when keys arrive in different orders", () => {
    // Given / When / Then: equivalent nested inputs serialize identically.
    const a = { z: [{ b: 2, a: 1 }], a: true },
      b = { a: true, z: [{ a: 1, b: 2 }] };
    assert(canonical(a) === canonical(b));
  });
  Deno.test("capture timestamp converts the Hex epoch to UTC milliseconds", () => {
    // Given / When / Then
    assert(capturedEnd(0) === "2001-01-01T00:00:00.000Z");
  });
  for (const filler of [false, true]) {
    Deno.test(`float WAV parses sample frames when filler=${filler}`, () => {
      // Given
      const bytes = floatWav(filler);
      // When
      const wav = parseWav(bytes);
      // Then
      assert(
        wav.samples === 160 && wav.sampleRate === 16000 && wav.channels === 1 &&
          wav.format === "f32le",
      );
    });
  }
  for (const kind of ["garbage", "truncated", "format"] as const) {
    Deno.test(`WAV rejects ${kind} through a typed error`, () => {
      // Given
      const bytes = kind === "garbage" ? new Uint8Array(20) : floatWav(true);
      if (kind === "format") bytes[20] = 1;
      // When / Then
      try {
        parseWav(
          kind === "truncated" ? bytes.subarray(0, bytes.length - 1) : bytes,
        );
      } catch (cause) {
        assert(cause instanceof WavError);
        return;
      }
      throw new Error("expected typed WAV failure");
    });
  }
  for (
    const input of [
      "file:///fixture/Recordings/audio%20one.wav",
      "/fixture/audio%20one.wav",
      "audio%20one.wav",
    ]
  ) {
    Deno.test(`audio basename decodes input form ${input.indexOf(":") >= 0 ? "URL" : input.startsWith("/") ? "absolute" : "relative"}`, () => {
      // Given / When / Then
      assert(audioBasename(input) === "audio one.wav");
    });
  }
  Deno.test("configuration uses flags before file before defaults", () => {
    // Given
    const base = defaults("/home/test", "/state");
    // When
    const merged = mergeConfig(base, {
      destination: { host: "example.invalid", path: "/file", port: 2222 },
      recipe: { bitrate: "32k" },
    }, { destination: { host: "", path: "/flag" } });
    // Then
    assert(
      merged.destination.host === "" && merged.destination.path === "/flag" &&
        merged.destination.port === 2222 && merged.recipe.bitrate === "32k" &&
        merged.destination.connectTimeoutSeconds === 15,
    );
  });
  Deno.test("encryption refuses writes when no recipient or explicit consent exists", async () => {
    // Given / When
    const result = await Effect.runPromiseExit(
      requireEncryption(defaults("/home/test", "/state"), false),
    );
    // Then
    assert(result._tag === "Failure");
  });
  Deno.test("ffmpeg argv keeps deterministic metadata and both bitexact flags", () => {
    // Given
    const facts = {
      hexId: fixtureId,
      sourceSha256: "a".repeat(64),
      capturedEnd: capturedEnd(0),
      bitrate: "24k",
      encoder: { ffmpeg: "9.0.2", libavcodec: "63.1.102", libopus: "unknown" },
    };
    // When
    const args = ffmpegArgs("/fixture/input.wav", facts);
    // Then
    assert(
      args[args.indexOf("-fflags") + 1] === "+bitexact" &&
        args[args.indexOf("-flags:a") + 1] === "+bitexact",
    );
    assert(
      args.includes(`HEX_ID=${fixtureId}`) &&
        args.includes(`SOURCE_SHA256=${facts.sourceSha256}`) &&
        args.includes(`CAPTURED_END=${facts.capturedEnd}`),
    );
    assert(
      !args.some((v) => v.includes("synthetic transcript") || v.includes("\r")),
    );
  });
  for (const remote of [false, true]) {
    Deno.test(`rsync preserves append-only transfer and checksum verification when remote=${remote}`, () => {
      // Given
      const base = defaults("/home/test", "/state");
      const config = mergeConfig(base, {}, {
        destination: {
          host: remote ? "example.invalid" : "",
          path: "/with space/a'b",
          identityFile: "/identity with space",
        },
      });
      // When
      const transfer = rsyncArgs(config, false),
        verify = rsyncArgs(config, true);
      // Then
      assert(
        transfer.includes("--ignore-existing") &&
          !verify.includes("--ignore-existing"),
      );
      assert(verify.includes("-rnc") && transfer.includes("-e") === remote);
      assert(
        ![...transfer, ...verify].some((v) =>
          ["--delete", "--mkpath", "--protect-args", "--no-motd"].includes(v) ||
          v.startsWith("--info=")
        ),
      );
      assert(
        transfer.at(-1) ===
          (remote
            ? "example.invalid:'/with space/a'\\''b/'"
            : "/with space/a'b/"),
      );
    });
  }
  Deno.test("new-object planning is a no-op when the current recipe is shipped", () => {
    // Given
    const config = defaults("/home/test", "/state"),
      desired = desiredObjects(fixtureId, config);
    // When
    const planned = newObjects(desired, new Set(desired), new Set());
    // Then
    assert(planned.length === 0);
  });
  Deno.test("recipe change adds exactly two objects and rewrites none", () => {
    // Given
    const config = defaults("/home/test", "/state"),
      shipped = new Set(desiredObjects(fixtureId, config));
    // When
    const planned = newObjects(
      desiredObjects(
        fixtureId,
        mergeConfig(config, {}, { recipe: { bitrate: "32k" } }),
      ),
      shipped,
      new Set(),
    );
    // Then
    assert(
      planned.length === 2 &&
        planned.every((p) =>
          p.includes("/recordings/opus-32k-") && !shipped.has(p)
        ),
    );
  });
}
