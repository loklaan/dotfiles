#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --no-prompt --allow-run --allow-read --allow-write --allow-env=HOME,PATH,SSH_AUTH_SOCK,XDG_STATE_HOME,NODE_V8_COVERAGE,LANG,LC_ALL,LC_CTYPE,NO_COLOR,TERM

// df-dictation-archive — immutable, optionally age-encrypted dictation archive.
// Usage: df-dictation-archive [run|status|verify] [--help]
// Configure home/.chezmoidata/dictation-archive.yaml, projected on macOS to
// ~/.config/dotfiles/dictation-archive.json. Flags > config file > built-in defaults.
// run is the default. --dry-run is read-only; --limit selects oldest-first.
// Plain-text count summaries by default; --json selects whitelisted JSON.
// status exits 0 = converged, 2 = work pending.
// verify checks only currently staged objects, NOT pruned ledger-only objects.
// Lost ledger: run adopts differing .age objects at existing write-once paths,
// fsyncs receipts before pruning duplicates; verify only reports wouldAdopt.
// Plaintext differences, missing destination files and unknown rsync output block
// ALL receipts/pruning. Adoption trusts destination ciphertext, not its integrity.
// Empty recipients require --allow-plaintext for writes (never for observation).
// --no-ship stages only; --keep-staged retains verified copies. Changed recipes
// add recording + sidecar objects; source and Hex projection remain write-once.
// Recipients apply to NEW objects only: existing ciphertext is never rekeyed.
// State: ${XDG_STATE_HOME:-~/.local/state}/dotfiles/dictation-archive/{staging,ledger.jsonl,lock}.
// Use one state/staging pair per destination; a binding prevents accidental reuse.
// Sources are read-only; Hex's tmp directory is never visited. No content logging.
// Read/write grants are unscoped because CLI paths may be outside HOME; spawning
// requires unscoped allow-run for supervised process-group teardown. Named env
// reads and extendEnv:false prevent environment enumeration. No age identity read.
// allow: SIZE_OK — explicitly requested single-file CLI, services and in-file tests.

import {
  ByteSize,
  Clock,
  Console,
  Context,
  Crypto,
  Effect,
  Layer,
  Match,
  Option,
  PlatformError,
  Schedule,
  Schema,
  SchemaIssue,
  Stream,
} from "npm:effect@4.0.0";
import { FileSystem, layerNoop } from "npm:effect@4.0.0/FileSystem";
import { layer as pathLayer, Path } from "npm:effect@4.0.0/Path";
import { Command, Flag } from "npm:effect@4.0.0/cli";
import { ChildProcess, ChildProcessSpawner } from "npm:effect@4.0.0/process";

// --- Contracts / pure transformations -------------------------------------
class ConfigError extends Schema.TaggedError<ConfigError>()("ConfigError", {
  key: Schema.String,
  message: Schema.String,
}) {}
class SourceError extends Schema.TaggedError<SourceError>()("SourceError", {
  operation: Schema.String,
  hexId: Schema.String,
  message: Schema.String,
}) {}
class StateError extends Schema.TaggedError<StateError>()("StateError", {
  operation: Schema.String,
  message: Schema.String,
}) {}
class ProcessError extends Schema.TaggedError<ProcessError>()("ProcessError", {
  program: Schema.String,
  exitCode: Schema.Number,
  stderr: Schema.String,
}) {
  override get message() {
    return `${this.program} exited ${this.exitCode}${
      this.stderr ? `: ${this.stderr}` : ""
    }`;
  }
}
class ShipVerifyError
  extends Schema.TaggedError<ShipVerifyError>()("ShipVerifyError", {
    differences: Schema.Number,
    adoptable: Schema.Number,
    blocking: Schema.Number,
    conflicts: Schema.Number,
    newAtDestination: Schema.Number,
    unknown: Schema.Number,
  }) {
  override get message() {
    const classes = [
      this.conflicts ? `non-adoptable file differences=${this.conflicts}` : "",
      this.newAtDestination ? `newAtDestination=${this.newAtDestination}` : "",
      this.unknown ? `unknown=${this.unknown}` : "",
    ].filter(Boolean).join(", ");
    return `verification blocked by ${classes}; differences=${this.differences}, adoptable=${this.adoptable}, blocking=${this.blocking}; staging preserved and ledger unchanged; resolve blocking records before retrying`;
  }
}
class WavError extends Schema.TaggedError<WavError>()("WavError", {
  reason: Schema.String,
}) {
  override get message() {
    return `WAV ${this.reason}`;
  }
}
const safeString = Schema.String.check(Schema.isPattern(/^[^\p{Cc}\p{Cf}]*$/u));
const positiveInt = Schema.Int.check(
  Schema.isBetween({ minimum: 1, maximum: 65535 }),
);
const Uuid = Schema.String.check(
  Schema.isPattern(/^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$/),
);
const Digest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/));
const Bitrate = Schema.String.check(
  Schema.isPattern(/^(?:[6-9]|[1-9][0-9]|[1-4][0-9]{2}|50[0-9]|51[0-2])k$/),
);
const Destination = Schema.Struct({
  host: Schema.String.check(
    Schema.isPattern(/^(?:[A-Za-z0-9][A-Za-z0-9._-]*)?$/),
  ),
  user: Schema.String.check(
    Schema.isPattern(/^(?:[A-Za-z0-9_][A-Za-z0-9._-]*)?$/),
  ),
  port: positiveInt,
  path: safeString,
  identityFile: safeString,
  connectTimeoutSeconds: positiveInt,
});
const Configuration = Schema.Struct({
  destination: Destination,
  encryption: Schema.Struct({
    recipients: Schema.Array(
      Schema.String.check(Schema.isPattern(/^age1\S+$/)),
    ),
  }),
  recipe: Schema.Struct({ bitrate: Bitrate }),
  sources: Schema.Array(safeString),
  stagingDir: safeString,
  stateDir: safeString,
});
type Configuration = typeof Configuration.Type;
const ConfigInput = Schema.Struct({
  destination: Schema.optional(Schema.Struct({
    host: Schema.optional(Destination.fields.host),
    user: Schema.optional(Destination.fields.user),
    port: Schema.optional(positiveInt),
    path: Schema.optional(safeString),
    identityFile: Schema.optional(safeString),
    connectTimeoutSeconds: Schema.optional(positiveInt),
  })),
  encryption: Schema.optional(
    Schema.Struct({
      recipients: Schema.optional(
        Configuration.fields.encryption.fields.recipients,
      ),
    }),
  ),
  recipe: Schema.optional(Schema.Struct({ bitrate: Schema.optional(Bitrate) })),
  sources: Schema.optional(Schema.Array(safeString)),
  stagingDir: Schema.optional(safeString),
  stateDir: Schema.optional(safeString),
});
type ConfigInput = typeof ConfigInput.Type;
const Transcript = Schema.Struct({
  id: Uuid,
  timestamp: Schema.Number,
  text: Schema.String,
  audioPath: Schema.String,
  duration: Schema.Number,
  sourceAppBundleID: Schema.optional(Schema.String),
  sourceAppName: Schema.optional(Schema.String),
});
type Transcript = typeof Transcript.Type;
type Entry = {
  readonly transcript: Transcript;
  readonly wav: string;
  readonly model: string;
};
const History = Schema.Struct({ history: Schema.Array(Transcript) });
// FROZEN ARCHIVE FORMAT
// Delivered objects and the ledger persist entries/<uuid>/source.json,
// projections/hex-capture.json and recordings/opus-<N>k-voip-v1.{opus,json},
// with .age for encrypted objects. Keep objectPattern and these paths unchanged.
// HEX_ID, SOURCE_SHA256, CAPTURED_END and CODING_HISTORY Opus tags, hexId/hex
// JSON keys, producer.name = "hex", postProcessing text and all source,
// projection and recording-sidecar fields are frozen deterministic bytes.
// These identifiers name the source app, not this tool. Hex is the only adapter
// today; its schemas, store layout and app lookup remain Hex-specific.
// Renaming the format requires a schema bump and a new recipe id; changing it
// in place breaks ledger/object-path planning and forces a full re-encode.
const objectPattern =
  /^entries\/[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}\/(?:source\.json|projections\/hex-capture\.json|recordings\/opus-[0-9]+k-voip-v1\.(?:opus|json))(?:\.age)?$/;
const ObjectPath = Schema.String.check(Schema.isPattern(objectPattern));
const Stored = Schema.Struct({ path: ObjectPath, sha256: Digest });
type Stored = typeof Stored.Type;
const HashedReceipt = Schema.Struct({
  ...Stored.fields,
  adopted: Schema.optionalKey(Schema.Never),
});
const AdoptedReceipt = Schema.Struct({
  path: ObjectPath.check(Schema.isPattern(/\.age$/)),
  adopted: Schema.Literal(true),
  sha256: Schema.optionalKey(Schema.Never),
});
type Receipt = typeof HashedReceipt.Type | typeof AdoptedReceipt.Type;
const receiptMetadata = {
  shippedAt: Schema.String,
  destination: Schema.String,
};
const LedgerRow = Schema.Union([
  Schema.Struct({ ...HashedReceipt.fields, ...receiptMetadata }),
  Schema.Struct({ ...AdoptedReceipt.fields, ...receiptMetadata }),
]);
const Manifest = Schema.Array(Stored);
const canonical = (value: Schema.Json): string => {
  const keys = new Set<string>();
  JSON.stringify(value, (key, entry: Schema.Json) => {
    keys.add(key);
    return entry;
  });
  return JSON.stringify(value, [...keys].sort()) + "\n";
};
const capturedEnd = (timestamp: number): string =>
  new Date(Math.round((timestamp + 978307200) * 1000)).toISOString();
const audioBasename = (value: string): string => {
  try {
    const pathname = value.startsWith("file:")
      ? new URL(value).pathname
      : value;
    const basename = decodeURIComponent(
      pathname.slice(pathname.lastIndexOf("/") + 1),
    );
    if (
      !basename || basename === "." || basename === ".." ||
      /[/\\\p{Cc}\p{Cf}]/u.test(basename)
    ) {
      throw new WavError({ reason: "audioPath basename is unsafe" });
    }
    return basename;
  } catch (cause) {
    if (cause instanceof WavError) throw cause;
    throw new WavError({ reason: "audioPath cannot be decoded" });
  }
};
type Wav = {
  readonly sampleRate: number;
  readonly channels: number;
  readonly samples: number;
  readonly format: "f32le";
};
const parseWav = (bytes: Uint8Array): Wav => {
  const fail = (reason: string): never => {
    throw new WavError({ reason });
  };
  if (bytes.length < 12) return fail("header is truncated");
  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  const tag = (offset: number) =>
    String.fromCharCode(...bytes.subarray(offset, offset + 4));
  if (tag(0) !== "RIFF" || tag(8) !== "WAVE") return fail("requires RIFF/WAVE");
  const end = view.getUint32(4, true) + 8;
  if (end > bytes.length || end < 12) return fail("RIFF length is truncated");
  let format: Omit<Wav, "samples"> | undefined;
  let samples: number | undefined;
  for (let offset = 12; offset < end;) {
    if (offset + 8 > end) return fail("chunk header is truncated");
    const length = view.getUint32(offset + 4, true), start = offset + 8;
    if (start + length > end) return fail("chunk payload is truncated");
    switch (tag(offset)) {
      case "fmt ": {
        if (length < 16 || format) {
          return fail("format chunk is missing fields or duplicated");
        }
        const code = view.getUint16(start, true),
          channels = view.getUint16(start + 2, true);
        const sampleRate = view.getUint32(start + 4, true),
          bits = view.getUint16(start + 14, true);
        const float = code === 3 || (code === 65534 && length >= 40 &&
          view.getUint16(start + 16, true) >= 22 &&
          view.getUint16(start + 18, true) === 32 &&
          [...bytes.subarray(start + 24, start + 40)].join(",") ===
            "3,0,0,0,0,0,16,0,128,0,0,170,0,56,155,113");
        if (!float || bits !== 32) {
          return fail("requires 32-bit IEEE float samples");
        }
        if (
          channels !== 1 || sampleRate !== 16000 ||
          view.getUint16(start + 12, true) !== 4 ||
          view.getUint32(start + 8, true) !== 64000
        ) return fail("requires 16 kHz mono with four-byte frames");
        format = { channels, sampleRate, format: "f32le" };
        break;
      }
      case "data":
        if (samples !== undefined || length % 4 !== 0) {
          return fail("data chunk has inconsistent frames");
        }
        samples = length / 4;
        break;
    }
    offset = start + length + length % 2;
    if (offset > end) return fail("chunk padding is truncated");
  }
  if (!format || samples === undefined) {
    return fail("requires format and data chunks");
  }
  return { ...format, samples };
};
const recipeId = (bitrate: string) => `opus-${bitrate}-voip-v1`;
