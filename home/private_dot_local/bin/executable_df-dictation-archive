        fixture.present ? [adoptedPath, "../unowned.age"] : [],
      );
      const blocking = fixture.conflicts + fixture.created + fixture.unknown;
      // When
      const verification = classifyVerification(fixture.output, staged);
      const outcome = await Effect.runPromise(
        requireVerified(verification).pipe(
          Effect.match({ onSuccess: () => null, onFailure: (error) => error }),
        ),
      );
      // Then: the gate never returns adoptable paths for a mixed/blocking batch.
      assert(
        verification.adoptable.size === fixture.adoptable &&
          verification.differences === fixture.adoptable + blocking &&
          verification.blocking === blocking,
      );
      assert(
        blocking === 0
          ? outcome === null
          : outcome instanceof ShipVerifyError &&
            outcome.adoptable === fixture.adoptable &&
            outcome.blocking === blocking &&
            outcome.conflicts === fixture.conflicts &&
            outcome.newAtDestination === fixture.created &&
            outcome.unknown === fixture.unknown,
      );
    });
  }
  for (
    const fixture of [
      { receipt: { sha256: "a".repeat(64) }, accepted: true },
      { receipt: { adopted: true }, accepted: true },
      { receipt: { adopted: true, sha256: "a".repeat(64) }, accepted: false },
      { receipt: {}, accepted: false },
      { receipt: { adopted: false }, accepted: false },
      { receipt: { adopted: true, sha256: undefined }, accepted: false },
    ]
  ) {
    Deno.test("ledger schema accepts exactly one receipt kind", () => {
      // Given
      const row = {
        path: adoptedPath,
        destination: "synthetic",
        shippedAt: capturedEnd(0),
        ...fixture.receipt,
      };
      // When
      const accepted = Option.isSome(
        Schema.decodeUnknownOption(LedgerRow)(row),
      );
      // Then
      assert(accepted === fixture.accepted);
    });
  }
  for (const leftover of [false, true]) {
    Deno.test(`adopted receipts prevent re-encoding when staged leftover=${leftover}`, async () => {
      // Given
      const config = mergeConfig(defaults("/home/test", "/state"), {}, {
        encryption: { recipients: ["age1synthetic"] },
      });
      const desired = desiredObjects(fixtureId, config);
      const rows = desired.map((path) =>
        Schema.decodeUnknownSync(LedgerRow)({
          path,
          adopted: true,
          destination: destinationLabel(config),
          shippedAt: capturedEnd(0),
        })
      );
      const fake = Layer.mergeAll(
        Layer.succeed(DictationSource, {
          scan: () =>
            Effect.succeed({
              sourcesScanned: 1,
              entriesTotal: 1,
              missingSource: 0,
              entries: [{
                transcript: {
                  id: fixtureId,
                  timestamp: 0,
                  duration: 1,
                  text: "",
                  audioPath: "unused",
                },
                wav: "unused",
                model: "unknown",
              }],
            }),
        }),
        Layer.succeed(Ledger, {
          read: () => Effect.succeed(rows),
          append: () => Effect.die("observer must not append"),
        }),
        Layer.succeed(Staging, {
          list: () => Effect.succeed(leftover ? [...desired] : []),
          recover: () => Effect.die("observer must not recover"),
          stage: () => Effect.die("observer must not stage"),
        }),
        layerNoop({}),
        pathLayer,
      );
      // When
      const plan = await Effect.runPromise(
        planWork(config).pipe(Effect.provide(fake)),
      );
      // Then
      assert(
        plan.plans.length === 0 && plan.counts.shipped === 1 &&
          plan.counts.stagedNotShipped === 0,
      );
      assert(desired.every((path) => plan.shipped.has(path)));
    });
  }
  Deno.test("verification reclassifies a staged adoption leftover without another receipt", async () => {
    // Given: a crash after ledger fsync but before staged duplicate removal.
    const shipped = new Set([adoptedPath]);
    const staged = new Set([adoptedPath]);
    const objects = [{ path: adoptedPath, sha256: "a".repeat(64) }];
    // When
    const verification = await Effect.runPromise(requireVerified(
      classifyVerification(`>fc.T....... ${adoptedPath}\n`, staged),
    ));
    // Then: still eligible for pruning, but excluded from new ledger receipts.
    assert(
      verification.adoptable.has(adoptedPath) && verification.blocking === 0,
    );
    assert(
      pendingReceipts(objects, shipped, verification.adoptable).length === 0,
    );
  });
  Deno.test("pending receipts omit the staged hash only when adopting", () => {
    // Given
    const matchedPath = `entries/${fixtureId}/projections/hex-capture.json.age`;
    const objects = [adoptedPath, matchedPath].map((path) => ({
      path,
      sha256: "a".repeat(64),
    }));
    // When
    const receipts = pendingReceipts(
      objects,
      new Set(),
      new Set([adoptedPath]),
    );
    // Then
    assert(
      JSON.stringify(receipts) === JSON.stringify([
        { path: adoptedPath, adopted: true },
        { path: matchedPath, sha256: "a".repeat(64) },
      ]),
    );
  });
  Deno.test("later-source entries use the first source's model at export", async () => {
    // Given
    const config = {
      ...defaults("/home/test", "/state"),
      sources: ["/first", "/later"],
    };
    const documents = new Map<string, Uint8Array>([
      [
        "/first/hex_settings.json",
        new TextEncoder().encode(canonical({ selectedModel: "current-model" })),
      ],
      [
        "/first/transcription_history.json",
        new TextEncoder().encode(canonical({ history: [] })),
      ],
      [
        "/later/hex_settings.json",
        new TextEncoder().encode(canonical({ selectedModel: "stale-model" })),
      ],
      [
        "/later/transcription_history.json",
        new TextEncoder().encode(
          canonical({
            history: [{
              id: fixtureId,
              timestamp: 0,
              duration: 1,
              text: "",
              audioPath: "fixture",
            }],
          }),
        ),
      ],
      ["/later/Recordings/fixture", new Uint8Array()],
    ]);
    const filesystem = layerNoop({
      stat: (file) => {
        const bytes = documents.get(file);
        if (bytes === undefined) return Effect.die("unexpected fixture access");
        return Effect.succeed({
          type: "File",
          size: ByteSize.bytes(bytes.length),
          mode: 0o600,
          dev: 1,
          mtime: Option.none(),
          atime: Option.none(),
          birthtime: Option.none(),
          ino: Option.none(),
          nlink: Option.none(),
          uid: Option.none(),
          gid: Option.none(),
          rdev: Option.none(),
          blksize: Option.none(),
          blocks: Option.none(),
        });
      },
      stream: (file) => {
        const bytes = documents.get(file);
        return bytes === undefined
          ? Stream.die("unexpected fixture access")
          : Stream.make(bytes);
      },
    });
    // When
    const scan = await Effect.runPromise(
      scanHexSource(config).pipe(
        Effect.provide(Layer.mergeAll(filesystem, pathLayer)),
      ),
    );
    // Then
    assert(
      scan.entries.length === 1 && scan.entries[0].model === "current-model",
    );
  });
