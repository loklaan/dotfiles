  "pipe:1",
];

// --- File boundaries / source and ledger services -------------------------
const missing = Effect.catch((cause: PlatformError.PlatformError) =>
  cause.reason._tag === "NotFound" ? Effect.succeed(null) : Effect.fail(cause)
);
const ioError = (operation: string) =>
  Effect.mapError((cause: PlatformError.PlatformError) =>
    new StateError({
      operation,
      message:
        `${operation}: ${cause.reason._tag}; inspect filesystem permissions and available space`,
    })
  );
const concatenate = (chunks: readonly Uint8Array[]): Uint8Array => {
  const bytes = new Uint8Array(chunks.reduce((n, c) => n + c.byteLength, 0));
  let offset = 0;
  for (const chunk of chunks) {
    bytes.set(chunk, offset);
    offset += chunk.byteLength;
  }
  return bytes;
};
const readBounded = Effect.fn("Files.readBounded")(
  function* (file: string, limit: number) {
    const fs = yield* FileSystem;
    const info = yield* fs.stat(file).pipe(ioError("read metadata"));
    if (info.type !== "File") {
      return yield* Effect.fail(
        new StateError({
          operation: "read",
          message: "expected a regular file",
        }),
      );
    }
    if (info.size > BigInt(limit)) {
      return yield* Effect.fail(
        new StateError({
          operation: "read",
          message: `input exceeds ${limit}-byte safety bound`,
        }),
      );
    }
    const bytes = concatenate(
      yield* fs.stream(file, { bytesToRead: limit + 1 }).pipe(
        Stream.runCollect,
        ioError("read bytes"),
      ),
    );
    if (bytes.length > limit) {
      return yield* Effect.fail(
        new StateError({
          operation: "read",
          message: `input grew beyond ${limit}-byte safety bound`,
        }),
      );
    }
    return bytes;
  },
);
const decodeJson = <S extends Schema.ConstraintDecoder<unknown>>(
  schema: S,
  bytes: Uint8Array,
) =>
  Schema.decodeUnknownEffect(Schema.fromJsonString(schema))(
    new TextDecoder().decode(bytes),
  );
const scanHexSource = Effect.fn("DictationSource.scanHexSource")(
  function* (config: Configuration) {
    const fs = yield* FileSystem, path = yield* Path;
    let model = "unknown";
    for (const directory of config.sources) {
      const settingsFile = path.join(directory, "hex_settings.json");
      const selectedModel = yield* readBounded(settingsFile, 4 * 1024 * 1024)
        .pipe(
          Effect.flatMap((bytes) =>
            decodeJson(
              Schema.Struct({ selectedModel: Schema.optional(Schema.String) }),
              bytes,
            )
          ),
          Effect.map((settings) => settings.selectedModel),
          Effect.orElseSucceed(() => undefined),
        );
      if (selectedModel !== undefined) {
        model = selectedModel;
        break;
      }
    }
    const seen = new Map<string, Entry | null>();
    let sourcesScanned = 0;
    for (const directory of config.sources) {
      const history = path.join(directory, "transcription_history.json");
      if (
        (yield* fs.stat(history).pipe(missing, ioError("inspect history"))) ===
          null
      ) continue;
      const entries = yield* readBounded(history, 128 * 1024 * 1024).pipe(
        Effect.flatMap((bytes) => decodeJson(History, bytes)),
        Effect.mapError(() =>
          new SourceError({
            operation: "history",
            hexId: "",
            message:
              "history could not be read as a complete Hex document; retry after Hex finishes writing",
          })
        ),
        Effect.retry(
          Schedule.max([Schedule.spaced("100 millis"), Schedule.recurs(3)]),
        ),
      );
      sourcesScanned++;
      if (entries.history.length > 500000) {
        return yield* Effect.fail(
          new SourceError({
            operation: "history",
            hexId: "",
            message: "history exceeds 500000-entry safety bound",
          }),
        );
      }
      for (const raw of entries.history) {
        const id = raw.id.toLowerCase();
        if (seen.get(id)) continue;
        const basename = yield* Effect.try({
          try: () => audioBasename(raw.audioPath),
          catch: () =>
            new SourceError({
              operation: "audioPath",
              hexId: id,
              message: `cannot decode audioPath for ${id}`,
            }),
        });
        const wav = path.join(directory, "Recordings", basename);
        const info = yield* fs.stat(wav).pipe(
          missing,
          ioError("inspect recording"),
        );
        if (info === null) {
          seen.set(id, null);
          continue;
        }
        if (info.type !== "File") {
          return yield* Effect.fail(
            new SourceError({
              operation: "recording",
              hexId: id,
              message: `recording is not a regular file for ${id}`,
            }),
          );
        }
        yield* Effect.try({
          try: () => capturedEnd(raw.timestamp),
          catch: () =>
            new SourceError({
              operation: "timestamp",
              hexId: id,
              message:
                `timestamp is outside the supported date range for ${id}`,
            }),
        });
        seen.set(id, { transcript: { ...raw, id }, wav, model });
      }
    }
    return {
      sourcesScanned,
      entriesTotal: seen.size,
      missingSource: [...seen.values()].filter((e) => e === null).length,
      entries: [...seen.values()].filter((e): e is Entry => e !== null).sort((
        a,
        b,
      ) =>
        a.transcript.timestamp - b.transcript.timestamp ||
        a.transcript.id.localeCompare(b.transcript.id)
      ),
    };
  },
);
class DictationSource extends Context.Service<
  DictationSource,
  { readonly scan: typeof scanHexSource }
>()("df-dictation-archive/DictationSource") {
  static readonly layer = Layer.succeed(DictationSource, {
    scan: scanHexSource,
  });
}
const readLedger = Effect.fn("Ledger.read")(function* (config: Configuration) {
  const fs = yield* FileSystem, target = `${config.stateDir}/ledger.jsonl`;
  if (
    (yield* fs.stat(target).pipe(missing, ioError("inspect ledger"))) === null
  ) return [];
  const bytes = yield* readBounded(target, 256 * 1024 * 1024);
  const text = new TextDecoder().decode(bytes);
  if (text && !text.endsWith("\n")) {
    return yield* Effect.fail(
      new StateError({
        operation: "ledger",
        message:
          "ledger has a torn final line; preserve it and repair before retrying",
      }),
    );
  }
  return yield* Effect.forEach(
    text.split("\n").filter(Boolean),
    (line) =>
      Schema.decodeUnknownEffect(Schema.fromJsonString(LedgerRow))(line).pipe(
        Effect.mapError(() =>
          new StateError({
            operation: "ledger",
            message:
              "ledger row does not match the object receipt schema; preserve it and repair before retrying",
          })
        ),
      ),
    { concurrency: 1 },
  );
});
const appendLedger = Effect.fn("Ledger.append")(
  function* (config: Configuration, objects: readonly Receipt[]) {
    const fs = yield* FileSystem, now = yield* Clock.currentTimeMillis;
    if (
      (yield* physicalPath(`${config.stateDir}/ledger.jsonl`)) !==
        `${config.stateDir}/ledger.jsonl`
    ) {
      return yield* Effect.fail(
        new StateError({
          operation: "ledger",
          message: "ledger is a symlink; no receipt appended",
        }),
      );
    }
    const text = objects.map((object) => {
      const metadata = {
        destination: destinationLabel(config),
        shippedAt: new Date(now).toISOString(),
      };
      return Match.value(object).pipe(
        Match.when(
          { adopted: true },
          ({ path }) => canonical({ path, adopted: true, ...metadata }),
        ),
        Match.orElse(({ path, sha256 }) =>
          canonical({ path, sha256, ...metadata })
        ),
      );
    }).join("");
    if (!text) return;
    yield* fs.writeFileString(`${config.stateDir}/ledger.jsonl`, text, {
      flag: "a",
      mode: 0o600,
    }).pipe(ioError("append ledger"));
    yield* syncFile(`${config.stateDir}/ledger.jsonl`);
  },
);
class Ledger extends Context.Service<
  Ledger,
  { readonly read: typeof readLedger; readonly append: typeof appendLedger }
>()("df-dictation-archive/Ledger") {
  static readonly layer = Layer.succeed(Ledger, {
    read: readLedger,
    append: appendLedger,
  });
}

// --- Supervised processes / streaming encryption --------------------------
const environment = Effect.sync(() => {
  const env: Record<string, string> = {};
  for (const name of ["HOME", "PATH", "SSH_AUTH_SOCK"] as const) {
    const value = Deno.env.get(name);
    if (value !== undefined) env[name] = value;
  }
  return env;
});
const child = (
  program: string,
  args: readonly string[],
  env: Record<string, string>,
) =>
  ChildProcess.make(program, args, {
    env,
    extendEnv: false,
    stdin: "pipe",
    stdout: "pipe",
    stderr: "pipe",
    forceKillAfter: "5 seconds",
  });
const boundedOutput = <E>(
  stream: Stream.Stream<Uint8Array, E>,
  limit: number,
) =>
  stream.pipe(
    Stream.runFoldEffect(
      (): { chunks: Uint8Array[]; size: number } => ({ chunks: [], size: 0 }),
      (buffer, bytes) => {
        if (buffer.size + bytes.length > limit) {
          return Effect.fail(
            new StateError({
              operation: "process output",
              message:
                `process exceeded ${limit}-byte output bound; output withheld`,
            }),
          );
        }
        buffer.chunks.push(bytes);
        buffer.size += bytes.length;
        return Effect.succeed(buffer);
      },
    ),
    Effect.map((buffer) => concatenate(buffer.chunks)),
  );
const checkedExit = (program: string, code: number, stderr: Uint8Array) =>
  code === 0 ? Effect.void : Effect.fail(
    new ProcessError({
      program,
      exitCode: code,
      // Encoder diagnostics can contain timestamp-bearing WAV names. Only transfer
      // diagnostics are safe to render; neither argv nor raw defects are logged.
      stderr: ["rsync", "ssh"].includes(program)
        ? new TextDecoder().decode(stderr).split("\n").slice(-12).join("\n")
          .trim()
        : "diagnostics withheld to protect capture paths",
    }),
  );
const runProcess = Effect.fn("Processes.run")(
  function* (program: string, args: readonly string[], input?: Uint8Array) {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const env = yield* environment;
    // rsync 3.2.4+ otherwise quotes an already POSIX-quoted remote path again.
    // Older/openrsync ignores this compatibility env variable; no 3.x flags used.
    const handle = yield* spawner.spawn(
      child(
        program,
        args,
        program === "rsync" ? { ...env, RSYNC_OLD_ARGS: "1" } : env,
      ),
    ).pipe(ioError(`spawn ${program}`));
    const result = yield* Effect.all({
      input: Stream.make(input ?? new Uint8Array()).pipe(
        Stream.run(handle.stdin),
        ioError(`feed ${program}`),
      ),
      stdout: boundedOutput(handle.stdout, 64 * 1024 * 1024).pipe(
        Effect.mapError((e) =>
          e instanceof StateError ? e : new StateError({
            operation: program,
            message: `${program} stdout: ${e.reason._tag}`,
          })
        ),
      ),
      stderr: boundedOutput(handle.stderr, 65536).pipe(
        Effect.mapError((e) =>
          e instanceof StateError ? e : new StateError({
            operation: program,
            message: `${program} stderr: ${e.reason._tag}`,
          })
        ),
      ),
      code: handle.exitCode.pipe(ioError(`wait ${program}`)),
    }, { concurrency: "unbounded" });
    yield* checkedExit(program, Number(result.code), result.stderr);
    return result.stdout;
  },
  Effect.scoped,
);
const digest = Effect.fn("Crypto.sha256")(function* (bytes: Uint8Array) {
  return (yield* (yield* Crypto.Crypto).digest("SHA-256", bytes).pipe(
    ioError("SHA-256"),
  )).toHex();
});
const syncFile = Effect.fn("Files.sync")(function* (file: string) {
  const fs = yield* FileSystem;
  const handle = yield* fs.open(file, { flag: "r" }).pipe(
    ioError("open for sync"),
  );
  yield* handle.sync.pipe(ioError("sync file"));
}, Effect.scoped);
const makePrivateDirectory = Effect.fn("Files.privateDirectory")(
  function* (directory: string) {
    const fs = yield* FileSystem;
    if ((yield* physicalPath(directory)) !== directory) {
      return yield* Effect.fail(
        new StateError({
          operation: "directory",
          message:
            "managed directory contains a symlink; no permissions or contents changed",
        }),
      );
    }
    yield* fs.makeDirectory(directory, { recursive: true, mode: 0o700 }).pipe(
      ioError("create private directory"),
    );
    yield* fs.chmod(directory, 0o700).pipe(ioError("secure directory"));
  },
);
const atomicBytes = Effect.fn("Files.atomicBytes")(
  function* (file: string, bytes: Uint8Array) {
    const fs = yield* FileSystem;
    if (
      (yield* physicalPath(file)) !== file ||
      (yield* physicalPath(file + ".partial")) !== file + ".partial"
    ) {
      return yield* Effect.fail(
        new StateError({
          operation: "write",
          message: "publication path is a symlink; no bytes written",
        }),
      );
    }
    yield* fs.writeFile(file + ".partial", bytes, { flag: "wx", mode: 0o600 })
      .pipe(ioError("write partial"));
    yield* syncFile(file + ".partial");
    yield* fs.rename(file + ".partial", file).pipe(ioError("publish file"));
  },
);
const encryptBytes = Effect.fn("Staging.encryptBytes")(
  function* (file: string, bytes: Uint8Array, recipients: readonly string[]) {
    const fs = yield* FileSystem;
    if (recipients.length === 0) {
      yield* atomicBytes(file, bytes);
      return;
    }
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const handle = yield* spawner.spawn(
      child("age", recipients.flatMap((r) => ["-r", r]), yield* environment),
    ).pipe(ioError("spawn age"));
    const result = yield* Effect.all({
      input: Stream.make(bytes).pipe(
        Stream.run(handle.stdin),
        ioError("age input"),
      ),
      output: handle.stdout.pipe(
        Stream.run(fs.sink(file + ".partial", { flag: "wx", mode: 0o600 })),
        ioError("age output"),
      ),
      stderr: boundedOutput(handle.stderr, 65536),
      code: handle.exitCode,
    }, { concurrency: "unbounded" }).pipe(
      Effect.mapError((e) =>
        e instanceof StateError ? e : new StateError({
          operation: "encrypt",
          message: `age stream: ${e.reason._tag}`,
        })
      ),
    );
    yield* checkedExit("age", Number(result.code), result.stderr);
    yield* syncFile(file + ".partial");
    yield* fs.rename(file + ".partial", file).pipe(
      ioError("publish encrypted file"),
    );
  },
  Effect.scoped,
);
const encoderIdentity = Effect.fn("Transcoder.identity")(function* () {
  const text = new TextDecoder().decode(
    yield* runProcess("ffmpeg", ["-version"]),
  );
  return {
    ffmpeg: text.match(/^ffmpeg version (\S+)/)?.[1] ?? "unknown",
    libavcodec:
      text.match(/libavcodec\s+(\d+)\.\s*(\d+)\.\s*(\d+)/)?.slice(1).join(
        ".",
      ) ?? "unknown",
    libopus: text.match(/libopus\s+(\d+\.\d+(?:\.\d+)?)/)?.[1] ?? "unknown",
  };
});
const encodeRecording = Effect.fn("Transcoder.encode")(
  function* (
    file: string,
    entry: Entry,
    request: { readonly config: Configuration; readonly facts: EncodeFacts },
  ) {
    const fs = yield* FileSystem,
      spawner = yield* ChildProcessSpawner.ChildProcessSpawner,
      env = yield* environment;
    const encoder = yield* spawner.spawn(
      child("ffmpeg", ffmpegArgs(entry.wav, request.facts), env),
    ).pipe(ioError("spawn ffmpeg"));
    const recipients = request.config.encryption.recipients;
    const age = recipients.length
      ? yield* spawner.spawn(
        child("age", recipients.flatMap((r) => ["-r", r]), env),
      ).pipe(ioError("spawn age"))
      : null;
    // Effect 4.0.0 pipeTo exposes only the LAST exit status (NodeChildProcessSpawner
    // lines 667-685). Explicit stream wiring preserves both statuses and feed errors.
    // Crypto.digest is one-shot: retain bounded Opus chunks in memory while piping
    // them to age. No plaintext file is created, even during interruption.
    const chunks: Uint8Array[] = [];
    let size = 0;
    const audio = encoder.stdout.pipe(
      Stream.tap((bytes) =>
        Effect.gen(function* () {
          size += bytes.length;
          if (size > 64 * 1024 * 1024) {
            return yield* Effect.fail(
              new StateError({
                operation: "encode",
                message:
                  "Opus output exceeds 64 MiB per-recording safety bound",
              }),
            );
          }
          chunks.push(bytes);
        })
      ),
    );
    const output = fs.sink(file + ".partial", { flag: "wx", mode: 0o600 });
    const result = yield* Effect.all({
      closeInput: Stream.empty.pipe(Stream.run(encoder.stdin)),
      feed: age
        ? audio.pipe(Stream.run(age.stdin))
        : audio.pipe(Stream.run(output)),
      stored: age ? age.stdout.pipe(Stream.run(output)) : Effect.void,
      ffmpegError: boundedOutput(encoder.stderr, 65536),
      ffmpegCode: encoder.exitCode,
      ageError: age
        ? boundedOutput(age.stderr, 65536)
        : Effect.succeed(new Uint8Array()),
      ageCode: age ? age.exitCode : Effect.succeed(0),
    }, { concurrency: "unbounded" }).pipe(
      Effect.mapError((e) =>
        e instanceof StateError ? e : new StateError({
          operation: "encode",
          message: `encoding stream: ${e.reason._tag}`,
        })
      ),
    );
    yield* checkedExit("ffmpeg", Number(result.ffmpegCode), result.ffmpegError);
    yield* checkedExit("age", Number(result.ageCode), result.ageError);
    yield* syncFile(file + ".partial");
    yield* fs.rename(file + ".partial", file).pipe(
      ioError("publish recording"),
    );
    return { sha256: yield* digest(concatenate(chunks)), bytes: size };
  },
  Effect.scoped,
);
class Transcoder extends Context.Service<
  Transcoder,
  {
    readonly identity: typeof encoderIdentity;
    readonly encode: typeof encodeRecording;
  }
>()("df-dictation-archive/Transcoder") {
  static readonly layer = Layer.succeed(Transcoder, {
    identity: encoderIdentity,
    encode: encodeRecording,
  });
}

// --- Staging transactions -------------------------------------------------
// Each transaction becomes recoverable BEFORE any final object is published.
// Its manifest contains only export paths and ciphertext hashes. Recovery moves
// the original bytes; it never re-encrypts an already-published object.
const hashFile = Effect.fn("Staging.hashFile")(function* (file: string) {
  return yield* digest(yield* readBounded(file, 128 * 1024 * 1024));
});
const listStaged = Effect.fn("Staging.list")(function* (config: Configuration) {
  const fs = yield* FileSystem;
  const names = yield* fs.readDirectory(config.stagingDir).pipe(
    missing,
    ioError("inspect staging root"),
  );
  if (names === null) return [];
  if (names.some((name) => !["entries", ".pending", ".lock"].includes(name))) {
    return yield* Effect.fail(
      new StateError({
        operation: "staging",
        message:
          "staging root contains an unrecognized item; move unrelated files out before transfer",
      }),
    );
  }
  const root = `${config.stagingDir}/entries`;
  if (
    (yield* fs.stat(root).pipe(missing, ioError("inspect staging"))) === null
  ) return [];
  const found: string[] = [];
  const walk = Effect.fn("Staging.walk")(
    function* (
      relative: string,
      depth: number,
    ): Effect.fn.Return<void, StateError> {
      const dir = `${config.stagingDir}/${relative}`;
      if ((yield* fs.realPath(dir).pipe(ioError("resolve staging"))) !== dir) {
        return yield* Effect.fail(
          new StateError({
            operation: "staging",
            message:
              "staging contains a symlink; remove the link before retrying",
          }),
        );
      }
      for (
        const name of yield* fs.readDirectory(dir).pipe(ioError("list staging"))
      ) {
        const next = `${relative}/${name}`,
          full = `${config.stagingDir}/${next}`;
        if (
          (yield* fs.realPath(full).pipe(ioError("resolve object"))) !== full
        ) {
          return yield* Effect.fail(
            new StateError({
              operation: "staging",
              message:
                "staging contains a symlink; remove the link before retrying",
            }),
          );
        }
        const info = yield* fs.stat(full).pipe(ioError("inspect object"));
        if (
          info.type === "Directory" && depth < 3 &&
          (depth === 1
            ? Schema.is(Uuid)(name) && name === name.toLowerCase()
            : ["recordings", "projections"].includes(name))
        ) {
          yield* walk(next, depth + 1);
          continue;
        }
        if (info.type !== "File" || !objectPattern.test(next)) {
          return yield* Effect.fail(
            new StateError({
              operation: "staging",
              message:
                "staging contains an unrecognized object; move unrelated files out before retrying",
            }),
          );
        }
        if ((info.mode & 0o777) !== 0o600) {
          return yield* Effect.fail(
            new StateError({
              operation: "staging",
              message: "staged object permissions must be 0600",
            }),
          );
        }
        found.push(next);
        if (found.length > 2000000) {
          return yield* Effect.fail(
            new StateError({
              operation: "staging",
              message: "staging exceeds two million objects",
            }),
          );
        }
      }
    },
  );
  yield* walk("entries", 1);
  return found;
});
const objectDirectories = Effect.fn("Staging.objectDirectories")(
  function* (root: string, relative: string) {
    const path = yield* Path;
    let current = root;
    for (const part of path.dirname(relative).split("/")) {
      current += `/${part}`;
      yield* makePrivateDirectory(current);
    }
  },
);
const publishTransaction = Effect.fn("Staging.publish")(
  function* (config: Configuration, transaction: string) {
    const fs = yield* FileSystem;
    const manifest = yield* readBounded(`${transaction}/manifest.json`, 1048576)
      .pipe(
        Effect.flatMap((bytes) => decodeJson(Manifest, bytes)),
        Effect.mapError(() =>
          new StateError({
            operation: "transaction",
            message:
              "staging transaction manifest is unreadable; preserve it for recovery",
          })
        ),
      );
    for (const object of manifest) {
      const target = `${config.stagingDir}/${object.path}`,
        original = `${transaction}/${object.path}`;
      if (
        (yield* physicalPath(target)) !== target ||
        (yield* physicalPath(original)) !== original
      ) {
        return yield* Effect.fail(
          new StateError({
            operation: "transaction",
            message: "transaction object path contains a symlink",
          }),
        );
      }
      const present = yield* fs.stat(target).pipe(
        missing,
        ioError("inspect publication"),
      );
      if (present !== null) {
        if ((yield* hashFile(target)) !== object.sha256) {
          return yield* Effect.fail(
            new StateError({
              operation: "transaction",
              message:
                "published object conflicts with its transaction hash; no bytes overwritten",
            }),
          );
        }
      } else {
        if ((yield* hashFile(original)) !== object.sha256) {
          return yield* Effect.fail(
            new StateError({
              operation: "transaction",
              message: "transaction object differs from its recorded hash",
            }),
          );
        }
        yield* objectDirectories(config.stagingDir, object.path);
        yield* fs.rename(original, target).pipe(
          ioError("publish staged object"),
        );
      }
    }
    yield* fs.remove(transaction, { recursive: true }).pipe(
      ioError("finish transaction"),
    );
  },
);
const recoverStaging = Effect.fn("Staging.recover")(
  function* (config: Configuration) {
    const fs = yield* FileSystem, root = `${config.stagingDir}/.pending`;
    if (
      (yield* fs.stat(root).pipe(missing, ioError("inspect pending"))) === null
    ) return;
    for (
      const name of yield* fs.readDirectory(root).pipe(ioError("list pending"))
    ) {
      if (!Schema.is(Uuid)(name)) {
        return yield* Effect.fail(
          new StateError({
            operation: "recovery",
            message: "pending directory contains an unrecognized transaction",
          }),
        );
      }
      const transaction = `${root}/${name}`;
      if (
        (yield* fs.realPath(transaction).pipe(
          ioError("resolve transaction"),
        )) !== transaction
      ) {
        return yield* Effect.fail(
          new StateError({
            operation: "recovery",
            message: "transaction is a symlink",
          }),
        );
      }
      if (
        (yield* fs.stat(`${transaction}/manifest.json`).pipe(
          missing,
          ioError("inspect transaction"),
        )) === null
      ) {
        // Without a manifest nothing was published. Discard only our unfinished build.
        yield* fs.remove(transaction, { recursive: true }).pipe(
          ioError("discard unfinished transaction"),
        );
      } else yield* publishTransaction(config, transaction);
    }
  },
);
const stageEntry = Effect.fn("Staging.entry")(
  function* (
    entry: Entry,
    needed: readonly string[],
    request: {
      readonly config: Configuration;
      readonly encoder: Encoder;
      readonly appVersion: string;
    },
  ) {
    const { config, encoder, appVersion } = request;
    const fs = yield* FileSystem,
      path = yield* Path,
      transcoder = yield* Transcoder;
    const id = entry.transcript.id,
      transaction = `${config.stagingDir}/.pending/${id}`;
    yield* makePrivateDirectory(`${config.stagingDir}/.pending`);
    yield* fs.makeDirectory(transaction, { mode: 0o700 }).pipe(
      ioError("start transaction"),
    );
    let recoverable = false;
    yield* Effect.acquireRelease(
      Effect.succeed(transaction),
      (directory) =>
        recoverable
          ? Effect.void
          : fs.remove(directory, { recursive: true, force: true }).pipe(
            Effect.orDie,
          ),
    );
    const bytes = yield* readBounded(entry.wav, 512 * 1024 * 1024);
    const wav = yield* Effect.try({
      try: () => parseWav(bytes),
      catch: (cause) =>
        cause instanceof WavError
          ? cause
          : new WavError({ reason: "parser failed" }),
    });
    const sourceSha256 = yield* digest(bytes),
      end = capturedEnd(entry.transcript.timestamp),
      recipe = recipeId(config.recipe.bitrate);
    const suffix = config.encryption.recipients.length ? ".age" : "";
    const recordingPath = `entries/${id}/recordings/${recipe}.opus${suffix}`;
    let recording:
      | { readonly sha256: string; readonly bytes: number }
      | undefined;
    if (needed.includes(recordingPath)) {
      yield* objectDirectories(transaction, recordingPath);
      recording = yield* transcoder.encode(
        `${transaction}/${recordingPath}`,
        entry,
        {
          config,
          facts: {
            hexId: id,
            sourceSha256,
            capturedEnd: end,
            bitrate: config.recipe.bitrate,
            encoder,
          },
        },
      );
      if (
        (yield* digest(yield* readBounded(entry.wav, 512 * 1024 * 1024))) !==
          sourceSha256
      ) {
        return yield* Effect.fail(
          new SourceError({
            operation: "snapshot",
            hexId: id,
            message:
              `recording changed while encoding ${id}; retry after capture completes`,
          }),
        );
      }
    }
    for (
      const relative of needed.filter((p) => p !== recordingPath)
    ) {
      yield* objectDirectories(transaction, relative);
      let document: Schema.Json;
      if (relative.endsWith(`/source.json${suffix}`)) {
        const hex = entry.transcript;
        // durationReported is hotkey-hold time, NOT audio length. Real duration is
        // integer samples / sampleRate. Raw Hex seconds are preserved, not invented.
        document = {
          schema: 1,
          hexId: id,
          source: { sha256: sourceSha256, bytes: bytes.length, ...wav },
          hex: {
            timestampRaw: hex.timestamp,
            durationReported: hex.duration,
            ...(hex.sourceAppBundleID === undefined
              ? {}
              : { sourceAppBundleID: hex.sourceAppBundleID }),
            ...(hex.sourceAppName === undefined
              ? {}
              : { sourceAppName: hex.sourceAppName }),
          },
          capturedEnd: end,
        };
      } else if (relative.endsWith(`/hex-capture.json${suffix}`)) {
        document = {
          schema: 1,
          hexId: id,
          producer: {
            name: "hex",
            appVersion,
            selectedModelAtExport: entry.model,
          },
          sourceSha256,
          text: entry.transcript.text,
          postProcessing:
            "hex-applied (word removals, remappings, formatting) — per-entry settings at capture time are unknown",
        };
      } else {
        if (!recording) {
          return yield* Effect.fail(
            new StateError({
              operation: "recording sidecar",
              message:
                `recording pair is incomplete for ${id}; restore its staging transaction instead of regenerating metadata`,
            }),
          );
        }
        document = {
          schema: 1,
          hexId: id,
          recipe,
          file: path.basename(recordingPath),
          ...recording,
          sourceSha256,
          encoder,
        };
      }
      yield* encryptBytes(
        `${transaction}/${relative}`,
        new TextEncoder().encode(canonical(document)),
        config.encryption.recipients,
      );
    }
    const manifest = yield* Effect.forEach(
      needed,
      (relative) =>
        hashFile(`${transaction}/${relative}`).pipe(
          Effect.map((sha256) => ({ path: relative, sha256 })),
        ),
      { concurrency: 1 },
    );
    yield* atomicBytes(
      `${transaction}/manifest.json`,
      new TextEncoder().encode(canonical(manifest)),
    );
    recoverable = true;
    yield* publishTransaction(config, transaction);
  },
  Effect.scoped,
);
class Staging extends Context.Service<
  Staging,
  {
    readonly list: typeof listStaged;
    readonly recover: typeof recoverStaging;
    readonly stage: typeof stageEntry;
  }
>()("df-dictation-archive/Staging") {
  static readonly layer = Layer.succeed(Staging, {
    list: listStaged,
    recover: recoverStaging,
    stage: stageEntry,
  });
}

// --- Append-only shipper --------------------------------------------------
const verifyStaged = Effect.fn("Shipper.verify")(
  function* (config: Configuration, staged: ReadonlySet<string>) {
    const output = new TextDecoder().decode(
      yield* runProcess("rsync", rsyncArgs(config, true)),
    );
    // Never --ignore-existing here: classification needs existing-file conflicts.
    return yield* requireVerified(classifyVerification(output, staged));
  },
);
const shipStaged = Effect.fn("Shipper.ship")(function* (
  config: Configuration,
  staged: ReadonlySet<string>,
) {
  const d = config.destination;
  if (d.host) {
    // ssh executes its remote command through a shell even with an argv API.
    // Send ONE command argument, with the path POSIX-quoted, never raw interpolation.
    yield* runProcess("ssh", [
      ...sshArgs(d),
      "--",
      sshTarget(d),
      `mkdir -p -- ${quoteShell(d.path)}`,
    ]);
  } else yield* makePrivateDirectory(d.path);
  yield* runProcess("rsync", rsyncArgs(config, false));
  return yield* verifyStaged(config, staged);
});
class Shipper extends Context.Service<
  Shipper,
  { readonly ship: typeof shipStaged; readonly verify: typeof verifyStaged }
>()("df-dictation-archive/Shipper") {
  static readonly layer = Layer.succeed(Shipper, {
    ship: shipStaged,
    verify: verifyStaged,
  });
}

// --- Configuration / path ownership --------------------------------------
const configFailure = (cause: Schema.SchemaError) => {
  const issue =
    SchemaIssue.makeFormatterStandardSchemaV1()(cause.issue).issues[0];
  const known = new Set([
    "destination",
    "host",
    "user",
    "port",
    "path",
    "identityFile",
    "connectTimeoutSeconds",
    "encryption",
    "recipients",
    "recipe",
    "bitrate",
    "sources",
    "stagingDir",
    "stateDir",
  ]);
  const key =
    (issue?.path ?? []).map((part) =>
      typeof part === "number"
        ? String(part)
        : typeof part === "string" && known.has(part)
        ? part
        : "<unknown-key>"
    ).join(".") || "config";
  return new ConfigError({
    key,
    message:
      `${key} does not match the configuration schema; check its type and allowed range`,
  });
};
const parseConfig = (value: unknown) =>
  Schema.decodeUnknownEffect(ConfigInput)(value, { onExcessProperty: "error" })
    .pipe(Effect.mapError(configFailure));
const expandHome = (value: string, home: string) =>
  value === "~" ? home : value.startsWith("~/") ? home + value.slice(1) : value;
const physicalPath = Effect.fn("Files.physicalPath")(function* (value: string) {
  const fs = yield* FileSystem, path = yield* Path;
  let current = path.resolve(value);
  const names: string[] = [];
  for (;;) {
    const info = yield* fs.stat(current).pipe(missing, ioError("resolve path"));
    if (info !== null) {
      return path.join(
        yield* fs.realPath(current).pipe(ioError("resolve physical path")),
        ...names.reverse(),
      );
    }
    const parent = path.dirname(current);
    // stat follows symlinks, so detect a dangling link rather than creating through it.
    const siblings = yield* fs.readDirectory(parent).pipe(
      missing,
      ioError("inspect path parent"),
    );
    if (siblings?.includes(path.basename(current))) {
      return yield* Effect.fail(
        new StateError({
          operation: "path",
          message: "configured path contains a dangling symlink",
        }),
      );
    }
    if (parent === current) {
      return yield* Effect.fail(
        new StateError({
          operation: "path",
          message: "cannot resolve path root",
        }),
      );
    }
    names.push(path.basename(current));
    current = parent;
  }
});
const overlaps = (a: string, b: string): boolean =>
  a === b || a.startsWith(b + "/") || b.startsWith(a + "/");
const validateLocations = Effect.fn("Config.locations")(
  function* (config: Configuration, home: string) {
    if (
      config.sources.some((p) =>
        overlaps(p, `${home}/Library/Containers/com.kitlangton.Hex/Data/tmp`)
      )
    ) {
      return yield* Effect.fail(
        new ConfigError({
          key: "sources",
          message: "sources must not include the Hex temporary-data tree",
        }),
      );
    }
    const protectedPaths = [
      ...config.sources,
      `${home}/Library/Containers/com.kitlangton.Hex`,
      `${home}/Library/Application Support/com.kitlangton.Hex`,
    ];
    const sources = yield* Effect.forEach(config.sources, physicalPath, {
      concurrency: 4,
    });
    const protectedRoots = yield* Effect.forEach(protectedPaths, physicalPath, {
      concurrency: 4,
    });
    const stateDir = yield* physicalPath(config.stateDir),
      stagingDir = yield* physicalPath(config.stagingDir);
    const destinationPath = config.destination.host || !config.destination.path
      ? config.destination.path
      : yield* physicalPath(config.destination.path);
    for (
      const [key, output] of [
        ["stateDir", stateDir],
        ["stagingDir", stagingDir],
        ...(!config.destination.host && destinationPath
          ? [["destination.path", destinationPath]]
          : []),
      ]
    ) {
      if (
        output === "/" ||
        protectedRoots.some((source) => overlaps(output, source))
      ) {
        return yield* Effect.fail(
          new ConfigError({
            key,
            message:
              `${key} overlaps read-only source storage; select an independent export location`,
          }),
        );
      }
    }
    if (stateDir === stagingDir || stateDir.startsWith(stagingDir + "/")) {
      return yield* Effect.fail(
        new ConfigError({
          key: "stagingDir",
          message: "stagingDir must not contain stateDir",
        }),
      );
    }
    if (
      !config.destination.host && destinationPath &&
      [stateDir, stagingDir].some((p) => overlaps(p, destinationPath))
    ) {
      return yield* Effect.fail(
        new ConfigError({
          key: "destination.path",
          message: "destination.path must not overlap state or staging",
        }),
      );
    }
    return {
      ...config,
      sources,
      stateDir,
      stagingDir,
      destination: { ...config.destination, path: destinationPath },
    };
  },
);
const optionalString = (name: string) => Flag.String(name).pipe(Flag.optional);
const boolean = (name: string, description: string) =>
  Flag.Boolean(name).pipe(
    Flag.withDefault(false),
    Flag.withDescription(description),
  );
const commonFlags = {
  json: boolean("json", "Print machine-readable counts instead of plain text"),
  config: optionalString("config"),
  host: optionalString("host"),
  user: optionalString("user"),
  port: Flag.Int("port").pipe(Flag.optional),
  path: optionalString("path"),
  identityFile: optionalString("identity-file"),
  bitrate: optionalString("bitrate"),
  source: Flag.String("source").pipe(Flag.between(0, 32)),
  recipient: Flag.String("recipient").pipe(Flag.between(0, 128)),
  stateDir: optionalString("state-dir"),
  stagingDir: optionalString("staging-dir"),
};
type FlagValue<F> = F extends Flag.Flag<infer A> ? A : never;
type CommonFlags = {
  readonly [K in keyof typeof commonFlags]: FlagValue<typeof commonFlags[K]>;
};
const loadConfig = Effect.fn("Config.load")(function* (flags: CommonFlags) {
  const fs = yield* FileSystem;
  const home = yield* Effect.sync(() => Deno.env.get("HOME") ?? "");
  if (!home) {
    return yield* Effect.fail(
      new ConfigError({
        key: "HOME",
        message:
          "HOME is required to resolve configuration and default sources",
      }),
    );
  }
  const stateHome = yield* Effect.sync(() =>
    Deno.env.get("XDG_STATE_HOME") || `${home}/.local/state`
  );
  const filePath = expandHome(
    Option.getOrElse(
      flags.config,
      () => `${home}/.config/dotfiles/dictation-archive.json`,
    ),
    home,
  );
  const present = yield* fs.stat(filePath).pipe(
    missing,
    ioError("inspect config"),
  );
  if (present === null && Option.isSome(flags.config)) {
    return yield* Effect.fail(
      new ConfigError({
        key: "config",
        message: "explicit --config file does not exist",
      }),
    );
  }
  const file = present === null
    ? {}
    : yield* readBounded(filePath, 1048576).pipe(
      Effect.flatMap((bytes) =>
        Schema.decodeUnknownEffect(Schema.fromJsonString(ConfigInput))(
          new TextDecoder().decode(bytes),
          { onExcessProperty: "error" },
        )
      ),
      Effect.mapError((e) => e instanceof StateError ? e : configFailure(e)),
    );
  const override: ConfigInput = {
    destination: {
      host: Option.getOrUndefined(flags.host),
      user: Option.getOrUndefined(flags.user),
      port: Option.getOrUndefined(flags.port),
      path: Option.getOrUndefined(flags.path),
      identityFile: Option.getOrUndefined(flags.identityFile),
    },
    ...(Option.isSome(flags.bitrate)
      ? { recipe: { bitrate: flags.bitrate.value } }
      : {}),
    ...(flags.source.length ? { sources: flags.source } : {}),
    ...(flags.recipient.length
      ? { encryption: { recipients: flags.recipient } }
      : {}),
    ...(Option.isSome(flags.stateDir)
      ? { stateDir: flags.stateDir.value }
      : {}),
    ...(Option.isSome(flags.stagingDir)
      ? { stagingDir: flags.stagingDir.value }
      : {}),
  };
  // Absent flag keys must not overwrite file values with undefined.
  const cleaned = {
    ...override,
    destination: Object.fromEntries(
      Object.entries(override.destination ?? {}).filter(([, v]) =>
        v !== undefined
      ),
    ),
  };
  const config = mergeConfig(
    defaults(home, stateHome),
    file,
    yield* parseConfig(cleaned),
  );
  const expanded = {
    ...config,
    sources: config.sources.map((p) => expandHome(p, home)),
    stateDir: expandHome(config.stateDir, home),
    stagingDir: expandHome(config.stagingDir, home),
    destination: {
      ...config.destination,
      path: config.destination.host
        ? config.destination.path
        : expandHome(config.destination.path, home),
      identityFile: expandHome(config.destination.identityFile, home),
    },
  };
  const validated = yield* Schema.decodeUnknownEffect(Configuration)(expanded)
    .pipe(Effect.mapError(configFailure));
  for (
    const [key, values] of [
      ["sources", validated.sources],
      ["stateDir", [validated.stateDir]],
      ["stagingDir", [validated.stagingDir]],
      [
        "destination.path",
        validated.destination.path ? [validated.destination.path] : [],
      ],
      [
        "destination.identityFile",
        validated.destination.identityFile
          ? [validated.destination.identityFile]
          : [],
      ],
    ] as const
  ) {
    if (values.some((v) => !v.startsWith("/"))) {
      return yield* Effect.fail(
        new ConfigError({
          key,
          message:
            `${key} must use absolute paths (local paths may start with ~/)`,
        }),
      );
    }
  }
  return yield* validateLocations(validated, home);
});
const requireDestination = (config: Configuration) =>
  config.destination.path ? Effect.void : Effect.fail(
    new ConfigError({
      key: "destination.path",
      message:
        "destination is not configured; edit home/.chezmoidata/dictation-archive.yaml or pass --path and optionally --host/--user/--port/--identity-file",
    }),
  );
const lockDirectory = Effect.fn("State.lock")(function* (directory: string) {
  const fs = yield* FileSystem;
  yield* Effect.acquireRelease(
    fs.makeDirectory(directory, { mode: 0o700 }).pipe(
      Effect.mapError((cause) =>
        new StateError({
          operation: "lock",
          message: cause.reason._tag === "AlreadyExists"
            ? `lock exists at ${directory}; another run may be active; remove only after confirming it is stale`
            : `lock creation: ${cause.reason._tag}`,
        })
      ),
    ),
    () => fs.remove(directory, { recursive: true }).pipe(Effect.orDie),
  );
});
const bindDestination = Effect.fn("State.bindDestination")(
  function* (config: Configuration) {
    const fs = yield* FileSystem, file = `${config.stateDir}/destination.json`;
    const wanted = destinationLabel(config);
    if (
      (yield* fs.stat(file).pipe(
        missing,
        ioError("inspect destination binding"),
      )) === null
    ) {
      yield* atomicBytes(
        file,
        new TextEncoder().encode(
          canonical({ destination: wanted, stagingDir: config.stagingDir }),
        ),
      );
    } else {
      const binding = yield* readBounded(file, 1048576).pipe(
        Effect.flatMap((bytes) =>
          decodeJson(
            Schema.Struct({
              destination: Schema.String,
              stagingDir: Schema.String,
            }),
            bytes,
          )
        ),
        Effect.mapError(() =>
          new StateError({
            operation: "binding",
            message: "state destination binding is unreadable",
          })
        ),
      );
      if (
        binding.destination !== wanted ||
        binding.stagingDir !== config.stagingDir
      ) {
        return yield* Effect.fail(
          new ConfigError({
            key: "stateDir",
            message:
              "stateDir belongs to a different destination or staging directory; use a separate state/staging pair",
          }),
        );
      }
    }
  },
);

// --- Observation / reconciliation ----------------------------------------
const probe = (program: string) =>
  runProcess(program, ["--version"]).pipe(
    Effect.map(() => true),
    Effect.orElseSucceed(() => false),
  );
const planWork = Effect.fn("Export.plan")(function* (config: Configuration) {
  const source = yield* DictationSource,
    ledger = yield* Ledger,
    staging = yield* Staging;
  const scan = yield* source.scan(config),
    rows = yield* ledger.read(config),
    staged = yield* staging.list(config);
  const shipped = new Set(
    rows.filter((r) => r.destination === destinationLabel(config)).map((r) =>
      r.path
    ),
  );
  const stagedSet = new Set(staged);
  const plans = scan.entries.map((entry) => ({
    entry,
    needed: newObjects(
      desiredObjects(entry.transcript.id, config),
      shipped,
      stagedSet,
    ),
  })).filter((p) => p.needed.length);
  const counts = {
    sourcesScanned: scan.sourcesScanned,
    entriesTotal: scan.entriesTotal,
    missingSource: scan.missingSource,
    shipped: scan.entries.filter((entry) =>
      desiredObjects(entry.transcript.id, config).every((p) =>
        shipped.has(p)
      )
    ).length,
    stagedNotShipped:
      new Set(staged.filter((p) => !shipped.has(p)).map((p) => p.split("/")[1]))
        .size,
    new: plans.length,
    destinationConfigured: Boolean(config.destination.path),
    encryptionConfigured: config.encryption.recipients.length > 0,
  };
  return { counts, plans, staged, shipped };
});
const observe = Effect.fn("Export.observe")(function* (config: Configuration) {
  const plan = yield* planWork(config);
  const fs = yield* FileSystem;
  const pending = yield* fs.readDirectory(`${config.stagingDir}/.pending`).pipe(
    missing,
    ioError("observe pending transactions"),
  );
  const pendingIds = new Set(
    plan.staged.filter((p) => !plan.shipped.has(p)).map((p) => p.split("/")[1]),
  );
  for (const id of pending ?? []) {
    if (!Schema.is(Uuid)(id)) {
      return yield* Effect.fail(
        new StateError({
          operation: "observation",
          message: "pending staging contains an unrecognized transaction",
        }),
      );
    }
    pendingIds.add(id);
  }
  const tools = yield* Effect.all({
    ffmpegFound: runProcess("ffmpeg", ["-version"]).pipe(
      Effect.map(() => true),
      Effect.orElseSucceed(() => false),
    ),
    ageFound: probe("age"),
    rsyncFound: probe("rsync"),
  }, { concurrency: "unbounded" });
  return {
    ...plan,
    counts: { ...plan.counts, stagedNotShipped: pendingIds.size, ...tools },
  };
});
type StatusCounts = {
  readonly sourcesScanned: number;
  readonly entriesTotal: number;
  readonly missingSource: number;
  readonly shipped: number;
  readonly stagedNotShipped: number;
  readonly new: number;
  readonly destinationConfigured: boolean;
  readonly encryptionConfigured: boolean;
  readonly ffmpegFound: boolean;
  readonly ageFound: boolean;
  readonly rsyncFound: boolean;
};
const statusJson = (counts: StatusCounts, newObjects?: number) =>
  JSON.stringify({
    sourcesScanned: counts.sourcesScanned,
    entriesTotal: counts.entriesTotal,
    missingSource: counts.missingSource,
    shipped: counts.shipped,
    stagedNotShipped: counts.stagedNotShipped,
    new: counts.new,
    destinationConfigured: counts.destinationConfigured,
    encryptionConfigured: counts.encryptionConfigured,
    ffmpegFound: counts.ffmpegFound,
    ageFound: counts.ageFound,
    rsyncFound: counts.rsyncFound,
    ...(newObjects === undefined ? {} : { newObjects }),
  });
const statusExitCode = (counts: StatusCounts): 0 | 2 =>
  counts.new || counts.stagedNotShipped || counts.missingSource ? 2 : 0;
const plural = (n: number, noun: string): string =>
  `${n} ${noun}${n === 1 ? "" : "s"}`;
const renderStatus = (counts: StatusCounts): string =>
  [
    `Dictation recordings found: ${counts.entriesTotal} (${
      plural(counts.sourcesScanned, "source")
    })`,
    `Exported: ${counts.shipped}`,
    `Waiting to export: ${counts.new}`,
    `Staged but not sent: ${counts.stagedNotShipped}`,
    `Recordings with missing audio: ${counts.missingSource}`,
    "Setup:",
    `  destination: ${counts.destinationConfigured ? "set" : "not set"}`,
    `  encryption: ${
      counts.encryptionConfigured ? "on" : "off (--allow-plaintext needed)"
    }`,
    `  ffmpeg: ${counts.ffmpegFound ? "found" : "missing"}`,
    `  age: ${counts.ageFound ? "found" : "missing"}`,
    `  rsync: ${counts.rsyncFound ? "found" : "missing"}`,
    statusExitCode(counts) === 0 ? "Up to date." : "Work remaining (exit 2).",
  ].join("\n");
const renderDryRun = (
  counts: StatusCounts & {
    readonly newObjects: number;
    readonly limit: number;
  },
): string =>
  [
    "Dry run, nothing written:",
    renderStatus(counts),
    `Would create ${plural(counts.newObjects, "file")} for ${
      plural(Math.min(counts.limit, counts.new), "recording")
    }.`,
  ].join("\n");
// Receipt paths already satisfy ObjectPath; every object belongs to one entry.
const recordingIds = (receipts: readonly Receipt[]): ReadonlySet<string> =>
  new Set(receipts.map((receipt) => receipt.path.split("/")[1]));
const runSummary = (
  receipts: readonly Receipt[],
  encodedThisRun: number,
  filesStagedOnly: number,
) => ({
  recordings: recordingIds(receipts).size,
  filesDelivered: receipts.filter((r) => r.adopted !== true).length,
  filesAdopted: receipts.filter((r) => r.adopted === true).length,
  filesStagedOnly,
  recordingsEncodedThisRun: encodedThisRun,
});
const renderRunSummary = (
  receipts: readonly Receipt[],
  encodedThisRun: number,
  outcome: {
    readonly filesStagedOnly: number;
    readonly remaining: number;
    readonly noShip: boolean;
  },
): string => {
  const counts = runSummary(receipts, encodedThisRun, outcome.filesStagedOnly);
  // Keep grouping local to run: status, dry-run and verify retain their layout.
  const count = (n: number, noun: string): string =>
    `${n.toLocaleString("en-US")} ${noun}${n === 1 ? "" : "s"}`;
  if (
    counts.recordingsEncodedThisRun === 0 && counts.recordings === 0 &&
    counts.filesStagedOnly === 0 && outcome.remaining === 0
  ) return "Up to date: 0 new recordings.";
  // No file total: delivered, adopted and staged-only are disjoint outcomes.
  const lines = outcome.noShip
    ? [
      `Processed ${count(counts.recordingsEncodedThisRun, "recording")}.`,
      `  staged ${count(counts.filesStagedOnly, "file")}, not sent (--no-ship)`,
    ]
    : [
      `Exported ${
        count(counts.recordings, "recording")
      } (delivered and verified at destination).`,
      `  delivered and verified: ${count(counts.filesDelivered, "file")}`,
      `  already at destination (adopted): ${
        count(counts.filesAdopted, "file")
      }`,
      ...(counts.recordingsEncodedThisRun === counts.recordings ? [] : [
        `  encoded in this run: ${
          count(counts.recordingsEncodedThisRun, "recording")
        } (the rest were staged by an earlier run)`,
      ]),
    ];
  lines.push(
    outcome.remaining === 0
      ? "Up to date: nothing left to export."
      : `Remaining: ${count(outcome.remaining, "recording")} still to export`,
  );
  return lines.join("\n");
};
const verifySummary = (
  stagedObjects: number,
  verification: ReturnType<typeof classifyVerification>,
) => ({
  stagedObjects,
  differences: verification.differences,
  wouldAdopt: verification.adoptable.size,
  blocking: verification.blocking,
});
const renderVerify = (counts: ReturnType<typeof verifySummary>): string =>
  `Checked ${
    plural(counts.stagedObjects, "staged file")
  } against destination: ${
    counts.wouldAdopt === 0
      ? "all match."
      : `${counts.wouldAdopt} of ${counts.stagedObjects} already at destination (would be adopted by run).`
  }`;
// --- Count-only terminal progress -----------------------------------------
// Renderers accept no source data. All glyphs occupy one terminal cell.
const fitToWidth = (line: string, width: number): string =>
  line.slice(0, Math.max(0, Math.floor(width)));
const formatDuration = (seconds: number): string => {
  const s = Math.max(0, Math.floor(seconds));
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
  return `${Math.floor(s / 3600)}h ${Math.floor(s / 60) % 60}m ${s % 60}s`;
};
const formatEta = (seconds: number): string => {
  const s = Math.max(0, Math.ceil(seconds));
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m`;
  return `${Math.floor(s / 3600)}h${
    String(Math.floor(s / 60) % 60).padStart(2, "0")
  }m`;
};
type ProgressCounts = {
  readonly completed: number;
  readonly total: number;
  readonly elapsedSeconds: number;
};
const renderProgressBar = (counts: ProgressCounts, width: number): string => {
  const { completed, total, elapsedSeconds } = counts;
  const fraction = total === 0 ? 1 : Math.min(1, completed / total);
  const warmed = (completed >= 3 || elapsedSeconds >= 2) &&
    completed > 0 && elapsedSeconds > 0;
  const rate = completed / elapsedSeconds;
  const details = `  ${completed.toLocaleString("en-US")} / ${
    total.toLocaleString("en-US")
  } recordings  ${Math.floor(fraction * 100)}%  ${
    warmed ? rate.toFixed(1) : "--"
  }/s  ETA ${warmed ? formatEta((total - completed) / rate) : "--"}`;
  // Keep at least one bar cell; truncation handles very narrow terminals.
  const cells = Math.max(
    1,
    Math.min(40, width - "Exporting  []".length - details.length),
  );
  const filled = Math.floor(fraction * cells);
  return fitToWidth(
    `Exporting  [${"█".repeat(filled)}${"░".repeat(cells - filled)}]${details}`,
    width,
  );
};
const renderShippingProgress = (
  counts: { readonly total: number; readonly elapsedSeconds: number },
  frame: string,
  width: number,
): string =>
  fitToWidth(
    `Sending to destination  ${frame}  ${
      formatDuration(counts.elapsedSeconds)
    }  [${counts.total.toLocaleString("en-US")} files staged]`,
    width,
  );
type ProgressLabel = "Exporting" | "Sending to destination";
class Progress extends Context.Service<Progress, {
  readonly start: (label: ProgressLabel, total: number) => Effect.Effect<void>;
  readonly advance: () => Effect.Effect<void>;
  readonly phase: (label: "Sending to destination") => Effect.Effect<void>;
  readonly finish: () => Effect.Effect<void>;
}>()("df-dictation-archive/Progress") {
  static readonly noop = Layer.succeed(Progress, {
    start: () => Effect.void,
    advance: () => Effect.void,
    phase: () => Effect.void,
    finish: () => Effect.void,
  });

  static readonly live = Layer.effect(
    Progress,
    Effect.gen(function* () {
      const clock = yield* Clock.Clock;
      const now = () => Number(clock.monotonicTimeNanosUnsafe()) / 1_000_000;
      const locale = Deno.env.get("LC_ALL") || Deno.env.get("LC_CTYPE") ||
        Deno.env.get("LANG") || "";
      const frames = /utf-?8/i.test(locale) &&
          Deno.env.get("NO_COLOR") === undefined &&
          Deno.env.get("TERM") !== "dumb"
        ? "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        : "|/-\\";
      // Layer-local state; each update + synchronous write is one atomic turn,
      // including concurrent staging completions. No queue grows with input.
      let label: ProgressLabel = "Exporting", total = 0, completed = 0;
      let started = 0, lastDraw = -Infinity, frame = 0;
      let visible = false, shipping = false, finished = false, writable = true;
      const write = (text: string) => {
        if (!writable) return;
        try {
          const bytes = new TextEncoder().encode(text);
          let offset = 0;
          while (offset < bytes.length) {
            offset += Deno.stderr.writeSync(bytes.subarray(offset));
          }
        } catch {
          // Cosmetic output must not abort a transaction if the terminal closes.
          // Disable further writes rather than retrying a broken sink forever.
          writable = false;
        }
      };
      const draw = (force = false) => {
        if (finished || !writable) return;
        const time = now();
        if (!force && time - lastDraw < 100) return;
        let columns = 80;
        try {
          columns = Deno.consoleSize().columns || 80;
        } catch {
          // A detached or unsupported terminal has no queryable dimensions.
        }
        // Leave the final column unused to avoid terminal autowrap pending state.
        const width = Math.max(0, columns - 1);
        const elapsedSeconds = Math.max(0, (time - started) / 1000);
        const line = label === "Exporting"
          ? renderProgressBar({ completed, total, elapsedSeconds }, width)
          : renderShippingProgress(
            { total, elapsedSeconds },
            frames[frame++ % frames.length],
            width,
          );
        visible = true;
        lastDraw = time;
        write(`\r\x1b[2K${line}`);
      };
      const finish = () =>
        Effect.sync(() => {
          finished = true;
          shipping = false;
          if (visible) write("\r\x1b[2K");
          visible = false;
        });
      // One scoped ticker, asleep during staging; at most eight ship frames/s.
      yield* Effect.gen(function* () {
        while (!finished && writable) {
          yield* Effect.sleep("125 millis");
          if (shipping) draw();
        }
      }).pipe(Effect.catchCause(() => finish()), Effect.forkScoped);
      yield* Effect.addFinalizer(finish);
      return Progress.of({
        start: (nextLabel, nextTotal) =>
          Effect.sync(() => {
            label = nextLabel;
            total = nextTotal;
            completed = 0;
            started = now();
            shipping = false;
            if (label === "Exporting") draw(true);
          }),
        advance: () =>
          Effect.sync(() => {
            completed++;
            // The final 100% frame bypasses throttling, even for very small runs.
            draw(completed === total);
          }),
        phase: (nextLabel) =>
          Effect.sync(() => {
            label = nextLabel;
            shipping = true;
            draw(true);
          }),
        finish,
      });
    }),
  );
}

const runFlags = {
  ...commonFlags,
  dryRun: boolean("dry-run", "Plan only; no writes"),
  noProgress: boolean(
    "no-progress",
    "Disable stderr TTY progress (also off for --json and --dry-run)",
  ),
  noShip: boolean("no-ship", "Stage only; do not contact destination"),
  keepStaged: boolean("keep-staged", "Keep checksum-verified staged objects"),
  allowPlaintext: boolean(
    "allow-plaintext",
    "Explicitly allow unencrypted export objects",
  ),
  limit: Flag.Int("limit").pipe(
    Flag.optional,
    Flag.withDescription("Process at most N new entries, oldest first"),
  ),
  concurrency: Flag.Int("concurrency").pipe(
    Flag.optional,
    Flag.withDescription("Parallel encoders, default min(CPUs,4); maximum 16"),
  ),
};
type RunFlags = {
  readonly [K in keyof typeof runFlags]: FlagValue<typeof runFlags[K]>;
};
const runExport = Effect.fn("Export.run")(function* (flags: RunFlags) {
  const config = yield* loadConfig(flags);
  const limit = Option.getOrElse(flags.limit, () => Number.MAX_SAFE_INTEGER),
    concurrency = Option.getOrElse(
      flags.concurrency,
      () => Math.min(navigator.hardwareConcurrency || 1, 4),
    );
  if (limit < 1) {
    return yield* Effect.fail(
      new ConfigError({
        key: "limit",
        message: "limit must be a positive integer",
      }),
    );
  }
  if (concurrency < 1 || concurrency > 16) {
    return yield* Effect.fail(
      new ConfigError({
        key: "concurrency",
        message: "concurrency must be between 1 and 16",
      }),
    );
  }
  if (flags.dryRun) {
    const observation = yield* observe(config);
    const newObjects = observation.plans.slice(0, limit).reduce(
      (n, p) => n + p.needed.length,
      0,
    );
    yield* Console.log(
      flags.json
        ? statusJson(observation.counts, newObjects)
        : renderDryRun({ ...observation.counts, newObjects, limit }),
    );
    return;
  }
  yield* requireDestination(config);
  yield* requireEncryption(config, flags.allowPlaintext);
  const progress = Context.get(
    yield* Layer.build(
      !flags.json && !flags.noProgress && Deno.stderr.isTerminal()
        ? Progress.live
        : Progress.noop,
    ),
    Progress,
  );
  const fs = yield* FileSystem,
    ledger = yield* Ledger,
    staging = yield* Staging,
    shipper = yield* Shipper,
    transcoder = yield* Transcoder;
  yield* makePrivateDirectory(config.stateDir);
  yield* lockDirectory(`${config.stateDir}/lock`);
  yield* makePrivateDirectory(config.stagingDir);
  yield* lockDirectory(`${config.stagingDir}/.lock`);
  yield* bindDestination(config);
  yield* staging.recover(config);
  const observation = yield* observe(config),
    plans = observation.plans.slice(0, limit);
  if (plans.length) {
    const encoder = yield* transcoder.identity();
    const appVersion = yield* runProcess("/usr/bin/defaults", [
      "read",
      "/Applications/Hex.app/Contents/Info",
      "CFBundleShortVersionString",
    ]).pipe(
      Effect.map((bytes) =>
        new TextDecoder().decode(bytes).trim() || "unknown"
      ),
      Effect.orElseSucceed(() => "unknown"),
    );
    yield* progress.start("Exporting", plans.length);
    yield* Effect.forEach(
      plans,
      (plan) =>
        staging.stage(plan.entry, plan.needed, { config, encoder, appVersion })
          .pipe(
            Effect.tap(() => progress.advance()),
          ),
      { concurrency },
    );
  }
  const staged = yield* staging.list(config);
  if (
    config.encryption.recipients.length && staged.some((p) =>
      !p.endsWith(".age")
    ) && !flags.allowPlaintext
  ) {
    return yield* Effect.fail(
      new ConfigError({
        key: "stagingDir",
        message:
          "staging contains plaintext objects; isolate them or explicitly pass --allow-plaintext",
      }),
    );
  }
  let receipts: readonly Receipt[] = [];
  if (!flags.noShip && staged.length) {
    // Rebase the count from recordings to the actual objects, including backlog.
    yield* progress.start("Sending to destination", staged.length);
    yield* progress.phase("Sending to destination");
    const hashes = yield* Effect.forEach(
      staged,
      (relative) =>
        hashFile(`${config.stagingDir}/${relative}`).pipe(
          Effect.map((sha256) => ({ path: relative, sha256 })),
        ),
      { concurrency: 1 },
    );
    const verification = yield* shipper.ship(config, new Set(staged));
    // age output is random: after ledger loss, different bytes at the same
    // write-once path are expected. We never have an age identity, so cannot
    // decrypt-and-compare. Trust the destination copy as canonical. This cannot
    // detect destination encrypted-object corruption (accepted limitation).
    const unshipped = pendingReceipts(
      hashes,
      observation.shipped,
      verification.adoptable,
    );
    // Append + fsync ALL receipts before removing anything. A crash after sync
    // leaves shipped paths staged: planning skips them, verification reclassifies
    // them, and this filter avoids duplicate receipts before pruning the leftovers.
    yield* ledger.append(config, unshipped);
    receipts = unshipped;
    for (const object of hashes) {
      // --keep-staged applies only to matching copies, never adopted duplicates.
      if (!flags.keepStaged || verification.adoptable.has(object.path)) {
        yield* fs.remove(`${config.stagingDir}/${object.path}`).pipe(
          ioError("prune verified object"),
        );
      }
    }
  }
  const stagedOnly = flags.noShip
    ? staged.filter((p) => !observation.shipped.has(p))
    : [];
  const encodedThisRun = new Set(plans.map((p) => p.entry.transcript.id)).size;
  const remaining = observation.counts.missingSource + (flags.noShip
    ? new Set([
      ...observation.plans.map((p) => p.entry.transcript.id),
      ...stagedOnly.map((p) => p.split("/")[1]),
    ]).size
    : observation.plans.length - plans.length);
  yield* progress.finish();
  yield* Console.log(
    flags.json
      ? JSON.stringify(runSummary(receipts, encodedThisRun, stagedOnly.length))
      : renderRunSummary(receipts, encodedThisRun, {
        filesStagedOnly: stagedOnly.length,
        remaining,
        noShip: flags.noShip,
      }),
  );
}, Effect.scoped);
const statusCommand = Command.make(
  "status",
  commonFlags,
  (flags) =>
    Effect.gen(function* () {
      const observation = yield* observe(yield* loadConfig(flags));
      yield* Console.log(
        flags.json
          ? statusJson(observation.counts)
          : renderStatus(observation.counts),
      );
      Deno.exitCode = statusExitCode(observation.counts);
    }),
).pipe(
  Command.withDescription(
    "Read-only counts; exits 2 while export work remains",
  ),
);
const verifyCommand = Command.make(
  "verify",
  commonFlags,
  (flags) =>
    Effect.gen(function* () {
      const config = yield* loadConfig(flags);
      yield* requireDestination(config);
      const staged = yield* (yield* Staging).list(config);
      const verification = staged.length
        ? yield* (yield* Shipper).verify(config, new Set(staged))
        : classifyVerification("", new Set());
      const summary = verifySummary(staged.length, verification);
      yield* Console.log(
        flags.json ? JSON.stringify(summary) : renderVerify(summary),
      );
    }),
).pipe(
  Command.withDescription(
    "Checksum-verify currently staged objects only, never pruned objects",
  ),
);
const command = Command.make("df-dictation-archive", runFlags, runExport).pipe(
  Command.withDescription(
    "Export dictations without changing their source stores",
  ),
  Command.withSubcommands([
    Command.make("run", runFlags, runExport),
    statusCommand,
    verifyCommand,
  ]),
);
const services = Layer.mergeAll(
  DictationSource.layer,
  Ledger.layer,
  Staging.layer,
  Transcoder.layer,
  Shipper.layer,
);
if (import.meta.main) {
  // Privacy overrides the generic backstop: raw defects may contain capture data.
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(
      "error uncaught rejection; details withheld to protect capture data",
    );
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(
      "error uncaught exception; details withheld to protect capture data",
    );
    Deno.exit(1);
  });
  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0/NodeServices"
  );
  Command.run(command, { version: "1.0.0", renderErrors: false }).pipe(
    Effect.provide(services),
    Effect.provide(NodeServices.layer),
    Effect.catch((error) =>
      Console.error(
        `error ${
          error instanceof ConfigError || error instanceof StateError ||
            error instanceof SourceError || error instanceof WavError ||
            error instanceof ShipVerifyError || error instanceof ProcessError
            ? error.message
            : "arguments rejected; run df-dictation-archive --help"
        }`,
      ).pipe(Effect.andThen(Effect.sync(() => {
        Deno.exitCode = 1;
      })))
    ),
    Effect.catchCause(() =>
      Console.error(
        "error unexpected runtime failure; details withheld to protect capture data",
      ).pipe(Effect.andThen(Effect.sync(() => {
        Deno.exitCode = 1;
      })))
    ),
    NodeRuntime.runMain({ disableErrorReporting: true }),
  );
}

