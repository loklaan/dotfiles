  canonical({
    host: config.destination.host,
    user: config.destination.user,
    port: config.destination.port,
    path: config.destination.path,
  }).trim();
const quoteShell = (value: string): string =>
  `'${value.replaceAll("'", "'\\''")}'`;
const sshArgs = (d: Configuration["destination"]): readonly string[] => [
  "-o",
  "BatchMode=yes",
  "-o",
  `ConnectTimeout=${d.connectTimeoutSeconds}`,
  "-p",
  String(d.port),
  ...(d.identityFile ? ["-i", d.identityFile] : []),
];
const sshTarget = (d: Configuration["destination"]) =>
  `${d.user ? `${d.user}@` : ""}${d.host}`;
const rsyncArgs = (
  config: Configuration,
  verify: boolean,
): readonly string[] => {
  const d = config.destination;
  return [
    ...(verify ? ["-rnc"] : ["-a", "--ignore-existing", "--partial"]),
    "--itemize-changes",
    "--exclude=/.pending/",
    "--exclude=/.lock/",
    ...(d.host ? ["-e", ["ssh", ...sshArgs(d)].map(quoteShell).join(" ")] : []),
    "--",
    `${config.stagingDir}/`,
    d.host ? `${sshTarget(d)}:${quoteShell(`${d.path}/`)}` : `${d.path}/`,
  ];
};
type VerifyRecord =
  | { readonly _tag: "differs"; readonly path: string }
  | { readonly _tag: "newAtDestination"; readonly path: string }
  | { readonly _tag: "ignorable" }
  | { readonly _tag: "unknown" };
const parseVerifyLine = (line: string): VerifyRecord => {
  // -rnc emits 7 attribute columns in macOS openrsync (protocol 29),
  // 10 in Homebrew rsync 3.4.1 (9 in earlier rsync 3.x). Never trim paths.
  const fields =
    /^([<>.c])([fd])(\+{7}|\+{9}|\+{10}|[.c][.s][.tT](?:\.{4}|\.{6}|\.{7})) (.+)$/
      .exec(line);
  if (!fields) return { _tag: "unknown" };
  const [, update, kind, attributes, path] = fields;
  if (/[\p{Cc}\p{Cf}]/u.test(path)) return { _tag: "unknown" };
  if (kind === "d" && (update === "c" || update === ".")) {
    return { _tag: "ignorable" };
  }
  if (kind !== "f" || update === "c") return { _tag: "unknown" };
  if (attributes.startsWith("+")) {
    return update === "."
      ? { _tag: "unknown" }
      : { _tag: "newAtDestination", path };
  }
  if (attributes[0] === "c" || attributes[1] === "s") {
    return { _tag: "differs", path };
  }
  return { _tag: "ignorable" };
};
const classifyVerification = (
  output: string,
  staged: ReadonlySet<string>,
) => {
  const adoptable = new Set<string>();
  let conflicts = 0, newAtDestination = 0, unknown = 0;
  // Only the record terminator is discarded; blank/malformed records fail closed.
  const lines = output === "" ? [] : output.replace(/\n$/, "").split("\n");
  for (const line of lines) {
    Match.value(parseVerifyLine(line)).pipe(
      Match.tag("differs", ({ path }) => {
        if (
          objectPattern.test(path) && path.endsWith(".age") && staged.has(path)
        ) {
          adoptable.add(path);
        } else conflicts++;
      }),
      Match.tag("newAtDestination", () => {
        newAtDestination++;
      }),
      Match.tag("unknown", () => {
        unknown++;
      }),
      Match.tag("ignorable", () => undefined),
      Match.exhaustive,
    );
  }
  const blocking = conflicts + newAtDestination + unknown;
  return {
    differences: adoptable.size + blocking,
    adoptable,
    blocking,
    conflicts,
    newAtDestination,
    unknown,
  };
};
const requireVerified = (
  result: ReturnType<typeof classifyVerification>,
): Effect.Effect<ReturnType<typeof classifyVerification>, ShipVerifyError> =>
  result.blocking
    ? Effect.fail(
      new ShipVerifyError({ ...result, adoptable: result.adoptable.size }),
    )
    : Effect.succeed(result);
const pendingReceipts = (
  objects: readonly Stored[],
  shipped: ReadonlySet<string>,
  adoptable: ReadonlySet<string>,
): readonly Receipt[] =>
  objects.filter((object) => !shipped.has(object.path)).map((object) =>
    adoptable.has(object.path) ? { path: object.path, adopted: true } : object
  );
