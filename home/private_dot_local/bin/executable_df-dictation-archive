const fixtureId = "00000000-0000-4000-8000-000000000001";
const floatWav = (extraChunk: boolean): Uint8Array => {
  const bytes = new Uint8Array(44 + (extraChunk ? 12 : 0) + 160 * 4);
  const view = new DataView(bytes.buffer), text = new TextEncoder();
  bytes.set(text.encode("RIFF"));
  view.setUint32(4, bytes.length - 8, true);
  bytes.set(text.encode("WAVEfmt "), 8);
  view.setUint32(16, 16, true);
  view.setUint16(20, 3, true);
  view.setUint16(22, 1, true);
  view.setUint32(24, 16000, true);
  view.setUint32(28, 64000, true);
  view.setUint16(32, 4, true);
  view.setUint16(34, 32, true);
  if (extraChunk) {
    bytes.set(text.encode("FLLR"), 36);
    view.setUint32(40, 4, true);
  }
  const data = extraChunk ? 48 : 36;
  bytes.set(text.encode("data"), data);
  view.setUint32(data + 4, 640, true);
  for (let i = 0; i < 160; i++) {
    view.setFloat32(data + 8 + i * 4, Math.sin(i / 5) * 0.1, true);
  }
  return bytes;
};
const assert = (condition: boolean, message = "assertion failed"): void => {
  if (!condition) throw new Error(message);
};
