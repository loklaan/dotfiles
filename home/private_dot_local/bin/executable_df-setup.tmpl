const main = (
  probeOnly: boolean,
): Effect.Effect<ProcessExitCode, never, DoctorServices> =>
  Effect.gen(function* () {
  const bws = yield* checkBwsToken;
  if (probeOnly) {
    return bws.exitCode;
  }

  yield* detectColorSupport;
{{- if eq .machineProfile "work" }}

  const hasGhAuth = yield* checkGhAuth;
  const workMissing = yield* checkWorkConfig;
  const tokenPath = yield* bwsTokenPath;

  yield* printStatus(bws.state, hasGhAuth, workMissing);
  yield* printInstructions(bws.state, tokenPath, hasGhAuth, workMissing);
{{- else }}
  const tokenPath = yield* bwsTokenPath;
  yield* printStatus(bws.state);
  yield* printInstructions(bws.state, tokenPath);
{{- end }}
  return 0;
  });

class ProbeExit extends Error {
  override readonly name = "ProbeExit";
  override readonly [Runtime.errorExitCode]: 1 | 2;
  override readonly [Runtime.errorReported] = false;

  constructor(exitCode: 1 | 2) {
    super(`BWS probe exited with code ${exitCode}`);
    this[Runtime.errorExitCode] = exitCode;
  }
}

const setupCommand = Command.make(
  "df-setup",
  { probeBws: probeBwsFlag },
  ({ probeBws }) =>
    main(probeBws).pipe(
      Effect.flatMap((code) =>
        code === 0 ? Effect.void : Effect.fail(new ProbeExit(code))
      ),
    ),
).pipe(Command.withDescription(DESCRIPTION));

if (import.meta.main) {
  // Last-resort backstop: catch anything that escapes the Effect runtime
  // (raw node-stream callbacks, forked-fiber defects, unhandled rejections).
  // NodeRuntime.runMain does NOT install these (only SIGINT/SIGTERM) — verified
  // against effect-smol source. Inside import.meta.main so `deno test` stays hermetic.
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(`error uncaught: ${event.message}`);
    Deno.exit(1);
  });

  // Keep the live Node runtime out of permission-free unit tests.
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0-rc.117/NodeServices"
  );
  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0-rc.117/NodeRuntime"
  );

  Command.run(setupCommand, { version: "0.0.0" }).pipe(
    Effect.provide(NodeServices.layer),
    NodeRuntime.runMain,
  );
}

