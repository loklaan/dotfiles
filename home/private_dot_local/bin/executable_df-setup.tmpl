const printEffectReferenceHealth = (): Effect.Effect<
  void,
  never,
  ChildProcessSpawner.ChildProcessSpawner
> =>
  Effect.gen(function* () {
    const health = yield* effectReferenceHealth;
    effectReferenceConverged = health.state === "current";
    printPlain();
    if (effectReferenceConverged) {
      print("green", [], `  ✓ Effect v4 reference (${health.version})`);
      print("white", ["dim"], `    Mise-owned source at ${health.commit.slice(0, 12)}`);
      return;
    }
    print("yellow", [], `  ✗ Effect v4 reference (${health.state})`);
    print("white", ["dim"], "    Run: mise run effect-v4:install");
  });

const printLifecycleHealth = (): Effect.Effect<void, never, DoctorServices> =>
  Effect.gen(function* () {
    const health = yield* skillsHealth;
    skillsConverged = health.state === "converged" || health.state === "disabled";
    printPlain();
    const symbol = health.state === "converged"
      ? "✓"
      : health.state === "disabled"
      ? "⋯"
      : "✗";
    const color: Color = health.state === "converged"
      ? "green"
      : health.state === "disabled"
      ? "white"
      : "yellow";
    print(color, [], `  ${symbol} Skills (${health.state})`);
    print("white", ["dim"], `    ${health.detail}`);
    if (health.manifest !== null) {
      print("white", ["dim"], `    Manifest schema 2: ${health.manifest}`);
    }
    if (health.boundary !== null) {
      print("white", ["dim"], `    Boundary: ${health.boundary}`);
    }
    if (health.action !== null) {
      print("white", ["dim"], `    ${health.action}`);
    }
  });

