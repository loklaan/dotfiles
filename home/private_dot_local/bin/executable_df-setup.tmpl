#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --allow-run=tput,{{ .chezmoi.homeDir }}/.local/bin/df-effect-v4-reference,{{ .chezmoi.homeDir }}/.local/bin/df-skills{{ if lookPath "bws" }},bws{{ end }}{{ if lookPath "mise" }},mise{{ end }}{{ if lookPath "pitchfork" }},pitchfork{{ end }}{{ if lookPath "curl" }},curl{{ end }}{{ if lookPath "gh" }},gh{{ end }}{{ if lookPath "chezmoi" }},chezmoi{{ end }}{{ if lookPath "hostname" }},hostname{{ end }}{{ if lookPath "pgrep" }},pgrep{{ end }} --allow-read --allow-env

// deno-fmt-ignore-file
// df-setup — dotfiles health-check doctor (Deno + Effect v4).
//
// `--probe-bws` returns 0=ok, 1=missing, 2=invalid; `chezmoi-preflight.sh`
// depends on these exit codes, so keep them and the output/prose stable.

import {
  Config,
  Effect,
  Layer,
  Runtime,
  Schema,
  Sink,
  Stream,
} from "npm:effect@4.0.0-rc.117";
import * as FileSystem from "npm:effect@4.0.0-rc.117/FileSystem";
import { Command, Flag } from "npm:effect@4.0.0-rc.117/unstable/cli";
import {
  ChildProcess,
  ChildProcessSpawner,
} from "npm:effect@4.0.0-rc.117/unstable/process";

const DESCRIPTION = `Checks dotfiles configuration status and prints instructions for
  completing setup. Run it after an initial dotfiles installation.`;

const bwsTokenPath: Effect.Effect<string> = Effect.gen(function* () {
  const home = yield* Config.String("HOME").pipe(Config.withDefault(""), Effect.orElseSucceed(() => ""));
  return `${home}/.config/chezmoi/secrets/bws-access-token.txt`;
});
// Canary secret used to probe BWS token validity. Any live secret ID works;
// GitHub auth token is present on all machines (personal and work) in this
// repo's Bitwarden project.
const BWS_PROBE_SECRET_ID = "{{ dig "bwsIdGithubAuthToken" "" . }}";

type BwsState = "ok" | "missing" | "invalid-auth" | "invalid-unknown";
type ProbeResult =
  | { readonly state: "ok"; readonly exitCode: 0 }
  | { readonly state: "missing"; readonly exitCode: 1 }
  | {
    readonly state: "invalid-auth" | "invalid-unknown";
    readonly exitCode: 2;
  };

interface RunResult {
  readonly ok: boolean;
  readonly code: number;
  readonly stdout: string;
  readonly stderr: string;
}

type DoctorServices =
  | FileSystem.FileSystem
  | ChildProcessSpawner.ChildProcessSpawner;
type ProcessExitCode = 0 | 1 | 2;

type Color = "red" | "green" | "yellow" | "cyan" | "white";
type Style = "bold" | "dim";

const RESET = "\x1b[0m";
const COLORS: Record<Color, string> = {
  red: "31",
  green: "32",
  yellow: "33",
  cyan: "36",
  white: "37",
};

let colorSupport: boolean | undefined;
let skillsConverged = true;
let effectReferenceConverged = true;

const supportedColors = (): boolean => colorSupport ?? false;

const colorize = (color: Color, styles: readonly Style[], text: string): string => {
  if (!supportedColors()) return text;
  const code = [COLORS[color], ...styles.map((style) => style === "bold" ? "1" : "2")]
    .join(";");
  return `\x1b[${code}m${text}${RESET}`;
};

const print = (color: Color, styles: readonly Style[], text: string): void => {
  console.log(colorize(color, styles, text));
};

const printPlain = (text = ""): void => {
  console.log(text);
};

const probeBwsFlag = Flag.Boolean("probe-bws").pipe(
  Flag.withDescription(
    "Probe BWS token validity and exit 0=ok, 1=missing, 2=invalid",
  ),
  Flag.withDefault(false),
);

const run = (
  cmd: string,
  args: readonly string[],
  options: Partial<{ env: Record<string, string> }> = {},
): Effect.Effect<RunResult, never, ChildProcessSpawner.ChildProcessSpawner> =>
  Effect.gen(function* () {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const handle = yield* spawner.spawn(
      ChildProcess.make(cmd, args, {
        env: options.env,
        extendEnv: true,
        stdin: "inherit",
        stdout: "pipe",
        stderr: "pipe",
      }),
    );
    const collected = yield* Effect.all({
      stdout: handle.stdout.pipe(
        Stream.decodeText(),
        Stream.runFold(() => "", (output, chunk) => output + chunk),
      ),
      stderr: handle.stderr.pipe(
        Stream.decodeText(),
        Stream.runFold(() => "", (output, chunk) => output + chunk),
      ),
      code: handle.exitCode,
    }, { concurrency: "unbounded" });
    const code = Number(collected.code);
    return {
      ok: code === 0,
      code,
      stdout: collected.stdout,
      stderr: collected.stderr,
    };
  }).pipe(
    Effect.scoped,
    Effect.orElseSucceed((): RunResult => ({
      ok: false,
      code: 127,
      stdout: "",
      stderr: "",
    })),
  );

const detectColorSupport: Effect.Effect<
  void,
  never,
  ChildProcessSpawner.ChildProcessSpawner
> = run("tput", ["colors"]).pipe(
  Effect.map((result) => {
    const colors = Number(result.stdout.trim());
    colorSupport = result.ok && Number.isFinite(colors) && colors > 8;
  }),
);

const fileExists = (
  path: string,
): Effect.Effect<boolean, never, FileSystem.FileSystem> =>
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    const info = yield* fs.stat(path);
    return info.type === "File";
  }).pipe(Effect.orElseSucceed(() => false));

const pathExists = (
  path: string,
): Effect.Effect<boolean, never, FileSystem.FileSystem> =>
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    yield* fs.stat(path);
    return true;
  }).pipe(Effect.orElseSucceed(() => false));

const hasCommand = (
  cmd: string,
): Effect.Effect<boolean, never, FileSystem.FileSystem> =>
  Effect.gen(function* () {
    if (cmd.includes("/")) return yield* pathExists(cmd);
    const pathEnv = yield* Config.String("PATH").pipe(Config.withDefault(""), Effect.orElseSucceed(() => ""));
    for (const dir of pathEnv.split(":")) {
      if (dir === "") continue;
      if (yield* pathExists(`${dir}/${cmd}`)) return true;
    }
    return false;
  }).pipe(Effect.orElseSucceed(() => false));

const readTextFile = (
  path: string,
): Effect.Effect<string | null, never, FileSystem.FileSystem> =>
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    return yield* fs.readFileString(path);
  }).pipe(Effect.orElseSucceed(() => null));

const parseJson = (text: string | null): unknown => {
  if (text === null) return null;
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
};

interface EffectReferenceHealth {
  readonly state: string;
  readonly version: string;
  readonly commit: string;
}

const effectReferenceHealth: Effect.Effect<
  EffectReferenceHealth,
  never,
  ChildProcessSpawner.ChildProcessSpawner
> = Effect.gen(function* () {
  const result = yield* run("{{ .chezmoi.homeDir }}/.local/bin/df-effect-v4-reference", ["status"]);
  const parsed = parseJson(result.stdout);
  const entry = parsed !== null && typeof parsed === "object" && !Array.isArray(parsed)
    ? parsed as Record<string, unknown>
    : {};
  return {
    state: typeof entry.state === "string" ? entry.state : "unavailable",
    version: typeof entry.version === "string" ? entry.version : "unknown",
    commit: typeof entry.commit === "string" ? entry.commit : "unknown",
  };
});

const SkillBoundary = Schema.Struct({
  healthy: Schema.NullOr(Schema.Boolean),
  error: Schema.NullOr(Schema.String),
  message: Schema.NullOr(Schema.String),
});
const SkillObservation = Schema.Struct({
  manifestDigest: Schema.NullOr(Schema.String),
  sources: Schema.Record(Schema.String, SkillBoundary),
  providers: Schema.Record(Schema.String, SkillBoundary),
  registry: SkillBoundary,
  packages: SkillBoundary,
  reference: SkillBoundary,
  pendingOwnership: Schema.Unknown,
  healthy: Schema.Boolean,
});
type SkillObservation = typeof SkillObservation.Type;
type SkillBoundary = typeof SkillBoundary.Type;
type SkillsState = "converged" | "disabled" | "stale" | "pending-recovery" | "invalid" | "unavailable";
interface SkillsHealth {
  readonly state: SkillsState;
  readonly detail: string;
  readonly action: string | null;
  readonly manifest: string | null;
  readonly boundary: string | null;
}

const disabledSkillsHealth: SkillsHealth = {
  state: "disabled",
  detail: "No schema-2 skills manifest is projected on this machine",
  action: null,
  manifest: null,
  boundary: null,
};
const decodeSkillObservation = (text: string): SkillObservation | null => {
  try {
    return Schema.decodeUnknownSync(Schema.fromJsonString(SkillObservation))(text, {
      onExcessProperty: "error",
    });
  } catch {
    return null;
  }
};
const firstSkillBoundary = (
  observation: SkillObservation,
): readonly [string, SkillBoundary] | null => {
  if (observation.pendingOwnership !== null) {
    return ["ownership", {
      healthy: false,
      error: "PendingProvider",
      message: "A provider ownership transition is incomplete",
    }];
  }
  for (const [group, statuses] of [
    ["sources", observation.sources],
    ["providers", observation.providers],
  ] as const) {
    for (const id of Object.keys(statuses).sort()) {
      if (statuses[id].healthy === false) return [`${group}/${id}`, statuses[id]];
    }
  }
  for (const [boundary, status] of [
    ["registry", observation.registry],
    ["packages", observation.packages],
    ["reference", observation.reference],
  ] as const) {
    if (status.healthy === false) return [boundary, status];
  }
  return null;
};
const isProviderBoundary = (boundary: string): boolean =>
  boundary === "provider" || boundary === "providers" || boundary.startsWith("providers/");
const isSourceBoundary = (boundary: string): boolean =>
  boundary === "source" || boundary === "sources" || boundary.startsWith("sources/");
const classifySkillObservation = (
  observation: SkillObservation,
): SkillsHealth => {
  const failed = firstSkillBoundary(observation);
  const expectedHealthy = failed === null;
  if (observation.healthy !== expectedHealthy) {
    return {
      state: "invalid",
      detail: "The observe envelope contradicts its boundary statuses",
      action: "Run: df-skills observe; inspect the machine-readable envelope",
      manifest: observation.manifestDigest,
      boundary: "envelope",
    };
  }
  if (failed === null) {
    return {
      state: "converged",
      detail: "Sources, providers, registry links, and packages are healthy",
      action: null,
      manifest: observation.manifestDigest,
      boundary: null,
    };
  }
  const [boundary, status] = failed;
  const unavailable = status.error === "NotFound" &&
      (isProviderBoundary(boundary) || isSourceBoundary(boundary)) ||
    isProviderBoundary(boundary) && [
      "ExecutableMissing",
      "ExecutableChanged",
      "VersionMismatch",
      "CommandFailed",
      "CommandTimeout",
      "OutputLimit",
      "ObservationInvalid",
    ].includes(status.error ?? "");
  const state: SkillsState = boundary === "ownership"
    ? "pending-recovery"
    : unavailable
    ? "unavailable"
    : "stale";
  const action = boundary === "ownership"
    ? "Run: df-skills reconcile"
    : isSourceBoundary(boundary)
    ? "Restore the declared source through chezmoi, then run: df-skills observe"
    : isProviderBoundary(boundary)
    ? "Correct the provider contract or executable, then run: df-skills reconcile"
    : boundary === "registry"
    ? "Run: df-skills reconcile"
    : boundary === "packages"
    ? "Run: df-skills package"
    : "Run: mise run effect-v4:install";
  return {
    state,
    detail: `${status.error ?? "Unhealthy"}: ${status.message ?? "The boundary is not healthy"}`,
    action,
    manifest: observation.manifestDigest,
    boundary,
  };
};
const classifyObservedSkills = (
  observed: RunResult,
  observation: SkillObservation,
): SkillsHealth => observed.ok === observation.healthy
  ? classifySkillObservation(observation)
  : {
    state: "invalid",
    detail: "The df-skills exit code contradicts its observe envelope",
    action: "Run: df-skills observe; inspect the exit code and machine-readable envelope",
    manifest: observation.manifestDigest,
    boundary: "exit",
  };
const failedSkillsHealth = (observed: RunResult): SkillsHealth => {
  const failure = parseJson(observed.stderr);
  const record = failure !== null && typeof failure === "object" && !Array.isArray(failure)
    ? failure as Record<string, unknown>
    : {};
  const error = typeof record.error === "string" ? record.error : observed.code === 127 ? "ExecutableMissing" : "ObservationInvalid";
  const boundary = typeof record.boundary === "string" ? record.boundary : "runtime";
  const message = typeof record.message === "string" ? record.message : "df-skills did not return a valid observe envelope";
  const missingTool = error === "ExecutableMissing" || error === "RuntimeUnavailable";
  const unavailable = missingTool || error === "NotFound" &&
    (isProviderBoundary(boundary) || isSourceBoundary(boundary));
  return {
    state: unavailable ? "unavailable" : "invalid",
    detail: `${error}: ${message}`,
    action: missingTool
      ? "Install df-skills, then rerun: df-setup"
      : isProviderBoundary(boundary)
      ? "Correct the provider contract or executable, then run: df-skills reconcile"
      : isSourceBoundary(boundary)
      ? "Restore the declared source through chezmoi, then run: df-skills observe"
      : boundary === "manifest"
      ? "Correct the projected schema-2 manifest, then run: chezmoi diff"
      : "Run: df-skills observe; inspect the machine-readable failure",
    manifest: null,
    boundary,
  };
};
const skillsHealth: Effect.Effect<SkillsHealth, never, DoctorServices> = Effect.gen(function* () {
  const home = yield* Config.String("HOME").pipe(Config.withDefault(""), Effect.orElseSucceed(() => ""));
  const root = yield* Config.String("DF_SETUP_SKILLS_ROOT").pipe(Config.withDefault(home), Effect.orElseSucceed(() => home));
  const stateHome = root === home
    ? yield* Config.String("XDG_STATE_HOME").pipe(Config.withDefault(`${root}/.local/state`), Effect.orElseSucceed(() => `${root}/.local/state`))
    : `${root}/.local/state`;
  const manifestPath = `${root}/.config/dotfiles/skill-lifecycle.json`;
  const stateDir = `${stateHome}/dotfiles/skill-lifecycle`;
  const skillsPath = `${root}/.agents/skills`;
  if (!(yield* pathExists(manifestPath))) return disabledSkillsHealth;
  const observed = yield* run("{{ .chezmoi.homeDir }}/.local/bin/df-skills", ["observe", "--manifest", manifestPath, "--state-dir", stateDir, "--skills-path", skillsPath, "--package-dir", `${root}/.cache/claude-skill-packs`]);
  const observation = decodeSkillObservation(observed.stdout);
  return observation === null
    ? failedSkillsHealth(observed)
    : classifyObservedSkills(observed, observation);
});

const trimAllWhitespace = (value: string): string => value.replace(/\s/g, "");

// Probes the BWS token by fetching a canary secret. Returns:
//   0  — token file present AND server accepts it (ok)
//   1  — token file missing (missing)
//   2  — token file present AND server rejects it (invalid)
const checkBwsToken: Effect.Effect<ProbeResult, never, DoctorServices> = Effect.gen(function* () {
  const tokenPath = yield* bwsTokenPath;
  if (!(yield* fileExists(tokenPath))) {
    return { state: "missing", exitCode: 1 } as const;
  }

  if (!(yield* hasCommand("bws"))) {
    return { state: "missing", exitCode: 1 } as const;
  }

  const token = trimAllWhitespace((yield* readTextFile(tokenPath)) ?? "");
  if (token === "") {
    return { state: "missing", exitCode: 1 } as const;
  }

  // Pass the token via BWS_ACCESS_TOKEN env (never argv) so it cannot leak
  // through `ps`/procfs to other local users (CWE-214).
  const probe = yield* run("bws", ["secret", "get", BWS_PROBE_SECRET_ID], {
    env: { BWS_ACCESS_TOKEN: token },
  });

  if (probe.ok) return { state: "ok", exitCode: 0 } as const;

  if (
    /invalid_client|401 Unauthorized|403 Forbidden|not in a valid format|Error decoding base64/
      .test(probe.stderr)
  ) {
    return { state: "invalid-auth", exitCode: 2 } as const;
  }
  return { state: "invalid-unknown", exitCode: 2 } as const;
});

{{- if and (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) (dig "openCodeServer" false .) }}

const checkOpencodeServe: Effect.Effect<boolean, never, DoctorServices> = Effect.gen(function* () {
  const pitchfork = (yield* hasCommand("pitchfork"))
