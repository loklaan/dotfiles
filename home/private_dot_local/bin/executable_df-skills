const replace = (input: unknown, path: string, value: unknown): unknown => {
  const [key, ...rest] = path.split(".");
  // deno-fmt-ignore
  const next = (child: unknown) => rest.length ? replace(child, rest.join("."), value) : value;
  if (Array.isArray(input)) {
    return input.map((child, index) =>
      String(index) === key ? next(child) : child
    );
  }
  assert.ok(Schema.is(Schema.JsonObject)(input));
  return { ...input, [key]: next(input[key]) };
};
const expect = async (
  schema: Schema.ConstraintDecoder<unknown>,
  input: unknown,
  ok = false,
) => {
  const before = structuredClone(input);
  const result: ContractResult<unknown> = await Effect.runPromise(
    decodeContract(schema, input).pipe(Effect.result),
  );
  assert.equal(result._tag, ok ? "Success" : "Failure");
  assert.deepEqual(input, before);
  // deno-fmt-ignore
  if (result._tag === "Failure") assert.ok(Schema.isSchemaError(result.failure)); else assert.deepEqual(result.success, input);
};
// deno-fmt-ignore
const paths = (input: unknown, prefix = ""): string[] => input === null || typeof input !== "object" ? [] : Object.entries(input).flatMap(([key, value]) => { const path = prefix ? `${prefix}.${key}` : key; return [path, ...paths(value, path)]; });
