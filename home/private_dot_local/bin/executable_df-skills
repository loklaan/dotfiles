type Diagnostic =
  | keyof typeof messages
  | readonly [error: string, message: string];
const codes: Partial<Record<keyof typeof messages, string>> = {
  DanglingPath: "UnsafePath",
  SourceMissing: "NotFound",
  SkillMissing: "NotFound",
  ProviderMissing: "NotFound",
};
const issue = (value: Diagnostic) =>
  typeof value === "string"
    ? { error: codes[value] ?? value, message: messages[value] }
    : { error: value[0], message: value[1] };
export const referenceStateStatus = (
  state: typeof ReferenceObservation.Type["state"],
) =>
  state === "current" ? true : {
    missing: issue("ReferenceMissing"),
    stale: issue("ReferenceStale"),
    invalid: issue("ReferenceInvalid"),
  }[state];
const receiptStatus = (receipt: Receipt, current: string | null) =>
  current === null || receipt.manifestDigest === current
    ? null
    : issue("ReceiptStale");
const fault = (value: Diagnostic, boundary = "filesystem", cause?: unknown) =>
  new BoundaryError({ ...issue(value), boundary, cause });
type BoundaryCause =
  | Schema.SchemaError
  | Config.ConfigError
  | PlatformError.PlatformError
  | BoundaryError;
const guarded = (boundary: string) =>
  Effect.mapError((cause: BoundaryCause) => {
    const error = cause instanceof BoundaryError
      ? cause.error
      : cause._tag === "SchemaError"
      ? "ContractInvalid"
      : cause._tag === "ConfigError"
      ? "ConfigMissing"
      : cause.reason._tag;
    const message = cause instanceof BoundaryError
      ? cause.message
      : `${boundary}: ${error}; inspect the private input and read permissions`;
    return new BoundaryError({ boundary, error, message, cause });
  });
const absent = Effect.catch((error: PlatformError.PlatformError) =>
  error.reason._tag === "NotFound" ? Effect.succeed(null) : Effect.fail(error)
);
function* physical(target: string, type: "File" | "Directory", mode?: number) {
  yield* decodeContract(Path, target);
  const fs = yield* FileSystem;
  const path = yield* PathService;
  let cursor = target;
  while (true) {
    const info = yield* fs.stat(cursor).pipe(absent);
    if (info !== null) {
      if ((yield* fs.realPath(cursor)) !== cursor) {
        return yield* fault("UnsafePath");
      }
      if (info.type !== (cursor === target ? type : "Directory")) {
        return yield* fault([
          "FileType",
          `Expected a physical ${type.toLowerCase()}`,
        ]);
      }
      if (cursor !== target) return null;
      if (mode !== undefined && (info.mode & 0o7777) !== mode) {
        return yield* fault([
          "FileMode",
          `Expected mode ${mode.toString(8)}`,
        ]);
      }
      return info;
    }
    const parent = path.dirname(cursor);
    const names = yield* fs.readDirectory(parent).pipe(absent);
    if (names?.includes(path.basename(cursor))) {
      return yield* fault("DanglingPath");
    }
    cursor = parent;
  }
}
export const loadDocument = <
  Contract extends Schema.ConstraintDecoder<unknown>,
>(
  schema: Contract,
  target: string,
) =>
  Effect.gen(function* () {
    const info = yield* physical(target, "File", 0o600);
    if (info === null) return null;
    if (info.size > 1048576n) return yield* fault("FileTooLarge");
    const fs = yield* FileSystem;
    const chunks = yield* fs.stream(target, { bytesToRead: 1048577 }).pipe(
      Stream.runCollect,
    );
    const bytes = Uint8Array.from(chunks.flatMap((chunk) => [...chunk]));
    if (bytes.length > 1048576) return yield* fault("FileTooLarge");
    const text = yield* Effect.try({
      try: () => new TextDecoder("utf-8", { fatal: true }).decode(bytes),
      catch: (cause) => fault("EncodingInvalid", "filesystem", cause),
    });
    return yield* decodeContract(Schema.fromJsonString(schema), text);
  });
export const digest = Effect.fn(function* (value: Schema.Json) {
  const crypto = yield* Crypto.Crypto;
  const bytes = yield* crypto.digest(
    "SHA-256",
    new TextEncoder().encode(canonical(value)),
  );
  return bytes.toHex();
});
const digestBytes = Effect.fn(function* (value: Uint8Array | string) {
  const bytes = typeof value === "string"
    ? new TextEncoder().encode(value)
    : value;
  return (yield* (yield* Crypto.Crypto).digest("SHA-256", bytes)).toHex();
});
const collisionKey = (name: string) =>
  name.normalize("NFKC").toLocaleLowerCase("en-US");
export const collisions = (
  desired: readonly string[],
  live: readonly string[],
) => {
  const pairs: Array<readonly [string, string]> = [];
  for (const wanted of desired) {
    for (const name of live) {
      if (wanted !== name && collisionKey(wanted) === collisionKey(name)) {
        pairs.push([wanted, name]);
      }
    }
  }
  return pairs.sort(([left], [right]) => left.localeCompare(right));
};
const SkillMetadata = Struct({ name: Schema.String });
const safeLogicalName = (name: string) =>
  name !== "." && name !== ".." && name.normalize("NFC") === name &&
  !/[\\/\p{Cc}\p{Cf}]/u.test(name);
export const parseSkill = Effect.fn(function* (text: string) {
  if (!text.startsWith("---\n")) {
    return yield* fault("SkillInvalid", "sources");
  }
  const closing = text.indexOf("\n---\n", 4);
  if (closing < 0 || closing > 65536) {
    return yield* fault("SkillInvalid", "sources");
  }
  const yaml = text.slice(4, closing);
  if (yaml.split("\n").filter((line) => /^name\s*:/.test(line)).length !== 1) {
    return yield* fault("SkillInvalid", "sources");
  }
  const metadata = yield* Effect.try({
    try: () => parseYaml(yaml),
    catch: (cause) => fault("SkillInvalid", "sources", cause),
  }).pipe(
    Effect.flatMap((value) =>
      Schema.decodeUnknownEffect(SkillMetadata)(value).pipe(
        Effect.mapError((cause) => fault("SkillInvalid", "sources", cause)),
      )
    ),
  );
  if (!safeLogicalName(metadata.name)) {
    return yield* fault("SkillInvalid", "sources");
  }
  return { name: metadata.name, closing };
});
const renameFrontmatter = Effect.fn(function* (
  text: string,
  from: string,
  to: string,
) {
  const metadata = yield* parseSkill(text);
  if (metadata.name !== from) return yield* fault("SkillInvalid", "sources");
  const lines = text.slice(4, metadata.closing).split("\n");
  const index = lines.findIndex((line) => /^name\s*:/.test(line));
  lines[index] = `name: ${to}`;
  return `---\n${lines.join("\n")}${text.slice(metadata.closing)}`;
});
type Locations = Readonly<
  Record<
    "manifest" | "stateDir" | "skillsPath" | "packageDir" | "reference",
    string
  >
>;
type Active = {
  readonly manifest: Manifest;
  readonly receipt: Receipt;
  readonly manifestDigest: string | null;
};
const unowned = (manifestDigest: string): Receipt => ({
  schema: 1,
  manifestDigest,
  links: {},
  providers: {},
  packages: {},
  pendingPublication: null,
  pendingProvider: null,
});
function* loadActive(locations: Locations) {
  const manifest = yield* loadDocument(Manifest, locations.manifest).pipe(
    guarded("manifest"),
  );
  const manifestDigest = manifest === null
    ? null
    : yield* digest(manifest).pipe(guarded("manifest"));
  const path = yield* PathService;
  const receipt = manifest === null ? null : yield* Effect.gen(function* () {
    yield* physical(locations.stateDir, "Directory", 0o700);
    return yield* loadDocument(
      Receipt,
      path.join(locations.stateDir, "receipt.json"),
    );
  }).pipe(guarded("receipt"));
  return {
    manifest: manifest ?? empty,
    manifestDigest,
    receipt: receipt ?? unowned(manifestDigest ?? "0".repeat(64)),
  } satisfies Active;
}
type Status = true | null | Readonly<ReturnType<typeof issue>>;
const okay = (status: Status): status is true | null =>
  status === true || status === null;
const renderStatus = (status: Status) =>
  okay(status)
    ? { healthy: status, error: null, message: null } as const
    : { healthy: false, error: status.error, message: status.message } as const;
type RenderedHealth = Readonly<{ healthy: boolean | null }>;
export const reconcileHealthy = (
  observation: Readonly<{
    sources: Readonly<Record<string, RenderedHealth>>;
    providers: Readonly<Record<string, RenderedHealth>>;
    registry: RenderedHealth;
    pendingOwnership: unknown | null;
  }>,
) =>
  observation.pendingOwnership === null &&
  [
    ...Object.values(observation.sources),
    ...Object.values(observation.providers),
    observation.registry,
  ]
    .every(({ healthy }) => healthy !== false);
type ReadStatus = Effect.fn.Return<
  Status,
  BoundaryCause,
  | FileSystem
  | PathService
  | Crypto.Crypto
  | ChildProcessSpawner.ChildProcessSpawner
>;
const observe = (boundary: string, inspect: () => ReadStatus) =>
  Effect.gen(inspect).pipe(
    guarded(boundary),
    Effect.catch(Effect.succeed),
  );
const survey = <Entry extends { readonly id: string }>(
  boundary: string,
  entries: readonly Entry[],
  inspect: (entry: Entry) => ReadStatus,
) =>
  Effect.forEach(
    entries,
    (entry) =>
      observe(boundary, () => inspect(entry)).pipe(
        Effect.map((status) => [entry.id, status] as const),
      ),
    { concurrency: 4 },
  ).pipe(Effect.map(Object.fromEntries));
const inventory = <Entry extends { readonly id: string }, Previous>(
  entries: readonly Entry[],
  previous: Readonly<Record<string, Previous>>,
) => {
  const desired = new Map(entries.map((entry) => [entry.id, entry]));
  const owned = new Map(Object.entries(previous));
  return [...new Set([...desired.keys(), ...owned.keys()])].sort().map((
    id,
  ) => ({ id, desired: desired.get(id), owned: owned.get(id) }));
};
type Provider = typeof Provider.Type;
type ProviderReceipt = typeof ProviderReceipt.Type;
type Direct = typeof Direct.Type;
type Execution = Direct & { readonly acceptFailure?: boolean };
const same = (left: readonly string[], right: readonly string[]) =>
  canonical(left.toSorted()) === canonical(right.toSorted());
export const bindCall = (
  command: Direct,
  executable: string,
  value = "",
): Direct => ({
  ...command,
  argv: [
    executable,
    ...command.argv.slice(1).map((arg) => arg.startsWith("{") ? value : arg),
  ],
});
export const selectOutput = Effect.fn(
  function* (selector: string, document: Schema.Json) {
    yield* decodeContract(Selector, selector);
    const [collection] = selector.split(" | map(");
    const fields = collection === "." || selector.startsWith("[")
      ? []
      : collection.slice(1).split(".");
    const property = (value: Schema.Json, key: string): Schema.Json =>
      Schema.is(Schema.JsonObject)(value) && Object.hasOwn(value, key)
        ? value[key]
        : null;
    let selected = fields.reduce(property, document);
    const output = selector.match(/\| \.([A-Za-z_][A-Za-z0-9_-]*)[\])]$/) ??
      selector.match(/map\(\.([A-Za-z_][A-Za-z0-9_-]*)\)$/);
    if (output) {
      if (!Array.isArray(selected)) {
        return yield* fault("ObservationInvalid", "providers");
      }
      const predicate = selector.match(
        /select\(\.([A-Za-z_][A-Za-z0-9_-]*)(?: == (.*))?\) \|/,
      );
      const expected = predicate?.[2] === undefined
        ? true
        : yield* decodeContract(
          Schema.fromJsonString(Schema.Json),
          predicate[2],
        );
      selected = selected.filter((entry) =>
        !predicate || property(entry, predicate[1]) === expected
      )
        .map((entry) => property(entry, output[1]));
    }
    return (yield* decodeContract(Observed, selected)).toSorted();
  },
  Effect.mapError((cause) => fault("ObservationInvalid", "providers", cause)),
);
const environmentKeys = [
  "HOME",
  "PATH",
  "TMPDIR",
  "LANG",
  "LC_ALL",
  "XDG_CONFIG_HOME",
  "XDG_DATA_HOME",
  "XDG_STATE_HOME",
  "XDG_CACHE_HOME",
];
const childEnvironment = Effect.gen(function* () {
  const entries = yield* Effect.forEach(
    environmentKeys,
    (key) =>
      Config.String(key).pipe(
        Config.withDefault(""),
        Effect.map((value) => [key, value] as const),
      ),
  );
  return Object.fromEntries(entries.filter(([, value]) => value !== ""));
});
const terminate = (child: ChildProcessSpawner.ChildProcessHandle) =>
  Effect.gen(function* () {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const signal = (name: string) =>
      spawner.exitCode(
        ChildProcess.make("/bin/kill", ["-s", name, "--", String(-child.pid)], {
          stdin: "ignore",
          stdout: "ignore",
          stderr: "ignore",
          shell: false,
          extendEnv: false,
          env: {},
        }),
      ).pipe(Effect.timeout("1 second"));
    yield* signal("TERM");
    yield* Effect.sleep("50 millis");
    yield* signal("KILL");
    if (yield* child.isRunning) {
      yield* child.exitCode.pipe(Effect.timeout("1 second"));
    }
  });
export const execute = (
  command: Execution,
  boundary = "providers",
  cwd = "",
) =>
  Effect.gen(function* () {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const env = yield* childEnvironment;
    const child = yield* Effect.gen(function* () {
      const process = ChildProcess.make(
        command.argv[0],
        command.argv.slice(1),
        {
          stdin: "ignore",
          stdout: "pipe",
          stderr: "pipe",
          shell: false,
          detached: true,
          extendEnv: false,
          env,
          forceKillAfter: "250 millis",
        },
      );
      const handle = yield* spawner.spawn(
        cwd ? process.pipe(ChildProcess.setCwd(cwd)) : process,
      );
      yield* Effect.addFinalizer(() => terminate(handle).pipe(Effect.orDie));
      return handle;
    }).pipe(Effect.uninterruptible);
    let bytes = 0;
    const consume = (stream: typeof child.stdout, collect: boolean) => {
      const decoder = new TextDecoder("utf-8", { fatal: true });
      return Stream.runFoldEffect(stream, () =>
        "", (text, chunk) =>
        Effect.gen(function* () {
          bytes += chunk.length;
          if (bytes > command.maxOutputBytes) {
            return yield* fault("OutputLimit", boundary);
          }
          return collect
            ? text + (yield* Effect.try({
              try: () =>
                decoder.decode(chunk, { stream: true }),
              catch: (cause) => fault("EncodingInvalid", boundary, cause),
            }))
            : "";
        })).pipe(Effect.flatMap((text) =>
          Effect.try({
            try: () =>
              text + (collect ? decoder.decode() : ""),
            catch: (cause) => fault("EncodingInvalid", boundary, cause),
          })
        ));
    };
    const [stdout, , code] = yield* Effect.all([
      consume(child.stdout, true),
      consume(child.stderr, false),
      child.exitCode,
    ], { concurrency: 3 });
    if (code !== 0 && !command.acceptFailure) {
      return yield* fault([
        "CommandFailed",
        `Command exited with code ${Number(code)}; output and argv suppressed`,
      ], boundary);
    }
    return stdout;
  }).pipe(
    Effect.timeout(command.timeoutSeconds * 1000),
    Effect.catchTag("TimeoutError", (cause) =>
      Effect.fail(fault("CommandTimeout", boundary, cause))),
    Effect.scoped,
    guarded(boundary),
  );
const executableDigest = Effect.fn(function* (
  executable: string,
  boundary = "providers",
) {
  yield* decodeContract(Executable, executable);
  const info = yield* physical(executable, "File");
  if (!info || !(info.mode & 0o111)) {
    return yield* fault("ProviderMissing", boundary);
  }
  if (info.size > 536870912n) {
    return yield* fault("ExecutableChanged", boundary);
  }
  const fs = yield* FileSystem;
  const crypto = yield* Crypto.Crypto;
  return (yield* crypto.digest("SHA-256", yield* fs.readFile(executable)))
    .toHex();
});
export const executableTargetAllowed = (root: string, target: string) =>
  root !== "/" && target.startsWith(`${root}/`);
const resolveExecutable = Effect.fn(function* (
  name: string,
  boundary = "providers",
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const captured = yield* Config.String("DF_SKILLS_PINS").pipe(
    Config.withDefault(""),
  );
  const pins = captured
    ? yield* decodeContract(
      Schema.fromJsonString(Schema.Record(Path, Digest)),
      captured,
    )
    : null;
  if (name.startsWith("/")) {
    const digest = yield* executableDigest(name, boundary);
    if (pins && pins[name] !== digest) {
      return yield* fault("ExecutableChanged", boundary);
    }
    return { path: name, digest };
  }
  const search = yield* Config.String("PATH");
  for (
    const directory of search.split(":").filter((part) => part.startsWith("/"))
  ) {
    const physicalDirectory = yield* fs.realPath(directory).pipe(absent);
    if (physicalDirectory === null) continue;
    const candidate = path.join(directory, name);
    const info = yield* fs.stat(candidate).pipe(absent);
    if (info?.type === "File" && (info.mode & 0o111)) {
      const resolved = yield* fs.realPath(candidate);
      const root = path.dirname(physicalDirectory);
      if (!executableTargetAllowed(root, resolved)) {
        return yield* fault("UnsafePath", boundary);
      }
      const digest = yield* executableDigest(resolved, boundary);
      if (pins && pins[resolved] !== digest) {
        return yield* fault("ExecutableChanged", boundary);
      }
      return { path: resolved, digest };
    }
  }
  return yield* fault("ProviderMissing", boundary);
});
const verifyExecutable = (executable: ProviderReceipt["executable"]) =>
  executableDigest(executable.path).pipe(
    Effect.flatMap((digest) =>
      digest === executable.digest
        ? Effect.void
        : Effect.fail(fault("ExecutableChanged", "providers"))
    ),
  );
const observeProvider = Effect.fn(
  function* (record: ProviderReceipt) {
    yield* verifyExecutable(record.executable);
    const output = yield* execute(record.observe);
    const document = yield* decodeContract(
      Schema.fromJsonString(Schema.Json),
      output,
    ).pipe(
      Effect.mapError((cause) =>
        fault("ObservationInvalid", "providers", cause)
      ),
    );
    if (record.identity !== undefined) {
      if (
        !Schema.is(Schema.JsonObject)(document) ||
        !Schema.is(Safe)(document.identity)
      ) {
        return yield* fault("IdentityUnavailable", "providers");
      }
      if (document.identity !== record.identity) {
        return yield* fault("IdentityMismatch", "providers");
      }
    }
    return yield* selectOutput(record.observe.selector, document);
  },
);
const prepareProvider = Effect.fn(
  function* (
    desired: Provider | undefined,
    previous: ProviderReceipt | undefined,
  ) {
    if (previous) yield* verifyExecutable(previous.executable);
    if (!desired) {
      if (!previous) return yield* fault("ProviderMissing", "providers");
      return { record: previous, current: yield* observeProvider(previous) };
    }
    const resolved = yield* resolveExecutable(desired.lock.executable);
    if (
      previous &&
      (previous.executable.path !== resolved.path ||
        previous.executable.digest !== resolved.digest ||
        previous.kind !== desired.kind)
    ) {
      return yield* fault("ExecutableChanged", "providers");
    }
    const version = (yield* execute(bindCall(desired.version, resolved.path)))
      .trim();
    if (
      version !== desired.lock.version ||
      (previous && version !== previous.executable.version)
    ) return yield* fault("VersionMismatch", "providers");
    const record: ProviderReceipt = previous ?? {
      kind: desired.kind,
      ...(desired.lock.identity === undefined
        ? {}
        : { identity: desired.lock.identity }),
      executable: { ...resolved, version },
      observe: {
        ...bindCall(desired.observe, resolved.path),
        selector: desired.observe.selector,
      },
      owned: {},
    };
    if (
      previous &&
      (previous.identity !== desired.lock.identity ||
        canonical(previous.observe) !==
          canonical({
            ...bindCall(desired.observe, resolved.path),
            selector: desired.observe.selector,
          }))
    ) {
      return yield* fault([
        "RecoveryChanged",
        "Restore the captured observation and identity contract before reconciliation",
      ], "providers");
    }
    const current = yield* observeProvider(record);
    if (
      desired.kind === "pack" && desired.exclusive &&
      current.some((id) =>
        !desired.items.some((item) => item.id === id) &&
        !Object.hasOwn(record.owned, id)
      )
    ) return yield* fault("ExclusiveConflict", "providers");
    return { record, current };
  },
);
export class OperationLock extends Context.Service<OperationLock, {
  readonly acquire: (
    path: string,
  ) => Effect.Effect<void, BoundaryError, Scope.Scope>;
}>()("df-skills/OperationLock") {
  static readonly layer = Layer.succeed(OperationLock, {
    acquire: (path) =>
      Effect.gen(function* () {
        const file = yield* Effect.acquireRelease(
          Effect.try({
            try: () =>
              Deno.openSync(path, {
                read: true,
                write: true,
                create: true,
                mode: 0o600,
              }),
            catch: (cause) =>
              fault(
                ["LockOpen", "Cannot open the private operation lock"],
                "receipt",
                cause,
              ),
          }),
          (handle) => Effect.sync(() => handle.close()),
        );
        const acquired = yield* Effect.try({
          try: () => file.tryLockSync(true),
          catch: (cause) => fault("ReceiptBusy", "receipt", cause),
        });
        const info = yield* Effect.try({
          try: () => file.statSync(),
          catch: (cause) => fault("UnsafePath", "receipt", cause),
        });
        if (
          !info.isFile || info.mode === null || (info.mode & 0o7777) !== 0o600
        ) {
          return yield* fault([
            "FileMode",
            "Expected private operation lock mode 600",
          ], "receipt");
        }
        if (!acquired) return yield* fault("ReceiptBusy", "receipt");
      }),
  });
}
export const removeArchivePath = (target: string, recursive = false) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    yield* fs.remove(target, recursive ? { recursive: true } : undefined);
  }).pipe(
    Effect.mapError((cause) => fault("ArchiveChanged", "sources", cause)),
  );
const receiptBytes = (receipt: Receipt) =>
  new TextEncoder().encode(canonical(receipt));
export const receiptWriteRequired = (current: Uint8Array, receipt: Receipt) => {
  const next = receiptBytes(receipt);
  return current.length !== next.length ||
    current.some((byte, index) => byte !== next[index]);
};
const writeReceipt = (root: string, receipt: Receipt) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    const target = `${root}/receipt.json`, temporary = `${root}/.receipt.tmp`;
    yield* decodeContract(Receipt, receipt);
    const bytes = receiptBytes(receipt);
    if (bytes.length > 1048576) return yield* fault("FileTooLarge", "receipt");
    const existing = yield* physical(target, "File", 0o600);
    if (
      existing !== null &&
      !receiptWriteRequired(yield* fs.readFile(target), receipt)
    ) {
      return false;
    }
    yield* Effect.acquireUseRelease(
      fs.open(temporary, { flag: "wx", mode: 0o600 }),
      (file) =>
        file.writeAll(bytes).pipe(
          Effect.andThen(file.sync),
          Effect.andThen(fs.rename(temporary, target)),
        ),
      () => fs.remove(temporary, { force: true }).pipe(Effect.orDie),
    );
    const directory = yield* fs.open(root, { flag: "r" });
    yield* directory.sync;
    return true;
  }).pipe(Effect.scoped, guarded("receipt"));
export const finishPending = (
  receipt: Receipt,
  actual: readonly string[],
): Receipt => {
  const pending = receipt.pendingProvider;
  if (!pending) return receipt;
  const record = receipt.providers[pending.providerId];
  const owned = Object.fromEntries(
    Object.entries(record.owned).filter(([id]) => actual.includes(id)),
  );
  return {
    ...receipt,
    pendingProvider: null,
    providers: {
      ...receipt.providers,
      [pending.providerId]: { ...record, owned },
    },
  };
};
export const providerRecovery = (
  pending: NonNullable<Receipt["pendingProvider"]>,
  current: readonly string[],
) =>
  pending.phase === "achieved"
    ? same(current, pending.expected) ? "finish" : "blocked"
    : pending.itemId !== null && same(current, pending.expected)
    ? "finish"
    : same(current, pending.startedFrom)
    ? "retry"
    : "blocked";
const validateLocations = Effect.fn(function* (locations: Locations) {
  const path = yield* PathService;
  yield* physical(locations.manifest, "File", 0o600);
  yield* physical(locations.stateDir, "Directory", 0o700);
  yield* physical(locations.skillsPath, "Directory");
  yield* physical(locations.packageDir, "Directory", 0o700);
  if (locations.reference) yield* decodeContract(Path, locations.reference);
  yield* physical(
    path.join(locations.stateDir, "operation.lock"),
    "File",
    0o600,
  );
});
const reconcileProviders = (
  locations: Locations,
  options: { readonly locked?: boolean; readonly commitManifest?: boolean } =
    {},
) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    if (!options.locked) {
      yield* physical(locations.stateDir, "Directory", 0o700);
      yield* fs.makeDirectory(locations.stateDir, {
        recursive: true,
        mode: 0o700,
      });
      const lockPath = `${locations.stateDir}/operation.lock`;
      yield* physical(lockPath, "File", 0o600);
      yield* (yield* OperationLock).acquire(lockPath);
      const temporary = `${locations.stateDir}/.receipt.tmp`;
      if (yield* physical(temporary, "File", 0o600)) {
        yield* fs.remove(temporary);
      }
    }
    const active = yield* loadActive(locations);
    let receipt = active.receipt;
    const statuses: Record<string, Status> = {};
    const save = (next: Receipt) =>
      writeReceipt(locations.stateDir, next).pipe(
        Effect.tap(() =>
          Effect.sync(() => {
            receipt = next;
          })
        ),
      );
    const pending = receipt.pendingProvider;
    let refreshedProvider: string | null = null;
    if (pending) {
      const recovered = yield* Effect.gen(function* () {
        let current = yield* observeProvider(
          receipt.providers[pending.providerId],
        );
        const recovery = providerRecovery(pending, current);
        if (recovery === "blocked") {
          return yield* fault("ObservationMismatch", "providers");
        }
        if (recovery === "finish" && pending.phase === "not-achieved") {
          yield* save({
            ...receipt,
            pendingProvider: { ...pending, phase: "achieved" },
          });
        } else if (recovery === "retry") {
          const result = yield* execute(pending.command).pipe(Effect.result);
          current = yield* observeProvider(
            receipt.providers[pending.providerId],
          );
          if (!same(current, pending.expected)) {
            return yield* fault("ObservationMismatch", "providers");
          }
          if (result._tag === "Failure" && pending.itemId === null) {
            return yield* result.failure;
          }
          yield* save({
            ...receipt,
            pendingProvider: { ...pending, phase: "achieved" },
          });
          if (result._tag === "Failure") return yield* result.failure;
        }
        if (!same(current, pending.expected)) {
          return yield* fault("ObservationMismatch", "providers");
        }
        yield* save(finishPending(receipt, current));
        if (pending.itemId === null) refreshedProvider = pending.providerId;
      }).pipe(guarded("providers"), Effect.result);
      if (recovered._tag === "Failure") {
        statuses[pending.providerId] = recovered.failure;
      }
    }
    for (
      const { id, desired, owned: previous } of inventory(
        active.manifest.providers,
        receipt.providers,
      )
    ) {
      if (Object.hasOwn(statuses, id)) continue;
      statuses[id] = yield* Effect.gen(function* () {
        const prepared = yield* prepareProvider(desired, previous);
        let { record, current } = prepared;
        const mutate = (
          command: Direct,
          action: NonNullable<Receipt["pendingProvider"]>["action"],
          itemId: string | null,
        ) =>
          Effect.gen(function* () {
            if (receipt.pendingProvider !== null) {
              return yield* fault("PendingProvider", "providers");
            }
            const startedFrom = current;
            const expected = itemId === null
              ? current
              : current.filter((entry) => entry !== itemId);
            if (action === "enable" || action === "install") {
              expected.push(itemId ?? "");
            }
            yield* verifyExecutable(record.executable);
            yield* save({
              ...receipt,
              providers: { ...receipt.providers, [id]: record },
              pendingProvider: {
                providerId: id,
                itemId,
                action,
                phase: "not-achieved",
                command,
                startedFrom,
                expected: expected.toSorted(),
              },
            });
            const result = yield* execute(command).pipe(Effect.result);
            current = yield* observeProvider(record);
            if (!same(current, expected)) {
              return yield* fault("ObservationMismatch", "providers");
            }
            if (result._tag === "Failure" && itemId === null) {
              return yield* result.failure;
            }
            yield* save({
              ...receipt,
              pendingProvider: {
                providerId: id,
                itemId,
                action,
                phase: "achieved",
                command,
                startedFrom,
                expected: expected.toSorted(),
              },
            });
            yield* save(finishPending(receipt, current));
            record = receipt.providers[id];
            if (result._tag === "Failure") return yield* result.failure;
            if (!same(current, expected)) {
              return yield* fault("ObservationMismatch", "providers");
            }
          });
        const wanted = desired?.items.map((item) => item.id) ?? [];
        const expected = [
          ...new Set([
            ...current.filter((item) => !Object.hasOwn(record.owned, item)),
            ...wanted,
          ]),
        ];
        if (desired?.kind === "command" && refreshedProvider !== id) {
          yield* mutate(
            bindCall(desired.sync, record.executable.path),
            "sync",
            null,
          );
        }
        for (const [itemId, entry] of Object.entries(record.owned)) {
          if (wanted.includes(itemId)) continue;
          if (current.includes(itemId)) {
            yield* mutate(
              entry.remove,
              record.kind === "command" ? "disable" : "remove",
              itemId,
            );
          } else {
            record = {
              ...record,
              owned: Object.fromEntries(
                Object.entries(record.owned).filter(([id]) => id !== itemId),
              ),
            };
            yield* save({
              ...receipt,
              providers: { ...receipt.providers, [id]: record },
            });
          }
        }
        if (desired) {
          for (const item of desired.items) {
            if (current.includes(item.id)) continue;
            const remove = desired.kind === "command"
              ? bindCall(desired.disable, record.executable.path, item.id)
              : bindCall(desired.remove, record.executable.path, item.removeAs);
            record = {
              ...record,
              owned: { ...record.owned, [item.id]: { remove } },
            };
            const command = desired.kind === "command"
              ? bindCall(desired.enable, record.executable.path, item.id)
              : bindCall(desired.install, record.executable.path, item.source);
            yield* mutate(
              command,
              desired.kind === "command" ? "enable" : "install",
              item.id,
            );
          }
        }
        if (
          desired?.kind === "pack" && desired.exclusive && wanted.length &&
          refreshedProvider !== id
        ) {
          yield* mutate(
            bindCall(desired.update, record.executable.path),
            "update",
            null,
          );
        }
        current = yield* observeProvider(record);
        if (!same(current, expected)) {
          return yield* fault("ObservationMismatch", "providers");
        }
        if (!desired) {
          yield* save({
            ...receipt,
            providers: Object.fromEntries(
              Object.entries(receipt.providers).filter(([key]) => key !== id),
            ),
          });
        }
        return true as const;
      }).pipe(guarded("providers"), Effect.catch(Effect.succeed));
    }
    if (
      options.commitManifest !== false && Object.values(statuses).every(okay) &&
      active.manifestDigest !== null
    ) {
      const next = { ...receipt, manifestDigest: active.manifestDigest };
      if (canonical(next) !== canonical(active.receipt)) {
        yield* save(next);
      }
    }
    return { active: { ...active, receipt }, statuses };
  }).pipe(Effect.scoped, guarded("receipt"));
const reconcileAll = (locations: Locations) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    yield* physical(locations.stateDir, "Directory", 0o700);
    yield* fs.makeDirectory(locations.stateDir, {
      recursive: true,
      mode: 0o700,
    });
    const lockPath = `${locations.stateDir}/operation.lock`;
    yield* physical(lockPath, "File", 0o600);
    yield* (yield* OperationLock).acquire(lockPath);
    const temporary = `${locations.stateDir}/.receipt.tmp`;
    if (yield* physical(temporary, "File", 0o600)) yield* fs.remove(temporary);
    const files = yield* reconcileFiles(locations);
    const providers = yield* reconcileProviders(locations, {
      locked: true,
      commitManifest: false,
    });
    const statuses = { ...files.statuses, ...providers.statuses };
    let active = providers.active;
    if (
      Object.values(statuses).every(okay) && active.manifestDigest !== null &&
      active.receipt.manifestDigest !== active.manifestDigest
    ) {
      const receipt = {
        ...active.receipt,
        manifestDigest: active.manifestDigest,
      };
      yield* writeReceipt(locations.stateDir, receipt);
      active = { ...active, receipt };
    }
    return {
      active,
      statuses,
      fileStatuses: files.statuses,
      providerStatuses: providers.statuses,
    };
  }).pipe(Effect.scoped, guarded("receipt"));
export const runPaths = (paths: readonly string[]) =>
  paths.length ? [...new Set([...paths, "/bin/kill"])].sort() : [];
export const packageArchiveName = (logical: string) => {
  if (
    logical.normalize("NFC") !== logical || logical.length > 128 ||
    logical === "." || logical === ".." || /[\/\\\p{Cc}]/u.test(logical)
  ) return null;
  const safe = (logical.startsWith("lochy:") ? logical.slice(6) : logical)
    .toLocaleLowerCase("en-US").replaceAll("claude", "cc")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  return safe && safe.length <= 64 ? `${safe}.zip` : null;
};
export const packageArchiveOwned = (
  packageDir: string,
  id: string,
  archive: string,
) => archive === `${packageDir}/${packageArchiveName(id) ?? ""}`;
export const packageStageOwned = (name: string) =>
  /^\.df-skills-package-[A-Za-z0-9:._-]+-[A-Za-z0-9]{6}$/.test(name);
export const packageIds = (manifest: Manifest, receipt: Receipt) =>
  [...manifest.links, ...manifest.archives].filter((entry) =>
    entry.package && receipt.links[entry.id]?.target === entry.target
  ).map((entry) => entry.id).sort();
export const packageAction = (
  desired: string | undefined,
  owned:
    | Readonly<
      Pick<typeof PackageReceipt.Type, "contentDigest" | "archiveDigest">
    >
    | undefined,
  live: string | null,
) => {
  if (desired === undefined) {
    return owned
      ? (live === null || live === owned.archiveDigest ? "remove" : "blocked")
      : "unchanged";
  }
  if (live === null) return "build";
  if (!owned || live !== owned.archiveDigest) return "blocked";
  return desired === owned.contentDigest ? "unchanged" : "build";
};
export const packageEntryAllowed = (relative: string) =>
  relative.split("/").every((name) => {
    const lower = name.toLocaleLowerCase("en-US");
    return name !== "." && name !== ".." && name.normalize("NFC") === name &&
      !/[:\\\p{Cc}\p{Cf}]/u.test(name) && !lower.startsWith(".git") &&
      ![
        ".hg",
        ".svn",
        ".bzr",
        ".ssh",
        ".gnupg",
        ".aws",
        ".azure",
        ".kube",
        ".docker",
        ".netrc",
        ".npmrc",
        ".pypirc",
        ".ds_store",
        ".skills-cli.json",
      ].includes(lower) &&
      lower !== ".env" && !lower.startsWith(".env.") &&
      !/^(?:credentials?|secrets?)(?:\..+)?$/.test(lower) &&
      !/^(?:id_rsa|id_dsa|id_ecdsa|id_ed25519)(?:\.pub)?$/.test(lower) &&
      !/\.(?:key|pem|p12|pfx)$/.test(lower);
  });
export const archiveEntriesAllowed = (
  safe: string,
  names: readonly string[],
) => {
  const keys = new Set<string>();
  return names.length > 0 && names.every((name) => {
    const relative = name.endsWith("/") ? name.slice(0, -1) : name;
    const valid = (relative === safe || relative.startsWith(`${safe}/`)) &&
      !relative.startsWith("/") &&
      packageEntryAllowed(relative) && !keys.has(collisionKey(relative));
    keys.add(collisionKey(relative));
    return valid;
  });
};
const permissionGate = (
  active: Active,
  packaging = false,
  reference = false,
) =>
  Effect.gen(function* () {
    const paths: string[] = [];
    const pins: Record<string, string> = {};
    for (
      const { desired, owned } of inventory(
        active.manifest.providers,
        active.receipt.providers,
      )
    ) {
      const resolved = yield* Effect.gen(function* () {
        if (owned) {
          yield* verifyExecutable(owned.executable);
          paths.push(owned.executable.path);
        }
        if (desired) {
          const resolved = yield* resolveExecutable(desired.lock.executable);
          paths.push(resolved.path);
          pins[resolved.path] = resolved.digest;
        }
      }).pipe(guarded("providers"), Effect.result);
      if (resolved._tag === "Failure") continue;
    }
    if (
      active.manifest.links.some((entry) =>
        "source" in entry && entry.source?.kind === "git"
      )
    ) {
      const resolved = yield* resolveExecutable("git", "sources").pipe(
        Effect.result,
      );
      if (resolved._tag === "Success") {
        paths.push(resolved.success.path);
        pins[resolved.success.path] = resolved.success.digest;
      }
    }
    if (packaging && packageIds(active.manifest, active.receipt).length) {
      for (const helper of ["zip", "unzip"]) {
        const resolved = yield* resolveExecutable(helper, "packages");
        paths.push(resolved.path);
        pins[resolved.path] = resolved.digest;
      }
    }
    if (reference) {
      const resolved = yield* resolveExecutable(
        "df-effect-v4-reference",
        "reference",
      );
      paths.push(resolved.path);
      pins[resolved.path] = resolved.digest;
    }
    const grants = runPaths(paths);
    const permission = (command: string) =>
      Deno.permissions.querySync({ name: "run", command }).state === "granted";
    const captured = yield* Config.String("DF_SKILLS_PINS").pipe(
      Config.withDefault(""),
    );
    if (captured || !permission(Deno.execPath())) {
      if (grants.every(permission)) return null;
      return yield* fault("PermissionMissing", "runtime");
    }
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    const path = yield* PathService;
    const child = yield* spawner.spawn(ChildProcess.make(Deno.execPath(), [
      "run",
      "--no-prompt",
      "--allow-read",
      "--allow-write",
      "--allow-env",
      "--allow-sys=uid",
      ...(grants.length ? [`--allow-run=${grants.join(",")}`] : []),
      yield* path.fromFileUrl(new URL(import.meta.url)).pipe(
        Effect.mapError((cause) => fault("UnsafePath", "runtime", cause)),
      ),
      ...Deno.args,
    ], {
      stdin: "ignore",
      stdout: "inherit",
      stderr: "inherit",
      shell: false,
      detached: true,
      extendEnv: false,
      env: {
        ...yield* childEnvironment,
        DENO_NO_PACKAGE_JSON: "1",
        DF_SKILLS_PINS: JSON.stringify(pins),
      },
    }));
    yield* Effect.addFinalizer(() => terminate(child).pipe(Effect.orDie));
    return Number(yield* child.exitCode);
  }).pipe(Effect.scoped, guarded("runtime"));
const failures = (
  boundary: string,
  checks: Iterable<readonly [string | null, Status]>,
) =>
  [...checks].flatMap(([id, status]) => {
    if (okay(status)) return [];
    const { error, message } = status;
    return [{ boundary, id, error, message }];
  });
export const linkAction = (
  target: string | undefined,
  owned: string | undefined,
  live: string | null,
) => {
  if (live === null) {
    return target ? "creates" : owned ? "removes" : "unchanged";
  }
  if (owned !== undefined && live === target) {
    return owned === target ? "unchanged" : "replaces";
  }
  if (live !== owned) return "blocked";
  return target === undefined
    ? "removes"
    : live === target
    ? "unchanged"
    : "replaces";
};
export const treeAction = (
  desired: string | undefined,
  owned: string | undefined,
  live: string | null,
) => {
  if (live === null) return desired ? "creates" : "unchanged";
  if (owned === undefined) return "blocked";
  if (live !== owned) return "blocked";
  return desired === undefined
    ? "removes"
    : desired === live
    ? "unchanged"
    : "replaces";
};
type TreeEntry = typeof OwnedTreeEntry.Type;
type TreeSnapshot = Readonly<{
  contentDigest: string;
  ownershipDigest: string;
  entries: readonly TreeEntry[];
}>;
const ordered = <Value extends { readonly relative: string }>(
  values: readonly Value[],
) => values.toSorted((left, right) => left.relative < right.relative ? -1 : 1);
const decodeText = (bytes: Uint8Array) =>
  Effect.try({
    try: () => new TextDecoder("utf-8", { fatal: true }).decode(bytes),
    catch: (cause) => fault("EncodingInvalid", "sources", cause),
  });
const snapshotTree = Effect.fn(function* (
  root: string,
  frontmatter?: string,
  omitGitMetadata = false,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const rootInfo = yield* physical(root, "Directory");
  if (rootInfo === null) return yield* fault("SourceMissing", "sources");
  const entries: TreeEntry[] = [{
    relative: ".",
    kind: "directory",
    mode: frontmatter === undefined ? rootInfo.mode & 0o777 : 0o700,
    digest: null,
  }];
  const pending = [{ directory: root, relative: "" }];
  let count = 0, total = 0;
  while (pending.length) {
    const next = pending.pop();
    if (!next) break;
    const keys = new Set<string>();
    for (const name of (yield* fs.readDirectory(next.directory)).toSorted()) {
      if (omitGitMetadata && next.relative === "" && name === ".git") continue;
      const key = collisionKey(name);
      if (
        keys.has(key) || name === "." || name === ".." ||
        name.normalize("NFC") !== name || /[\\/\p{Cc}\p{Cf}]/u.test(name)
      ) return yield* fault("TreeInvalid", "sources");
      keys.add(key);
      const target = path.join(next.directory, name);
      const info = yield* fs.stat(target).pipe(absent);
      if (info === null || (yield* fs.realPath(target)) !== target) {
        return yield* fault("TreeInvalid", "sources");
      }
      const relative = next.relative ? `${next.relative}/${name}` : name;
      count += 1;
      if (count > 4096) return yield* fault("TreeInvalid", "sources");
      if (info.type === "Directory") {
        entries.push({
          relative,
          kind: "directory",
          mode: info.mode & 0o777,
          digest: null,
        });
        pending.push({ directory: target, relative });
        continue;
      }
      if (info.type !== "File" || info.size > 16777216n) {
        return yield* fault("TreeInvalid", "sources");
      }
      total += Number(info.size);
      if (total > 67108864) return yield* fault("TreeInvalid", "sources");
      const replacement = relative === "SKILL.md" ? frontmatter : undefined;
      entries.push({
        relative,
        kind: "file",
        mode: replacement === undefined ? info.mode & 0o777 : 0o644,
        digest: yield* digestBytes(replacement ?? (yield* fs.readFile(target))),
      });
    }
  }
  const sorted = ordered(entries);
  const files = sorted.filter((entry) => entry.kind === "file").map((
    entry,
  ) => ({
    relative: entry.relative,
    digest: entry.digest,
    mode: entry.mode,
  }));
  return {
    contentDigest: yield* digestBytes(JSON.stringify(files)),
    ownershipDigest: yield* digestBytes(JSON.stringify(sorted)),
    entries: sorted,
  } satisfies TreeSnapshot;
});
const skillText = Effect.fn(function* (root: string) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const target = path.join(root, "SKILL.md");
  const info = yield* physical(target, "File");
  if (info === null || info.size > 16777216n) {
    return yield* fault("SkillMissing", "sources");
  }
  return yield* decodeText(yield* fs.readFile(target));
});
type FileEntry = Manifest["links"][number] | Manifest["archives"][number];
type Prepared = Readonly<{
  entry: FileEntry;
  snapshot: TreeSnapshot;
  frontmatter?: string;
}>;
const gitOutput = Effect.fn(function* (
  entry: Manifest["links"][number],
  args: readonly string[],
) {
  const git = yield* resolveExecutable("git", "sources");
  return (yield* execute({
    argv: [git.path, "-C", entry.target, ...args],
    timeoutSeconds: 30,
    maxOutputBytes: 1048576,
  })).trim();
});
const inspectLinkTarget = Effect.fn(function* (
  entry: Manifest["links"][number],
) {
  const text = yield* skillText(entry.target);
  if ((yield* parseSkill(text)).name !== entry.id) {
    return yield* fault("SkillInvalid", "sources");
  }
  if ("source" in entry && entry.source?.kind === "git") {
    if (!entry.source.revision || !entry.source.url) {
      return yield* fault("SourceChanged", "sources");
    }
    const [revision, origin, dirty] = yield* Effect.all([
      gitOutput(entry, ["rev-parse", "HEAD"]),
      gitOutput(entry, ["remote", "get-url", "origin"]),
      gitOutput(entry, ["status", "--porcelain=v1"]),
    ]);
    if (
      revision !== entry.source.revision || origin !== entry.source.url || dirty
    ) return yield* fault("SourceChanged", "sources");
  }
  return {
    entry,
    snapshot: yield* snapshotTree(
      entry.target,
      undefined,
      "source" in entry && entry.source?.kind === "git",
    ),
  } satisfies Prepared;
});
const AcquisitionReceipt = Struct({
  schema: Tag(1),
  sourceId: Id,
  algorithm: Tag("sha256"),
  checksum: Digest,
  contentDigest: Digest,
  ref: Revision,
});
const prepareArchive = Effect.fn(function* (
  entry: Manifest["archives"][number],
) {
  const marker = "/.inputs/";
  const offset = entry.input.lastIndexOf(marker);
  if (offset < 1) return yield* fault("SourceChanged", "sources");
  const receiptPath = `${
    entry.input.slice(0, offset)
  }${marker}.receipts/${entry.id}.json`;
  const acquisition = yield* loadDocument(AcquisitionReceipt, receiptPath);
  if (
    acquisition === null || acquisition.algorithm !== entry.lock.algorithm ||
    acquisition.checksum !== entry.lock.checksum ||
    acquisition.contentDigest !== entry.lock.contentDigest ||
    acquisition.ref !== entry.lock.ref
  ) return yield* fault("SourceChanged", "sources");
  let frontmatter = yield* skillText(entry.input);
  const original = (yield* parseSkill(frontmatter)).name;
  let logical = original;
  for (const transform of entry.transforms) {
    if (transform.kind === "frontmatter-name") {
      frontmatter = yield* renameFrontmatter(
        frontmatter,
        transform.from,
        transform.to,
      );
    } else {
      if (logical !== transform.from) {
        return yield* fault("SkillInvalid", "sources");
      }
      logical = transform.to;
    }
  }
  if (
    (yield* parseSkill(frontmatter)).name !== entry.id || logical !== entry.id
  ) {
    return yield* fault("SkillInvalid", "sources");
  }
  const snapshot = yield* snapshotTree(entry.input, frontmatter);
  if (
    (yield* digestBytes(
      JSON.stringify([[entry.id, snapshot.contentDigest]]),
    )) !==
      entry.lock.contentDigest
  ) return yield* fault("SourceChanged", "sources");
  return { entry, snapshot, frontmatter } satisfies Prepared;
});
const inspectFileEntry = Effect.fn(function* (entry: FileEntry) {
  return "input" in entry
    ? yield* prepareArchive(entry)
    : yield* inspectLinkTarget(entry);
});
type LinkOwnership = typeof LinkReceipt.Type;
const publicationOwnership = (prepared: Prepared): LinkOwnership =>
  "input" in prepared.entry
    ? {
      target: prepared.entry.target,
      contentDigest: prepared.snapshot.ownershipDigest,
      kind: "archive",
      entries: prepared.snapshot.entries,
    }
    : {
      target: prepared.entry.target,
      contentDigest: prepared.snapshot.ownershipDigest,
      kind: "link",
    };
const syncDirectory = (target: string) =>
  Effect.gen(function* () {
    const directory = yield* (yield* FileSystem).open(target, { flag: "r" });
    yield* directory.sync;
  }).pipe(Effect.scoped);
const liveLink = Effect.fn(function* (target: string) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const parent = path.dirname(target), name = path.basename(target);
  if (!(yield* fs.readDirectory(parent)).includes(name)) return null;
  return yield* fs.readLink(target).pipe(
    Effect.mapError((cause) => fault("UnownedLink", "registry", cause)),
  );
});
const publishLink = Effect.fn(function* (
  root: string,
  id: string,
  target: string,
  owned: LinkOwnership | undefined,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const link = path.join(root, id);
  const temporary = path.join(root, `.df-skills-link-${id}`);
  const live = yield* liveLink(link);
  if (live === target) {
    const staged = yield* liveLink(temporary).pipe(Effect.result);
    if (staged._tag === "Success" && staged.success === target) {
      yield* fs.remove(temporary);
    }
    return;
  }
  if (live !== null && live !== owned?.target) {
    return yield* fault(owned ? "ChangedLink" : "UnownedLink", "registry");
  }
  const staged = yield* liveLink(temporary).pipe(Effect.result);
  if (staged._tag === "Failure") return yield* staged.failure;
  if (staged.success !== null && staged.success !== target) {
    return yield* fault("ChangedLink", "registry");
  }
  if (staged.success === null) yield* fs.symlink(target, temporary);
  yield* fs.rename(temporary, link);
  yield* syncDirectory(root);
});
const removeLink = Effect.fn(function* (
  root: string,
  id: string,
  owned: LinkOwnership,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const link = path.join(root, id);
  const live = yield* liveLink(link);
  if (live === null) return;
  if (live !== owned.target) return yield* fault("ChangedLink", "registry");
  yield* fs.remove(link);
  yield* syncDirectory(root);
});
const snapshotAt = (target: string) =>
  Effect.gen(function* () {
    const info = yield* (yield* FileSystem).stat(target).pipe(absent);
    return info === null ? null : yield* snapshotTree(target);
  });
const treeAt = (target: string) =>
  snapshotAt(target).pipe(Effect.map((tree) => tree?.ownershipDigest ?? null));
type ArchiveOwnership = Extract<LinkOwnership, { readonly kind: "archive" }>;
export const classifyOwnedTree = (
  actual: TreeSnapshot | null,
  owned: ArchiveOwnership,
) => {
  if (actual === null) return "absent" as const;
  if (actual.ownershipDigest === owned.contentDigest) {
    return "complete" as const;
  }
  const expected = new Set(owned.entries.map((entry) => canonical(entry)));
  return actual.entries.every((entry) => expected.has(canonical(entry)))
    ? "partial" as const
    : "changed" as const;
};
const writeDerivedTree = (
  target: string,
  prepared: Prepared,
) =>
  Effect.gen(function* () {
    if (!("input" in prepared.entry) || prepared.frontmatter === undefined) {
      return yield* fault("ArchiveChanged", "sources");
    }
    const fs = yield* FileSystem;
    const path = yield* PathService;
    const root = prepared.entry.input;
    const rootEntry = prepared.snapshot.entries.find((entry) =>
      entry.relative === "."
    );
    yield* fs.makeDirectory(target, { mode: rootEntry?.mode ?? 0o700 });
    yield* fs.chmod(target, rootEntry?.mode ?? 0o700);
    for (const entry of prepared.snapshot.entries) {
      if (entry.relative === ".") continue;
      const output = path.join(target, entry.relative);
      if (entry.kind === "directory") {
        yield* fs.makeDirectory(output, { mode: entry.mode });
        yield* fs.chmod(output, entry.mode);
        continue;
      }
      const bytes = entry.relative === "SKILL.md"
        ? new TextEncoder().encode(prepared.frontmatter)
        : yield* fs.readFile(path.join(root, entry.relative));
      if ((yield* digestBytes(bytes)) !== entry.digest) {
        return yield* fault("SourceChanged", "sources");
      }
      yield* Effect.gen(function* () {
        const file = yield* fs.open(output, { flag: "wx", mode: entry.mode });
        yield* file.writeAll(bytes);
        yield* file.sync;
      }).pipe(Effect.scoped);
      yield* fs.chmod(output, entry.mode);
    }
    const input = yield* snapshotTree(root, prepared.frontmatter);
    if (
      input.contentDigest !== prepared.snapshot.contentDigest ||
      input.ownershipDigest !== prepared.snapshot.ownershipDigest
    ) return yield* fault("SourceChanged", "sources");
    if ((yield* treeAt(target)) !== prepared.snapshot.ownershipDigest) {
      return yield* fault("ArchiveChanged", "sources");
    }
  }).pipe(Effect.scoped);
const cleanupOwnedTree = Effect.fn(function* (
  target: string,
  owned: ArchiveOwnership,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const actual = yield* snapshotAt(target);
  const state = classifyOwnedTree(actual, owned);
  if (state === "absent") return;
  if (state === "changed") return yield* fault("ArchiveChanged", "sources");
  for (
    const entry of [...(actual?.entries ?? [])].sort((left, right) =>
      right.relative.split("/").length - left.relative.split("/").length ||
      right.relative.localeCompare(left.relative)
    )
  ) {
    if (entry.relative === ".") continue;
    const child = path.join(target, entry.relative);
    const info = yield* fs.stat(child).pipe(absent);
    if (info === null) continue;
    if (
      (yield* fs.realPath(child)) !== child ||
      (info.mode & 0o777) !== entry.mode
    ) {
      return yield* fault("ArchiveChanged", "sources");
    }
    if (
      entry.kind === "file" &&
      (info.type !== "File" ||
        (yield* digestBytes(yield* fs.readFile(child))) !== entry.digest)
    ) return yield* fault("ArchiveChanged", "sources");
    if (entry.kind === "directory") {
      if (info.type !== "Directory") {
        return yield* fault("ArchiveChanged", "sources");
      }
      const remaining = yield* fs.readDirectory(child).pipe(
        Effect.mapError((cause) => fault("ArchiveChanged", "sources", cause)),
      );
      if (remaining.length) return yield* fault("ArchiveChanged", "sources");
    }
    yield* removeArchivePath(child, entry.kind === "directory");
  }
  const remaining = yield* fs.readDirectory(target).pipe(
    Effect.mapError((cause) => fault("ArchiveChanged", "sources", cause)),
  );
  if (remaining.length) return yield* fault("ArchiveChanged", "sources");
  yield* removeArchivePath(target, true);
  yield* syncDirectory(path.dirname(target));
});
const publishArchive = Effect.fn(function* (
  prepared: Prepared,
  owned: LinkOwnership | undefined,
) {
  if (!("input" in prepared.entry)) {
    return yield* fault("ArchiveChanged", "sources");
  }
  const entry = prepared.entry;
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const parent = path.dirname(entry.target);
  yield* physical(parent, "Directory");
  yield* fs.makeDirectory(parent, { recursive: true, mode: 0o700 });
  const stage = path.join(parent, `.df-skills-archive-${entry.id}.new`);
  const previous = path.join(parent, `.df-skills-archive-${entry.id}.old`);
  const desired = prepared.snapshot.ownershipDigest;
  const desiredOwnership: ArchiveOwnership = {
    target: entry.target,
    contentDigest: desired,
    kind: "archive",
    entries: prepared.snapshot.entries,
  };
  let stableDigest = yield* treeAt(entry.target);
  let stageTree = yield* snapshotAt(stage);
  let stageState = classifyOwnedTree(stageTree, desiredOwnership);
  if (stageState === "changed") {
    return yield* fault("ArchiveChanged", "sources");
  }
  if (stageState === "partial") {
    yield* cleanupOwnedTree(stage, desiredOwnership);
    stageTree = null;
    stageState = "absent";
  }
  const previousTree = yield* snapshotAt(previous);
  if (previousTree !== null) {
    if (
      !owned || owned.kind !== "archive" ||
      classifyOwnedTree(previousTree, owned) === "changed"
    ) {
      return yield* fault("ArchiveChanged", "sources");
    }
    if (stableDigest === null && stageState === "complete") {
      yield* fs.rename(stage, entry.target);
      stableDigest = desired;
      stageState = "absent";
      yield* syncDirectory(parent);
    }
    if (stableDigest !== desired) {
      return yield* fault("ArchiveChanged", "sources");
    }
    yield* cleanupOwnedTree(previous, owned);
  }
  if (stableDigest === desired) {
    if (stageState === "complete") {
      yield* cleanupOwnedTree(stage, desiredOwnership);
    }
    return;
  }
  if (stableDigest !== null && stableDigest !== owned?.contentDigest) {
    return yield* fault("ArchiveChanged", "sources");
  }
  if (stageState === "absent") {
    yield* writeDerivedTree(stage, prepared);
  }
  if (stableDigest !== null) yield* fs.rename(entry.target, previous);
  yield* fs.rename(stage, entry.target);
  yield* syncDirectory(parent);
  if ((yield* treeAt(entry.target)) !== desired) {
    return yield* fault("ArchiveChanged", "sources");
  }
  if (stableDigest !== null && owned?.kind === "archive") {
    yield* cleanupOwnedTree(previous, owned);
  }
});
const retireArchive = Effect.fn(function* (
  entry: LinkOwnership,
  id: string,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const parent = path.dirname(entry.target);
  const previous = path.join(parent, `.df-skills-archive-${id}.old`);
  if (entry.kind !== "archive") {
    return yield* fault("ArchiveChanged", "sources");
  }
  const live = yield* treeAt(entry.target);
  const detached = yield* snapshotAt(previous);
  if (classifyOwnedTree(detached, entry) === "changed") {
    return yield* fault("ArchiveChanged", "sources");
  }
  if (live !== null) {
    if (live !== entry.contentDigest || detached !== null) {
      return yield* fault("ArchiveChanged", "sources");
    }
    yield* fs.rename(entry.target, previous);
    yield* syncDirectory(parent);
  }
  yield* cleanupOwnedTree(previous, entry);
});
const reconcileFiles = (locations: Locations) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    const active = yield* loadActive(locations);
    let receipt = active.receipt;
    yield* fs.makeDirectory(locations.skillsPath, {
      recursive: true,
      mode: 0o755,
    });
    yield* physical(locations.skillsPath, "Directory");
    const desired = [...active.manifest.links, ...active.manifest.archives];
    const liveNames = yield* fs.readDirectory(locations.skillsPath);
    const statuses: Record<string, Status> = {};
    const prepared = new Map<string, Prepared>();
    const inspected = yield* Effect.forEach(
      desired,
      (entry) =>
        inspectFileEntry(entry).pipe(
          guarded("sources"),
          Effect.result,
          Effect.map((result) => [entry.id, result] as const),
        ),
      { concurrency: 4 },
    );
    for (const [id, result] of inspected) {
      if (result._tag === "Success") prepared.set(id, result.success);
      else statuses[id] = issue([result.failure.error, result.failure.message]);
    }
    for (
      const [id] of collisions(desired.map((entry) => entry.id), liveNames)
    ) {
      statuses[id] = issue("SkillCollision");
    }
    for (const entry of desired) {
      if (Object.hasOwn(statuses, entry.id)) continue;
      const pending = receipt.pendingPublication?.id === entry.id
        ? receipt.pendingPublication.ownership
        : undefined;
      const prior = receipt.links[entry.id] ?? pending;
      const expected = prepared.get(entry.id);
      if (
        pending &&
        (!expected ||
          canonical(pending) !== canonical(publicationOwnership(expected)))
      ) {
        statuses[entry.id] = issue("ArchiveChanged");
        continue;
      }
      const observed = yield* liveLink(`${locations.skillsPath}/${entry.id}`)
        .pipe(Effect.result);
      if (observed._tag === "Failure") {
        statuses[entry.id] = issue(prior ? "ChangedLink" : "UnownedLink");
      } else if (
        linkAction(entry.target, prior?.target, observed.success) === "blocked"
      ) {
        statuses[entry.id] = issue(prior ? "ChangedLink" : "UnownedLink");
      }
      if (prior && prior.kind !== ("input" in entry ? "archive" : "link")) {
        statuses[entry.id] = issue("ArchiveChanged");
      }
    }
    const save = (next: Receipt) =>
      writeReceipt(locations.stateDir, next).pipe(
        Effect.tap(() => Effect.sync(() => receipt = next)),
      );
    const publicationOwned = receipt.pendingPublication
      ? {
        ...receipt.links,
        [receipt.pendingPublication.id]: receipt.pendingPublication.ownership,
      }
      : receipt.links;
    for (
      const { id, desired: entry, owned } of inventory(
        desired,
        publicationOwned,
      )
    ) {
      if (Object.hasOwn(statuses, id)) continue;
      statuses[id] = yield* Effect.gen(function* () {
        let prior = owned;
        if (!entry) {
          if (!prior) return true as const;
          yield* removeLink(locations.skillsPath, id, prior);
          if (prior.kind === "archive") yield* retireArchive(prior, id);
          yield* save({
            ...receipt,
            pendingPublication: null,
            links: Object.fromEntries(
              Object.entries(receipt.links).filter(([key]) => key !== id),
            ),
          });
          return true as const;
        }
        const next = prepared.get(id);
        if (!next) return yield* fault("TreeInvalid", "sources");
        const ownership = publicationOwnership(next);
        if (!prior) {
          const path = yield* PathService;
          if ("input" in entry) {
            const parent = path.dirname(entry.target);
            if ((yield* treeAt(entry.target)) !== null) {
              return yield* fault("ArchiveChanged", "registry");
            }
            for (const suffix of ["new", "old"]) {
              const staged = path.join(
                parent,
                `.df-skills-archive-${id}.${suffix}`,
              );
              if ((yield* snapshotAt(staged)) !== null) {
                return yield* fault("ArchiveChanged", "registry");
              }
            }
          } else {
            const staged = yield* liveLink(
              path.join(locations.skillsPath, `.df-skills-link-${id}`),
            ).pipe(Effect.result);
            if (staged._tag === "Failure" || staged.success !== null) {
              return yield* fault("UnownedLink", "registry");
            }
          }
          yield* save({
            ...receipt,
            pendingPublication: { id, ownership },
          });
          prior = ownership;
        }
        if ("input" in entry) yield* publishArchive(next, prior);
        yield* publishLink(locations.skillsPath, id, entry.target, prior);
        yield* save({
          ...receipt,
          pendingPublication: null,
          links: { ...receipt.links, [id]: ownership },
        });
        return true as const;
      }).pipe(guarded("registry"), Effect.catch(Effect.succeed));
    }
    return { active: { ...active, receipt }, statuses };
  });
type PackageBuild = Readonly<{
  entry: FileEntry;
  prepared: Prepared;
  archive: string;
  safe: string;
}>;
const buildPackage = Effect.fn(function* (
  packageDir: string,
  build: PackageBuild,
  tools: Readonly<Record<"zip" | "unzip", string>>,
) {
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const stage = yield* fs.makeTempDirectoryScoped({
    directory: packageDir,
    prefix: `.df-skills-package-${build.entry.id}-`,
  });
  const root = path.join(stage, build.safe);
  yield* fs.makeDirectory(root, { mode: 0o700 });
  const touched = [root], files: string[] = [];
  const projected = yield* renameFrontmatter(
    yield* skillText(build.entry.target),
    build.entry.id,
    build.safe,
  );
  for (const item of build.prepared.snapshot.entries) {
    if (item.relative === ".") continue;
    if (!packageEntryAllowed(item.relative)) {
      return yield* fault("PackageInvalid", "packages");
    }
    const output = path.join(root, item.relative);
    touched.push(output);
    if (item.kind === "directory") {
      yield* fs.makeDirectory(output, { mode: 0o700 });
      continue;
    }
    const input = path.join(build.entry.target, item.relative);
    const bytes = yield* fs.readFile(input);
    if ((yield* digestBytes(bytes)) !== item.digest) {
      return yield* fault("SourceChanged", "packages");
    }
    yield* fs.writeFile(
      output,
      item.relative === "SKILL.md"
        ? new TextEncoder().encode(projected)
        : bytes,
      { flag: "wx", mode: 0o600 },
    );
    files.push(`${build.safe}/${item.relative}`);
  }
  if (!files.includes(`${build.safe}/SKILL.md`)) {
    return yield* fault("SkillMissing", "packages");
  }
  const after = yield* inspectFileEntry(build.entry);
  if (
    after.snapshot.ownershipDigest !== build.prepared.snapshot.ownershipDigest
  ) {
    return yield* fault("SourceChanged", "packages");
  }
  const epoch = new Date(1980, 0, 1);
  for (const target of touched.reverse()) {
    yield* fs.utimes(target, epoch, epoch);
  }
  const archive = path.join(stage, build.archive);
  const command = (argv: [string, ...string[]]) => ({
    argv,
    timeoutSeconds: 30,
    maxOutputBytes: 1048576,
  });
  yield* execute(
    command([
      tools.zip,
      "-q",
      "-X",
      "-D",
      "-0",
      "-MM",
      archive,
      ...files.toSorted(),
    ]),
    "packages",
    stage,
  );
  const listing = (yield* execute(
    command([tools.unzip, "-Z1", archive]),
    "packages",
    stage,
  )).split("\n").filter(Boolean);
  if (!archiveEntriesAllowed(build.safe, listing)) {
    return yield* fault("PackageInvalid", "packages");
  }
  yield* execute(
    command([tools.unzip, "-q", "-t", archive]),
    "packages",
    stage,
  );
  const metadata = yield* parseSkill(
    yield* execute(
      command([tools.unzip, "-p", archive, `${build.safe}/SKILL.md`]),
      "packages",
      stage,
    ),
  );
  if (metadata.name !== build.safe) {
    return yield* fault("PackageInvalid", "packages");
  }
  const info = yield* physical(archive, "File");
  if (info === null || info.size > 134217728n) {
    return yield* fault("PackageInvalid", "packages");
  }
  return {
    path: archive,
    digest: yield* digestBytes(yield* fs.readFile(archive)),
  };
});
const reconcilePackages = (locations: Locations) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    const path = yield* PathService;
    yield* fs.makeDirectory(locations.stateDir, {
      recursive: true,
      mode: 0o700,
    });
    yield* fs.makeDirectory(locations.packageDir, {
      recursive: true,
      mode: 0o700,
    });
    yield* physical(locations.stateDir, "Directory", 0o700);
    yield* physical(locations.packageDir, "Directory", 0o700);
    const lockPath = path.join(locations.stateDir, "operation.lock");
    yield* physical(lockPath, "File", 0o600);
    yield* (yield* OperationLock).acquire(lockPath);
    let recovered = false;
    for (const name of yield* fs.readDirectory(locations.packageDir)) {
      if (!packageStageOwned(name)) continue;
      yield* physical(path.join(locations.packageDir, name), "Directory");
      yield* fs.remove(path.join(locations.packageDir, name), {
        recursive: true,
      });
      recovered = true;
    }
    const active = yield* loadActive(locations);
    let receipt = active.receipt;
    const files = [...active.manifest.links, ...active.manifest.archives];
    const requested = files.filter((entry) => entry.package);
    if (packageIds(active.manifest, receipt).length !== requested.length) {
      return yield* fault("RegistryStale", "packages");
    }
    const logical = new Set<string>(), archives = new Set<string>();
    const builds: PackageBuild[] = [];
    for (const entry of requested) {
      const archive = packageArchiveName(entry.id);
      const logicalKey = collisionKey(entry.id),
        archiveKey = collisionKey(archive ?? "");
      if (!archive || logical.has(logicalKey) || archives.has(archiveKey)) {
        return yield* fault("SkillCollision", "packages");
      }
      logical.add(logicalKey);
      archives.add(archiveKey);
      const prepared = yield* inspectFileEntry(entry);
      if (
        receipt.links[entry.id]?.contentDigest !==
          prepared.snapshot.ownershipDigest
      ) {
        return yield* fault("RegistryStale", "packages");
      }
      builds.push({ entry, prepared, archive, safe: archive.slice(0, -4) });
    }
    let tools: Readonly<Record<"zip" | "unzip", string>> | null = null;
    let packaged = 0, removed = 0;
    const save = (next: Receipt) =>
      writeReceipt(locations.stateDir, next).pipe(
        Effect.tap(() => Effect.sync(() => receipt = next)),
      );
    for (const build of builds) {
      const target = path.join(locations.packageDir, build.archive);
      const prior = receipt.packages[build.entry.id];
      const info = yield* physical(target, "File");
      const live = info ? yield* digestBytes(yield* fs.readFile(target)) : null;
      const content = build.prepared.snapshot.ownershipDigest;
      if (packageAction(content, prior, live) === "unchanged") continue;
      if (tools === null) {
        tools = {
          zip: (yield* resolveExecutable("zip", "packages")).path,
          unzip: (yield* resolveExecutable("unzip", "packages")).path,
        };
      }
      const staged = yield* buildPackage(locations.packageDir, build, tools);
      if (
        live !== null && live !== prior?.archiveDigest && live !== staged.digest
      ) {
        return yield* fault("PackageChanged", "packages");
      }
      if (live !== staged.digest) {
        yield* fs.rename(staged.path, target);
        yield* syncDirectory(locations.packageDir);
        packaged += 1;
      }
      yield* save({
        ...receipt,
        packages: {
          ...receipt.packages,
          [build.entry.id]: {
            archive: target,
            contentDigest: content,
            archiveDigest: staged.digest,
          },
        },
      });
    }
    const desired = new Set(builds.map(({ entry }) => entry.id));
    for (const [id, prior] of Object.entries(receipt.packages)) {
      if (desired.has(id)) continue;
      if (!packageArchiveOwned(locations.packageDir, id, prior.archive)) {
        return yield* fault("PackageChanged", "packages");
      }
      const info = yield* physical(prior.archive, "File");
      const live = info
        ? yield* digestBytes(yield* fs.readFile(prior.archive))
        : null;
      if (packageAction(undefined, prior, live) === "blocked") {
        return yield* fault("PackageChanged", "packages");
      }
      if (live !== null) {
        yield* fs.remove(prior.archive);
        yield* syncDirectory(path.dirname(prior.archive));
        removed += 1;
      }
      yield* save({
        ...receipt,
        packages: Object.fromEntries(
          Object.entries(receipt.packages).filter(([key]) => key !== id),
        ),
      });
    }
    return {
      changed: recovered || packaged + removed > 0,
      packaged,
      removed,
      headless: false,
    };
  }).pipe(Effect.scoped, guarded("packages"));
function* inspectState(active: Active, locations: Locations) {
  const { manifest, receipt, manifestDigest } = active;
  const fs = yield* FileSystem;
  const path = yield* PathService;
  const files = [...manifest.links, ...manifest.archives];
  const sources = yield* survey("sources", files, function* (entry) {
    yield* inspectFileEntry(entry);
    return true;
  });
  const links: Record<
    "creates" | "replaces" | "removes" | "unchanged",
    string[]
  > = { creates: [], replaces: [], removes: [], unchanged: [] };
  const linkItems = inventory(
    files,
    receipt.pendingPublication
      ? {
        ...receipt.links,
        [receipt.pendingPublication.id]: receipt.pendingPublication.ownership,
      }
      : receipt.links,
  );
  const registryChecks = new Map<string | null, Status>();
  const stale = receiptStatus(receipt, manifestDigest);
  if (stale) registryChecks.set(null, stale);
  const registry = yield* observe("registry", function* () {
    if (linkItems.length === 0) return stale;
    const root = yield* physical(locations.skillsPath, "Directory");
    const names = root === null
      ? []
      : yield* fs.readDirectory(locations.skillsPath);
    for (const [id] of collisions(files.map((entry) => entry.id), names)) {
      registryChecks.set(id, issue("SkillCollision"));
    }
    for (const { id, desired, owned } of linkItems) {
      if (registryChecks.has(id)) continue;
      if (desired && !okay(sources[id])) {
        registryChecks.set(id, sources[id]);
        continue;
      }
      const live = names.includes(id)
        ? yield* fs.readLink(path.join(locations.skillsPath, id)).pipe(
          Effect.mapError((cause) => fault("UnownedLink", "registry", cause)),
          Effect.catch(Effect.succeed),
        )
        : null;
      if (live instanceof BoundaryError) {
        registryChecks.set(id, issue([live.error, live.message]));
        continue;
      }
      const action = linkAction(desired?.target, owned?.target, live);
      if (action === "blocked") {
        registryChecks.set(
          id,
          issue(owned ? "ChangedLink" : "UnownedLink"),
        );
      } else if (desired && "input" in desired) {
        const inspected = yield* Effect.gen(function* () {
          const prepared = yield* prepareArchive(desired);
          const liveDigest = yield* treeAt(desired.target);
          return treeAction(
            prepared.snapshot.ownershipDigest,
            owned?.kind === "archive" ? owned.contentDigest : undefined,
            liveDigest,
          );
        }).pipe(guarded("registry"), Effect.result);
        if (inspected._tag === "Failure") {
          registryChecks.set(
            id,
            issue([inspected.failure.error, inspected.failure.message]),
          );
          continue;
        }
        const tree = inspected.success;
        if (tree === "blocked") {
          registryChecks.set(id, issue("ArchiveChanged"));
        } else {
          links[tree].push(id);
        }
      } else links[action].push(id);
    }
    const blocked = [...registryChecks.values()][0];
    if (blocked) return blocked;
    if (
      links.creates.length + links.replaces.length + links.removes.length
    ) {
      return issue("RegistryStale");
    }
    return true;
  });
  if (
    !okay(registry) &&
    registry.error !== "RegistryStale" &&
    !registryChecks.size
  ) registryChecks.set(null, registry);
  const adds: Record<string, string[]> = {},
    removes: Record<string, string[]> = {},
    refreshes: Record<string, string[]> = {};
  const providerPairs = yield* Effect.forEach(
    inventory(manifest.providers, receipt.providers),
    ({ id, desired, owned }) =>
      Effect.gen(function* () {
        const wanted = desired?.items.map((item) => item.id) ?? [];
        const prior = Object.keys(owned?.owned ?? {});
        adds[id] = wanted.filter((item) => !prior.includes(item)).sort();
        removes[id] = prior.filter((item) => !wanted.includes(item)).sort();
        refreshes[id] = wanted.filter((item) =>
          prior.includes(item) &&
          (desired?.kind === "command" || desired?.exclusive)
        ).sort();
        if (receipt.pendingProvider?.providerId === id) {
          return issue("PendingProvider");
        }
        const { current } = yield* prepareProvider(desired, owned);
        adds[id] = wanted.filter((item) => !current.includes(item)).sort();
        removes[id] = prior.filter((item) => !wanted.includes(item)).sort();
        if (adds[id].length || removes[id].length || !desired) {
          return issue("ObservationMismatch");
        }
        return true as const;
      }).pipe(
        guarded("providers"),
        Effect.catch(Effect.succeed),
        Effect.map((status) => [id, status] as const),
      ),
    { concurrency: 4 },
  );
  const providers = Object.fromEntries(providerPairs);
  const builds = files.filter((entry) => entry.package).map((entry) => entry.id)
    .sort();
  const packageRemovals = Object.keys(receipt.packages).filter((id) =>
    !builds.includes(id)
  ).sort();
  const packages = yield* observe("packages", function* () {
    if (!builds.length && !packageRemovals.length) return null;
    for (const entry of files.filter(({ package: selected }) => selected)) {
      const archive = packageArchiveName(entry.id);
      const record = receipt.packages[entry.id];
      const prepared = yield* inspectFileEntry(entry);
      const expected = archive && path.join(locations.packageDir, archive);
      if (
        !record || record.archive !== expected ||
        record.contentDigest !== prepared.snapshot.ownershipDigest ||
        receipt.links[entry.id]?.contentDigest !== record.contentDigest
      ) return issue("PackageChanged");
      const info = yield* physical(record.archive, "File");
      if (
        info === null ||
        (yield* digestBytes(yield* fs.readFile(record.archive))) !==
          record.archiveDigest
      ) return issue("PackageChanged");
    }
    return packageRemovals.length ? issue("PackageChanged") : true;
  });
  const reference = yield* observe("reference", function* () {
    if (!locations.reference) return null;
    const helper = yield* resolveExecutable(
      "df-effect-v4-reference",
      "reference",
    );
    const output = yield* execute({
      argv: [helper.path, "status"],
      timeoutSeconds: 300,
      maxOutputBytes: 1048576,
      acceptFailure: true,
    }, "reference");
    const status = yield* decodeContract(
      Schema.fromJsonString(ReferenceObservation),
      output,
    ).pipe(
      Effect.mapError((cause) => fault("ReferenceInvalid", "reference", cause)),
    );
    return status.path === locations.reference
      ? referenceStateStatus(status.state)
      : issue("ReferenceInvalid");
  });
  const groups = { sources, providers }, singles = { packages, reference };
  const blockers = [
    ...Object.entries(groups).flatMap(([area, states]) =>
      failures(area, Object.entries(states))
    ),
    ...failures("registry", registryChecks),
    ...Object.entries(singles).flatMap(([area, state]) =>
      failures(area, [[null, state]])
    ),
  ].sort((left, right) =>
    `${left.boundary}/${left.id}` < `${right.boundary}/${right.id}`
      ? -1
      : `${left.boundary}/${left.id}` > `${right.boundary}/${right.id}`
      ? 1
      : 0
  );
  const observation = {
    manifestDigest,
    ...Records.map(groups, (states) => Records.map(states, renderStatus)),
    registry: renderStatus(registry),
    ...Records.map(singles, renderStatus),
    pendingOwnership: receipt.pendingProvider ?? receipt.pendingPublication,
    healthy: [
      ...Object.values(groups).flatMap(Object.values),
      registry,
      ...Object.values(singles),
    ].every(okay),
  };
  const plan = {
    manifestDigest,
    links,
    providers: { adds, removes, refreshes },
    packages: { builds, removes: packageRemovals },
    blockers,
  };
  return { plan, observation };
}
const flags = {
  manifest: Flag.String("manifest").pipe(Flag.withDefault("")),
  stateDir: Flag.String("state-dir").pipe(Flag.withDefault("")),
  skillsPath: Flag.String("skills-path").pipe(Flag.withDefault("")),
  packageDir: Flag.String("package-dir").pipe(Flag.withDefault("")),
  reference: Flag.String("reference").pipe(Flag.withDefault("")),
};
export const graphicalPlatform = (
  platform: string,
  display: string,
  wayland: string,
) => platform !== "linux" || Boolean(display || wayland);
const graphical = Effect.all([
  Config.String("DISPLAY").pipe(Config.withDefault("")),
  Config.String("WAYLAND_DISPLAY").pipe(Config.withDefault("")),
]).pipe(
  Effect.map(([display, wayland]) =>
    graphicalPlatform(Deno.build.os, display, wayland)
  ),
);
const run = (command: string, input: Locations) =>
  Effect.gen(function* () {
    const home = input.manifest && input.stateDir && input.skillsPath
      ? ""
      : yield* Config.String("HOME");
    const state = yield* Config.String("XDG_STATE_HOME").pipe(
      Config.withDefault(`${home}/.local/state`),
    );
    const locations = {
      manifest: input.manifest ||
        `${home}/.config/dotfiles/skill-lifecycle.json`,
      stateDir: input.stateDir || `${state}/dotfiles/skill-lifecycle`,
      skillsPath: input.skillsPath || `${home}/.agents/skills`,
      packageDir: input.packageDir || `${home}/.cache/claude-skill-packs`,
      reference: input.reference,
    };
    yield* validateLocations(locations).pipe(guarded("config"));
    const active = yield* loadActive(locations);
    if (command === "package" && !(yield* graphical)) {
      yield* Console.log(JSON.stringify({
        changed: false,
        packaged: 0,
        removed: 0,
        headless: true,
      }));
      Deno.exitCode = 0;
      return;
    }
    const workerCode = yield* permissionGate(
      active,
      command === "package",
      Boolean(locations.reference),
    );
    if (workerCode !== null) {
      Deno.exitCode = workerCode;
      return;
    }
    if (command === "package") {
      const result = yield* reconcilePackages(locations);
      yield* Console.log(JSON.stringify(result));
      Deno.exitCode = 0;
      return;
    }
    const reconciled = command === "reconcile" && active.manifestDigest !== null
      ? yield* reconcileAll(locations)
      : null;
    const result = yield* inspectState(reconciled?.active ?? active, locations);
    if (reconciled) {
      for (const [id, status] of Object.entries(reconciled.providerStatuses)) {
        if (!okay(status)) {
          result.observation.providers[id] = renderStatus(status);
          result.observation.healthy = false;
        }
      }
      const fileFailure = Object.values(reconciled.fileStatuses).find((
        status,
      ) => !okay(status));
      if (fileFailure !== undefined) {
        result.observation.registry = renderStatus(fileFailure);
        result.observation.healthy = false;
      }
    }
    const isPlan = command === "plan";
    const reconciledHealthy = command === "reconcile" &&
      reconcileHealthy(result.observation);
    const output = isPlan
      ? result.plan
      : command === "reconcile"
      ? { ...result.observation, reconcileHealthy: reconciledHealthy }
      : result.observation;
    const success = isPlan
      ? result.plan.blockers.length === 0
      : command === "reconcile"
      ? reconciledHealthy
      : result.observation.healthy;
    yield* Console.log(JSON.stringify(output));
    Deno.exitCode = Number(!success);
  });
const cli = Command.make("df-skills").pipe(
  Command.withSubcommands(
    ["plan", "observe", "reconcile", "package"].map((name) =>
      Command.make(name, flags, (input) => run(name, input))
    ),
  ),
);
const report = ({ error, message, boundary }: Failure) => {
  console.error(JSON.stringify({ error, message, boundary }));
  Deno.exitCode = 1;
};
if (import.meta.main) {
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    report(fault("UnexpectedDefect", "runtime"));
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    report(fault("UnexpectedDefect", "runtime"));
    Deno.exit(1);
  });
  try {
    const NodeRuntime = await import(
      "npm:@effect/platform-node@4.0.0-rc.117/NodeRuntime"
    );
    const NodeServices = await import(
      "npm:@effect/platform-node@4.0.0-rc.117/NodeServices"
    );
    const output: string[] = [];
    const config = ConfigProvider.fromEnvRecord(
      Object.fromEntries(
        [...environmentKeys, "DF_SKILLS_PINS"].map((
          key,
        ) => [
          key,
          Deno.permissions.querySync({ name: "env", variable: key }).state ===
              "granted"
            ? Deno.env.get(key)
            : undefined,
        ]),
      ),
    );
    Command.run(cli, { version: "0.2.0", renderErrors: false }).pipe(
      Effect.provide(
        CliConfig.layer({ builtIns: [GlobalFlag.Help, GlobalFlag.Version] }),
      ),
      Effect.provideService(Console.Console, {
        ...console,
        log: (...values: unknown[]) =>
          output.push(values.map(String).join(" ")),
      }),
      Effect.provideService(ConfigProvider.ConfigProvider, config),
      Effect.match({
        onSuccess: () => output.forEach((line) => console.log(line)),
        onFailure: (error) => {
          const failure = error instanceof BoundaryError
            ? error
            : error._tag === "ConfigError"
            ? fault("ConfigMissing", "config")
            : fault("ArgumentsInvalid", "cli");
          report(failure);
        },
      }),
      Effect.catchCause(() =>
        Effect.sync(() => report(fault("UnexpectedDefect", "runtime")))
      ),
      Effect.provide(NodeServices.layer),
      Effect.provide(OperationLock.layer),
      NodeRuntime.runMain,
    );
  } catch (cause) {
    report(fault("RuntimeUnavailable", "runtime", cause));
  }
}

