const { Array: List, optionalKey: Optional, Literal: Tag, makeFilter: rule } =
  Schema;
const Struct = <Fields extends Schema.Struct.Fields>(
  fields: Fields,
  valid = (_value: Schema.Struct<Fields>["Type"]) => true,
) => Schema.Struct(fields).check(rule(valid));
const text = (pattern: RegExp) =>
  Schema.String.check(Schema.isPattern(pattern));
const Safe = text(/^[^\p{Cc}\p{Cf}{}]+$/u);
const Id = text(/^[A-Za-z0-9][A-Za-z0-9:._-]*$/);
const Path = text(/^(?:\/(?!\.{1,2}(?:\/|$))[^/\\\p{Cc}\p{Cf}{}]+)+$/u);
const Digest = text(/^[a-f0-9]{64}$/);
const Revision = text(/^[a-f0-9]{40}$/);
const unique = (ids: readonly string[]) =>
  new Set(ids.map((id) => id.toLowerCase())).size === ids.length;
const shells = new RegExp(
  "(^|/)(?:sh|ash|bash|rbash|bosh|dash|hush|ksh|rksh|lksh|mksh|oksh|pdksh|" +
    "posh|yash|zsh|rzsh|fish|csh|tcsh|osh|ysh|oil|xonsh|nu|nushell|elvish|" +
    "ion|rc|es|sash|nash|msh|psh|rush|rssh|tclsh|wish|cmd|command\\.com|" +
    "powershell(?:_ise)?|pwsh(?:-preview)?|env|busybox|toybox)" +
    "(?:[-.]?\\d+(?:\\.\\d+)*)?(?:\\.exe)?$",
  "i",
);
const Executable = Schema.Union([Path, text(/^[A-Za-z0-9][A-Za-z0-9._+-]*$/)])
  .check(
    rule((value) =>
      !/[\s,]/.test(value) && !shells.test(value) &&
      !/(^|\/)chezmoi$/.test(value)
    ),
  );
const field = "[A-Za-z_][A-Za-z0-9_-]*";
const path = `${field}(?:\\.${field})*`;
const quoted = '"(?:[^"\\\\\\p{Cc}]|\\\\["\\\\/bfnrt]|\\\\u[0-9a-fA-F]{4})*"';
const predicate = `\\.${field}(?: == (?:true|false|${quoted}))?`;
export const Selector = text(
  new RegExp(
    `^(?:\\.|\\.${path}|\\[\\.\\[\\](?: \\| select\\(${predicate}\\))? \\| \\.${field}\\]|\\.${path} \\| map\\((?:select\\(${predicate}\\) \\| )?\\.${field}\\))$`,
    "u",
  ),
).check(Schema.isMaxLength(256));
const bounded = (maximum: number) =>
  Schema.Int.check(Schema.isBetween({ minimum: 1, maximum }));
const capability = (placeholder = "") =>
  Struct({
    argv: Schema.NonEmptyArray(
      Schema.Union([text(/^[^\p{Cc}\p{Cf}{}]*$/u), Tag(placeholder)]),
    ).check(rule((argv) =>
      Schema.is(Executable)(argv[0]) &&
      (!placeholder || argv.includes(placeholder))
    )),
    timeoutSeconds: bounded(300),
    maxOutputBytes: bounded(1048576),
  });
const Direct = capability();
const Observe = Struct({ ...Direct.fields, selector: Selector });
const lock = { executable: Executable, version: Safe };
const item = { id: Id, source: Optional(Safe), removeAs: Optional(Safe) };
const providerBase = {
  id: Id,
  exclusive: Schema.Boolean,
  observe: Observe,
  version: Direct,
  lock: Struct({ ...lock, identity: Optional(Safe) }),
  items: List(Struct(item)),
};
const uses = (executable: string, calls: readonly (typeof Direct.Type)[]) =>
  calls.every((call) => call.argv[0] === executable);
const Provider = Schema.Union([
  Struct({
    ...providerBase,
    kind: Tag("command"),
    sync: Direct,
    enable: capability("{id}"),
    disable: capability("{id}"),
  }),
  Struct({
    ...providerBase,
    kind: Tag("pack"),
    lock: Struct({ ...lock, identity: Safe }),
    items: List(Struct({ ...item, source: Safe, removeAs: Safe })),
    install: capability("{source}"),
    update: Direct,
    remove: capability("{removeAs}"),
  }),
]).check(rule((provider) => {
  const calls = "sync" in provider
    ? [provider.sync, provider.enable, provider.disable]
    : [provider.install, provider.update, provider.remove];
  const all = [provider.version, provider.observe, ...calls];
  return uses(provider.lock.executable, all);
}));
const skill = { id: Id, target: Path, package: Schema.Boolean };
const Source = Schema.Union([
  Struct({ kind: Tag("repository") }),
  Struct({ kind: Tag("git"), revision: Revision, url: Safe }),
]);
const Link = Schema.Union([
  Struct({ ...skill, owner: Tag("chezmoi"), source: Optional(Source) }),
  Struct({ ...skill, owner: Tag("provider"), package: Tag(false) }),
]);
const TransformKind = Schema.Literals([
  "frontmatter-name",
  "logical-directory-rename",
]);
const Transform = Struct({ kind: TransformKind, from: Id, to: Id });
const Archive = Struct({
  ...skill,
  input: Path,
  lock: Struct({
    algorithm: Tag("sha256"),
    checksum: Digest,
    contentDigest: Digest,
    ref: Revision,
  }),
  transforms: List(Transform),
}, ({ input, target }) =>
  input !== target && !input.startsWith(`${target}/`) &&
  !target.startsWith(`${input}/`));
export const Manifest = Struct({
  schema: Tag(2),
  links: List(Link),
  archives: List(Archive),
  providers: List(Provider),
}, ({ providers, links, archives }) =>
  unique(providers.map(({ id }) => id)) &&
  unique([...links, ...archives, ...providers.flatMap(({ items }) => items)]
    .map(({ id }) => id)));
export type Manifest = typeof Manifest.Type;
const empty: Manifest = { schema: 2, links: [], archives: [], providers: [] };
const owned = <S extends Schema.Constraint>(value: S) =>
  Schema.Record(Schema.String, value).check(
    rule((entries) =>
      Object.keys(entries).every(Schema.is(Id)) && unique(Object.keys(entries))
    ),
  );
const Observed = List(Id).check(rule(unique));
const ProviderReceipt = Struct(
  {
    kind: Schema.Literals(["command", "pack"]),
    identity: Optional(Safe),
    executable: Struct({ path: Path, digest: Digest, version: Safe }),
    observe: Observe,
    owned: owned(Struct({ remove: Direct })),
  },
  (value) => {
    const calls = Object.values(value.owned).map((item) => item.remove);
    return uses(value.executable.path, [value.observe, ...calls]) &&
      (value.kind !== "pack" || value.identity !== undefined);
  },
);
const operations = {
  command: ["enable", "disable", "sync"],
  pack: ["install", "remove", "update"],
} as const;
const PackageReceipt = Struct({
  archive: Path,
  contentDigest: Digest,
  archiveDigest: Digest,
});
const ReferenceObservation = Struct({
  schema: Tag(1),
  state: Schema.Literals(["current", "missing", "stale", "invalid"]),
  path: Path,
  version: Safe,
  commit: Revision,
  checksum: Digest,
  url: Safe,
});
const OwnedTreeEntry = Struct({
  relative: Safe,
  kind: Schema.Literals(["directory", "file"]),
  mode: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 0o777 })),
  digest: Schema.NullOr(Digest),
});
const linkOwnership = { target: Path, contentDigest: Digest };
const LinkReceipt = Schema.Union([
  Struct({ ...linkOwnership, kind: Tag("link") }),
  Struct({
    ...linkOwnership,
    kind: Tag("archive"),
    entries: List(OwnedTreeEntry),
  }),
]);
const PendingPublication = Struct({ id: Id, ownership: LinkReceipt });
export const Receipt = Struct({
  schema: Tag(1),
  manifestDigest: Digest,
  links: owned(LinkReceipt),
  providers: owned(ProviderReceipt),
  packages: owned(PackageReceipt),
  pendingPublication: Schema.NullOr(PendingPublication).pipe(
    Schema.withDecodingDefaultKey(Effect.succeed(null)),
  ),
  pendingProvider: Schema.NullOr(Struct({
    providerId: Id,
    itemId: Schema.NullOr(Id),
    action: Schema.Literals([...operations.command, ...operations.pack]),
    phase: Schema.Literals(["not-achieved", "achieved"]),
    command: Direct,
    startedFrom: Observed,
    expected: Observed,
  })),
}, ({ links, providers, pendingPublication, pendingProvider: pending }) => {
  if (pendingPublication && Object.hasOwn(links, pendingPublication.id)) {
    return false;
  }
  if (pending === null) return true;
  if (!Object.hasOwn(providers, pending.providerId)) return false;
  if (!uses(providers[pending.providerId].executable.path, [pending.command])) {
    return false;
  }
  const actions: readonly string[] =
    operations[providers[pending.providerId].kind];
  const operation = actions.indexOf(pending.action);
  if (
    operation < 2 && pending.itemId !== null &&
    pending.startedFrom.includes(pending.itemId) !== (operation === 1)
  ) return false;
  if (
    pending.itemId !== null &&
    !Object.hasOwn(providers[pending.providerId].owned, pending.itemId)
  ) return false;
  const expected = pending.startedFrom.filter((id) => id !== pending.itemId);
  if (operation === 0 && pending.itemId !== null) expected.push(pending.itemId);
  return operation >= 0 && ((operation === 2) === (pending.itemId === null)) &&
    canonical(expected.sort()) === canonical(pending.expected.toSorted());
});
export type Receipt = typeof Receipt.Type;
export type Failure = Readonly<
  Record<"error" | "message" | "boundary", string>
>;
export type ContractResult<Value> = Result.Result<Value, Schema.SchemaError>;
export const decodeContract = <S extends Schema.ConstraintDecoder<unknown>>(
  schema: S,
  input: unknown,
) => Schema.decodeUnknownEffect(schema)(input, { onExcessProperty: "error" });
export const canonical = (value: Schema.Json): string => {
  const keys = new Set<string>();
  JSON.stringify(value, (key, entry: Schema.Json) => {
    keys.add(key);
    return entry;
  });
  return JSON.stringify(value, [...keys].sort());
};
class BoundaryError extends Data.TaggedError("BoundaryError")<
  Failure & { readonly cause?: unknown }
> {}
