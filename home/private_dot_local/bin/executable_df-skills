Deno.test("package eligibility is explicit, file-backed, and receipt-owned", async () => {
  const manifest = await Effect.runPromise(
    decodeContract(Manifest, manifestFixture()),
  );
  const receipt = await Effect.runPromise(
    decodeContract(Receipt, receiptFixture()),
  );
  const owned = {
    ...receipt,
    links: {
      ...receipt.links,
      archive: {
        target: "/store/archive",
        contentDigest: hash,
        kind: "archive" as const,
        entries: [],
      },
    },
  };
  assert.deepEqual(packageIds(manifest, owned), ["archive", "repo"]);
  assert.deepEqual(packageIds(manifest, { ...owned, links: {} }), []);
});
const packageActions = [
  [hash, undefined, null, "build"],
  [hash, { contentDigest: hash, archiveDigest: hash }, hash, "unchanged"],
  ["b".repeat(64), { contentDigest: hash, archiveDigest: hash }, hash, "build"],
  [
    hash,
    { contentDigest: hash, archiveDigest: hash },
    "b".repeat(64),
    "blocked",
  ],
  [undefined, { contentDigest: hash, archiveDigest: hash }, hash, "remove"],
  [
    undefined,
    { contentDigest: hash, archiveDigest: hash },
    "b".repeat(64),
    "blocked",
  ],
] as const;
for (const [desired, ownedPackage, live, action] of packageActions) {
  Deno.test(`package ownership ${desired}/${live} is ${action}`, () =>
    assert.equal(packageAction(desired, ownedPackage, live), action));
}
Deno.test("package content rejects sensitive, VCS, escaping, and colliding entries", () => {
  for (
    const name of [
      ".env",
      ".git",
      ".gitignore",
      "secret.pem",
      "credentials.json",
    ]
  ) {
    assert.equal(packageEntryAllowed(name), false);
  }
  assert.equal(archiveEntriesAllowed("safe", ["safe/", "safe/SKILL.md"]), true);
  assert.equal(archiveEntriesAllowed("safe", ["safe/../escape"]), false);
  assert.equal(
    archiveEntriesAllowed("safe", ["safe/A", "safe/\uff21"]),
    false,
  );
});
Deno.test("sanitized package names and headless policy are explicit", () => {
  assert.equal(packageArchiveName("a:b"), packageArchiveName("a-b"));
  assert.equal(graphicalPlatform("linux", "", ""), false);
  assert.equal(graphicalPlatform("linux", ":0", ""), true);
});
Deno.test("reconcile exit permits explicit expected package drift only", () => {
  const healthy = { healthy: true, error: null, message: null };
  const packageDrift = {
    healthy: false,
    error: "PackageChanged",
    message: "drift",
  };
  const observation = {
    sources: { skill: healthy },
    providers: {},
    registry: healthy,
    packages: packageDrift,
    reference: healthy,
    pendingOwnership: null,
  };
  assert.equal(reconcileHealthy(observation), true);
  assert.equal(
    reconcileHealthy({ ...observation, registry: packageDrift }),
    false,
  );
  assert.equal(
    reconcileHealthy({ ...observation, pendingOwnership: {} }),
    false,
  );
});
Deno.test("stale package ownership is confined to its deterministic directory", () => {
  assert.deepEqual([
    packageArchiveOwned("/packages", "lochy:alpha", "/packages/alpha.zip"),
    packageArchiveOwned("/packages", "lochy:alpha", "/other/alpha.zip"),
    packageStageOwned(".df-skills-package-lochy:alpha-Ab12xZ"),
    packageStageOwned(".df-skills-package-lochy:alpha"),
  ], [true, false, true, false]);
});
Deno.test("named executable targets stay inside their provisioned root", () => {
  assert.deepEqual([
    executableTargetAllowed(
      "/opt/homebrew",
      "/opt/homebrew/Cellar/git/2/bin/git",
    ),
    executableTargetAllowed("/private/tmp/tools", "/usr/bin/git"),
    executableTargetAllowed("/", "/usr/bin/git"),
  ], [true, false, false]);
});
Deno.test("reference status states remain independent", () => {
  const observed = (["current", "missing", "stale", "invalid"] as const).map(
    (state) => {
      const status = referenceStateStatus(state);
      return status === true ? true : status.error;
    },
  );
  assert.deepEqual(observed, [
    true,
    "ReferenceMissing",
    "ReferenceStale",
    "ReferenceInvalid",
  ]);
});

const architectureRepoRoot = new URL("../../../", import.meta.url);
// deno-fmt-ignore
const architectureCatalogPath = new URL("home/.chezmoidata/skill-lifecycle.yaml", architectureRepoRoot), architectureReceiptPath = new URL("home/private_dot_local/share/dotfiles/skills/private_dot_inputs/private_dot_receipts/private_lochy:coding:architecture.json.tmpl", architectureRepoRoot);
// deno-fmt-ignore
const architectureIntegration = [architectureCatalogPath, architectureReceiptPath].every((path) => Deno.permissions.querySync({ name: "read", path }).state === "granted") && Deno.permissions.querySync({ name: "run", command: "chezmoi" }).state === "granted";
// deno-fmt-ignore
const ArchitectureLock = Schema.Struct({ algorithm: Schema.Literal("sha256"), checksum: Schema.String, contentDigest: Schema.String, ref: Schema.String }), ArchitectureSource = Schema.Struct({ id: Schema.String, kind: Schema.Literal("archive"), url: Schema.String, lock: ArchitectureLock }), ArchitectureCatalog = Schema.Struct({ skillLifecycleDefaults: Schema.Struct({ sources: Schema.Struct({ "public-architecture": ArchitectureSource }) }) }), ArchitectureReceipt = Schema.Struct({ schema: Schema.Literal(1), sourceId: Schema.String, algorithm: Schema.Literal("sha256"), checksum: Schema.String, contentDigest: Schema.String, ref: Schema.String });
// deno-fmt-ignore
const architectureIdentity = { sourceId: "public-architecture", itemId: "lochy:coding:architecture", checksum: "47650b9424a4156417f35985c7439b2d05a8968b29cd8b2d4006dd3bee01cdcb", ref: "3cca18b368ae95cdbdebbff572ccafa662551015", rawContentDigest: "34ba18e67814df0ef29ce146b29f1a06a60beeeb767e5de3b7f1f689698d973d", transformedContentDigest: "ded4896f80226acee5cd49ce67e4b6647ac2487bca6c5cc3dfe33512f8fe9537", lockContentDigest: "ae17dfe032ceae470b938a043e46552e5e6c2fde5e132adf358619d60ee43027", transformedOwnershipDigest: "a21d844126be1e48fff891afd01f97ce440b513d75aaa484335acc984e0f0ef5" } as const;
// deno-fmt-ignore
const architectureRawFiles = [{ relative: "HTML-REPORT.md", digest: "581e8bb5a521e46bbda8ca7e19b15948bed882187108092ebb90c62513b77528", mode: 0o644 }, { relative: "SKILL.md", digest: "d1ac25511a936ff4250a48dbcefda363837d6bb9321b3cba73df99fa37270a75", mode: 0o644 }, { relative: "agents/openai.yaml", digest: "c8cb20f68ebf0edb4e497bc11ae5fcaa196004e661cd189015b04f4109ced7f1", mode: 0o644 }] as const;
// deno-fmt-ignore
const architectureTransformedEntries = [{ relative: ".", kind: "directory", mode: 0o700, digest: null }, { relative: "HTML-REPORT.md", kind: "file", mode: 0o644, digest: "581e8bb5a521e46bbda8ca7e19b15948bed882187108092ebb90c62513b77528" }, { relative: "SKILL.md", kind: "file", mode: 0o644, digest: "c3f3e4a23db1755ef43b4b04074a90677e92c7a3f8ccc2edb66572977494a606" }, { relative: "agents", kind: "directory", mode: 0o755, digest: null }, { relative: "agents/openai.yaml", kind: "file", mode: 0o644, digest: "c8cb20f68ebf0edb4e497bc11ae5fcaa196004e661cd189015b04f4109ced7f1" }] as const;
// deno-fmt-ignore
const architectureDigest = async (value: string): Promise<string> => new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value))).toHex();
// deno-fmt-ignore
const renderArchitectureReceipt = async (template: Uint8Array): Promise<string> => { const child = new Deno.Command("chezmoi", { args: ["execute-template"], cwd: architectureRepoRoot, stdin: "piped", stdout: "piped", stderr: "piped" }).spawn(), writer = child.stdin.getWriter(); await writer.write(template); await writer.close(); const output = await child.output(); assert.equal(new TextDecoder().decode(output.stderr), ""); assert.equal(output.success, true); return new TextDecoder().decode(output.stdout); };
// deno-fmt-ignore
Deno.test({ name: "public architecture lock agrees with the verified archive tree", ignore: !architectureIntegration, fn: async () => { const catalog = Schema.decodeUnknownSync(ArchitectureCatalog)(parseYaml(await Deno.readTextFile(architectureCatalogPath))), source = catalog.skillLifecycleDefaults.sources["public-architecture"], transformedFiles = architectureTransformedEntries.filter((entry) => entry.kind === "file").map(({ relative, digest, mode }) => ({ relative, digest, mode })); assert.equal(await architectureDigest(JSON.stringify(architectureRawFiles)), architectureIdentity.rawContentDigest); assert.equal(await architectureDigest(JSON.stringify(transformedFiles)), architectureIdentity.transformedContentDigest); assert.equal(await architectureDigest(JSON.stringify([[architectureIdentity.itemId, architectureIdentity.transformedContentDigest]])), architectureIdentity.lockContentDigest); assert.equal(await architectureDigest(JSON.stringify(architectureTransformedEntries)), architectureIdentity.transformedOwnershipDigest); assert.deepEqual(source.lock, { algorithm: "sha256", checksum: architectureIdentity.checksum, contentDigest: architectureIdentity.lockContentDigest, ref: architectureIdentity.ref }); assert.ok(source.url.includes(architectureIdentity.ref)); } });
// deno-fmt-ignore
Deno.test({ name: "public architecture acquisition receipt is deterministic and lock-derived", ignore: !architectureIntegration, fn: async () => { const catalog = Schema.decodeUnknownSync(ArchitectureCatalog)(parseYaml(await Deno.readTextFile(architectureCatalogPath))), source = catalog.skillLifecycleDefaults.sources["public-architecture"], template = await Deno.readFile(architectureReceiptPath), first = await renderArchitectureReceipt(template), second = await renderArchitectureReceipt(template), receipt = Schema.decodeUnknownSync(ArchitectureReceipt)(JSON.parse(first)); assert.equal(first, second); assert.deepEqual(receipt, { schema: 1, sourceId: source.id, algorithm: source.lock.algorithm, checksum: source.lock.checksum, contentDigest: source.lock.contentDigest, ref: source.lock.ref }); } });
