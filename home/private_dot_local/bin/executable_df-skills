const linkCases = [
  ["next", undefined, null, "creates"],
  ["next", "old", "old", "replaces"],
  [undefined, "old", "old", "removes"],
  ["old", "old", "old", "unchanged"],
  ["next", "old", "other", "blocked"],
  ["old", undefined, "old", "blocked"],
] as const;
