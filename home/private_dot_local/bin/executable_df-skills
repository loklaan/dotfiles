Deno.test("null-item recovery retries until a post-observation is persisted", async () => {
  const receipt = await Effect.runPromise(
    decodeContract(Receipt, receiptFixture()),
  );
  const pending = receipt.pendingProvider;
  assert.ok(pending);
  const sync = {
    ...pending,
    itemId: null,
    action: "sync" as const,
    startedFrom: ["skill"],
    expected: ["skill"],
  };
  assert.deepEqual([
    providerRecovery(sync, ["skill"]),
    providerRecovery({ ...sync, phase: "achieved" }, ["skill"]),
  ], ["retry", "finish"]);
});
