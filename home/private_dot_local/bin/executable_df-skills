for (const [name, schema, fixture, cases] of contracts) {
  Deno.test(`accepts complete ${name} without dropping fields`, () =>
    expect(schema, fixture(), true));
  const fields = paths(fixture()).filter((path) =>
    path !== "pendingProvider" && path !== "pendingPublication"
  );
  for (const path of fields) {
    Deno.test(`rejects null ${name}.${path}`, () =>
      expect(schema, replace(fixture(), path, null)));
  }
  for (const [path, value] of cases) {
    Deno.test(`${name}.${path}: ${JSON.stringify(value)?.slice(0, 100)}`, () =>
      expect(schema, replace(fixture(), path, value)));
  }
}
