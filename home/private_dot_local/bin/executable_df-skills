Deno.test("historical schema-1 receipt is upgraded without changing ownership", async () => {
  const fixture = receiptFixture();
  // deno-fmt-ignore
  const current = { ...fixture, links: { ...fixture.links, archive: { target: "/store/archive", contentDigest: hash, kind: "archive" as const, entries: [] } }, providers: { command: { ...fixture.providers.command, identity: "original.lock" } } };
  const { pendingPublication: _pendingPublication, ...historical } = current;
  const receipt = await Effect.runPromise(decodeContract(Receipt, historical));
  assert.deepEqual(receipt, { ...current, pendingPublication: null });
  assert.ok(canonical(receipt).includes('"pendingPublication":null'));
  // deno-fmt-ignore
  assert.equal(receiptWriteRequired(new TextEncoder().encode(canonical(historical)), receipt), true);
});
