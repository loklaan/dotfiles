Deno.test("archive cleanup uses injected FileSystem and maps remove errors", async () => {
  let removed: readonly [string, boolean | undefined] | null = null;
  // deno-fmt-ignore
  const success = TestFileSystem.layerNoop({ remove: (target, options) => Effect.sync(() => removed = [target, options?.recursive]) });
  await Effect.runPromise(
    removeArchivePath("/archive", true).pipe(Effect.provide(success)),
  );
  assert.deepEqual(removed, ["/archive", true]);
  // deno-fmt-ignore
  const denied = TestFileSystem.layerNoop({ remove: () => Effect.fail(TestPlatformError.systemError({ _tag: "PermissionDenied", module: "test", method: "remove" })) });
  const failure = await Effect.runPromise(
    removeArchivePath("/archive").pipe(Effect.provide(denied), Effect.result),
  );
  assert.equal(failure._tag, "Failure");
  if (failure._tag === "Failure") {
    assert.equal(failure.failure.error, "ArchiveChanged");
  }
});
for (const mode of ["success", "overflow", "timeout"] as const) {
  Deno.test(`provider fake process/clock: ${mode}`, async () => {
    const signals: string[] = [];
    const spawner = ChildProcessSpawner.make((command) =>
      Effect.sync(() => {
        assert.equal(command._tag, "StandardCommand");
        if (command._tag !== "StandardCommand") {
          throw new TypeError("Expected direct command");
        }
        assert.equal(command.options.stdin, "ignore");
        assert.equal(command.options.shell, false);
        const helper = command.command === "/bin/kill";
        if (helper) signals.push(command.args[1]);
        const stdout = helper
          ? Stream.empty
          : Stream.make(new TextEncoder().encode("{}"));
        return ChildProcessSpawner.makeHandle({
          pid: ChildProcessSpawner.ProcessId(42),
          exitCode: !helper && mode === "timeout"
            ? Effect.never
            : Effect.succeed(ChildProcessSpawner.ExitCode(0)),
          isRunning: Effect.succeed(false),
          kill: () => Effect.void,
          stdin: Sink.drain,
          stdout,
          stderr: helper ? Stream.empty : stdout,
          all: stdout,
          getInputFd: () => Sink.drain,
          getOutputFd: () => Stream.empty,
          unref: Effect.succeed(Effect.void),
        });
      })
    );
    const result = await Effect.runPromise(
      Effect.gen(function* () {
        const fiber = yield* execute({
          ...call("/fake/provider"),
          maxOutputBytes: mode === "overflow" ? 3 : 100,
        }).pipe(Effect.result, Effect.forkChild);
        yield* TestClock.adjust("31 seconds");
        return yield* Fiber.join(fiber);
      }).pipe(
        Effect.provide(TestClock.layer()),
        Effect.provideService(ChildProcessSpawner.ChildProcessSpawner, spawner),
        Effect.provideService(
          ConfigProvider.ConfigProvider,
          ConfigProvider.fromEnvRecord({}),
        ),
      ),
    );
    assert.deepEqual(signals, ["TERM", "KILL"]);
    if (mode === "success") {
      assert.equal(result._tag, "Success");
      if (result._tag === "Success") assert.equal(result.success, "{}");
    } else {
      assert.equal(result._tag, "Failure");
      if (result._tag === "Failure") {
        assert.equal(
          result.failure.error,
          mode === "overflow" ? "OutputLimit" : "CommandTimeout",
        );
      }
    }
  });
}
Deno.test("receipt loader refuses symlink drift with a zero-permission filesystem layer", async () => {
  const none = Option.none();
  const result = await Effect.runPromise(
    loadDocument(Receipt, "/state/receipt.json").pipe(
      Effect.result,
      Effect.provide(TestPath.layer),
      Effect.provide(TestFileSystem.layerNoop({
        realPath: () => Effect.succeed("/other/receipt.json"),
        stat: () =>
          Effect.succeed({
            type: "File",
            mode: 0o600,
            size: ByteSize.bytes(10),
            dev: 1,
            mtime: none,
            atime: none,
            birthtime: none,
            ino: none,
            nlink: none,
            uid: none,
            gid: none,
            rdev: none,
            blksize: none,
            blocks: none,
          }),
        stream: () =>
          Stream.die("Receipt bytes must not be read through a symlink"),
      })),
    ),
  );
  assert.equal(result._tag, "Failure");
  if (result._tag === "Failure") {
    assert.equal(
      result.failure instanceof BoundaryError && result.failure.error,
      "UnsafePath",
    );
  }
});

