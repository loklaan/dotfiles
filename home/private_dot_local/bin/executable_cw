const ZSH_COMPLETION = String.raw`#compdef cw

_cw() {
  local -a subcommands
  subcommands=(
    'connect:Attach to a workspace (ssh/tmux/vscode/claude/app)'
    'tmux:Attach to a persistent tmux session on a workspace'
    'fleet:Run a mise task across running workspaces'
    'migrate:Pull working state from an old devbox to a new one'
    'completion:Output shell completion script'
  )

  _cw_workspaces() {
    local -a workspaces
    if command -v coder >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      workspaces=("\${(@f)$(coder list -o json 2>/dev/null | jq -r '.[].name')}")
    fi
    _describe 'workspace' workspaces
  }

  _cw_modes() {
    local ws="$1"
    local -a modes=(
      'ssh:SSH into workspace'
      'tmux:Attach or create a persistent tmux session'
      'vscode:Open in VS Code'
      'claude:SSH + Claude Code'
      'ccyolo:SSH + Claude Code YOLO mode'
    )
    if command -v coder >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      local -a apps
      apps=("\${(@f)$(coder list -o json 2>/dev/null | jq -r --arg ws "$ws" '
        .[] | select(.name == $ws)
        | .latest_build.resources[].agents[]?.apps[]?
        | .slug + ":" + .display_name
      ' 2>/dev/null)}")
      [[ \${#apps} -gt 0 && -n "\${apps[1]}" ]] && modes+=("\${apps[@]}")
    fi
    _describe 'mode' modes
  }

  _cw_mise_tasks() {
    local -a tasks
    if command -v mise >/dev/null 2>&1; then
      tasks=("\${(@f)$(mise tasks ls --no-header 2>/dev/null | awk '{print $1}')}")
    fi
    _describe 'mise task' tasks
  }

  local sub="\${words[2]}"

  case "$sub" in
    connect)
      if [[ "$words[CURRENT]" == -* ]]; then
        _describe 'option' '(
           -L:Listen: LOCAL PORT → REMOTE HOST:PORT
           --local-forward:Listen: LOCAL PORT → REMOTE HOST:PORT
           -R:Listen: REMOTE PORT → LOCAL HOST:PORT
           --remote-forward:Listen: REMOTE PORT → LOCAL HOST:PORT
        )'
        return
      fi
      case $CURRENT in
        3) _cw_workspaces ;;
        4) _cw_modes "$words[3]" ;;
        5) _message 'remote directory path (optional)' ;;
      esac
      ;;
    tmux)
      if [[ "$words[CURRENT]" == -* ]]; then
        _describe 'option' '(
           -L:Listen: LOCAL PORT → REMOTE HOST:PORT
           --local-forward:Listen: LOCAL PORT → REMOTE HOST:PORT
           -R:Listen: REMOTE PORT → LOCAL HOST:PORT
           --remote-forward:Listen: REMOTE PORT → LOCAL HOST:PORT
        )'
        return
      fi
      case $CURRENT in
        3) _cw_workspaces ;;
        4) _message 'remote directory path (optional)' ;;
      esac
      ;;
    fleet)
      local -a fleet_opts=(
        '--include-local:Also run on this machine'
        '--local-only:Run only on this machine'
        '--filter:jq expression that outputs workspace names'
        '--parallel:Max concurrent SSH targets'
        '--dry-run:Print the matrix; do not execute'
      )
      if [[ "$words[CURRENT]" == -* ]]; then
        _describe 'option' fleet_opts
      else
        _cw_mise_tasks
      fi
      ;;
    migrate)
      _describe 'option' '(--manifest:Custom manifest file)'
      ;;
    completion)
      _describe 'shell' '(zsh:zsh completion)'
      ;;
    *)
      if [[ "$words[CURRENT]" == -* ]]; then
        _describe 'option' '(
           -L:Listen: LOCAL PORT → REMOTE HOST:PORT
           --local-forward:Listen: LOCAL PORT → REMOTE HOST:PORT
           -R:Listen: REMOTE PORT → LOCAL HOST:PORT
           --remote-forward:Listen: REMOTE PORT → LOCAL HOST:PORT
        )'
      elif [[ $CURRENT -eq 2 ]]; then
        _describe 'subcommand' subcommands
        _cw_workspaces
      elif [[ $CURRENT -eq 3 ]]; then
        _cw_modes "$words[2]"
      elif [[ $CURRENT -eq 4 ]]; then
        _message 'remote directory path (optional)'
      fi
      ;;
  esac
}

_cw "$@"
`;

// ============================================================================
// Small platform helpers
// ============================================================================

interface CommandResult {
  readonly code: number;
  readonly stdout: string;
  readonly stderr: string;
}

type StdioOption = "inherit" | "piped" | "null";

interface RunOptions {
  readonly stdin?: StdioOption;
  readonly stdout?: StdioOption;
  readonly stderr?: StdioOption;
  readonly input?: string;
  readonly cwd?: string;
  readonly detached?: boolean;
}

const text = new TextEncoder();

const pipeInput = (value: string): Stream.Stream<Uint8Array> =>
  Stream.make(text.encode(value));

const stdinOption = (
  options: RunOptions,
): ChildProcess.CommandOptions["stdin"] =>
  options.input !== undefined
    ? pipeInput(options.input)
    : options.stdin === "inherit"
    ? "inherit"
    : options.stdin === "piped"
    ? "pipe"
    : "ignore";

const outputOption = (
  option: StdioOption | undefined,
): ChildProcess.CommandOptions["stdout"] =>
  option === "inherit" ? "inherit" : option === "null" ? "ignore" : "pipe";

const streamText = (stream: Stream.Stream<Uint8Array, unknown>) =>
  stream.pipe(
    Stream.decodeText(),
    Stream.runFold(() => "", (acc, chunk) => acc + chunk),
    Effect.orElseSucceed(() => ""),
  );

const runCommand = (
  spawner: ChildProcessSpawner.ChildProcessSpawner["Service"],
  cmd: string,
  args: ReadonlyArray<string>,
  options: RunOptions = {},
): Effect.Effect<CommandResult> =>
  Effect.gen(function* () {
    const handle = yield* spawner.spawn(
      ChildProcess.make(cmd, args, {
        cwd: options.cwd,
        detached: options.detached,
        stdin: stdinOption(options),
        stdout: outputOption(options.stdout),
        stderr: outputOption(options.stderr),
      }),
    );
    const collected = yield* Effect.all({
      stdout: streamText(handle.stdout),
      stderr: streamText(handle.stderr),
      code: handle.exitCode,
    }, { concurrency: "unbounded" });
    return {
      code: Number(collected.code),
      stdout: collected.stdout,
      stderr: collected.stderr,
    };
  }).pipe(
    Effect.scoped,
    Effect.orElseSucceed(() => ({ code: 127, stdout: "", stderr: "" })),
  );

const runChild = (
  cmd: string,
  args: ReadonlyArray<string>,
  options?: RunOptions,
): Effect.Effect<
  CommandResult,
  never,
  ChildProcessSpawner.ChildProcessSpawner
> =>
  Effect.gen(function* () {
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    return yield* runCommand(spawner, cmd, args, options);
  });

const consoleValue = (value: string): string =>
  value.endsWith("\n") ? value.slice(0, -1) : value;

const writeStdout = (value: string): Effect.Effect<void> =>
  Console.log(consoleValue(value));

const writeStderr = (value: string): Effect.Effect<void> =>
  Console.error(consoleValue(value));

const exitWith = (code: number): Effect.Effect<never> =>
  Effect.sync(() => Deno.exit(code)) as Effect.Effect<never>;

const logInfo = (value: string): Effect.Effect<void> =>
  Effect.sync(() => info(value));

const logWarning = (value: string): Effect.Effect<void> =>
  Effect.sync(() => warning(value));

const logError = (value: string): Effect.Effect<void> =>
  Effect.sync(() => error(value));

const tmpdir = Config.string("TMPDIR").pipe(
  Config.withDefault("/tmp"),
  Effect.orDie,
  Effect.map((value) => value.replace(/\/$/, "")),
);

const home = Config.string("HOME").pipe(Config.withDefault(""), Effect.orDie);

const pad2 = (n: number): string => n.toString().padStart(2, "0");
const timestamp = (): string => {
  const d = new Date();
  return `${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}_` +
    `${pad2(d.getHours())}${pad2(d.getMinutes())}${pad2(d.getSeconds())}`;
};

const shellQuote = (value: string): string =>
  value === "" ? "''" : `'${value.replaceAll("'", `'\\''`)}'`;

// Wrap a remote command in a login zsh. Bare `ssh <host> <cmd>` runs the
// account's shell non-interactively and non-login — and not necessarily zsh at
// all — so it can miss the repo-managed environment and its mise shims.
// Naming /usr/bin/zsh guarantees zsh, which sources .zshenv on every
// invocation; `-l` additionally supplies the login-shell startup contract
// (.zprofile/.zlogin). That matters most for anything long-lived: a tmux
// server captures its environment once, and every later attach inherits it.
const remoteZshCommand = (cmd: string): string =>
  `/usr/bin/zsh -lc ${shellQuote(cmd)}`;

const maxCode = (codes: ReadonlyArray<number>): number =>
  codes.reduce((max, code) => Math.max(max, code), 0);

const mkdirp = (path: string) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    yield* fs.makeDirectory(path, { recursive: true });
  }).pipe(
    Effect.mapError((cause) =>
      new Error(`failed to create ${path}: ${String(cause)}`)
    ),
  );

const writeTextFile = (
  path: string,
  value: string,
) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    yield* fs.writeFileString(path, value);
  }).pipe(
    Effect.mapError((cause) =>
      new Error(`failed to write ${path}: ${String(cause)}`)
    ),
  );

const readTextFile = (path: string) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    return yield* fs.readFileString(path);
  }).pipe(Effect.orElseSucceed(() => null));

const fileExists = (path: string) =>
  Effect.gen(function* () {
    const fs = yield* FileSystem;
    yield* fs.stat(path);
    return true;
  }).pipe(Effect.orElseSucceed(() => false));

const hasCommand = (cmd: string) =>
  Effect.gen(function* () {
    if (cmd.includes("/")) return yield* fileExists(cmd);
    const pathEnv = yield* Config.string("PATH").pipe(Config.withDefault(""));
    const path = yield* Path;
    for (const dir of pathEnv.split(":")) {
      if (dir !== "" && (yield* fileExists(path.join(dir, cmd)))) return true;
    }
    return false;
  }).pipe(Effect.orElseSucceed(() => false));

const requireCommand = (cmd: string, message: string) =>
  Effect.gen(function* () {
    if (!(yield* hasCommand(cmd))) fatal(message);
  });

// ============================================================================
// Coder JSON schema
// ============================================================================

const CoderWorkspace = Schema.Struct({
  name: Schema.String,
  latest_build: Schema.Struct({
    status: Schema.String,
    resources: Schema.optional(Schema.Array(Schema.Unknown)),
  }),
});
type CoderWorkspace = typeof CoderWorkspace.Type;

const CoderWorkspaces = Schema.Array(CoderWorkspace);
const decodeWorkspaces = Schema.decodeUnknownSync(CoderWorkspaces);

const parseJson = (value: string): unknown => JSON.parse(value) as unknown;

const coderListJson = (): Effect.Effect<
  string,
  Error,
  ChildProcessSpawner.ChildProcessSpawner
> =>
  runChild("coder", ["list", "-o", "json"]).pipe(
    Effect.flatMap((res) =>
      res.code === 0
        ? Effect.succeed(res.stdout)
        : Effect.fail(new Error("coder list failed"))
    ),
  );

const listCoderWorkspaces = (): Effect.Effect<
  ReadonlyArray<CoderWorkspace>,
  Error,
  ChildProcessSpawner.ChildProcessSpawner
> =>
  coderListJson().pipe(
    Effect.flatMap((json) =>
      Effect.try({
        try: () => decodeWorkspaces(parseJson(json)),
        catch: (cause) =>
          new Error(`failed to decode coder list: ${String(cause)}`),
      })
    ),
  );

const isRunning = (ws: CoderWorkspace): boolean =>
  ws.latest_build.status === "running";

const coderIsRunning = (name: string) =>
  listCoderWorkspaces().pipe(
    Effect.map((workspaces) =>
      workspaces.some((ws) => ws.name === name && isRunning(ws))
    ),
    Effect.orElseSucceed(() => false),
  );

// ============================================================================
// Coder Connect dead-datapath diagnostic
// ============================================================================

// When the system-wide Coder Connect VPN is running, `coder ssh --stdio` dials
// the workspace's tailnet address (fd60::/8 ULA) directly through the VPN
// datapath instead of opening a per-session agent tunnel. If that VPN datapath
// is wedged (e.g. CoderVPN toggled on but not actually active, path-MTU
// breakage), the dial hangs and times out with an opaque
// "dial tcp [fd60:...]:22: operation timed out" — even though the workspace
// agent itself is perfectly reachable over the classic P2P path.
//
// We detect Coder Connect being active by the presence of an fd60::/8 address
// on a tunnel interface — no subprocess needed (Deno.networkInterfaces). The
// classic path's health is probed separately with `coder ping`. The pure
// decision below combines the two signals so it can be unit-tested offline.

const coderConnectActive = Effect.sync(() => {
  try {
    return Deno.networkInterfaces().some((iface) =>
      iface.family === "IPv6" &&
      iface.name.startsWith("utun") &&
      iface.address.toLowerCase().startsWith("fd60:")
    );
  } catch {
    return false;
  }
});

// Classic agent reachability — a single short ping over the P2P datapath. This
// path is independent of the Coder Connect VPN datapath, so a success here
// while ssh failed is the smoking gun for a dead Connect tunnel.
const coderAgentReachable = (ws: string) =>
  runChild("coder", ["ping", "-n", "1", "-t", "5s", ws], {
    stdout: "null",
    stderr: "null",
  }).pipe(Effect.map((res) => res.code === 0));

// Pure decision: print the dead-datapath hint only when we can CONFIRM the
// split — Connect is active, ssh failed, and the classic agent path is healthy.
const shouldHintDeadDatapath = (
  sshExitCode: number,
  connectActive: boolean,
  agentReachable: boolean,
): boolean => sshExitCode !== 0 && connectActive && agentReachable;

const deadDatapathHint = (ws: string): string =>
  `\nCoder Connect is on, but its VPN datapath to '${ws}' is not carrying traffic\n` +
  `(the agent is reachable over the classic path, but ssh-over-Connect timed out).\n` +
  `Fix: toggle Coder Connect off and back on in Coder Desktop (or quit and reopen\n` +
  `the app). If it persists, restart Coder Desktop entirely, then retry 'cw ${ws}'.`;

// Runs after an ssh-mode connection exits non-zero. Cheap on the happy path
// (never called). On failure, probes both datapaths and surfaces the actionable
// hint only when the dead-Connect signature is confirmed.
const diagnoseConnectFailure = (
  ws: string,
  sshExitCode: number,
  enabled: boolean,
) =>
  Effect.gen(function* () {
    if (!enabled || sshExitCode === 0) return;
    const connectActive = yield* coderConnectActive;
    if (!connectActive) return;
    const agentReachable = yield* coderAgentReachable(ws);
    if (shouldHintDeadDatapath(sshExitCode, connectActive, agentReachable)) {
      yield* logWarning(deadDatapathHint(ws));
    }
  });

// ============================================================================
// connect — HAND-OVER terminal attach
// ============================================================================

// `new-session -A` attaches when the session exists and creates it otherwise.
// The directory is applied with a `cd` rather than tmux's own `-c`, because
// `-c` is only honoured on the create path — on an attach it is silently
// ignored, so a directory argument would do nothing whenever the session is
// already up.
const tmuxRemoteCommand = (directory: string): string => {
  const attach = `tmux new-session -A -s ${shellQuote(TMUX_DEFAULT_SESSION)}`;
  return directory === "" ? attach : `cd ${shellQuote(directory)} && ${attach}`;
};

// Modes that hand the local terminal to a remote interactive SSH session.
// These are the modes that need the GPG/terminfo/pubkey preflight, and the
// ones whose non-zero exit is worth running the dead-datapath diagnostic over.
const usesSshTerminal = (mode: string): boolean =>
  ["ssh", "claude", "ccyolo", "tmux"].includes(mode);

const remoteForwardMessage = (forward: string): string => {
  const match = /^([^:]+):(.+):([^:]+)$/.exec(forward);
  return match === null
    ? `🔌  Forwarding remote port ${forward}`
    : `🔌  Forwarding remote port ${match[1]} → ${match[2]}:${match[3]}`;
};

const localForwardMessage = (forward: string): string => {
  const match = /^([^:]+):(.+):([^:]+)$/.exec(forward);
  return match === null
    ? `🔌  Forwarding local port ${forward}`
    : `🔌  Forwarding local port ${match[1]} → workspace ${match[2]}:${
      match[3]
    }`;
};

interface ConnectForwards {
  readonly local: ReadonlyArray<string>;
  readonly remote: ReadonlyArray<string>;
}

const noConnectForwards: ConnectForwards = { local: [], remote: [] };

interface ConnectEnv {
  readonly log: boolean;
  readonly preflight: boolean;
  readonly checkCommands: boolean;
  readonly diagnostics: boolean;
}

const defaultConnectEnv: ConnectEnv = {
  log: true,
  preflight: true,
  checkCommands: true,
  diagnostics: true,
};

const gpgSshOptionsFromPreflightOutput = (
  output: string,
  localSocket: string,
): ReadonlyArray<string> => {
  const options: string[] = [];
  for (const line of output.split(/\r?\n/)) {
    if (line.startsWith("GPG_SOCKET:")) {
      const remoteSocket = line.slice("GPG_SOCKET:".length);
      if (remoteSocket !== "" && localSocket !== "") {
        options.push("-o", "StreamLocalBindUnlink=yes");
        options.push("-o", `RemoteForward ${remoteSocket}:${localSocket}`);
      }
    } else if (line === "TERMINFO_OK:1") {
      options.push(
        "-o",
        "SendEnv TERM_PROGRAM -o SendEnv TERM_PROGRAM_VERSION -o SendEnv COLORTERM",
      );
    }
  }
  return options;
};

const coderPreflight = (
  env: ConnectEnv,
  host: string,
) =>
  Effect.gen(function* () {
    if (!env.preflight) return [];

    let script = "";
    let gpgLocalSocket = "";

    if ((yield* hasCommand("gpgconf")) && (yield* hasCommand("gpg"))) {
      const socketRes = yield* runChild("gpgconf", [
        "--list-dirs",
        "agent-extra-socket",
      ]);
      gpgLocalSocket = socketRes.code === 0 ? socketRes.stdout.trim() : "";
      if (gpgLocalSocket !== "") {
        yield* runChild("gpgconf", ["--launch", "gpg-agent"], {
          stdout: "null",
          stderr: "null",
        });
        const pubkeys = yield* runChild("gpg", ["--armor", "--export"], {
          stderr: "null",
        });
        const ownertrust = yield* runChild(
          "gpg",
          ["--export-ownertrust"],
          {
            stderr: "null",
          },
        );
        if (pubkeys.code === 0 && pubkeys.stdout !== "") {
          yield* logInfo("🔑  Forwarding GPG agent…");
          const pubkeysB64 = btoa(pubkeys.stdout);
          const ownertrustB64 = ownertrust.code === 0
            ? btoa(ownertrust.stdout)
            : "";
          script += `(
gpg_socket=$(gpgconf --list-dirs agent-socket 2>/dev/null) || exit 0
gpgconf --kill gpg-agent 2>/dev/null || true
[ -S "$gpg_socket" ] && rm -f "$gpg_socket"
sleep 1
printf '%s' '${pubkeysB64}' | base64 -d | gpg --batch --import 2>/dev/null || true
printf '%s' '${ownertrustB64}' | base64 -d | gpg --batch --import-ownertrust 2>/dev/null || true
gpgconf --kill gpg-agent 2>/dev/null || true
[ -S "$gpg_socket" ] && rm -f "$gpg_socket"
echo "GPG_SOCKET:${"${gpg_socket}"}"
)
`;
        }
      }
    }

    const ghosttyResources = yield* Config.string("GHOSTTY_RESOURCES_DIR").pipe(
      Config.withDefault(""),
    );
    if (ghosttyResources !== "") {
      const homebrewPrefix = yield* Config.string("HOMEBREW_PREFIX").pipe(
        Config.withDefault("/opt/homebrew"),
      );
      const path = yield* Path;
      const infocmp = path.join(homebrewPrefix, "opt/ncurses/bin/infocmp");
      if (yield* fileExists(infocmp)) {
        const terminfo = yield* runChild(
          infocmp,
          ["-x", "xterm-ghostty"],
          {
            stderr: "null",
          },
        );
        if (terminfo.code === 0 && terminfo.stdout !== "") {
          yield* logInfo("🖥️  Installing xterm-ghostty terminfo…");
          script += `(printf '%s' '${
            btoa(terminfo.stdout)
          }' | base64 -d | tic -x - 2>/dev/null && echo 'TERMINFO_OK:1' || echo 'TERMINFO_OK:0')\n`;
        }
      }
    }

    // Copy public identities for tools that require a key file without forwarding
    // SSH_AUTH_SOCK, which would let remote processes use the local agent.
    const sshAdd = yield* runChild("ssh-add", ["-L"], {
      stdout: "piped",
      stderr: "null",
    });
    if (sshAdd.code === 0) {
      yield* logInfo("🔑  Forwarding SSH public key…");
      script += `(
mkdir -p ~/.ssh
if ssh-add -L > ~/.ssh/id_rsa.pub 2>/dev/null; then
  chmod 644 ~/.ssh/id_rsa.pub
  echo "SSH_PUBKEY_OK:1"
else
  rm -f ~/.ssh/id_rsa.pub
  echo "SSH_PUBKEY_OK:0"
fi
)
`;
    }

    if (script === "") return [];

    const opts = ["-o", "ConnectTimeout=10"];
    const homeDir = yield* home;
    if (yield* fileExists(`${homeDir}/.ssh/coder.conf.sh`)) {
      opts.push("-o", "PermitLocalCommand=no", "-o", "ClearAllForwardings=yes");
    }
    const preflight = yield* runChild("ssh", [...opts, host, "/bin/sh"], {
      input: script,
      stdin: "piped",
      stdout: "piped",
      stderr: "null",
    });
    if (preflight.code !== 0) return [];
    return gpgSshOptionsFromPreflightOutput(preflight.stdout, gpgLocalSocket);
  }).pipe(Effect.orElseSucceed(() => []));

const connectCommand = (
  args: ReadonlyArray<string>,
  env: ConnectEnv = defaultConnectEnv,
  forwards: ConnectForwards = noConnectForwards,
) =>
  Effect.gen(function* () {
    if (args[0] === "--help") {
      yield* writeStdout(CONNECT_USAGE);
      return 0;
    }
    if (args.length < 1) {
      yield* writeStderr(CONNECT_USAGE);
      fatal("connect requires a workspace name");
    }
    if (env.checkCommands) {
      yield* requireCommand("coder", "coder CLI not found");
    }

    const ws = args[0];
    const mode = args[1] ?? "ssh";
    const directory = args[2] ?? "";

    if (!(yield* coderIsRunning(ws))) {
      yield* logInfo(`workspace '${ws}' is not running — starting it…`);
      const start = yield* runChild("coder", ["start", ws], {
        stdin: "inherit",
        stdout: "inherit",
        stderr: "inherit",
      });
      if (start.code !== 0) return start.code;
    }

    const host = `coder.${ws}`;
    const sshOpts = usesSshTerminal(mode)
      ? yield* coderPreflight(env, host)
      : [];
    const localForwardOpts = forwards.local.flatMap((forward) => [
      "-L",
      forward,
    ]);
    const remoteForwardOpts = forwards.remote.flatMap((forward) => [
      "-R",
      forward,
    ]);
    const hasRequestedForwards = forwards.local.length > 0 ||
      forwards.remote.length > 0;
    const forwardFailureOpts = hasRequestedForwards
      ? ["-o", "ExitOnForwardFailure=yes"]
      : [];
    const diagnoseSshFailure = env.diagnostics && !hasRequestedForwards;
    if (env.log) {
      for (const forward of forwards.local) {
        yield* logInfo(localForwardMessage(forward));
      }
      for (const forward of forwards.remote) {
        yield* logInfo(remoteForwardMessage(forward));
      }
    }

    switch (mode) {
      case "ssh": {
        const remote = directory === ""
          ? "/usr/bin/zsh -l"
          : `cd ${shellQuote(directory)} && /usr/bin/zsh -l`;
        const res = yield* runChild("ssh", [
          "-tt",
          ...forwardFailureOpts,
          ...sshOpts,
          ...localForwardOpts,
          ...remoteForwardOpts,
          host,
          remote,
        ], {
          detached: true,
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
        });
        yield* diagnoseConnectFailure(ws, res.code, diagnoseSshFailure);
        return res.code;
      }
      case "tmux": {
        // The whole point of the tmux mode is a session that outlives the
        // connection, so the environment its server captures on first launch
        // has to be the login-shell one — hence remoteZshCommand, never a bare
        // remote `tmux`.
        const res = yield* runChild("ssh", [
          "-tt",
          ...forwardFailureOpts,
          ...sshOpts,
          ...localForwardOpts,
          ...remoteForwardOpts,
          host,
          remoteZshCommand(tmuxRemoteCommand(directory)),
        ], {
          detached: true,
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
        });
        yield* diagnoseConnectFailure(ws, res.code, diagnoseSshFailure);
        return res.code;
      }
      case "vscode": {
        const vscodeArgs = ["open", "vscode", "--generate-token", ws];
        if (directory !== "") vscodeArgs.push(directory);
        yield* logInfo(
          `Opening VS Code: ${ws}${directory ? ` at ${directory}` : ""}`,
        );
        const res = yield* runChild("coder", vscodeArgs, {
          detached: true,
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
        });
        return res.code;
      }
      case "claude":
      case "ccyolo": {
        const base = mode === "claude"
          ? "claude"
          : "claude --dangerously-skip-permissions --permission-mode bypassPermissions --model global.anthropic.claude-opus-4-7";
        const cmd = directory === ""
          ? base
          : `cd ${shellQuote(directory)} && ${base}`;
        const res = yield* runChild("ssh", [
          "-tt",
          ...forwardFailureOpts,
          ...sshOpts,
          ...localForwardOpts,
          ...remoteForwardOpts,
          host,
          "/usr/bin/zsh",
          "-lc",
          cmd,
        ], {
          detached: true,
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
        });
        yield* diagnoseConnectFailure(ws, res.code, diagnoseSshFailure);
        return res.code;
      }
      default: {
        if (directory !== "") {
          yield* logError(
            `Coder's generic app opener cannot accept a remote path; use vscode for path-aware opening or open ${mode} and select ${directory} manually`,
          );
          return 2;
        }
        const appArgs = ["open", "app", ws, mode];
        yield* logInfo(`Opening ${mode}: ${ws}`);
        const res = yield* runChild("coder", appArgs, {
          detached: true,
          stdin: "inherit",
          stdout: "inherit",
          stderr: "inherit",
        });
        return res.code;
      }
    }
  });

// ============================================================================
// fleet — bounded FAN-OUT
// ============================================================================

const DEFAULT_FLEET_FILTER =
  '.[] | select(.latest_build.status == "running") | .name';

interface FleetOptions {
  readonly includeLocal: boolean;
  readonly localOnly: boolean;
  readonly filter: string;
  readonly parallel: number;
  readonly dryRun: boolean;
  readonly taskAndArgs: ReadonlyArray<string>;
}

// An omitted `Flag.boolean` fails as a missing required flag rather than
// resolving to `false`, so every boolean flag needs an explicit fallback.
const fleetIncludeLocalFlag = Flag.boolean("include-local").pipe(
  Flag.withDefault(false),
);
const fleetLocalOnlyFlag = Flag.boolean("local-only").pipe(
  Flag.withDefault(false),
);
const fleetFilterFlag = Flag.string("filter").pipe(
  Flag.withDefault(DEFAULT_FLEET_FILTER),
);
const fleetParallelFlag = Flag.integer("parallel").pipe(Flag.withDefault(4));
const fleetDryRunFlag = Flag.boolean("dry-run").pipe(Flag.withDefault(false));
const fleetHelpFlag = Flag.boolean("help").pipe(Flag.withDefault(false));
const fleetTaskArgs = Argument.string("mise-task").pipe(Argument.variadic());

const makeFleetCli = <A, E, R>(
  handler: (options: FleetOptions) => Effect.Effect<A, E, R>,
) =>
  Command.make("fleet", {
    includeLocal: fleetIncludeLocalFlag,
    localOnly: fleetLocalOnlyFlag,
    filter: fleetFilterFlag,
    parallel: fleetParallelFlag,
    dryRun: fleetDryRunFlag,
    help: fleetHelpFlag,
    taskAndArgs: fleetTaskArgs,
  }, ({ help, ...options }) =>
    help
      ? writeStdout(FLEET_USAGE).pipe(Effect.andThen(exitWith(0)))
      : handler(options));

interface FleetEnv {
  readonly checkCommands: boolean;
}

interface FleetTargetOk {
  readonly host: string;
  readonly code: 0;
  readonly logFile?: string;
}

interface FleetTargetFail {
  readonly host: string;
  readonly code: number;
  readonly logFile?: string;
}

type HostEither = Data.TaggedEnum<{
  Right: { readonly right: FleetTargetOk };
  Left: { readonly left: FleetTargetFail };
}>;
const HostEither = Data.taggedEnum<HostEither>();

const chooseDefaultFleetWorkspaces = (
  workspaces: ReadonlyArray<CoderWorkspace>,
): ReadonlyArray<string> => workspaces.filter(isRunning).map((ws) => ws.name);

const listFleetWorkspaces = (
  _env: FleetEnv,
  filter: string,
) =>
  Effect.gen(function* () {
    const json = yield* coderListJson();
    const workspaces = decodeWorkspaces(parseJson(json));
    if (filter === DEFAULT_FLEET_FILTER) {
      return chooseDefaultFleetWorkspaces(workspaces);
    }

    // Preserve the legacy --filter CLI as a jq expression. The JSON is still
    // schema-decoded first, so malformed coder output fails before jq runs.
    const jq = yield* runChild("jq", ["-r", filter], { input: json });
    if (jq.code !== 0) {
      return yield* Effect.fail(new Error(`jq filter failed (${jq.code})`));
    }
    return jq.stdout.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
  });

const fleetCommandString = (
  task: string,
  args: ReadonlyArray<string>,
): string =>
  [
    'export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"',
    `cd "$HOME/.local/share/chezmoi" && mise run ${shellQuote(task)} ${
      args.map(shellQuote).join(" ")
    }`.trimEnd(),
  ].join("; ");

const runFleetLocal = (
  _env: FleetEnv,
  options: FleetOptions,
  task: string,
  args: ReadonlyArray<string>,
) =>
  Effect.gen(function* () {
    yield* logInfo(
      `[local] mise run ${task} ${args.join(" ")}`.trimEnd(),
    );
    if (options.dryRun) {
      return HostEither.Right({ right: { host: "local", code: 0 } });
    }
    const res = yield* runChild("mise", ["run", task, ...args], {
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
    if (res.code === 0) {
      yield* writeStderr("[local] ok\n");
      return HostEither.Right({ right: { host: "local", code: 0 } });
    }
    yield* writeStderr(`[local] FAIL (${res.code})\n`);
    return HostEither.Left({
      left: { host: "local", code: res.code },
    });
  });

const runFleetRemote = (
  _env: FleetEnv,
  options: FleetOptions,
  ws: string,
  logDir: string,
  task: string,
  args: ReadonlyArray<string>,
) =>
  Effect.gen(function* () {
    const logFile = `${logDir}/${ws}.log`;
    const cmd = fleetCommandString(task, args);
    yield* logInfo(`[${ws}] ${cmd}`);
    if (options.dryRun) {
      return HostEither.Right({
        right: { host: ws, code: 0, logFile },
      });
    }
    const res = yield* runChild("ssh", [
      "-o",
      "ConnectTimeout=15",
      `coder.${ws}`,
      remoteZshCommand(cmd),
    ]);
    yield* writeTextFile(logFile, res.stdout + res.stderr);
    if (res.code === 0) {
      yield* writeStderr(`[${ws}] ok\n`);
      return HostEither.Right({
        right: { host: ws, code: 0, logFile },
      });
    }
    yield* writeStderr(`[${ws}] FAIL (${res.code}) — see ${logFile}\n`);
    return HostEither.Left({
      left: { host: ws, code: res.code, logFile },
    });
  });

const fleetResultCode = (results: ReadonlyArray<HostEither>): number =>
  maxCode(
    results.map((result) =>
      result._tag === "Right" ? result.right.code : result.left.code
    ),
  );

const fleetCommand = (
  options: FleetOptions,
  env: FleetEnv = { checkCommands: true },
) =>
  Effect.gen(function* () {
    if (options.parallel < 1) {
      yield* writeStderr(FLEET_USAGE);
      return fatal("--parallel must be a positive integer");
    }
    if (options.taskAndArgs.length === 0) {
      yield* writeStderr(FLEET_USAGE);
      fatal("no mise task specified");
    }

    if (env.checkCommands) yield* requireCommand("mise", "mise not on PATH");
    if (env.checkCommands && !options.localOnly) {
      yield* requireCommand(
        "coder",
        "coder CLI not found (needed for fleet dispatch)",
      );
      if (options.filter !== DEFAULT_FLEET_FILTER) {
        yield* requireCommand("jq", "jq not found");
      }
    }

    const [task, ...taskArgs] = options.taskAndArgs;
    const tmp = yield* tmpdir;
    const logDir = `${tmp}/cw-fleet-${timestamp()}`;
    return yield* Effect.acquireRelease(
      mkdirp(logDir).pipe(Effect.as(logDir)),
      () => Effect.void,
    ).pipe(
      Effect.flatMap((scopedLogDir) =>
        runFleetWithLogDir(env, options, task, taskArgs, scopedLogDir)
      ),
      Effect.scoped,
    );
  });

const runFleetWithLogDir = (
  env: FleetEnv,
  options: FleetOptions,
  task: string,
  taskArgs: ReadonlyArray<string>,
  logDir: string,
) =>
  Effect.gen(function* () {
    const localResults: HostEither[] = [];
    if (options.includeLocal || options.localOnly) {
      localResults.push(yield* runFleetLocal(env, options, task, taskArgs));
    }

    if (options.localOnly) {
      return fleetResultCode(localResults);
    }

    const workspaces = yield* listFleetWorkspaces(env, options.filter);
    if (workspaces.length === 0) {
      yield* logWarning("no running workspaces matched filter");
      return fleetResultCode(localResults);
    }

    yield* logInfo(
      `fan-out: ${workspaces.length} workspace(s) · parallelism=${options.parallel} · log_dir=${logDir}`,
    );
    const remoteResults = yield* Effect.forEach(
      workspaces,
      (ws) => runFleetRemote(env, options, ws, logDir, task, taskArgs),
      { concurrency: options.parallel },
    );

    const code = fleetResultCode([...localResults, ...remoteResults]);
    if (code === 0) {
      yield* writeStdout("cw fleet: all targets ok\n");
    } else {
      yield* writeStdout(
        `cw fleet: completed with ${code} max-rc — inspect ${logDir}\n`,
      );
    }
    return code;
  });

// ============================================================================
// migrate — supervised subprocess workflow
// ============================================================================

const MIGRATE_DEFAULT_PATHS = [
  "dev",
  ".claude",
  ".claude.json",
  ".zsh_history",
  ".z",
  ".local/share/tmux/resurrect",
];

const MIGRATE_DEFAULT_AUDIT_PATHS = ["dev"];

interface MigrateManifest {
  readonly migrate: ReadonlyArray<string>;
  readonly audit: ReadonlyArray<string>;
}

interface MigrateState extends MigrateManifest {
  readonly sourceHost: string;
  readonly existingPaths: ReadonlyArray<string>;
}

const defaultManifestPath = home.pipe(
  Effect.map((homeDir) => `${homeDir}/.config/cw-migrate/manifest`),
);

const migrateManifestFlag = Flag.string("manifest").pipe(
  Flag.withDescription("Custom manifest file"),
  Flag.withDefault(""),
);
const migrateHelpFlag = Flag.boolean("help").pipe(Flag.withDefault(false));

const parseManifest = (content: string): MigrateManifest => {
  let section = "";
  const migrate: string[] = [];
  const audit: string[] = [];
  for (const raw of content.split(/\r?\n/)) {
    const line = raw.replace(/#.*$/, "").trim();
    if (line === "") continue;
    const heading = /^\[(.+)]$/.exec(line);
    if (heading) {
      section = heading[1];
      continue;
    }
    if (section === "migrate") migrate.push(line);
    else if (section === "audit") audit.push(line);
    else console.error(`warning Unknown manifest section: [${section}]`);
  }
  if (migrate.length === 0) fatal("Manifest has no [migrate] entries");
  return { migrate, audit };
};

const loadMigrateManifest = (
  manifestPath: string,
) =>
  Effect.gen(function* () {
    const content = yield* readTextFile(manifestPath);
    if (content === null) {
      if (manifestPath === (yield* defaultManifestPath)) {
        yield* logInfo("╍ No manifest found, using defaults");
        return {
          migrate: MIGRATE_DEFAULT_PATHS,
          audit: MIGRATE_DEFAULT_AUDIT_PATHS,
        };
      }
      return fatal(`Manifest not found: ${manifestPath}`);
    }
    yield* logInfo(`╍ Loading manifest from ${manifestPath}`);
    return parseManifest(content);
  });

const promptRequired = (label: string): string => {
  const value = prompt(label) ?? "";
  return value.trim();
};

type MigrateSourceConnection = Data.TaggedEnum<{
  Connected: { readonly sourceHost: string };
  Failed: Record<never, never>;
}>;
const MigrateSourceConnection = Data.taggedEnum<MigrateSourceConnection>();

const connectMigrateSource = () =>
  Effect.gen(function* () {
    yield* writeStdout("\nSource devbox\n\n");
    yield* writeStdout("Enter the SSH host of the OLD devbox to pull from.\n");
    yield* writeStdout("  - Coder devbox:  coder.<workspace-name>\n");
    yield* writeStdout("  - Any SSH host:  user@hostname\n\n");
    const sourceHost = promptRequired("Source host: ");
    if (sourceHost === "") fatal("No source host specified");
    yield* logInfo(`› Testing SSH connection to ${sourceHost}`);
    const res = yield* runChild("ssh", [
      "-o",
      "ConnectTimeout=10",
      sourceHost,
      "echo ok",
    ], {
      stdout: "null",
      stderr: "null",
    });
    if (res.code !== 0) {
      yield* logError(`Cannot connect to ${sourceHost}`);
      yield* writeStderr("Try: coder config-ssh\n");
      return MigrateSourceConnection.Failed();
    }
    yield* logInfo("╍ Connection OK");
    return MigrateSourceConnection.Connected({ sourceHost });
  });

const remoteHereDoc = (values: ReadonlyArray<string>): string =>
  values.join("\n");

const auditRepos = (
  sourceHost: string,
  auditPaths: ReadonlyArray<string>,
) =>
  Effect.gen(function* () {
    if (auditPaths.length === 0) {
      yield* logInfo("╍ No audit paths configured, skipping repo check");
      return 0;
    }
    yield* writeStdout("\nChecking source repos for unpushed branches...\n\n");
    const paths = remoteHereDoc(auditPaths);
    const script = `set -euo pipefail
audit_paths=()
while IFS= read -r p; do
  [[ -z "\${p}" ]] && continue
  audit_paths+=("\${p}")
done <<< ${shellQuote(paths)}
for audit_path in "\${audit_paths[@]}"; do
  full_path="\${HOME}/\${audit_path}"
  if [[ ! -d "\${full_path}" ]]; then continue; fi
  while IFS= read -r git_dir; do
    [[ -z "\${git_dir}" ]] && continue
    repo_dir=$(dirname "\${git_dir}")
    repo_rel="\${repo_dir#\${HOME}/}"
    has_issues=false
    while IFS= read -r branch; do
      [[ -z "\${branch}" ]] && continue
      upstream_ref=$(git -C "\${repo_dir}" rev-parse --abbrev-ref "\${branch}@{upstream}" 2>/dev/null || true)
      if [[ -z "\${upstream_ref}" ]]; then
        echo "ISSUE|\${repo_rel}|\${branch} (no remote tracking branch)"
        has_issues=true
      else
        ahead_count=$(git -C "\${repo_dir}" rev-list --count "\${upstream_ref}..\${branch}" 2>/dev/null || echo "0")
        if [[ "\${ahead_count}" -gt 0 ]]; then
          echo "ISSUE|\${repo_rel}|\${branch} (\${ahead_count} unpushed commit(s))"
          has_issues=true
        fi
      fi
    done < <(git -C "\${repo_dir}" for-each-ref --format='%(refname:short)' refs/heads/)
    if [[ "\${has_issues}" == "false" ]]; then echo "OK|\${repo_rel}"; fi
  done < <(find "\${full_path}" -name .git -type d 2>/dev/null)
done
`;
    const res = yield* runChild("ssh", [sourceHost, "bash", "-s"], {
      input: script,
    });
    const output = res.stdout.trim();
    if (output === "") {
      yield* logInfo("╍ No git repos found in audit paths");
      return 0;
    }
    let hasUnpushed = false;
    let currentRepo = "";
    for (const line of output.split(/\r?\n/)) {
      const [status, repoPath, detail] = line.split("|");
      if (status === "OK") {
        yield* writeStdout(`  ~/${repoPath} — all branches pushed\n`);
      }
      if (status === "ISSUE") {
        if (repoPath !== currentRepo) {
          yield* writeStdout(`  ~/${repoPath}\n`);
          currentRepo = repoPath;
        }
        yield* writeStdout(`    [ ] ${detail}\n`);
        hasUnpushed = true;
      }
    }
    yield* writeStdout("\n");
    if (hasUnpushed) {
      yield* logWarning(
        "Unpushed branches found! Push them first or they will be lost.",
      );
      const confirm = promptRequired("Continue anyway? [y/N]: ");
      if (confirm !== "y" && confirm !== "Y") {
        yield* logInfo(
          "Aborted. Push branches on the source and re-run.",
        );
        return 1;
      }
    } else {
      yield* logInfo("╍ All repo branches are pushed");
    }
    return 0;
  });

const validateMigratePaths = (
  sourceHost: string,
  paths: ReadonlyArray<string>,
) =>
  Effect.gen(function* () {
    const script = `set -euo pipefail
while IFS= read -r path; do
  [[ -z "\${path}" ]] && continue
  if [[ -e "\${HOME}/\${path}" ]]; then echo "EXISTS|\${path}"; else echo "MISSING|\${path}"; fi
done <<< ${shellQuote(remoteHereDoc(paths))}
`;
    const res = yield* runChild("ssh", [sourceHost, "bash", "-s"], {
      input: script,
    });
    const existing: string[] = [];
    for (const line of res.stdout.split(/\r?\n/)) {
      const [status, path] = line.split("|");
      if (status === "EXISTS") existing.push(path);
      if (status === "MISSING") {
        yield* logWarning(`Not found on source: ~/${path}`);
      }
    }
    yield* logInfo(
      `╍ Found ${existing.length}/${paths.length} items to migrate`,
    );
    if (existing.length === 0) fatal("Nothing to migrate!");
    return existing;
  });

const showMigrateSummary = (
  sourceHost: string,
  paths: ReadonlyArray<string>,
) =>
  Effect.gen(function* () {
    yield* writeStdout("\nItems to migrate:\n\n");
    const script = `set -euo pipefail
size_args=()
while IFS= read -r path; do
  [[ -z "\${path}" ]] && continue
  size=$(du -sh "\${HOME}/\${path}" 2>/dev/null | cut -f1)
  echo "\${path}|\${size}"
  size_args+=("\${HOME}/\${path}")
done <<< ${shellQuote(remoteHereDoc(paths))}
total=$(du -shc "\${size_args[@]}" 2>/dev/null | tail -1 | cut -f1)
echo "TOTAL|\${total}"
`;
    const res = yield* runChild("ssh", [sourceHost, "bash", "-s"], {
      input: script,
    });
    for (const line of res.stdout.split(/\r?\n/)) {
      if (line === "") continue;
      const [path, size] = line.split("|");
      if (path === "TOTAL") yield* writeStdout(`\n  Total: ${size}\n`);
      else yield* writeStdout(`  ${`~/${path}`.padEnd(45)} ${size}\n`);
    }
    yield* writeStdout("\n");
  });

const parentOf = (path: string): string => {
  const idx = path.lastIndexOf("/");
  return idx === -1 ? "." : path.slice(0, idx);
};

const doRsync = (state: MigrateState) =>
  Effect.gen(function* () {
    yield* writeStdout("\n");
    yield* logWarning(
      "This will overwrite matching paths locally. Continue? [y/N]",
    );
    const confirm = promptRequired("");
    if (confirm !== "y" && confirm !== "Y") {
      yield* logInfo("Aborted");
      return 0;
    }
    yield* logInfo("› Creating local directory structure");
    for (const path of state.existingPaths) {
      const parent = parentOf(path);
      const homeDir = yield* home;
      if (parent !== ".") yield* mkdirp(`${homeDir}/${parent}`);
    }
    let failed = 0;
    for (const path of state.existingPaths) {
      const parent = parentOf(path);
      const homeDir = yield* home;
      const localDir = parent === "." ? `${homeDir}/` : `${homeDir}/${parent}/`;
      yield* logInfo(`╍ Pulling ~/${path}`);
      const res = yield* runChild("rsync", [
        "-az",
        `${state.sourceHost}:~/${path}`,
        localDir,
      ], {
        stdin: "inherit",
        stdout: "inherit",
        stderr: "inherit",
      });
      if (res.code === 0) yield* writeStdout("    done\n");
      else {
        yield* logError(`Failed to pull ~/${path}`);
        failed++;
      }
    }
    yield* writeStdout("\n");
    if (failed === 0) {
      yield* logInfo(
        `› Migration complete! All ${state.existingPaths.length} items pulled.`,
      );
    } else {
      yield* logWarning(`Migration finished with ${failed} failure(s)`);
    }
    return failed === 0 ? 0 : 1;
  });

const doTar = (state: MigrateState) =>
  Effect.gen(function* () {
    const archiveName = `devbox-migration-${timestamp()}.tar.gz`;
    const remoteArchive = `/tmp/${archiveName}`;
    yield* writeStdout("\nCreating tar archive on source\n\n");
    const script = `set -euo pipefail
paths=()
while IFS= read -r path; do
  [[ -z "\${path}" ]] && continue
  paths+=("\${path}")
done <<< ${shellQuote(remoteHereDoc(state.existingPaths))}
tar -czf ${shellQuote(remoteArchive)} -C "\${HOME}" "\${paths[@]}"
`;
    yield* logInfo(`› Creating archive on ${state.sourceHost}`);
    let res = yield* runChild("ssh", [state.sourceHost, "bash", "-s"], {
      input: script,
      stdin: "piped",
      stdout: "inherit",
      stderr: "inherit",
    });
    if (res.code !== 0) return res.code;
    yield* logInfo("╍ Pulling archive");
    res = yield* runChild("scp", [
      `${state.sourceHost}:${remoteArchive}`,
      `/tmp/${archiveName}`,
    ], {
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
    if (res.code !== 0) return res.code;
    const size = yield* runChild("du", ["-sh", `/tmp/${archiveName}`]);
    yield* logInfo(
      `╍ Archive saved: /tmp/${archiveName} (${
        size.stdout.split(/\s+/, 1)[0] ?? "?"
      })`,
    );
    yield* writeStdout(
      "\nTo extract:\n  cd ~ && tar -xzf /tmp/${archiveName}\n\n",
    );
    yield* logInfo("╍ Cleaning up remote archive");
    yield* runChild("ssh", [state.sourceHost, "rm", "-f", remoteArchive]);
    return 0;
  });

const doChecklist = (state: MigrateState) =>
  Effect.gen(function* () {
    yield* writeStdout("\nMigration Checklist\n\n");
    yield* writeStdout(
      `Pull these paths from ${state.sourceHost}:~ to local ~:\n\n`,
    );
    for (const path of state.existingPaths) {
      yield* writeStdout(`  [ ] ~/${path}\n`);
    }
    yield* writeStdout("\nExample for each:\n");
    yield* writeStdout(`  rsync -az ${state.sourceHost}:~/PATH ~/PATH\n\n`);
    yield* writeStdout("After copying:\n\n");
    yield* writeStdout("  [ ] Run chezmoi apply to restore dotfiles\n");
    yield* writeStdout("  [ ] Verify git repos have correct remotes\n\n");
    return 0;
  });

const migrateCommand = (
  manifestOverride: string,
) =>
  Effect.gen(function* () {
    const manifestPath = manifestOverride === ""
      ? yield* defaultManifestPath
      : manifestOverride;
    yield* writeStdout("\nDevbox Migration\n\n");
    const manifest = yield* loadMigrateManifest(manifestPath);
    const sourceConnection: MigrateSourceConnection =
      yield* connectMigrateSource();
    if (sourceConnection._tag === "Failed") return 1;
    const sourceHost = sourceConnection.sourceHost;
    const auditCode = yield* auditRepos(sourceHost, manifest.audit);
    if (auditCode !== 0) return 0;
    const existingPaths = yield* validateMigratePaths(
      sourceHost,
      manifest.migrate,
    );
    yield* showMigrateSummary(sourceHost, existingPaths);
    const state: MigrateState = { ...manifest, sourceHost, existingPaths };
    yield* writeStdout("Transfer method\n\n");
    yield* writeStdout("  1) rsync  — pull directly over SSH\n");
    yield* writeStdout(
      "  2) tar    — archive on source, pull here, extract manually\n",
    );
    yield* writeStdout("  3) list   — just show what to copy\n\n");
    const choice = promptRequired("Choose [1/2/3]: ");
    const code = choice === "1"
      ? yield* doRsync(state)
      : choice === "2"
      ? yield* doTar(state)
      : choice === "3"
      ? yield* doChecklist(state)
      : (() => fatal(`Invalid choice: ${choice}`))();
    yield* writeStdout("\n");
    yield* logWarning(
      "Credentials are NOT included — migrate these yourself:",
    );
    yield* writeStdout("  ~/.ssh/  ~/.aws/  ~/.gnupg/  ~/.npmrc\n\n");
    yield* logWarning(
      "Run chezmoi apply on this devbox to restore dotfiles.",
    );
    yield* writeStdout("\n");
    return code;
  });

// ============================================================================
// CLI
// ============================================================================

const connectHelpFlag = Flag.boolean("help").pipe(Flag.withDefault(false));
const localForwardFlag = Flag.string("local-forward").pipe(
  Flag.withAlias("L"),
  Flag.withMetavar("PORT:HOST:PORT"),
  Flag.withDescription(
    `Listen: ${localPortHelp} → ${remoteDestinationHelp}`,
  ),
  Flag.atMost(Number.MAX_SAFE_INTEGER),
);
const remoteForwardFlag = Flag.string("remote-forward").pipe(
  Flag.withAlias("R"),
  Flag.withMetavar("PORT:HOST:PORT"),
  Flag.withDescription(
    `Listen: ${remotePortHelp} → ${localDestinationHelp}`,
  ),
  Flag.atMost(Number.MAX_SAFE_INTEGER),
);
const connectArgs = Argument.string("connect-arg").pipe(Argument.variadic());
const makeConnectCli = <A, E, R>(
  handler: (
    args: ReadonlyArray<string>,
    forwards: ConnectForwards,
  ) => Effect.Effect<A, E, R>,
) =>
  Command.make(
    "connect",
    {
      help: connectHelpFlag,
      localForwards: localForwardFlag,
      remoteForwards: remoteForwardFlag,
      args: connectArgs,
    },
    ({ help, localForwards, remoteForwards, args }) =>
      help
        ? writeStdout(CONNECT_USAGE).pipe(Effect.andThen(exitWith(0)))
        : handler(args, { local: localForwards, remote: remoteForwards }),
  );
const connectCli = makeConnectCli((args, forwards) =>
  connectCommand(args, defaultConnectEnv, forwards).pipe(
    Effect.flatMap(exitWith),
  )
);

const fleetCli = makeFleetCli((options) =>
  fleetCommand(options).pipe(Effect.flatMap(exitWith))
);

const tmuxHelpFlag = Flag.boolean("help").pipe(Flag.withDefault(false));
// Declared as two named positionals rather than a variadic, so a third
// argument is a parse error instead of being silently dropped. `workspace` is
// optional at the parser so `cw tmux --help` still reaches the help branch;
// its absence is then reported here.
const tmuxWorkspace = Argument.string("workspace").pipe(Argument.optional);
const tmuxDirectory = Argument.string("directory").pipe(
  Argument.withDefault(""),
);

const makeTmuxCli = <A, E, R>(
  handler: (
    workspace: string,
    directory: string,
    forwards: ConnectForwards,
  ) => Effect.Effect<A, E, R>,
) =>
  Command.make("tmux", {
    help: tmuxHelpFlag,
    localForwards: localForwardFlag,
    remoteForwards: remoteForwardFlag,
    workspace: tmuxWorkspace,
    directory: tmuxDirectory,
  }, ({ help, localForwards, remoteForwards, workspace, directory }) => {
    if (help) return writeStdout(TMUX_USAGE).pipe(Effect.andThen(exitWith(0)));
    const name = Option.getOrElse(workspace, () => "");
    if (name === "") {
      return writeStderr(TMUX_USAGE).pipe(
        Effect.andThen(logError("tmux requires a workspace name")),
        Effect.andThen(exitWith(1)),
      );
    }
    return handler(name, directory, {
      local: localForwards,
      remote: remoteForwards,
    });
  });

const tmuxCli = makeTmuxCli((workspace, directory, forwards) =>
  connectCommand(
    [workspace, "tmux", directory],
    defaultConnectEnv,
    forwards,
  ).pipe(
    Effect.flatMap(exitWith),
  )
);

const migrateCli = Command.make(
  "migrate",
  { manifest: migrateManifestFlag, help: migrateHelpFlag },
  ({ manifest, help }) =>
    help
      ? writeStdout(MIGRATE_USAGE).pipe(Effect.andThen(exitWith(0)))
      : migrateCommand(manifest).pipe(Effect.flatMap(exitWith)),
);

const completionShell = Argument.string("shell").pipe(Argument.withDefault(""));
const completionCli = Command.make(
  "completion",
  { shell: completionShell },
  ({ shell }) =>
    Effect.gen(function* () {
      if (shell === "zsh") {
        yield* writeStdout(ZSH_COMPLETION);
        return yield* exitWith(0);
      }
      yield* writeStderr(TOP_USAGE);
      return fatal(`Unknown completion shell: ${shell}. Supported: zsh`);
    }),
);

const rootHelpFlag = Flag.boolean("help").pipe(Flag.withDefault(false));
const rootWorkspace = Argument.string("workspace").pipe(Argument.optional);
const rootConnectArgs = Argument.string("connect-arg").pipe(
  Argument.variadic(),
);
const cwCli = Command.make(
  "cw",
  {
    help: rootHelpFlag,
    localForwards: localForwardFlag,
    remoteForwards: remoteForwardFlag,
    workspace: rootWorkspace,
    connectArgs: rootConnectArgs,
  },
  ({ help, localForwards, remoteForwards, workspace, connectArgs }) => {
    const workspaceName = Option.getOrElse(workspace, () => "");
    if (help || workspaceName === "help") {
      return writeStdout(TOP_USAGE).pipe(Effect.andThen(exitWith(0)));
    }
    if (workspaceName === "") {
      return writeStdout(TOP_USAGE).pipe(Effect.andThen(exitWith(1)));
    }
    return connectCommand(
      [workspaceName, ...connectArgs],
      defaultConnectEnv,
      { local: localForwards, remote: remoteForwards },
    ).pipe(
      Effect.flatMap(exitWith),
    );
  },
).pipe(Command.withSubcommands([
  connectCli,
  tmuxCli,
  fleetCli,
  migrateCli,
  completionCli,
]));

const cliConfig = CliConfig.make({ builtIns: [] });
interface TerminalRuntime {
  readonly isTerminal: () => boolean;
  readonly consoleSize: () => {
    readonly columns: number;
    readonly rows: number;
  };
  readonly write: (value: Uint8Array) => void;
}

const DEFAULT_TERMINAL_SIZE = { columns: 80, rows: 24 } as const;
const denoTerminalRuntime: TerminalRuntime = {
  isTerminal: () => Deno.stdout.isTerminal(),
  consoleSize: () => Deno.consoleSize(),
  write: (value) => {
    Deno.stdout.writeSync(value);
  },
};

const detectTerminalSize = (runtime: TerminalRuntime) => {
  if (!runtime.isTerminal()) return DEFAULT_TERMINAL_SIZE;
  try {
    return runtime.consoleSize();
  } catch {
    return DEFAULT_TERMINAL_SIZE;
  }
};

const nativeCliTerminalLayer = (
  runtime: TerminalRuntime = denoTerminalRuntime,
) =>
  Layer.succeed(
    Terminal.Terminal,
    Terminal.make({
      columns: Effect.sync(() => detectTerminalSize(runtime).columns),
      rows: Effect.sync(() => detectTerminalSize(runtime).rows),
      readInput: Effect.die("terminal input unavailable"),
      readLine: Effect.die("terminal input unavailable"),
      display: (value) =>
        Effect.sync(() => {
          runtime.write(text.encode(value));
        }),
    }),
  );

const cliTerminalLayer = Layer.succeed(
  Terminal.Terminal,
  Terminal.make({
    columns: Effect.succeed(80),
    rows: Effect.succeed(24),
    readInput: Effect.die("terminal input unavailable"),
    readLine: Effect.die("terminal input unavailable"),
    display: () => Effect.void,
  }),
);
const cliSupportLayer = (args: ReadonlyArray<string>) =>
  Layer.mergeAll(
    Stdio.layerTest({ args: Effect.succeed(args) }),
    cliTerminalLayer,
  );
const unavailableChildProcessLayer = Layer.succeed(
  ChildProcessSpawner.ChildProcessSpawner,
  ChildProcessSpawner.make(() => Effect.die("child process unavailable")),
);
const cliNoopLayer = (args: ReadonlyArray<string>) =>
  Layer.mergeAll(
    cliSupportLayer(args),
    fileSystemLayerNoop({}),
    pathLayer,
    unavailableChildProcessLayer,
  );

if (import.meta.main) {
  // Last-resort backstop: catch anything that escapes the Effect runtime
  // (raw node-stream callbacks, forked-fiber defects, unhandled rejections).
  // NodeRuntime.runMain does NOT install these (only SIGINT/SIGTERM) — verified
  // against effect-smol source. Inside import.meta.main so `deno test` stays hermetic.
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(`error uncaught: ${event.message}`);
    Deno.exit(1);
  });

  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeServices"
  );
  Command.run(cwCli, { version: "0.0.0" }).pipe(
    Effect.catchTags({
      ShowHelp: () => exitWith(1),
      UserError: () => exitWith(1),
    }),
    Effect.provideService(CliConfig.CliConfig, cliConfig),
    Effect.provide(Layer.mergeAll(
      NodeServices.layer,
      nativeCliTerminalLayer(),
    )),
    NodeRuntime.runMain,
  );
}

// ============================================================================
// Tests — pure/mocked. Must pass offline:
//   deno test home/private_dot_local/bin/executable_cw
// ============================================================================

const assertEq = <T>(actual: T, expected: T): void => {
  if (actual !== expected) {
    throw new Error(
      `assertion failed: ${JSON.stringify(actual)} !== ${
        JSON.stringify(expected)
      }`,
    );
  }
};

// Connect env for offline tests: no logging, no preflight ssh round-trip, no
// PATH probing, no failure diagnostics — so only the calls under test are made.
const offlineConnectEnv: ConnectEnv = {
  log: false,
  preflight: false,
  checkCommands: false,
  diagnostics: false,
};

// Parse an argv through the real `cw tmux` argument declarations, with the
// handler swapped for a capture so nothing connects or exits. Returns
// "<workspace>\0<directory>", or null when the parser rejected the argv.
const parseTmuxCli = async (
  argv: ReadonlyArray<string>,
): Promise<string | null> => {
  let parsed: string | null = null;
  const testCli = makeTmuxCli((workspace, directory, _remoteForwards) =>
    Effect.sync(() => {
      parsed = `${workspace}\u0000${directory}`;
    })
  );
  const exit = await Effect.runPromiseExit(
    Command.runWith(testCli, { version: "0.0.0", renderErrors: false })(argv)
      .pipe(
        Effect.provideService(CliConfig.CliConfig, cliConfig),
        Effect.provide(cliNoopLayer([])),
      ),
  );
  return exit._tag === "Success" ? parsed : null;
};

const parseConnectCli = async (
  argv: ReadonlyArray<string>,
): Promise<ConnectForwards | null> => {
  let parsed: ConnectForwards | null = null;
  const testCli = makeConnectCli((_args, forwards) =>
    Effect.sync(() => {
      parsed = forwards;
    })
  );
  const exit = await Effect.runPromiseExit(
    Command.runWith(testCli, { version: "0.0.0", renderErrors: false })(argv)
      .pipe(
        Effect.provideService(CliConfig.CliConfig, cliConfig),
        Effect.provide(cliNoopLayer([])),
      ),
  );
  return exit._tag === "Success" ? parsed : null;
};

class MockChildProcessSpawner {
  readonly calls: Array<
    { cmd: string; args: ReadonlyArray<string>; options?: RunOptions }
  > = [];
  constructor(private readonly results: ReadonlyArray<CommandResult>) {}

  readonly service = ChildProcessSpawner.make((command) => {
    if (!ChildProcess.isStandardCommand(command)) {
      return Effect.fail(
        new Error("mock only supports standard commands") as never,
      );
    }
    const options = command.options;
    this.calls.push({
      cmd: command.command,
      args: command.args,
      options: {
        cwd: options.cwd,
        detached: options.detached,
        stdin: options.stdin === "inherit"
          ? "inherit"
          : options.stdin === "ignore"
          ? "null"
          : "piped",
        stdout: options.stdout === "inherit"
          ? "inherit"
          : options.stdout === "ignore"
          ? "null"
          : "piped",
        stderr: options.stderr === "inherit"
          ? "inherit"
          : options.stderr === "ignore"
          ? "null"
          : "piped",
      },
    });
    const result = this.results[this.calls.length - 1] ??
      { code: 0, stdout: "", stderr: "" };
    return Effect.succeed(ChildProcessSpawner.makeHandle({
      pid: ChildProcessSpawner.ProcessId(this.calls.length),
      exitCode: Effect.succeed(ChildProcessSpawner.ExitCode(result.code)),
      isRunning: Effect.succeed(false),
      kill: () => Effect.void,
      stdin: Sink.drain,
      stdout: result.stdout === ""
        ? Stream.empty
        : Stream.make(text.encode(result.stdout)),
      stderr: result.stderr === ""
        ? Stream.empty
        : Stream.make(text.encode(result.stderr)),
      all: Stream.empty,
      getInputFd: () => Sink.drain,
      getOutputFd: () => Stream.empty,
      unref: Effect.succeed(Effect.void),
    }));
  });

  readonly layer = Layer.succeed(
    ChildProcessSpawner.ChildProcessSpawner,
    this.service,
  );
}

if (!import.meta.main) {
  Deno.test({
    name: "runtime allow-run excludes tput",
    ignore: Deno.permissions.querySync({
      name: "read",
      path: new URL(import.meta.url),
    }).state !== "granted",
    fn: async () => {
      const source = await Deno.readTextFile(new URL(import.meta.url));
      const shebang = source.split("\n", 1)[0];
      const allowRun = /--allow-run=([^ ]+)/.exec(shebang)?.[1].split(",") ??
        [];
      assertEq(allowRun.includes("tput"), false);
    },
  });

  Deno.test("terminal size defaults without a stdout TTY", () => {
    const size = detectTerminalSize({
      isTerminal: () => false,
      consoleSize: () => {
        throw new Error("consoleSize must not run for a non-TTY");
      },
      write: () => undefined,
    });
    assertEq(size.columns, 80);
    assertEq(size.rows, 24);
  });

  Deno.test("terminal size defaults when consoleSize fails", () => {
    const size = detectTerminalSize({
      isTerminal: () => true,
      consoleSize: () => {
        throw new Error("console size unavailable");
      },
      write: () => undefined,
    });
    assertEq(size.columns, 80);
    assertEq(size.rows, 24);
  });

  Deno.test("native terminal layer overrides an existing terminal service", async () => {
    const dimensions = await Effect.runPromise(
      Effect.gen(function* () {
        const terminal = yield* Terminal.Terminal;
        return [yield* terminal.columns, yield* terminal.rows] as const;
      }).pipe(
        Effect.provide(Layer.mergeAll(
          cliTerminalLayer,
          nativeCliTerminalLayer({
            isTerminal: () => true,
            consoleSize: () => ({ columns: 132, rows: 43 }),
            write: () => undefined,
          }),
        )),
      ),
    );
    assertEq(dimensions[0], 132);
    assertEq(dimensions[1], 43);
  });

  Deno.test("native terminal layer re-reads dimensions after resize", async () => {
    let columns = 80;
    let rows = 24;
    const dimensions = await Effect.runPromise(
      Effect.gen(function* () {
        const terminal = yield* Terminal.Terminal;
        const before = [yield* terminal.columns, yield* terminal.rows] as const;
        columns = 47;
        rows = 19;
        const after = [yield* terminal.columns, yield* terminal.rows] as const;
        return { before, after };
      }).pipe(
        Effect.provide(nativeCliTerminalLayer({
          isTerminal: () => true,
          consoleSize: () => ({ columns, rows }),
          write: () => undefined,
        })),
      ),
    );
    assertEq(dimensions.before.join("x"), "80x24");
    assertEq(dimensions.after.join("x"), "47x19");
  });

  Deno.test("native terminal layer preserves CJK output", async () => {
    const output: Uint8Array[] = [];
    await Effect.runPromise(
      Effect.gen(function* () {
        const terminal = yield* Terminal.Terminal;
        yield* terminal.display("接続 → 工作区\n");
      }).pipe(
        Effect.provide(nativeCliTerminalLayer({
          isTerminal: () => true,
          consoleSize: () => ({ columns: 80, rows: 24 }),
          write: (value) => output.push(value),
        })),
      ),
    );
    const rendered = output[0];
    if (rendered === undefined) throw new Error("terminal wrote no output");
    assertEq(new TextDecoder().decode(rendered), "接続 → 工作区\n");
  });

  Deno.test("fleet CLI preserves options and task args", async () => {
    let parsed: FleetOptions | undefined;
    const testCli = makeFleetCli((options) =>
      Effect.sync(() => {
        parsed = options;
      })
    );
    await Effect.runPromise(
      Command.runWith(testCli, {
        version: "0.0.0",
        renderErrors: false,
      })([
        "--include-local",
        "--parallel",
        "2",
        "--",
        "update",
        "--fast",
      ]).pipe(
        Effect.provideService(CliConfig.CliConfig, cliConfig),
        Effect.provide(cliNoopLayer([])),
      ),
    );
    if (parsed === undefined) throw new Error("expected CLI handler to run");
    assertEq(parsed.includeLocal, true);
    assertEq(parsed.parallel, 2);
    assertEq(parsed.taskAndArgs.join("\0"), "update\0--fast");
  });

  Deno.test("fleet default filter selects running workspace names", () => {
    const selected = chooseDefaultFleetWorkspaces([
      { name: "one", latest_build: { status: "running" } },
      { name: "two", latest_build: { status: "stopped" } },
    ]);
    assertEq(selected.join(","), "one");
  });

  Deno.test("fleet aggregation returns max partial-failure exit", () => {
    const code = fleetResultCode([
      HostEither.Right({ right: { host: "a", code: 0 } }),
      HostEither.Left({ left: { host: "b", code: 7, logFile: "/tmp/b.log" } }),
      HostEither.Left({ left: { host: "c", code: 2, logFile: "/tmp/c.log" } }),
    ]);
    assertEq(code, 7);
  });

  Deno.test("fleet remote command seeds PATH and runs from source repo", () => {
    assertEq(
      fleetCommandString("update", ["--fast"]),
      `export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"; cd "$HOME/.local/share/chezmoi" && mise run 'update' '--fast'`,
    );
  });

  Deno.test("fleet ssh command preserves multiword remote command", () => {
    assertEq(
      remoteZshCommand("mise run 'update'"),
      "/usr/bin/zsh -lc 'mise run '\\''update'\\'''",
    );
  });

  Deno.test("connect ssh uses hand-over stdio and mirrors child code", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 23, stdout: "", stderr: "" },
    ]);
    const code = await Effect.runPromise(
      connectCommand(["box"], {
        log: false,
        preflight: false,
        checkCommands: false,
        diagnostics: false,
      }).pipe(Effect.provide(spawner.layer)) as Effect.Effect<number>,
    );
    assertEq(code, 23);
    const ssh = spawner.calls[1];
    assertEq(ssh.cmd, "ssh");
    assertEq(ssh.options?.stdin, "inherit");
    assertEq(ssh.options?.stdout, "inherit");
    assertEq(ssh.options?.stderr, "inherit");
    assertEq(ssh.options?.detached, true);
    assertEq(
      ssh.args.join("\u0000"),
      ["-tt", "coder.box", "/usr/bin/zsh -l"].join("\u0000"),
    );
  });

  Deno.test("connect ssh requires requested forwards to bind", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 0, stdout: "", stderr: "" },
    ]);
    await Effect.runPromise(
      connectCommand(
        ["box"],
        offlineConnectEnv,
        {
          local: ["3000:127.0.0.1:3000"],
          remote: ["3845:127.0.0.1:3845", "9000:localhost:9001"],
        },
      ).pipe(Effect.provide(spawner.layer)) as Effect.Effect<number>,
    );
    const ssh = spawner.calls[1];
    assertEq(
      ssh.args.join("\u0000"),
      [
        "-tt",
        "-o",
        "ExitOnForwardFailure=yes",
        "-L",
        "3000:127.0.0.1:3000",
        "-R",
        "3845:127.0.0.1:3845",
        "-R",
        "9000:localhost:9001",
        "coder.box",
        "/usr/bin/zsh -l",
      ].join("\u0000"),
    );
  });

  Deno.test("connect ssh returns a requested forwarding bind failure", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      {
        code: 255,
        stdout: "",
        stderr: "bind [127.0.0.1]:3000: Address already in use\n",
      },
    ]);
    const code = await Effect.runPromise(
      connectCommand(
        ["box"],
        { ...offlineConnectEnv, diagnostics: true },
        { local: ["3000:127.0.0.1:3000"], remote: [] },
      ).pipe(Effect.provide(spawner.layer)) as Effect.Effect<number>,
    );
    assertEq(code, 255);
    assertEq(spawner.calls.length, 2);
  });

  Deno.test("connect claude requires requested forwards to bind", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 0, stdout: "", stderr: "" },
    ]);
    await Effect.runPromise(
      connectCommand(
        ["box", "claude"],
        offlineConnectEnv,
        { local: [], remote: ["3845:127.0.0.1:3845"] },
      ).pipe(Effect.provide(spawner.layer)) as Effect.Effect<number>,
    );
    const ssh = spawner.calls[1];
    assertEq(
      ssh.args.join("\u0000"),
      [
        "-tt",
        "-o",
        "ExitOnForwardFailure=yes",
        "-R",
        "3845:127.0.0.1:3845",
        "coder.box",
        "/usr/bin/zsh",
        "-lc",
        "claude",
      ].join("\u0000"),
    );
  });

  Deno.test("connect generic app rejects a requested directory", async () => {
    const directory = "--project o'brien;$(touch nope)";
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
    ]);
    const code = await Effect.runPromise(
      connectCommand(["box", "cursor", directory], offlineConnectEnv).pipe(
        Effect.provide(spawner.layer),
      ) as Effect.Effect<number>,
    );
    assertEq(code, 2);
    assertEq(spawner.calls.length, 1);
    assertEq(spawner.calls[0].cmd, "coder");
    assertEq(spawner.calls[0].args.join("\u0000"), "list\u0000-o\u0000json");
  });

  Deno.test("connect VS Code forwards the requested path as one argv", async () => {
    const directory = "/home/coder/dev/o'brien project;$(touch nope)";
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 0, stdout: "", stderr: "" },
    ]);
    await Effect.runPromise(
      connectCommand(["box", "vscode", directory], offlineConnectEnv).pipe(
        Effect.provide(spawner.layer),
      ) as Effect.Effect<number>,
    );
    const open = spawner.calls[1];
    assertEq(open.cmd, "coder");
    assertEq(
      open.args.join("\u0000"),
      ["open", "vscode", "--generate-token", "box", directory].join(
        "\u0000",
      ),
    );
  });

  Deno.test("connect CLI collects repeated local and remote forward options", async () => {
    const forwards = await parseConnectCli([
      "-L",
      "3000:127.0.0.1:3000",
      "--remote-forward",
      "3845:127.0.0.1:3845",
      "-R",
      "9000:localhost:9001",
      "--local-forward",
      "4000:localhost:4000",
      "box",
    ]);
    assertEq(
      forwards?.local.join("\u0000"),
      "3000:127.0.0.1:3000\u00004000:localhost:4000",
    );
    assertEq(
      forwards?.remote.join("\u0000"),
      "3845:127.0.0.1:3845\u00009000:localhost:9001",
    );
  });

  Deno.test("local forwards print their direction through the workspace", () => {
    assertEq(
      localForwardMessage("3000:127.0.0.1:3000"),
      "🔌  Forwarding local port 3000 → workspace 127.0.0.1:3000",
    );
  });

  Deno.test("remote forwards print their direction", () => {
    assertEq(
      remoteForwardMessage("3845:127.0.0.1:3845"),
      "🔌  Forwarding remote port 3845 → 127.0.0.1:3845",
    );
  });

  Deno.test("connect tmux mode attaches through a remote login zsh", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 4, stdout: "", stderr: "" },
    ]);
    const code = await Effect.runPromise(
      connectCommand(["box", "tmux"], offlineConnectEnv).pipe(
        Effect.provide(spawner.layer),
      ) as Effect.Effect<number>,
    );
    assertEq(code, 4);
    const ssh = spawner.calls[1];
    assertEq(ssh.cmd, "ssh");
    assertEq(
      ssh.args.join("\u0000"),
      [
        "-tt",
        "coder.box",
        "/usr/bin/zsh -lc 'tmux new-session -A -s '\\''main-session'\\'''",
      ].join("\u0000"),
    );
    assertEq(ssh.options?.detached, true);
    assertEq(ssh.options?.stdin, "inherit");
    assertEq(ssh.options?.stdout, "inherit");
    assertEq(ssh.options?.stderr, "inherit");
  });

  Deno.test("connect tmux mode cds into the requested directory", async () => {
    const spawner = new MockChildProcessSpawner([
      {
        code: 0,
        stdout: JSON.stringify([{
          name: "box",
          latest_build: { status: "running" },
        }]),
        stderr: "",
      },
      { code: 0, stdout: "", stderr: "" },
    ]);
    await Effect.runPromise(
      connectCommand(
        ["box", "tmux", "/home/coder/dev/me/dotfiles"],
        offlineConnectEnv,
      ).pipe(Effect.provide(spawner.layer)) as Effect.Effect<number>,
    );
    const ssh = spawner.calls[1];
    assertEq(ssh.cmd, "ssh");
    assertEq(
      ssh.args.join("\u0000"),
      [
        "-tt",
        "coder.box",
        "/usr/bin/zsh -lc 'cd '\\''/home/coder/dev/me/dotfiles'\\'' && tmux new-session -A -s '\\''main-session'\\'''",
      ].join("\u0000"),
    );
  });

  Deno.test("tmux remote command attaches or creates the one session", () => {
    assertEq(
      tmuxRemoteCommand(""),
      "tmux new-session -A -s 'main-session'",
    );
  });

  Deno.test("tmux remote command cds rather than passing tmux -c", () => {
    const cmd = tmuxRemoteCommand("/home/coder/dev/o'brien");
    assertEq(
      cmd,
      "cd '/home/coder/dev/o'\\''brien' && tmux new-session -A -s 'main-session'",
    );
    // `-c` is honoured only when tmux creates the session, so an attach to an
    // existing session would silently ignore the requested directory.
    assertEq(cmd.includes(" -c "), false);
  });

  Deno.test("tmux is an ssh-terminal mode, so it gets preflight + diagnostics", () => {
    assertEq(usesSshTerminal("tmux"), true);
    assertEq(usesSshTerminal("vscode"), false);
  });

  Deno.test("tmux CLI maps its positionals to workspace and directory", async () => {
    assertEq(await parseTmuxCli(["box"]), "box\u0000");
    assertEq(
      await parseTmuxCli(["box", "/srv/app"]),
      "box\u0000/srv/app",
    );
  });

  Deno.test("tmux CLI rejects a third positional instead of dropping it", async () => {
    assertEq(await parseTmuxCli(["box", "/srv/app", "extra"]), null);
  });

  Deno.test("zsh completion offers tmux as a subcommand and a mode", () => {
    assertEq(ZSH_COMPLETION.includes("'tmux:"), true);
    assertEq(/^\s*tmux\)$/m.test(ZSH_COMPLETION), true);
  });

  Deno.test("zsh completion offers every forwarding flag spelling", () => {
    for (
      const option of [
        "-L:Listen:",
        "--local-forward:Listen:",
        "-R:Listen:",
        "--remote-forward:Listen:",
      ]
    ) {
      assertEq(ZSH_COMPLETION.includes(option), true);
    }
  });

  Deno.test("dead-datapath hint fires only when split confirmed", () => {
    // ssh failed + Connect active + agent reachable over classic path
    // = the confirmed dead-Connect-datapath signature.
    assertEq(shouldHintDeadDatapath(255, true, true), true);
    // ssh succeeded — nothing to diagnose.
    assertEq(shouldHintDeadDatapath(0, true, true), false);
    // Connect not active — the failure is some other ssh problem.
    assertEq(shouldHintDeadDatapath(255, false, true), false);
    // Agent unreachable — workspace genuinely down, not a Connect split.
    assertEq(shouldHintDeadDatapath(255, true, false), false);
  });

  Deno.test("dead-datapath hint names the workspace and the fix", () => {
    const hint = deadDatapathHint("for-tasks-1");
    assertEq(hint.includes("for-tasks-1"), true);
    assertEq(hint.includes("Coder Connect"), true);
    assertEq(hint.includes("toggle"), true);
  });

  Deno.test("coder list schema rejects missing build status", () => {
    let failed = false;
    try {
      decodeWorkspaces([{ name: "bad", latest_build: {} }]);
    } catch {
      failed = true;
    }
    assertEq(failed, true);
  });
}
