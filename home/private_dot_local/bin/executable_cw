// Shared dotfiles log renderer. At runtime this resolves from ~/.local/bin to
// ~/.local/lib (chezmoi: home/private_dot_local/lib/df-log.ts).
import { error, info, warning } from "../lib/df-log.ts";

const fatal = (msg: string): never => {
  console.error(`fatal ${msg}`);
  Deno.exit(1);
};

// The one tmux session per box, matching the local convention so
// tmux-resurrect snapshots restore into the same name. Shared by the usage
// text and the remote attach command.
const TMUX_DEFAULT_SESSION = "main-session";

// ============================================================================
// Usage text
// ============================================================================

const helpColour = (colour: string, value: string): string =>
  Deno.stdout.isTerminal() ? `${colour}${value}\x1b[0m` : value;
const localPortHelp = helpColour("\x1b[36m", "LOCAL PORT");
const localDestinationHelp = helpColour(
  "\x1b[36m",
  "LOCAL HOST:PORT",
);
const remotePortHelp = helpColour("\x1b[35m", "REMOTE PORT");
const remoteDestinationHelp = helpColour(
  "\x1b[35m",
  "REMOTE HOST:PORT",
);

const TOP_USAGE = `Usage:
  cw <subcommand> [args...]
  cw [-L PORT:HOST:PORT] [--local-forward PORT:HOST:PORT]
     [-R PORT:HOST:PORT] [--remote-forward PORT:HOST:PORT]
     <workspace> [mode] [directory]
                                         (shorthand for \`cw connect ...\`)

Description:
  One-stop CLI for Coder dev boxes. Connect to a single workspace, fan a
  mise task across the whole fleet, or migrate working state between boxes.

Subcommands:
  connect <ws> [mode] [dir]   Attach to a workspace (ssh/tmux/vscode/claude/app)
  tmux <ws> [dir]             Attach to a persistent tmux session on a workspace
  fleet [opts] <mise-task>    Run a mise task across running workspaces
  migrate [opts]              Pull working state from an old devbox to a new one
  completion zsh              Output zsh completion script

  Bare \`cw <workspace> ...\` is shorthand for \`cw connect <workspace> ...\`.

Examples:
  cw for-tasks                # SSH into for-tasks
  cw tmux for-tasks           # Attach to for-tasks' persistent tmux session
  cw connect for-tasks-2 vscode
  cw fleet --include-local update
  cw migrate

Options:
  -L, --local-forward PORT:HOST:PORT
      Listen: ${localPortHelp} → ${remoteDestinationHelp} (repeatable)
  -R, --remote-forward PORT:HOST:PORT
      Listen: ${remotePortHelp} → ${localDestinationHelp} (repeatable)
  --help                           Display this message
`;

const CONNECT_USAGE = `Usage:
  cw connect [-L PORT:HOST:PORT] [--local-forward PORT:HOST:PORT]
             [-R PORT:HOST:PORT] [--remote-forward PORT:HOST:PORT]
             <workspace> [mode] [directory]

Description:
  Connect to a Coder workspace in various modes. Built-in modes handle
  SSH, tmux, VSCode, and Claude Code sessions. Any other mode is passed
  through to \`coder open app\` as a workspace app slug (so like: intellij,
  cursor).

Arguments:
  workspace    Workspace name (e.g. for-tasks, for-tasks-2)
  mode         ssh (default), tmux, vscode, claude, ccyolo, or any app slug
               available on the coder box (cursor, intellij, code-server)
  directory    Absolute project path on the remote (/home/coder/dev/<project>)

Options:
  -L, --local-forward PORT:HOST:PORT
      Listen: ${localPortHelp} → ${remoteDestinationHelp} (repeatable)
  -R, --remote-forward PORT:HOST:PORT
      Listen: ${remotePortHelp} → ${localDestinationHelp} (repeatable)

Examples:
  cw connect for-tasks                # SSH into for-tasks
  cw connect for-tasks tmux           # Attach to the persistent tmux session
  cw connect for-tasks-2 vscode       # Open in VS Code
  cw connect for-tasks-2 cursor       # Open Cursor via coder
  cw connect for-tasks-2 intellij     # Open IntelliJ via coder
  cw connect for-tasks code-server    # Open code-server in browser
  cw connect for-tasks claude         # SSH + Claude Code
  cw connect for-prs ccyolo           # YOLO mode
  cw connect --local-forward 3000:127.0.0.1:3000 for-tasks   # Mac:3000 → workspace:3000
  cw connect --remote-forward 3845:127.0.0.1:3845 for-tasks  # workspace:3845 → Mac:3845
`;

const TMUX_USAGE = `Usage:
  cw tmux [-L PORT:HOST:PORT] [--local-forward PORT:HOST:PORT]
          [-R PORT:HOST:PORT] [--remote-forward PORT:HOST:PORT]
          <workspace> [directory]

Description:
  Attach to the persistent \`${TMUX_DEFAULT_SESSION}\` tmux session on a Coder
  workspace, creating it if it does not exist yet. Shorthand for
  \`cw connect <workspace> tmux [directory]\`.

  The session is started from a login zsh, so its server captures the
  repo-managed environment — mise shims included — and every later attach
  inherits that. A directory seeds the initial pane when the session is
  created; an existing session retains its active pane and directory.

Arguments:
  workspace    Workspace name (e.g. for-tasks, for-tasks-2)
  directory    Absolute project path on the remote (/home/coder/dev/<project>)

Options:
  -L, --local-forward PORT:HOST:PORT
      Listen: ${localPortHelp} → ${remoteDestinationHelp} (repeatable)
  -R, --remote-forward PORT:HOST:PORT
      Listen: ${remotePortHelp} → ${localDestinationHelp} (repeatable)
  --help                           Display this message

Examples:
  cw tmux for-tasks
  cw tmux for-tasks-2 /home/coder/dev/me/dotfiles
`;

const FLEET_USAGE = `Usage:
  cw fleet [OPTIONS] -- <mise-task> [args...]
  cw fleet [OPTIONS] <mise-task> [args...]

Description:
  Run a mise task on every running Coder workspace, in parallel.
  A small composable primitive, not a workflow-aware orchestrator.
  Whatever task you can \`mise run\` locally, you can run on the fleet.

  Discovery is dynamic via \`coder list -o json\` (filtered to running
  workspaces by default). No static inventory.

Options:
  --include-local       Also run the task on this machine (before the fleet)
  --local-only          Run only on this machine (skip the fleet)
  --filter <jq-expr>    jq filter against \`coder list -o json\`; output workspace names
                        (default: '.[] | select(.latest_build.status == "running") | .name')
  --parallel <N>        Max concurrent SSH targets (default: 4)
  --dry-run             Print the matrix; don't execute

Examples:
  cw fleet update                          # \`mise run update\` on every running box
  cw fleet --include-local update          # me first, then every box
  cw fleet --local-only drift:check        # local convergence only
  cw fleet --filter '.[] | select(.name == "for-tasks-1") | .name' update
  cw fleet --dry-run update                # preview the fan-out

Output:
  Per-host structured: [<ws>] ok | [<ws>] FAIL: <reason>
  Per-host stdout/stderr captured to $TMPDIR/cw-fleet-<ts>/<ws>.log
  Aggregate exit code = max of per-host codes (0 only if all succeeded)
`;

