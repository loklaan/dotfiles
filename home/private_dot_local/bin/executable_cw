#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --allow-run=coder,ssh,ssh-add,gpgconf,gpg,mise,jq,rsync,scp,du,tput,/opt/homebrew/opt/ncurses/bin/infocmp --allow-net --allow-read --allow-write --allow-env --allow-sys=networkInterfaces

// cw — Coder Workspaces CLI (Deno + Effect v4). Public surface: the
// subcommands (`connect`, `tmux`, `fleet`, `migrate`), the bare workspace
// shorthand, and the zsh completion output.

