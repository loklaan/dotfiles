#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --no-prompt --allow-run --allow-env --allow-read --allow-sys=uid

// df-task-mise-upgrade (Deno + Effect v4). Bumps the global mise lock in the
// chezmoi SOURCE repo and installs it, invoked from the `[tasks."mise:upgrade"]`
// mise task. Contract:
//   1. probe `mise` and `chezmoi` on PATH (fatal if absent)
//   2. resolve the source dir via `chezmoi source-path`
//   3. `mise lock --global --bump` with MISE_GLOBAL_CONFIG_FILE pointing at
//      <source>/private_dot_config/mise/config.toml, so the bumped mise.lock is
//      written next to it, in the repo. The config's minimum_release_age holds
//      back releases younger than 4 days.
//   4. `mise install --locked -y` against the same config
//   5. propagate the first non-zero exit code verbatim
// The next `chezmoi apply` (df-task-update runs one straight after) copies the
// bumped lock to ~/.config/mise/mise.lock. `mise upgrade` is not used: under
// the config's `locked = true` it only replays the existing lock.
//
// Both mise children run with cwd = the source dir's mise config directory,
// outside any project config, so `--global` and the install see only the
// global config. chezmoi-source-path already ends in `home` (.chezmoiroot).
//
// SUPERVISE (deno-effect-tools.md §9): the mise child inherits stdout/stderr so
// its progress streams straight to the terminal, and the parent captures the
// exit code to mirror it. Run under NodeRuntime.runMain so a Ctrl-C gracefully
// tears the child down (SIGTERM -> SIGKILL).
//
// PERMISSIONS: --allow-run (spawn mise, chezmoi), --allow-sys=uid (the Node
// spawner checks the child `cwd` with fs.access, which calls uid()), plus
// --allow-env for child-process
// environment inheritance. NodeRuntime and NodeServices are
// imported as SUBMODULE paths, never as the bare package, because the package
// index re-exports cluster/ShardingConfig, which calls
// ConfigProvider.fromEnv at module-evaluation time and so ENUMERATES process.env —
// an enumeration Deno cannot scope, forcing a blanket --allow-env. Argument
// parsing and `--help` are owned by effect/cli, which reads argv through
// the Stdio service in NodeServices.layer, so they need the same grants as the
// real upgrade path. The platform-node import is dynamic (import.meta.main path
// only) to keep `deno test` hermetic and permission-free.
//
// Logging: `fatal` is a tiny inline helper (prints "fatal <msg>" to stderr then
// exits 1); progress goes through df-log so the format matches every other
// dotfiles tool. Effect v4 import paths verified against effect@4.0.0.

import {
  Data,
  Effect,
  FileSystem,
  Layer,
  Path,
  Stdio,
  Stream,
  Terminal,
} from "npm:effect@4.0.0";
import { Command } from "npm:effect@4.0.0/cli";
import { ChildProcess, ChildProcessSpawner } from "npm:effect@4.0.0/process";
import { setTopic, step } from "../lib/df-log.ts";

setTopic("mise");

// Inline replacement for deno-logging.fatal: "fatal <msg>" on stderr, exit 1.
const fatal = (msg: string): never => {
  console.error(`fatal ${msg}`);
  Deno.exit(1);
};

// --------------------------------------------------------------------------
// Command description, rendered by the CLI framework under `--help`. The
// framework indents the first line only, so continuation lines carry their own
// two spaces to keep the DESCRIPTION block aligned.
// --------------------------------------------------------------------------

const DESCRIPTION =
  `Bumps the global mise lock in the chezmoi source repo, then installs it.
  Runs \`mise lock --global --bump\` and \`mise install --locked\` with
  MISE_GLOBAL_CONFIG_FILE set to the source copy of the mise config, so the
  new mise.lock lands in the repo (commit it) and the next chezmoi apply
  deploys it. Requests such as "latest" move; exact pins do not. Releases
  younger than the config's minimum_release_age are skipped.`;

// --------------------------------------------------------------------------
// Errors — one cause per error, structured. Each decision is a typed failure
// so the entrypoint (not the core logic) owns the fatal/exit side effect,
// keeping `program` observable under test.
// --------------------------------------------------------------------------

class MissingCommandError extends Data.TaggedError("MissingCommandError")<{
  readonly command: string;
}> {}

class SourcePathError
  extends Data.TaggedError("SourcePathError")<Record<never, never>> {}

// --------------------------------------------------------------------------
// Pure helpers
// --------------------------------------------------------------------------

/** Source-relative path of the managed mise config. */
const MISE_CONFIG_RELATIVE = "private_dot_config/mise/config.toml";

/**
 * Absolute path of the managed mise config inside the chezmoi source dir
 * (the `chezmoi source-path` output, which already includes .chezmoiroot).
 */
export const sourceMiseConfig = (sourcePath: string): string =>
  `${sourcePath.replace(/\/+$/, "")}/${MISE_CONFIG_RELATIVE}`;

/** Directory of a file path (the config's dir: the cwd for both mise runs). */
export const dirOf = (file: string): string =>
  file.slice(0, file.lastIndexOf("/"));

/** The two mise steps, in order: bump the lock, then install from it. */
export const MISE_STEPS: ReadonlyArray<ReadonlyArray<string>> = [
  ["lock", "--global", "--bump"],
  ["install", "--locked", "-y"],
];

// --------------------------------------------------------------------------
// Runtime program (SUPERVISE). Requires ChildProcessSpawner, supplied by
// NodeServices.layer at the entrypoint. Returns the exit code to propagate:
// 0, or the first failing mise step's code.
// --------------------------------------------------------------------------

const program: Effect.Effect<
  number,
  MissingCommandError | SourcePathError,
  ChildProcessSpawner.ChildProcessSpawner
> = Effect.gen(function* () {
  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;

  // Probe a binary on PATH (mirrors bash `command -v`). Any failure to even
  // start the probe counts as absent.
  const probe = (command: string) =>
    spawner
      .exitCode(
        ChildProcess.make(command, ["--version"], {
          stdout: "ignore",
          stderr: "ignore",
        }),
      )
      .pipe(
        Effect.map((code) => code === 0),
        Effect.orElseSucceed(() => false),
      );

  for (const command of ["mise", "chezmoi"]) {
    if (!(yield* probe(command))) {
      return yield* Effect.fail(new MissingCommandError({ command }));
    }
  }

  // `.string` captures stdout and fails on a non-zero exit; collapse that to
  // "" and treat an empty result as a failure.
  const sourcePath = (yield* spawner
    .string(
      ChildProcess.make("chezmoi", ["source-path"], { stderr: "inherit" }),
    )
    .pipe(Effect.orElseSucceed(() => ""))).trim();
  if (sourcePath === "") {
    return yield* Effect.fail(new SourcePathError());
  }

  const config = sourceMiseConfig(sourcePath);

  for (const args of MISE_STEPS) {
    yield* Effect.sync(() => step(`Running mise ${args.join(" ")}`));
    // Inherit stdio so mise's progress goes straight to the terminal. A
    // spawner-level failure after the probe is treated as exit 1.
    const code = yield* spawner
      .exitCode(
        ChildProcess.make("mise", [...args], {
          cwd: dirOf(config),
          env: { MISE_GLOBAL_CONFIG_FILE: config },
          extendEnv: true,
          stdout: "inherit",
          stderr: "inherit",
        }),
      )
      .pipe(Effect.orElseSucceed(() => 1));
    if (code !== 0) return code;
  }

  return 0;
});

// --------------------------------------------------------------------------
// CLI command. Takes no flags or arguments; the framework owns `--help`.
// Top-level safe: defining the command pulls no platform-node code.
// --------------------------------------------------------------------------

const command = Command.make(
  "df-task-mise-upgrade",
  {},
  () =>
    program.pipe(
      // Missing binary -> "fatal <cmd> not on PATH" + exit 1.
      Effect.catchTag(
        "MissingCommandError",
        (error) => Effect.sync(() => fatal(`${error.command} not on PATH`)),
      ),
      Effect.catchTag(
        "SourcePathError",
        () =>
          Effect.sync(() =>
            fatal(
              "could not resolve chezmoi source path (chezmoi source-path failed)",
            )
          ),
      ),
      // Propagate mise's exit code verbatim.
      Effect.flatMap((code) => Effect.sync(() => Deno.exit(code))),
    ),
).pipe(Command.withDescription(DESCRIPTION));

// --------------------------------------------------------------------------
// Entry point
// --------------------------------------------------------------------------

if (import.meta.main) {
  // Last-resort backstop: catch anything that escapes the Effect runtime
  // (raw node-stream callbacks, forked-fiber defects, unhandled rejections).
  // NodeRuntime.runMain does NOT install these (only SIGINT/SIGTERM) — verified
  // against effect-smol source. Inside import.meta.main so `deno test` stays hermetic.
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(`error uncaught: ${event.message}`);
    Deno.exit(1);
  });

  // Dynamic import keeps `deno test` permission-free (see header). NodeServices
  // supplies the ChildProcessSpawner and the Stdio argv source; NodeRuntime.runMain
  // installs the signal handlers SUPERVISE relies on for graceful child teardown.
  // Submodule paths, not the bare package index — see the header note on
  // --allow-env.
  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0/NodeServices"
  );
  Command.run(command, { version: "0.0.0" }).pipe(
    Effect.provide(NodeServices.layer),
    NodeRuntime.runMain,
  );
}

// === Tests =================================================================
// Run offline with ZERO permission flags:
//   deno test home/private_dot_local/bin/executable_df-task-mise-upgrade
// The import.meta.main guard keeps the CLI (and the Node platform import) from
// firing under test. These cover argument handling through the real CLI parser
// (`--help` is handled without reaching the handler; an unrecognised flag is
// rejected), the pure path helpers, and the SUPERVISE program against a mock
// spawner (missing-binary and source-path failures, the lock-then-install
// sequence with its cwd/env, and exit-code propagation) — all without spawning
// real mise or chezmoi.

const assertEq = <T>(actual: T, expected: T, msg: string): void => {
  const a = JSON.stringify(actual);
  const e = JSON.stringify(expected);
  if (a !== e) throw new Error(`${msg}: ${a} !== ${e}`);
};

// What the program asked the spawner to run.
interface Call {
  readonly command: string;
  readonly args: ReadonlyArray<string>;
  readonly cwd?: string;
  readonly config?: string;
}

const callOf = (command: unknown): Call => {
  const c = command as {
    readonly command?: string;
    readonly args?: ReadonlyArray<string>;
    readonly options?: {
      readonly cwd?: string;
      readonly env?: Record<string, string | undefined>;
    };
  };
  return {
    command: c.command ?? "",
    args: c.args ?? [],
    cwd: c.options?.cwd,
    config: c.options?.env?.MISE_GLOBAL_CONFIG_FILE,
  };
};

const SOURCE = "/src/chezmoi/home";

// Mock ChildProcessSpawner. `exitFor` decides each exit code from the call, so
// probes (`<cmd> --version`) and mise steps can be steered independently;
// `string` answers `chezmoi source-path`. Every call is recorded. The other
// methods are deliberately unimplemented stubs that fail loudly if reached.
const mockSpawner = (
  exitFor: (call: Call) => number,
  sourcePath: string = SOURCE,
) => {
  const calls: Array<Call> = [];
  const layer: Layer.Layer<ChildProcessSpawner.ChildProcessSpawner> = Layer
    .succeed(
      ChildProcessSpawner.ChildProcessSpawner,
      ChildProcessSpawner.ChildProcessSpawner.of({
        spawn: () => Effect.die("mock spawner: spawn() unused"),
        exitCode: (command) =>
          Effect.sync(() => {
            const call = callOf(command);
            calls.push(call);
            return ChildProcessSpawner.ExitCode(exitFor(call));
          }),
        streamString: () => Stream.die("mock spawner: streamString() unused"),
        streamLines: () => Stream.die("mock spawner: streamLines() unused"),
        lines: () => Effect.die("mock spawner: lines() unused"),
        string: (command) =>
          Effect.sync(() => {
            calls.push(callOf(command));
            return `${sourcePath}\n`;
          }),
      }),
    );
  return { layer, calls };
};

const isProbe = (call: Call) => call.args.includes("--version");

// Environment the CLI parser needs (FileSystem | Path | Terminal | Stdio |
// ChildProcessSpawner), assembled from in-memory test implementations so the
// parser runs offline. The spawner dies if reached: the parse-only cases below
// never invoke the handler.
const cliTestLayer = Layer.mergeAll(
  FileSystem.layerNoop({}),
  Path.layer,
  Stdio.layerTest({}),
  Layer.succeed(
    Terminal.Terminal,
    Terminal.make({
      columns: Effect.succeed(80),
      rows: Effect.succeed(24),
      readInput: Effect.die("cli test: readInput unused"),
      readLine: Effect.die("cli test: readLine unused"),
      display: () => Effect.void,
    }),
  ),
  Layer.succeed(
    ChildProcessSpawner.ChildProcessSpawner,
    ChildProcessSpawner.make(() => Effect.die("cli test: spawn unused")),
  ),
);

const parseArgv = (argv: ReadonlyArray<string>) =>
  Effect.runPromise(
    Command.runWith(command, { version: "0.0.0" })(argv).pipe(
      Effect.provide(cliTestLayer),
      Effect.exit,
    ),
  );

Deno.test("cli: --help is handled by the framework, handler never runs", async () => {
  // A spawner call would die; reaching Success proves the help path
  // short-circuits before the handler.
  const exit = await parseArgv(["--help"]);
  assertEq(exit._tag, "Success", "help exit");
});

Deno.test("cli: an unrecognised flag is rejected", async () => {
  const exit = await parseArgv(["--bogus"]);
  assertEq(exit._tag, "Failure", "unknown flag exit");
});

Deno.test("sourceMiseConfig: joins the source dir and the config path", () => {
  assertEq(
    sourceMiseConfig("/src/home"),
    "/src/home/private_dot_config/mise/config.toml",
    "plain",
  );
  assertEq(
    sourceMiseConfig("/src/home/"),
    "/src/home/private_dot_config/mise/config.toml",
    "trailing slash",
  );
  assertEq(dirOf("/a/b/config.toml"), "/a/b", "dirOf");
});

Deno.test(
  "program: a missing binary fails with MissingCommandError naming it",
  async () => {
    for (const absent of ["mise", "chezmoi"]) {
      const { layer } = mockSpawner((call) =>
        isProbe(call) && call.command === absent ? 127 : 0
      );
      const err = await Effect.runPromise(
        program.pipe(Effect.provide(layer), Effect.flip),
      );
      assertEq(err._tag, "MissingCommandError", `${absent} error tag`);
      assertEq(
        (err as MissingCommandError).command,
        absent,
        `${absent} command`,
      );
    }
  },
);

Deno.test("program: empty chezmoi source-path fails with SourcePathError", async () => {
  const { layer, calls } = mockSpawner(() => 0, "  ");
  const err = await Effect.runPromise(
    program.pipe(Effect.provide(layer), Effect.flip),
  );
  assertEq(err._tag, "SourcePathError", "error tag");
  assertEq(
    calls.filter((call) => call.command === "mise" && !isProbe(call)).length,
    0,
    "no mise step ran",
  );
});

Deno.test(
  "program: locks then installs against the source config, returns 0",
  async () => {
    const { layer, calls } = mockSpawner(() => 0);
    const code = await Effect.runPromise(program.pipe(Effect.provide(layer)));
    assertEq(code, 0, "exit code");
    const config = `${SOURCE}/private_dot_config/mise/config.toml`;
    const steps = calls.filter((call) =>
      call.command === "mise" && !isProbe(call)
    );
    assertEq(steps, [
      {
        command: "mise",
        args: ["lock", "--global", "--bump"],
        cwd: `${SOURCE}/private_dot_config/mise`,
        config,
      },
      {
        command: "mise",
        args: ["install", "--locked", "-y"],
        cwd: `${SOURCE}/private_dot_config/mise`,
        config,
      },
    ], "mise steps");
  },
);

Deno.test(
  "program: a failed lock bump stops before install and propagates its code",
  async () => {
    const { layer, calls } = mockSpawner((call) =>
      call.args.includes("lock") ? 7 : 0
    );
    const code = await Effect.runPromise(program.pipe(Effect.provide(layer)));
    assertEq(code, 7, "propagated exit code");
    assertEq(
      calls.some((call) => call.args.includes("install")),
      false,
      "install skipped",
    );
  },
);

Deno.test("program: propagates the install's non-zero exit code", async () => {
  const { layer } = mockSpawner((call) =>
    call.args.includes("install") ? 3 : 0
  );
  const code = await Effect.runPromise(program.pipe(Effect.provide(layer)));
  assertEq(code, 3, "propagated exit code");
});
