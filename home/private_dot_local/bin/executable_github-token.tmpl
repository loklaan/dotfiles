#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# Source shared logging for help and error paths. Session logging is omitted
# because this command's stdout is its secret-bearing API.
source "${HOME}/.local/lib/bash-logging.sh"

#/ Usage:
#/   github-token
#/
#/ Description:
#/   Prints a GitHub API token to stdout for use by tools that need
#/   authenticated GitHub access (brew, gh, scripts, etc.).
#/
#/   Prints the static GITHUB_TOKEN from the shell environment (sourced from
#/   Bitwarden Secrets).
#/
#/ Options:
#/   --help:      Display this help message
main() {
  bl_parse_help "$@"

  if [ -z "${GITHUB_TOKEN:-}" ]; then
    fatal "GITHUB_TOKEN is not set. Check BWS configuration with 'df-setup'."
  fi

  echo "$GITHUB_TOKEN"
}

main "$@"
