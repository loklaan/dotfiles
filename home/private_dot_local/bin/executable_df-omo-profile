#!/usr/bin/env -S DENO_NO_PACKAGE_JSON=1 deno run -q --allow-run=chezmoi --allow-read --allow-write --allow-env --allow-ffi

// df-omo-profile (Deno + Effect v4). Switches the oh-my-openagent (omo) cost
// profile without a full `chezmoi apply`. Profiles trade model quality for token
// cost while preserving each agent's personality family (Claude-likes stay
// Claude-likes, GPT stays GPT, Gemini stays Gemini).
//
// Single source of truth: a dotfiles-owned sidecar
// (~/.config/opencode/.omo-profile.json) holds `profile` (the active tier) and
// `availableTiers` (the valid tier names). Tier state lives OUTSIDE OMO's config
// because OMO validates its config against a strict schema
// (additionalProperties:false) and rejects unknown keys — so the dotfiles'
// bookkeeping cannot sit inside ~/.omo/omo.jsonc. This tool reads/writes the
// sidecar; the rendered OMO config is read only to list resolved models.
//
// Mechanism: this tool writes `profile` in the sidecar, then runs a TARGETED
// `chezmoi apply` on just ~/.omo/omo.jsonc; that file's modify-template reads the
// sidecar to pick the tier and re-renders the models. The profile table is the
// source of truth in the chezmoi template; a later full `chezmoi apply`
// re-derives the same result — the switch survives. omo reads its config once
// per session, so START A NEW opencode SESSION for the switch to take effect.
//
// CLI surface (preserved from the original bash):
//   df-omo-profile            Show the active profile and its resolved models
//   df-omo-profile list       List available profiles
//   df-omo-profile <name>     Switch to <name> and re-render the omo config
//   df-omo-profile --help     Display this help message
//
// Exit codes: 0 success; 1 unknown profile / chezmoi missing / too many args.
//
// All concerns (FS, subprocess, errors, flow) run through Effect. NodeServices /
// NodeRuntime from @effect/platform-node run under Deno via its node:
// compatibility layer; NodeServices provides FileSystem, Path, and the
// ChildProcessSpawner used for the targeted apply. Effect v4 import paths.
//
// IMPORTANT: @effect/platform-node is imported DYNAMICALLY inside the
// `import.meta.main` block, never at module top level, and as the NodeRuntime and
// NodeServices SUBMODULE paths rather than the bare package. Its graph pulls in
// msgpackr, which reads `MSGPACKR_NATIVE_ACCELERATION_DISABLED` at module-load
// time, and the package index re-exports unstable/cluster/ShardingConfig, whose
// `ConfigProvider.fromEnv` call ENUMERATES `process.env` — an enumeration Deno
// cannot scope, so loading it demands a blanket `--allow-env`. Deferring the
// import keeps `deno test` runnable with ZERO permission flags: the tests only
// touch the pure surfaces below and never construct the Node layer. The runtime
// entrypoint loads it on demand.
//
// FILESYSTEM: file reads/writes go through Deno's native APIs (Deno.readTextFile
// / Deno.mkdir / Deno.writeTextFile) wrapped in Effect, NOT through the platform
// FileSystem service. Under Deno, the platform FileSystem's `exists`/stat path
// resolves file ownership via `uid`, which demands `--allow-sys` — a permission
// the mandated shebang deliberately omits. Native FS honours exactly
// `--allow-read` / `--allow-write`. The ChildProcessSpawner (for the chezmoi
// probe + targeted apply) still comes from the Node platform layer.

import {
  Console,
  Context,
  Effect,
  Layer,
  Option,
  Schema,
} from "npm:effect@4.0.0-rc.112";
import { Argument, Command } from "npm:effect@4.0.0-rc.112/unstable/cli";
import {
  ChildProcess,
  ChildProcessSpawner,
} from "npm:effect@4.0.0-rc.112/unstable/process";

// --------------------------------------------------------------------------
// Constants & contracts
// --------------------------------------------------------------------------

// Tier state lives in a dotfiles-owned sidecar — NOT inside OMO's config, whose
// strict schema (additionalProperties:false) rejects unknown keys. The rendered
// OMO config is only read for the model listing in `showStatus`.
const SIDECAR_REL = ".config/opencode/.omo-profile.json";
const OMO_CONFIG_REL = ".omo/omo.jsonc";

// Printed alongside a fatal argument error so the caller sees the shape it
// should have used. `--help` renders the generated CLI help instead.
const USAGE = `Usage:
  df-omo-profile            Show the active profile and its resolved models
  df-omo-profile list       List available profiles
  df-omo-profile <name>     Switch to <name> and re-render the omo config
  df-omo-profile --help     Display this help message`;

// Rendered in the DESCRIPTION block of `df-omo-profile --help`.
const DESCRIPTION =
  `Switches the oh-my-openagent (omo) cost profile without a full
\`chezmoi apply\`. Profiles trade model quality for token cost while
preserving each agent's personality family (Claude-likes stay
Claude-likes, GPT stays GPT, Gemini stays Gemini).

Single source of truth: a dotfiles-owned sidecar
(~/.config/opencode/.omo-profile.json) holds \`profile\` (the active tier)
and \`availableTiers\` (the valid names). Tier state lives outside OMO's
config, whose strict schema rejects unknown keys. This tool reads and
writes the sidecar directly.

Mechanism: this tool writes \`profile\` in the sidecar, then runs a
TARGETED \`chezmoi apply\` on just ~/.omo/omo.jsonc so the new models
land immediately. The profile table is the source of truth in the chezmoi
template; a later full \`chezmoi apply\` re-derives the same result — the
switch survives.

omo reads its config once per session, so START A NEW opencode SESSION
for the switch to take effect.`;

// --------------------------------------------------------------------------
// Errors — one cause per error, structured, never information-hiding.
// --------------------------------------------------------------------------

class UnknownProfileError extends Schema.TaggedError<UnknownProfileError>()(
  "UnknownProfileError",
  {
    name: Schema.String,
    available: Schema.Array(Schema.String),
  },
) {
  get displayMessage(): string {
    return `Unknown profile: ${this.name} (known: ${this.available.join(" ")})`;
  }
}

class TooManyArgumentsError extends Schema.TaggedError<TooManyArgumentsError>()(
  "TooManyArgumentsError",
  { args: Schema.Array(Schema.String) },
) {
  get displayMessage(): string {
    return "Too many arguments";
  }
}

class ChezmoiMissingError extends Schema.TaggedError<ChezmoiMissingError>()(
  "ChezmoiMissingError",
  {},
) {
  get displayMessage(): string {
    return "chezmoi not on PATH — required to re-render the omo config";
  }
}

class ChezmoiApplyError
  extends Schema.TaggedError<ChezmoiApplyError>()("ChezmoiApplyError", {
    exitCode: Schema.Number,
    target: Schema.String,
  }) {
  get displayMessage(): string {
    return `chezmoi apply --force ${this.target} failed (exit ${this.exitCode})`;
  }
}

// Fatal CLI errors carry a `displayMessage` (mirrors the bash `fatal` wording)
// so the runner can map any tagged failure to a process exit without inspecting
// each tag. Exit code is always 1 for these, matching the original bash.
type FatalCliError =
  | UnknownProfileError
  | TooManyArgumentsError
  | ChezmoiMissingError
  | ChezmoiApplyError;

// --------------------------------------------------------------------------
// Schemas.
//
// Tier state (active profile + valid tiers) lives in the dotfiles-owned sidecar.
// The rendered OMO config is read ONLY for the agent/category model listing in
// `showStatus`; its models sit inside the "[opencode]" harness block.
// --------------------------------------------------------------------------

const ModelEntry = Schema.Struct({
  model: Schema.optional(Schema.String),
  variant: Schema.optional(Schema.String),
});
type ModelEntry = typeof ModelEntry.Type;

// Dotfiles-owned tier-state sidecar (~/.config/opencode/.omo-profile.json).
const Sidecar = Schema.Struct({
  profile: Schema.optional(Schema.String),
  availableTiers: Schema.optional(Schema.Array(Schema.String)),
});
type Sidecar = typeof Sidecar.Type;

// Rendered OMO config — only the "[opencode]" block's model maps are read.
const OmoConfig = Schema.Struct({
  "[opencode]": Schema.optional(Schema.Struct({
    agents: Schema.optional(Schema.Record(Schema.String, ModelEntry)),
    categories: Schema.optional(Schema.Record(Schema.String, ModelEntry)),
  })),
});
type OmoConfig = typeof OmoConfig.Type;

const decodeSidecarSync = Schema.decodeUnknownSync(Sidecar);
const decodeOmoConfigSync = Schema.decodeUnknownSync(OmoConfig);

// Decode-or-none: callers tolerate a malformed/foreign file by degrading rather
// than throwing. Unknown keys (OMO's own config) are tolerated by Schema.Struct.
const decodeSidecar = (input: unknown): Option.Option<Sidecar> => {
  try {
    return Option.some(decodeSidecarSync(input));
  } catch {
    return Option.none();
  }
};

const decodeOmoConfig = (input: unknown): Option.Option<OmoConfig> => {
  try {
    return Option.some(decodeOmoConfigSync(input));
  } catch {
    return Option.none();
  }
};

// OMO writes ~/.omo/omo.jsonc with a leading `// OMO configuration` comment.
// JSON.parse rejects comments, so strip whole-line // comments before parsing.
// Exported-shaped as a pure helper so the in-file tests can exercise it.
const stripJsoncComments = (text: string): string =>
  text
    .split("\n")
    .filter((line) => !line.trimStart().startsWith("//"))
    .join("\n");

// --------------------------------------------------------------------------
// Pure helpers (unit-testable without FS or env).
// --------------------------------------------------------------------------

// Pure: format a {model, variant?} record as the sorted "    key: model (variant)"
// lines the original jq pipeline produced.
const formatModelLines = (
  record: Record<string, ModelEntry> | undefined,
): ReadonlyArray<string> =>
  Object.entries(record ?? {})
    .map(([key, value]) => {
      const model = value.model ?? "";
      const variant = value.variant ? ` (${value.variant})` : "";
      return `    ${key}: ${model}${variant}`;
    })
    .sort();

// --------------------------------------------------------------------------
// Native filesystem helpers (Deno APIs wrapped in Effect).
//
// These deliberately bypass the platform FileSystem service: under Deno its
// stat path resolves `uid`, which would force `--allow-sys` onto the shebang.
// Native Deno.* honours exactly `--allow-read` / `--allow-write`.
// --------------------------------------------------------------------------

// Read + parse the tier-state sidecar, returning Option.none on any failure.
const readSidecar = (
  path: string,
): Effect.Effect<Option.Option<Sidecar>> =>
  Effect.sync(() => {
    try {
      const raw = JSON.parse(Deno.readTextFileSync(path)) as unknown;
      return decodeSidecar(raw);
    } catch {
      return Option.none();
    }
  });

// Write the tier-state sidecar (whole-file rewrite).
const writeSidecar = (
  path: string,
  sidecar: Sidecar,
): Effect.Effect<void> =>
  Effect.tryPromise(() =>
    Deno.writeTextFile(path, JSON.stringify(sidecar, null, 2))
  ).pipe(Effect.orDie);

// Read + parse the rendered OMO config (JSONC), returning Option.none on any
// failure. Strips // comments before parsing since OMO writes a comment header.
const readOmoConfig = (
  path: string,
): Effect.Effect<Option.Option<OmoConfig>> =>
  Effect.sync(() => {
    try {
      const raw = JSON.parse(
        stripJsoncComments(Deno.readTextFileSync(path)),
      ) as unknown;
      return decodeOmoConfig(raw);
    } catch {
      return Option.none();
    }
  });

// Recursively create a directory, swallowing "already exists".
const makeDirRecursive = (path: string): Effect.Effect<void> =>
  Effect.tryPromise(() => Deno.mkdir(path, { recursive: true })).pipe(
    Effect.orElseSucceed(() => undefined),
  );

// Join HOME with a relative path using a single forward slash. The targets are
// always under ~/.config, so POSIX joining is sufficient and keeps this free of
// the Path service (and its transitive permission surface).
const joinHome = (home: string, rel: string): string =>
  home.endsWith("/") ? `${home}${rel}` : `${home}/${rel}`;

// Directory portion of a POSIX path (everything before the last slash).
const posixDirname = (path: string): string => {
  const idx = path.lastIndexOf("/");
  return idx <= 0 ? "/" : path.slice(0, idx);
};

// --------------------------------------------------------------------------
// Profiles service: all state-file + chezmoi interaction behind one interface.
// --------------------------------------------------------------------------

class Profiles extends Context.Service<Profiles, {
  readonly activeProfile: Effect.Effect<string>;
  readonly showStatus: Effect.Effect<void>;
  readonly listProfiles: Effect.Effect<void>;
  readonly switchProfile: (name: string) => Effect.Effect<void, FatalCliError>;
}>()("omo-profile/Profiles") {
  static readonly layer = Layer.effect(
    Profiles,
    Effect.gen(function* () {
      const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;

      const home = yield* Effect.sync(() => Deno.env.get("HOME") ?? "");
      const sidecarPath = joinHome(home, SIDECAR_REL);
      const omoConfigPath = joinHome(home, OMO_CONFIG_REL);

      // Active profile: read `profile` from the sidecar. Fall back to the first
      // item of `availableTiers` when unset, else a sentinel.
      const activeProfile: Effect.Effect<string> = readSidecar(
        sidecarPath,
      ).pipe(
        Effect.map((maybe) =>
          Option.match(maybe, {
            onNone: () => "(unknown)" as string,
            onSome: (sidecar) => {
              const profile = sidecar.profile;
              if (profile !== undefined && profile.length > 0) {
                return profile;
              }
              const tiers = sidecar.availableTiers;
              if (tiers !== undefined && tiers.length > 0) {
                return tiers[0];
              }
              return "(unset)" as string;
            },
          })
        ),
      );

      // Does a binary exist on PATH? Probe via the platform spawner so the
      // permission surface stays exactly `--allow-run=chezmoi,...`. Any failure
      // to even start the probe is treated as "absent".
      const onPath = (bin: string): Effect.Effect<boolean> =>
        spawner.exitCode(
          ChildProcess.make(bin, ["--version"], {
            stdout: "ignore",
            stderr: "ignore",
          }),
        ).pipe(
          Effect.map((code) => code === 0),
          Effect.orElseSucceed(() => false),
        );

      const info = (msg: string) => Console.error(`info ${msg}`);
      const warning = (msg: string) => Console.error(`warning ${msg}`);

      // Read `availableTiers` from the sidecar for validation.
      const getAvailableTiers = (): Effect.Effect<ReadonlyArray<string>> =>
        readSidecar(sidecarPath).pipe(
          Effect.map((maybe) =>
            Option.match(maybe, {
              onNone: () => [] as string[],
              onSome: (sidecar) => sidecar.availableTiers ?? [],
            })
          ),
        );

      const showStatus: Effect.Effect<void> = Effect.gen(function* () {
        const active = yield* activeProfile;

        yield* info(`\u25B6 Active omo profile: ${active}`);

        const tiers = yield* getAvailableTiers();

        const maybeConfig = yield* readOmoConfig(omoConfigPath);
        if (Option.isNone(maybeConfig)) {
          yield* warning(
            `omo config not found at ${omoConfigPath} — run \`chezmoi apply\` first`,
          );
          if (tiers.length > 0) {
            yield* info(`\u254D Available tiers: ${tiers.join(", ")}`);
          }
          return;
        }

        const block = maybeConfig.value["[opencode]"] ?? {};

        yield* info("\u254D Agents");
        for (const line of formatModelLines(block.agents)) {
          yield* Console.error(line);
        }
        yield* info("\u254D Categories");
        for (const line of formatModelLines(block.categories)) {
          yield* Console.error(line);
        }

        if (tiers.length > 0) {
          yield* info(`\u254D Available tiers: ${tiers.join(", ")}`);
        }
      });

      const listProfiles: Effect.Effect<void> = Effect.gen(function* () {
        const active = yield* activeProfile;
        const tiers = yield* getAvailableTiers();
        yield* info("\u25B6 Available omo profiles");
        for (const p of tiers) {
          const marker = p === active ? "* " : "  ";
          yield* Console.error(`  ${marker}${p}`);
        }
      });

      const switchProfile = (
        name: string,
      ): Effect.Effect<void, FatalCliError> =>
        Effect.gen(function* () {
          const tiers = yield* getAvailableTiers();

          if (!tiers.includes(name)) {
            yield* Console.error(USAGE);
            yield* Console.error("");
            return yield* Effect.fail(
              new UnknownProfileError({ name, available: tiers }),
            );
          }

          const hasChezmoi = yield* onPath("chezmoi");
          if (!hasChezmoi) {
            return yield* Effect.fail(new ChezmoiMissingError());
          }

          const current = yield* activeProfile;
          if (current === name) {
            yield* info(
              `\u25B6 Already on profile '${name}' — re-rendering anyway`,
            );
          } else {
            yield* info(
              `\u25B6 Switching omo profile: ${current} \u2192 ${name}`,
            );
          }

          // Write the active tier to the dotfiles-owned sidecar. Preserve the
          // known tier list so a fresh read is self-describing even before the
          // next full apply re-derives it from profiles.json.
          const maybeSidecar = yield* readSidecar(sidecarPath);
          const priorTiers = Option.match(maybeSidecar, {
            onNone: () => tiers,
            onSome: (s) => s.availableTiers ?? tiers,
          });
          const updatedSidecar: Sidecar = {
            profile: name,
            availableTiers: priorTiers,
          };

          yield* makeDirRecursive(posixDirname(sidecarPath));
          yield* writeSidecar(sidecarPath, updatedSidecar);
          yield* info(`\u254D Wrote ${sidecarPath}`);

          yield* info(
            `\u254D Re-rendering ${omoConfigPath} via targeted chezmoi apply`,
          );

          // Targeted apply on just the omo config; its modify-template reads the
          // sidecar we just wrote to pick the tier. Inherit stdio so chezmoi's
          // own output reaches the terminal, matching the bash behaviour.
          const exitCode = yield* spawner.exitCode(
            ChildProcess.make("chezmoi", ["apply", "--force", omoConfigPath], {
              stdout: "inherit",
              stderr: "inherit",
            }),
          ).pipe(Effect.orElseSucceed(() => 1));
          if (exitCode !== 0) {
            return yield* Effect.fail(
              new ChezmoiApplyError({ exitCode, target: omoConfigPath }),
            );
          }

          yield* info(
            "\u25B6 Done. Start a NEW opencode session for the switch to take effect.",
          );
        });

      return Profiles.of({
        activeProfile,
        showStatus,
        listProfiles,
        switchProfile,
      });
    }),
  );
}

// The only platform service this layer depends on is the ChildProcessSpawner
// (for the chezmoi probe + targeted apply). It is supplied at the runtime
// entrypoint via NodeServices.layer, which is imported dynamically to keep tests
// permission-free. All filesystem work uses native Deno APIs, not the platform
// FileSystem service (see the FILESYSTEM note in the header).
type ProfilesRequirements = ChildProcessSpawner.ChildProcessSpawner;

// --------------------------------------------------------------------------
// CLI
// --------------------------------------------------------------------------

// Surface the fatal message exactly like bash `fatal`, then re-fail so the
// runtime maps it to a non-zero exit.
const withProfiles = <A>(
  body: Effect.Effect<A, FatalCliError, Profiles>,
): Effect.Effect<A, FatalCliError, ProfilesRequirements> =>
  body.pipe(
    Effect.tapError((error) => Console.error(`fatal ${error.displayMessage}`)),
    Effect.provide(Profiles.layer),
  );

const listCli = Command.make(
  "list",
  {},
  () =>
    withProfiles(Effect.gen(function* () {
      const profiles = yield* Profiles;
      yield* profiles.listProfiles;
    })),
).pipe(Command.withDescription("List available profiles"));

// A bare positional keeps the documented `df-omo-profile <name>` form. The
// parser rejects a second positional with exit 1, so arity needs no guard here.
const profileArg = Argument.string("profile").pipe(
  Argument.withDescription("profile to switch to"),
  Argument.optional,
);

const profileCommand = Command.make(
  "df-omo-profile",
  { profile: profileArg },
  ({ profile }) =>
    withProfiles(Effect.gen(function* () {
      const profiles = yield* Profiles;
      yield* Option.match(profile, {
        onNone: () => profiles.showStatus,
        onSome: (name) => profiles.switchProfile(name),
      });
    })),
).pipe(
  Command.withDescription(DESCRIPTION),
  Command.withSubcommands([listCli]),
);

if (import.meta.main) {
  // Last-resort backstop: catch anything that escapes the Effect runtime
  // (raw node-stream callbacks, forked-fiber defects, unhandled rejections).
  // NodeRuntime.runMain does NOT install these (only SIGINT/SIGTERM) — verified
  // against effect-smol source. Inside import.meta.main so `deno test` stays hermetic.
  globalThis.addEventListener("unhandledrejection", (event) => {
    event.preventDefault();
    console.error(`error uncaught rejection: ${event.reason}`);
    Deno.exit(1);
  });
  globalThis.addEventListener("error", (event) => {
    event.preventDefault();
    console.error(`error uncaught: ${event.message}`);
    Deno.exit(1);
  });

  // Dynamic import: @effect/platform-node's graph reads process.env at load time
  // (via msgpackr), which would force --allow-env onto `deno test`. Loading it
  // only here keeps the test surface permission-free. Submodule paths, not the
  // bare package index — see the IMPORTANT note in the header.
  const NodeRuntime = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeRuntime"
  );
  const NodeServices = await import(
    "npm:@effect/platform-node@4.0.0-rc.112/NodeServices"
  );
  Command.run(profileCommand, { version: "0.0.0" }).pipe(
    Effect.provide(NodeServices.layer),
    NodeRuntime.runMain,
  );
}

// ===========================================================================
// Tests. Run offline with ZERO permission flags:
//
//   deno test home/private_dot_local/bin/executable_df-omo-profile
//
// The `import.meta.main` guard above keeps the CLI from firing under test. These
// tests cover the pure surfaces that carry the contract: sidecar tier-state
// decode, the omo-config [opencode]-block model decode (the shape the status
// command relies on), the JSONC comment stripping, profile-name validation, and
// the model-line formatting. No FS, env, or subprocess access is touched, so no
// permissions are required.
// ===========================================================================

const assert = (cond: boolean, msg: string) => {
  if (!cond) throw new Error(msg);
};

Deno.test("Sidecar decodes tier state with all fields", () => {
  const decoded = decodeSidecar({
    profile: "cheap",
    availableTiers: ["default", "cheap"],
  });
  assert(Option.isSome(decoded), "expected a successful decode");
  if (Option.isSome(decoded)) {
    assert(decoded.value.profile === "cheap", "profile field did not decode");
    assert(
      decoded.value.availableTiers !== undefined &&
        decoded.value.availableTiers.length === 2,
      "availableTiers did not decode",
    );
  }
});

Deno.test("Sidecar decodes with missing optional fields", () => {
  const decoded = decodeSidecar({});
  assert(Option.isSome(decoded), "empty object should decode");
  if (Option.isSome(decoded)) {
    assert(decoded.value.profile === undefined, "profile should be undefined");
    assert(
      decoded.value.availableTiers === undefined,
      "availableTiers should be undefined",
    );
  }
});

Deno.test("OmoConfig decodes models from the [opencode] block", () => {
  const decoded = decodeOmoConfig({
    "[opencode]": {
      agents: {
        oracle: { model: "openai/gpt-5.4-mini" },
        explore: { model: "amazon-bedrock/...haiku" },
      },
      categories: {
        ultrabrain: { model: "openai/gpt-5.4-mini" },
        "visual-engineering": { model: "google/flash" },
      },
      // Unknown keys (OMO's own config) must be tolerated, not rejected.
      git_master: { commit_footer: false },
    },
    // Top-level OMO keys must be tolerated too.
    _migrations: ["2026-07-opencode-config-unification"],
  });
  assert(Option.isSome(decoded), "expected a successful decode");
  if (Option.isSome(decoded)) {
    assert(
      decoded.value["[opencode]"]?.agents?.oracle.model ===
        "openai/gpt-5.4-mini",
      "agent model did not decode",
    );
    assert(
      decoded.value["[opencode]"]?.categories?.["visual-engineering"].model ===
        "google/flash",
      "category model did not decode",
    );
  }
});

Deno.test("OmoConfig decodes a config missing the block", () => {
  const decoded = decodeOmoConfig({});
  assert(Option.isSome(decoded), "empty object should decode");
  if (Option.isSome(decoded)) {
    assert(
      decoded.value["[opencode]"] === undefined,
      "[opencode] should be undefined",
    );
  }
});

Deno.test("OmoConfig decode fails on the wrong shape", () => {
  // agents must be a record of {model,variant}; a string is invalid.
  const decoded = decodeOmoConfig({ "[opencode]": { agents: "nope" } });
  assert(Option.isNone(decoded), "string agents should fail to decode");
});

Deno.test("stripJsoncComments removes whole-line // comments only", () => {
  const input = [
    "// OMO configuration",
    "{",
    '  "a": 1,',
    "  // indented comment",
    '  "url": "https://not-a-comment"',
    "}",
  ].join("\n");
  const out = stripJsoncComments(input);
  assert(!out.includes("// OMO configuration"), "leading comment not stripped");
  assert(!out.includes("indented comment"), "indented comment not stripped");
  assert(
    out.includes('"url": "https://not-a-comment"'),
    "inline // inside a string value was wrongly stripped",
  );
  const parsed = JSON.parse(out) as { a: number; url: string };
  assert(parsed.a === 1 && parsed.url === "https://not-a-comment", "bad parse");
});

Deno.test("formatModelLines sorts and renders model + variant", () => {
  const lines = formatModelLines({
    zeta: { model: "m-z" },
    alpha: { model: "m-a", variant: "high" },
    beta: { model: "m-b" },
  });
  assert(lines.length === 3, `expected 3 lines, got ${lines.length}`);
  assert(lines[0] === "    alpha: m-a (high)", `bad line 0: ${lines[0]}`);
  assert(lines[1] === "    beta: m-b", `bad line 1: ${lines[1]}`);
  assert(lines[2] === "    zeta: m-z", `bad line 2: ${lines[2]}`);
});

Deno.test("formatModelLines handles undefined and empty input", () => {
  assert(formatModelLines(undefined).length === 0, "undefined → []");
  assert(formatModelLines({}).length === 0, "empty record → []");
});

Deno.test("error messages preserve the CLI wording", () => {
  assert(
    new UnknownProfileError({
      name: "x",
      available: ["a", "b"],
    }).displayMessage === "Unknown profile: x (known: a b)",
    "UnknownProfileError wording drifted",
  );
  assert(
    new TooManyArgumentsError({ args: ["a", "b"] }).displayMessage ===
      "Too many arguments",
    "TooManyArgumentsError wording drifted",
  );
  assert(
    new ChezmoiMissingError().displayMessage ===
      "chezmoi not on PATH — required to re-render the omo config",
    "ChezmoiMissingError wording drifted",
  );
  assert(
    new ChezmoiApplyError({ exitCode: 2, target: "/tmp/x.json" })
      .displayMessage ===
      "chezmoi apply --force /tmp/x.json failed (exit 2)",
    "ChezmoiApplyError wording drifted",
  );
});
