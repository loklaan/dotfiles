{{- /* chezmoi:modify-template */ -}}
{{- /* Auth placeholders for @canva/opencode-plugin-llmproxy. Only rendered on
       work machines — .chezmoiignore skips this file on every other profile.

       A modify_ template, not a plain file: other writers own other keys here.
       run_after_install-065-opencode-auth writes the opencode/opencode-go API
       keys on Linux, and `opencode auth login` may add more. A plain file made
       every apply either prompt ("has changed since chezmoi last wrote it") or
       wipe those keys. Only the keys below are chezmoi's; the rest is kept.

       opencode (V1) only invokes a plugin's auth.loader for providers that
       have an entry in auth.json (provider.ts: `if (!stored) continue`).
       Without these placeholders the plugin loads but never wires up its
       transport: Bedrock requests go straight to AWS and bypass the plugin,
       and openai/google vanish (`Provider not found: openai`).

       VPN (no CODER env):
         The plugin fetches a bearer token via `otter` and injects it in place
         of the "llmproxy" placeholder key.

       Coder devbox (CODER=true):
         The plugin signs Bedrock requests with AWS IMDS credentials (SigV4)
         and replaces whatever auth header the placeholder produces, so
         amazon-bedrock needs the placeholder here too.

       google + openai route through the proxy in both modes (mTLS on Coder,
       VPN endpoint elsewhere), and both need the placeholder.

       opencode2 needs none of these: it imports this file once into its own
       database, and the plugin routes Bedrock without a stored credential. */ -}}
{{- $auth := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $placeholder := dict "type" "api" "key" "llmproxy" -}}
{{- $_ := set $auth "amazon-bedrock" $placeholder -}}
{{- $_ := set $auth "google" $placeholder -}}
{{- $_ := set $auth "openai" $placeholder -}}
{{ toPrettyJson $auth | trim }}
