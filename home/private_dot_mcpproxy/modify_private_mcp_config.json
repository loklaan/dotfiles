{{- /* chezmoi:modify-template */ -}}
{{- $base := fromJson (default "{}" .chezmoi.stdin) -}}

{{- /* Resolve API keys from Bitwarden Secrets via the soft-fail wrapper so
       per-secret access gaps (a machine account without Context7 access,
       for example) produce an empty key rather than aborting apply. */ -}}
{{- $bwsToken := "" -}}
{{- if and (lookPath "bws") (stat .bwsTokenPath) -}}
{{-   $bwsToken = include .bwsTokenPath | trim -}}
{{- end -}}
{{- $bwsGet := joinPath .chezmoi.homeDir ".local/lib/bws-get-or-empty" -}}
{{- $context7Key := "" -}}
{{- $exaKey := "" -}}
{{- $pushbulletToken := "" -}}
{{- /* dig the data var so machines whose active config predates it (not yet
       re-inited) degrade gracefully instead of aborting apply on a missing key. */ -}}
{{- $pushbulletSecretId := dig "bwsIdPushbulletAccessToken" "" . -}}
{{- if and (ne "" $bwsToken) (stat $bwsGet) -}}
{{-   $context7Key = output $bwsGet .bwsIdContext7ApiKey .bwsTokenPath | trim -}}
{{-   $exaKey = output $bwsGet .bwsIdExaApiKey .bwsTokenPath | trim -}}
{{-   if ne "" $pushbulletSecretId -}}
{{-     $pushbulletToken = output $bwsGet $pushbulletSecretId .bwsTokenPath | trim -}}
{{-   end -}}
{{- end -}}

{{- /* Build our managed server list */ -}}
{{- $servers := list -}}
{{- /* Per-machine stdio servers belong in chezmoi's local config, not this
       source model. Each [data.mcpStdioServers.<name>] table supplies the
       executable fields; this template supplies the mcpproxy identity and
       transport fields. `dig` keeps older machine configs valid. */ -}}
{{- $localStdioServers := dig "mcpStdioServers" (dict) . -}}
{{- $reservedServerNames := list "otter" "pushbullet" "effect-docs" "smithers" "pdf-tools" "chrome-devtools" "figma-desktop" "context7" "websearch" "notion" -}}
{{- range $name, $server := $localStdioServers -}}
{{-   if has $name $reservedServerNames -}}
{{-     fail (printf "mcpStdioServers.%s conflicts with a dotfiles-managed MCP server" $name) -}}
{{-   end -}}
{{-   if not (hasKey $server "command") -}}
{{-     fail (printf "mcpStdioServers.%s must define command" $name) -}}
{{-   end -}}
{{-   $server = merge (dict) $server -}}
{{-   if not (hasKey $server "enabled") -}}
{{-     $server = set $server "enabled" true -}}
{{-   end -}}
{{-   if not (hasKey $server "args") -}}
{{-     $server = set $server "args" (list) -}}
{{-   end -}}
{{-   $server = set $server "name" $name -}}
{{-   $server = set $server "protocol" "stdio" -}}
{{-   $servers = append $servers $server -}}
{{- end -}}

{{- if eq .machineProfile "work" -}}
{{-   $servers = append $servers (dict
        "name" "otter"
        "command" "otter"
        "args" (list "mcp" "serve")
        "protocol" "stdio"
        "enabled" true
      ) -}}
{{- end -}}

{{- /* Pushbullet MCP: local single-file Deno server. Only registered when the
       access token resolves from Bitwarden, since the server is useless without
       it; a missing token therefore omits the server rather than registering a
       broken one. The token is passed via env (read by Config.redacted). The
       deno invocation lives in the script's shebang, so we exec it directly. */ -}}
{{- if ne "" $pushbulletToken -}}
{{-   $servers = append $servers (dict
        "name" "pushbullet"
        "command" (joinPath .chezmoi.homeDir ".local/bin/pushbullet-mcp")
        "args" (list)
        "protocol" "stdio"
        "enabled" true
        "env" (dict "PUSHBULLET_ACCESS_TOKEN" $pushbulletToken)
      ) -}}
{{- end -}}

{{- $servers = append $servers (dict
      "name" "effect-docs"
      "command" "npx"
      "args" (list "-y" "effect-mcp@latest")
      "protocol" "stdio"
      "enabled" true
    ) -}}

{{- /* Smithers: durable, code-defined workflow orchestrator. Exposed as an MCP
       server so the lead agent can OPERATE it — run deterministic workflow
       graphs (Sequence/Branch/Ralph-with-predicate, schema-validated handoffs)
       for by-step mid-horizon work, with opencode as the worker. Runs on bun
       (its CLI shebang is bun); bunx resolves via the mise shim like npx/uvx. */ -}}
{{- $servers = append $servers (dict
      "name" "smithers"
      "command" "bunx"
      "args" (list "smithers-orchestrator" "--mcp")
      "protocol" "stdio"
      "enabled" true
    ) -}}

{{- $servers = append $servers (dict
      "name" "pdf-tools"
      "command" "uvx"
      "args" (list "mcp-pdf")
      "protocol" "stdio"
      "enabled" true
    ) -}}

{{- $servers = append $servers (dict
      "name" "chrome-devtools"
      "command" "npx"
      "args" (list "-y" "chrome-devtools-mcp@latest")
      "protocol" "stdio"
      "enabled" true
    ) -}}

{{- $servers = append $servers (dict
      "name" "figma-desktop"
      "url" "http://127.0.0.1:3845/mcp"
      "protocol" "http"
      "enabled" true
    ) -}}

{{- /* Remote MCP servers (moved from oh-my-openagent defaults) */ -}}
{{- $context7Headers := dict -}}
{{- if ne "" $context7Key -}}
{{-   $context7Headers = dict "CONTEXT7_API_KEY" $context7Key -}}
{{- end -}}
{{- $servers = append $servers (dict
      "name" "context7"
      "url" "https://mcp.context7.com/mcp"
      "protocol" "http"
      "headers" $context7Headers
      "enabled" true
    ) -}}

{{- $exaHeaders := dict -}}
{{- if ne "" $exaKey -}}
{{-   $exaHeaders = dict "x-api-key" $exaKey -}}
{{- end -}}
{{- $servers = append $servers (dict
      "name" "websearch"
      "url" "https://mcp.exa.ai"
      "protocol" "http"
      "headers" $exaHeaders
      "enabled" true
    ) -}}

{{- /* Notion: hosted, actively-maintained remote MCP. Streamable HTTP with
       user-based OAuth (no API key / bearer token), so first use prompts an
       OAuth flow whose grant the proxy persists in its own runtime state. */ -}}
{{- $servers = append $servers (dict
      "name" "notion"
      "url" "https://mcp.notion.com/mcp"
      "protocol" "http"
      "enabled" true
    ) -}}

{{- /* Project the optional machine-local host allowlist. MCPProxy accepts
       loopback separately; these entries cover non-loopback Host/Origin values. */ -}}
{{- $mcpproxyConfig := dig "mcpproxy" (dict) . -}}
{{- if not (kindIs "map" $mcpproxyConfig) -}}
{{-   fail "mcpproxy must be an object" -}}
{{- end -}}
{{- $configuredHosts := dig "hosts" (list) $mcpproxyConfig -}}
{{- if not (kindIs "slice" $configuredHosts) -}}
{{-   fail "mcpproxy.hosts must be an array of strings" -}}
{{- end -}}
{{- $trustedHosts := list -}}
{{- range $index, $rawHost := $configuredHosts -}}
{{-   if not (kindIs "string" $rawHost) -}}
{{-     fail (printf "mcpproxy.hosts[%d] must be a string" $index) -}}
{{-   end -}}
{{-   if regexMatch "[[:cntrl:]]" $rawHost -}}
{{-     fail (printf "mcpproxy.hosts[%d] must not contain control characters" $index) -}}
{{-   end -}}
{{-   $host := lower (trim $rawHost) -}}
{{-   if or (eq $host "") (eq $host "*") -}}
{{-     fail (printf "mcpproxy.hosts[%d] must be a non-empty host and cannot be * or contain controls" $index) -}}
{{-   end -}}
{{-   $hostPattern := "^\\.?[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]+)?$" -}}
{{-   $ipv6Pattern := "^\\[[0-9a-f:.]+\\](?::[0-9]+)?$" -}}
{{-   if not (or (regexMatch $hostPattern $host) (regexMatch $ipv6Pattern $host)) -}}
{{-     fail (printf "mcpproxy.hosts[%d] %q must be a hostname or bracketed IPv6 address with an optional port" $index $rawHost) -}}
{{-   end -}}
{{-   if regexMatch $ipv6Pattern $host -}}
{{-     $ipv6Body := regexReplaceAll "^\\[|\\](?::[0-9]+)?$" $host "" -}}
{{-     $ipv6Parts := splitList "::" $ipv6Body -}}
{{-     $validIPv6 := le (len $ipv6Parts) 2 -}}
{{-     $ipv6Units := 0 -}}
{{-     range $partIndex, $part := $ipv6Parts -}}
{{-       $units := list -}}
{{-       if ne $part "" -}}
{{-         $units = splitList ":" $part -}}
{{-       end -}}
{{-       range $unitIndex, $unit := $units -}}
{{-         $isIPv4 := contains "." $unit -}}
{{-         if $isIPv4 -}}
{{-           $octets := splitList "." $unit -}}
{{-           if or (ne (len $octets) 4) (ne $partIndex (sub (len $ipv6Parts) 1)) (ne $unitIndex (sub (len $units) 1)) (not (regexMatch "^(?:0|[1-9][0-9]{0,2})(?:\\.(?:0|[1-9][0-9]{0,2})){3}$" $unit)) -}}
{{-             $validIPv6 = false -}}
{{-           else -}}
{{-             range $octet := $octets -}}
{{-               $octetNumber := atoi $octet -}}
{{-               if or (lt $octetNumber 0) (gt $octetNumber 255) -}}
{{-                 $validIPv6 = false -}}
{{-               end -}}
{{-             end -}}
{{-           end -}}
{{-           $ipv6Units = add $ipv6Units 2 -}}
{{-         else -}}
{{-           if not (regexMatch "^[0-9a-f]{1,4}$" $unit) -}}
{{-             $validIPv6 = false -}}
{{-           end -}}
{{-           $ipv6Units = add $ipv6Units 1 -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     if eq (len $ipv6Parts) 1 -}}
{{-       if ne $ipv6Units 8 -}}
{{-         $validIPv6 = false -}}
{{-       end -}}
{{-     else if ge $ipv6Units 8 -}}
{{-       $validIPv6 = false -}}
{{-     end -}}
{{-     if not $validIPv6 -}}
{{-       fail (printf "mcpproxy.hosts[%d] %q is not a valid IPv6 address" $index $rawHost) -}}
{{-     end -}}
{{-   end -}}
{{-   if regexMatch ":[0-9]+$" $host -}}
{{-     $port := regexReplaceAll "^.*:" $host "" -}}
{{-     $portNumber := atoi $port -}}
{{-     if or (lt $portNumber 1) (gt $portNumber 65535) -}}
{{-       fail (printf "mcpproxy.hosts[%d] %q has a port outside 1-65535" $index $rawHost) -}}
{{-     end -}}
{{-   end -}}
{{-   $trustedHosts = append $trustedHosts $host -}}
{{- end -}}
{{- $trustedHosts = $trustedHosts | sortAlpha | uniq -}}

{{- /* Merge existing server entries to preserve runtime state (quarantined,
       created, updated, oauth) while ensuring our definitions are present.
       For each managed server, find the existing entry and overlay our fields. */ -}}
{{- $existingServers := list -}}
{{- if hasKey $base "mcpServers" -}}
{{-   $existingServers = get $base "mcpServers" -}}
{{- end -}}

{{- $mergedServers := list -}}
{{- range $our := $servers -}}
{{-   $merged := dict -}}
{{-   range $existing := $existingServers -}}
{{-     if eq (get $existing "name") (get $our "name") -}}
{{-       $merged = $existing -}}
{{-     end -}}
{{-   end -}}
{{-   $merged = merge $our $merged -}}
{{-   $mergedServers = append $mergedServers $merged -}}
{{- end -}}

{{- /* Overlay our managed keys, preserve everything else */ -}}
{{- $config := $base -}}
{{- $_ := unset $config "top_k" -}}
{{- $config = $config | setValueAtPath "listen" (printf "127.0.0.1:%v" .ports.mcpproxy.internal) -}}
{{- $config = $config | setValueAtPath "data_dir" (printf "%s/.mcpproxy" .chezmoi.homeDir) -}}
{{- $config = $config | setValueAtPath "tools_limit" 15 -}}
{{- $config = $config | setValueAtPath "tool_response_limit" 20000 -}}
{{- $config = $config | setValueAtPath "mcpServers" $mergedServers -}}
{{- $config = $config | setValueAtPath "routing_mode" "retrieve_tools" -}}
{{- $config = $config | setValueAtPath "trusted_hosts" $trustedHosts -}}
{{- $config = $config | setValueAtPath "telemetry.enabled" false -}}

{{ $config | toPrettyJson }}
