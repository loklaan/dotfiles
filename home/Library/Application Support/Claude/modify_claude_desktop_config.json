{{- /* chezmoi:modify-template */ -}}
{{- $base := fromJson (default "{}" .chezmoi.stdin) -}}
{{- /* Claude Desktop is stdio-only: each MCPProxy lane is bridged by mcp-remote. */ -}}
{{- $servers := includeTemplate "mcp-client-tmpl" (dict "data" . "client" "claude-desktop") | fromJson -}}
{{ $base | setValueAtPath "mcpServers" $servers | toPrettyJson }}
