{{- /* The run_before key-seed script provisions a missing key before targets
     render. Missing file/key still returns empty (e.g. skipped seeding or a
     targeted apply); malformed config can fail parsing rather than return
     empty. See .agents/resources/mcp-authentication.md. */ -}}
{{- $apiKey := "" -}}
{{- $configPath := joinPath .chezmoi.homeDir ".mcpproxy/mcp_config.json" -}}
{{- if stat $configPath -}}
{{-   $mcpConfig := include $configPath | fromJson -}}
{{-   $apiKey = dig "api_key" "" $mcpConfig | trim -}}
{{- end -}}
{{- $apiKey -}}
