{{- /* Read MCPProxy's own machine-local credential. On a first install the
     config does not exist yet, so callers deliberately receive an empty value
     and fail closed until MCPProxy generates its key and chezmoi is re-run. */ -}}
{{- $apiKey := "" -}}
{{- $configPath := joinPath .chezmoi.homeDir ".mcpproxy/mcp_config.json" -}}
{{- if stat $configPath -}}
{{-   $mcpConfig := include $configPath | fromJson -}}
{{-   $apiKey = dig "api_key" "" $mcpConfig | trim -}}
{{- end -}}
{{- $apiKey -}}
