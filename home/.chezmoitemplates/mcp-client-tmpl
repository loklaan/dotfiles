{{- /* One client's MCP entries: the same single lane for every client, projected
     into that client's config shape.

       mcpproxy   -> <origin>/mcp/      (opencode2: <origin>/mcp/all/)

     <origin> is loopback plus .ports.mcpproxy.internal, which MCPProxy binds
     (its `listen` in ~/.mcpproxy/mcp_config.json). With nginxProxy on, nginx
     also listens on the external port. Local clients still dial the internal
     loopback port, so they never depend on nginx.

     Arguments (dict):
       data    the template root context (`.`)
       client  opencode | opencode2 | claude-code | claude-desktop | codex
               | oh-my-opencode-slim | oh-my-openagent

     Output: a JSON object of entries keyed by name. For codex the output is
     TOML text: one [mcp_servers.<name>] table per lane. For the two OpenCode
     plugins the output is their `disabled_mcps` JSON list: each built-in MCP
     the plugin would register directly (.mcpPluginBuiltins) whose
     replacement is in the merged catalogue, so it is reached via the proxy. */ -}}
{{- $d := .data -}}
{{- $client := .client -}}
{{- $apiKey := includeTemplate "mcpproxy-api-key-tmpl" $d | trim -}}
{{- $authHeaders := dict -}}
{{- if ne "" $apiKey -}}
{{-   $authHeaders = dict "Authorization" (printf "Bearer %s" $apiKey) -}}
{{- end -}}
{{- $headerFile := joinPath $d.chezmoi.homeDir ".mcpproxy/mcp-client-headers" -}}

{{- $builtins := dig "mcpPluginBuiltins" (dict) $d -}}
{{- if hasKey $builtins $client -}}
{{-   $catalogue := includeTemplate "mcp-catalogue-tmpl" (dict "data" $d) | fromJson -}}
{{-   $disabled := list -}}
{{-   range $builtin, $replacement := get $builtins $client -}}
{{-     if hasKey $catalogue $replacement -}}
{{-       $disabled = append $disabled $builtin -}}
{{-     end -}}
{{-   end -}}
{{    $disabled | sortAlpha | toJson }}
{{- else -}}
{{- $origin := printf "http://127.0.0.1:%v" $d.ports.mcpproxy.internal -}}
{{- /* OpenCode 2 dials /mcp/all/, which lists every upstream tool directly
     (named server__tool) instead of hiding them behind retrieve_tools. Its
     Code Mode indexes all MCP tools itself and exposes them through a
     synchronous search() that no plugin can extend, so hidden tools would be
     unreachable by that search. Calls bypass call_tool_* (no
     read/write/destructive intent). */ -}}
{{- $path := "/mcp/" -}}
{{- if eq $client "opencode2" -}}
{{-   $path = "/mcp/all/" -}}
{{- end -}}
{{- $lanes := list (list "mcpproxy" (printf "%s%s" $origin $path)) -}}

{{- if eq $client "codex" -}}
{{-   $tables := list -}}
{{-   range $lane := $lanes -}}
{{-     $table := printf "[mcp_servers.%s]\nurl = %s" (index $lane 0) (index $lane 1 | quote) -}}
{{-     if ne "" $apiKey -}}
{{-       $table = printf "%s\nhttp_headers = { Authorization = %s }" $table (printf "Bearer %s" $apiKey | quote) -}}
{{-     end -}}
{{-     $tables = append $tables $table -}}
{{-   end -}}
{{    join "\n\n" $tables }}
{{- else -}}
{{-   $out := dict -}}
{{-   range $lane := $lanes -}}
{{-     $name := index $lane 0 -}}
{{-     $url := index $lane 1 -}}
{{-     $bridgeArgs := list "-y" "mcp-remote@latest" $url "--header-file" $headerFile -}}
{{-     if eq $client "opencode" -}}
{{-       $server := dict "type" "remote" "enabled" true "url" $url -}}
{{-       if ne "" $apiKey -}}
{{-         $server = set $server "headers" $authHeaders -}}
{{-       end -}}
{{-       $out = set $out $name $server -}}
{{-     else if eq $client "opencode2" -}}
{{-       $server := dict "type" "remote" "url" $url "disabled" false -}}
{{-       if ne "" $apiKey -}}
{{-         $server = set $server "headers" $authHeaders -}}
{{-       end -}}
{{-       $out = set $out $name $server -}}
{{-     else if or (eq $client "claude-code") (eq $client "claude-desktop") -}}
{{- /* Both Claude clients bridge over stdio with mcp-remote. The key stays in
       ~/.mcpproxy/mcp-client-headers, never in argv or a world-readable config. */ -}}
{{-       $out = set $out $name (dict "command" "npx" "args" $bridgeArgs) -}}
{{-     else -}}
{{-       fail (printf "mcp-client-tmpl: unknown client %q" $client) -}}
{{-     end -}}
{{-   end -}}
{{    $out | toJson }}
{{- end -}}
{{- end -}}
