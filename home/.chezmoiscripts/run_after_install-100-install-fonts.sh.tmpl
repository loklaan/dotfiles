#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# Source shared logging library and setup session logging
source "${HOME}/.local/lib/bash-logging.sh"
setup_session_logging "$(basename "$0")" "fonts"

#/ Usage:
#/   run_after_install-100-install-fonts.sh
#/
#/ Description:
#/   Installs fonts from ~/.local/share/fonts to OS-specific font directories.
#/
#/ Options:
#/   --help:      Display this help message
usage() { grep '^#/' "$0" | cut -c4-; }

main() {
  log_step "Installing fonts"
  if command -v font-install >/dev/null 2>&1; then
    font-install
  else
    log_warn "Missing font-install (expected at ${HOME}/.local/bin/font-install)"
  fi
}

main "$@"
