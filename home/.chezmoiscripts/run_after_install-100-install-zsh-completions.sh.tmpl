#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# Source shared logging library and setup session logging
source "${HOME}/.local/lib/bash-logging.sh"
setup_session_logging "$(basename "$0")" "completions"

#/ Usage:
#/   run_after_install-100-install-zsh-completions.sh
#/
#/ Description:
#/   Installs zsh completions by calling install-my-completions.
#/
#/ Options:
#/   --help:      Display this help message
usage() { grep '^#/' "$0" | cut -c4-; }

main() {
  if ! command -v install-my-completions >/dev/null 2>&1; then
    log_warn "Missing install-my-completions (expected at ${HOME}/.local/bin/install-my-completions)"
    return 0
  fi

  install-my-completions
  log_note "Completions available in new terminal sessions (restart, or run 'exec zsh')"
}

main "$@"
