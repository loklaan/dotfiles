{{- if eq (dig "machineProfile" "personal" .) "work" -}}
#!/usr/bin/env bash
{{ includeTemplate "script-prelude" "canva" }}
# Canva-specific quirks. Dev box quirks apply only when DEVBOX_EMAIL (set on
# Canva dev boxes) is the work email.

main() {
  if [ "${DEVBOX_EMAIL:-}" = {{ .emailWork | quote }} ]; then
    log_step "Applying Canva dev box quirks"

    # Ensure mise for the canva monorepo is installed in the devbox-specific
    # directory structure: link the config if it is not there yet, then trust it.
    if (
      cd ~/work/canva &&
        { [ -e .mise.local.toml ] || ln -s ../../dev/canva/canva/.mise.local.toml .; } &&
        mise trust --quiet .mise.local.toml
    ) >/dev/null 2>&1; then
      log_detail "Trusted the canva monorepo mise config"
    else
      log_warn "Failed to trust the canva monorepo mise config"
    fi
  fi
}

main
{{ end -}}
