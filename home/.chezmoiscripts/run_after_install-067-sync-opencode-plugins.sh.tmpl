{{- $llmproxyLocal := dig "openCodeWorkPluginLocalPath" "" . -}}
{{- $machineProfile := dig "machineProfile" "personal" . -}}
{{- $workRegistry := dig "npmWorkRegistry" "" . -}}
#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

source "${HOME}/.local/lib/bash-logging.sh"
source "${HOME}/.local/lib/tool-cache-sync.sh"
setup_session_logging "$(basename "$0")"

#/ Usage:
#/   run_after_install-067-sync-opencode-plugins.sh
#/
#/ Description:
#/   Clears OpenCode's cached @latest plugin package dirs on every apply so
#/   OpenCode re-resolves them on next launch. OpenCode owns plugin
#/   installation; chezmoi only invalidates the sticky cache.
#/
#/   OpenCode installs plugins with npm. npm resolves the @canva depot scope
#/   from ~/.config/.npmrc (npm's XDG userconfig path). BUT npm's HTTP cache
#/   (~/.npm/_cacache) can hold a STALE packument whose `latest` dist-tag points
#/   at an old version; OpenCode only re-resolves @latest when its package cache
#/   dir is absent, and on that re-resolve it reads npm's cached packument. So a
#/   frozen plugin needs BOTH levers: bust OpenCode's package dir AND invalidate
#/   npm's cached packument for that package, so the next launch resolves the
#/   current @latest from the depot.
#/
#/   The work plugin cache is skipped when a local dist path overrides it.
usage() { grep '^#/' "$0" | cut -c4-; }

cache_dir=$(tcs_get_opencode_cache) || exit 0
packages_dir="${cache_dir}/packages"
[ -d "$packages_dir" ] || exit 0

log_step "OpenCode plugin cache"

# tcs_bust_opencode_plugin <packages_dir> <sanitized-spec-dir>
tcs_bust_opencode_plugin "$packages_dir" "oh-my-openagent@latest"
{{- if and (eq "" $llmproxyLocal) (eq $machineProfile "work") }}
tcs_bust_opencode_plugin "$packages_dir" "@canva/opencode-plugin-llmproxy@latest"
tcs_bust_opencode_plugin "$packages_dir" "@canva/opencode-plugin-llmproxy"

# Invalidate npm's cached packument for the work plugin so OpenCode's next-launch
# npm install re-resolves @latest against the depot instead of a stale cached
# manifest. The key is make-fetch-happen's request-cache entry keyed by the
# scoped package URL (/ URL-encoded as %2f). Best-effort: never fail the apply.
{{- if ne "" $workRegistry }}
work_registry="{{ $workRegistry }}"
if command -v npm >/dev/null 2>&1; then
  packument_key="make-fetch-happen:request-cache:${work_registry}@canva%2fopencode-plugin-llmproxy"
  if npm cache clean "$packument_key" >/dev/null 2>&1; then
    log_detail "Invalidated npm packument cache for @canva/opencode-plugin-llmproxy"
  fi
fi
{{- end }}

# Remove any leftover self-managed on-disk bundle from the previous delivery
# approach so OpenCode doesn't load a stale duplicate alongside the npm-managed
# plugin[] entry. No-op once migrated.
legacy_bundle="${HOME}/.config/opencode/plugins/canva-llmproxy.js"
if [ -f "$legacy_bundle" ]; then
  rm -f "$legacy_bundle" "${legacy_bundle}.version"
  log_detail "Removed legacy self-managed bundle: ${legacy_bundle}"
fi
{{- end }}
