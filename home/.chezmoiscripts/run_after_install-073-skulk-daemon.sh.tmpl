{{- if has .chezmoi.os (list "linux" "darwin") -}}
#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

source "${HOME}/.local/lib/bash-logging.sh"
source "${HOME}/.local/lib/pitchfork-lifecycle.sh"
setup_session_logging "$(basename "$0")" "skulk"

#/ Usage:
#/   run_after_install-073-skulk-daemon.sh
#/
#/ Description:
#/   Reconciles the Skulk Pitchfork daemon after mise and OpenCode 2 install.
#/   Stops it when skulk.enabled is false; leaves durable watches untouched.
#/
#/ Options:
#/   --help:      Display this help message
usage() { grep '^#/' "$0" | cut -c4-; }

manage_service() {
  local enabled={{ dig "skulk" "enabled" true . }}

  if ! pf_resolve; then
    return 0
  fi

  if [ "$enabled" != "true" ]; then
    if pf_is_registered df-skulk; then
      log_step "Stopping Skulk daemon"
      pf_stop df-skulk
    fi
    return 0
  fi

  if ! command -v mise >/dev/null 2>&1; then
    log_warn "Skipping Skulk daemon — mise not on PATH"
    return 0
  fi

  local tool tool_path
  for tool in bun skulk; do
    tool_path=$(mise which "$tool" 2>/dev/null || true)
    if [ -z "$tool_path" ] || [ ! -x "$tool_path" ]; then
      log_warn "Skipping Skulk daemon — ${tool} not installed (install with: mise install)"
      return 0
    fi
  done

  if [ ! -x "${HOME}/.local/bin/opencode2" ] || [ ! -x "${HOME}/.local/share/opencode2/bin/opencode2" ]; then
    log_warn "Skipping Skulk daemon — OpenCode 2 not installed"
    return 0
  fi

  log_step "Restarting Skulk daemon"
  pf_restart df-skulk "Started Skulk daemon" || return 0

  local status
  if ! status=$(mise exec -- skulk status 2>/dev/null) || ! grep -q '^Daemon running (pid ' <<< "$status"; then
    log_warn "Skulk health probe failed — check: pitchfork logs df-skulk"
  fi
}

main() {
  bl_parse_help "$@"
  manage_service
}

main "$@"
{{- end }}
