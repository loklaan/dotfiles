#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# Normalize TMPDIR (strip trailing slash for consistent path construction)
TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

# Source shared logging library and setup session logging
# shellcheck disable=SC1091
source "${HOME}/.local/lib/bash-logging.sh"
setup_session_logging "$(basename "$0")" "skills"

#/ Usage:
#/   run_after_install-070-pack-claude-skills.sh [OPTIONS]
#/
#/ Description:
#/   Packages eligible canonical skills for Claude Desktop.
#/
#/ Options:
#/   --help:      Display this help message
usage() { grep '^#/' "$0" | cut -c4-; }

package_stderr_file=""
observe_stderr_file=""
package_stdout_file=""
observe_stdout_file=""
cleanup_skill_package_temps() {
  local path
  for path in \
    "${package_stderr_file:-}" \
    "${observe_stderr_file:-}" \
    "${package_stdout_file:-}" \
    "${observe_stdout_file:-}"; do
    [ -z "$path" ] || rm -f -- "$path"
  done
}
trap cleanup_skill_package_temps EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

main() {
  bl_parse_help "$@"

  local manifest="$HOME/.config/dotfiles/skill-lifecycle.json"
  if [ ! -f "$manifest" ]; then
    log_skip "Skill packaging is disabled because no manifest was projected"
    return 0
  fi
  if ! command -v df-skills >/dev/null 2>&1; then
    fatal "Cannot package skills: df-skills is not installed"
  fi

  local package_status=0 observe_status=0 package_raw observe_raw
  package_stderr_file="$(mktemp "${TMPDIR}/df-skills-package.XXXXXX")"
  observe_stderr_file="$(mktemp "${TMPDIR}/df-skills-observe.XXXXXX")"
  package_stdout_file="$(mktemp "${TMPDIR}/df-skills-package-json.XXXXXX")"
  observe_stdout_file="$(mktemp "${TMPDIR}/df-skills-observe-json.XXXXXX")"

  package_raw="$(df-skills package --manifest "$manifest" 2>"$package_stderr_file")" || package_status=$?
  printf '%s\n' "$package_raw" > "$package_stdout_file"
  observe_raw="$(df-skills observe --manifest "$manifest" 2>"$observe_stderr_file")" || observe_status=$?
  printf '%s\n' "$observe_raw" > "$observe_stdout_file"
  if [ -n "${BASH_LOGGING_FILE:-}" ]; then
    cat "$package_stdout_file" "$package_stderr_file" "$observe_stdout_file" "$observe_stderr_file" >> "$BASH_LOGGING_FILE"
  fi

  if [ "$package_status" -eq 0 ]; then
    if ! printf '%s' "$package_raw" | jq -e '(.changed | type == "boolean") and (.packaged | type == "number") and (.removed | type == "number")' >/dev/null 2>&1; then
      package_status=1
      log_fail "Skill packaging returned malformed JSON"
    elif [ "$(printf '%s' "$package_raw" | jq -er '.changed' 2>/dev/null)" = "false" ]; then
      log_skip "Packages unchanged"
    else
      log_ok "Packages updated: $(printf '%s' "$package_raw" | jq -er '.packaged' 2>/dev/null) packaged, $(printf '%s' "$package_raw" | jq -er '.removed' 2>/dev/null) removed"
    fi
  else
    log_fail "Skill packaging failed (exit $package_status)"
  fi

  if [ "$observe_status" -eq 0 ]; then
    if ! printf '%s' "$observe_raw" | jq -e '.healthy == true' >/dev/null 2>&1; then
      observe_status=1
      log_fail "Skill observation found unresolved drift"
    else
      log_detail "Skill health: sources, providers, registry, and packages healthy"
    fi
  else
    log_fail "Skill observation failed (exit $observe_status)"
  fi

  if [ "$package_status" -ne 0 ]; then
    return "$package_status"
  fi
  if [ "$observe_status" -ne 0 ]; then
    return "$observe_status"
  fi
}

main "$@"
