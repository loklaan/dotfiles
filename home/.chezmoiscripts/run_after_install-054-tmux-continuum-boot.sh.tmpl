#!/usr/bin/env bash
{{ includeTemplate "script-prelude" "tmux" }}
# Removes the boot integration tmux-continuum's @continuum-boot option left
# behind (tmux.conf now sets it 'off', but continuum never deletes what it wrote).
#
# Linux: a systemd user unit whose ExecStop runs resurrect's save.sh then
# `tmux kill-server`. That save runs against a dying server, writes a 0-byte
# snapshot that resurrect still claims as `last`, so a restore comes back as one
# blank window. An ACTIVE unit is never stopped (that would run the chain and
# kill the server the user may be attached to); it is disabled and left to
# expire at the next boot.
#
# macOS: a Tmux.Start.plist LaunchAgent that, at every login, opens Terminal.app
# and runs a bare `tmux`, creating a NEW session the next autosave writes over
# `last`. It has no stop action, so booting it out is safe.
{{ if eq .chezmoi.os "linux" -}}
UNIT_NAME="tmux.service"
UNIT_FILE="${HOME}/.config/systemd/user/${UNIT_NAME}"

remove_continuum_boot_unit() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi

  if [ ! -f "$UNIT_FILE" ]; then
    return 0
  fi

  log_step "Removing tmux continuum boot unit"

  if systemctl --user is-enabled --quiet "$UNIT_NAME" 2>/dev/null; then
    systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
    log_detail "Disabled ${UNIT_NAME}"
  fi

  if systemctl --user is-active --quiet "$UNIT_NAME" 2>/dev/null; then
    log_warn "${UNIT_NAME} is active — leaving it in place; stopping it would run its destructive ExecStop (resurrect save against a dying server, then kill-server). It is disabled and will not return after the next boot."
    return 0
  fi

  rm -f "$UNIT_FILE"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  log_detail "Removed ${UNIT_FILE}"
}
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
AGENT_LABEL="Tmux.Start.plist"
AGENT_FILE="${HOME}/Library/LaunchAgents/${AGENT_LABEL}"

remove_continuum_boot_launchagent() {
  if [ ! -f "$AGENT_FILE" ]; then
    return 0
  fi

  log_step "Removing tmux continuum boot LaunchAgent"

  # Safe to bootout: the agent's only action is ProgramArguments at load, so
  # unloading it cannot run a save against a dying server the way the Linux
  # unit's ExecStop does. A non-zero exit just means it was not loaded.
  launchctl bootout "gui/$(id -u)/${AGENT_LABEL}" >/dev/null 2>&1 || true

  rm -f "$AGENT_FILE"
  log_detail "Removed ${AGENT_FILE}"
}
{{- end }}

main() {
  case "$(uname -s)" in
{{ if eq .chezmoi.os "linux" -}}
    Linux)  remove_continuum_boot_unit ;;
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
    Darwin) remove_continuum_boot_launchagent ;;
{{- end }}
    *)
      return 0
      ;;
  esac
}

main
