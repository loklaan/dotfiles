#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# Normalize TMPDIR (strip trailing slash for consistent path construction)
TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

# Source shared logging library and setup session logging
source "${HOME}/.local/lib/bash-logging.sh"
setup_session_logging "$(basename "$0")"

#/ Usage:
#/   run_after_install-054-tmux-continuum-boot.sh
#/
#/ Description:
#/   Removes the boot integration tmux-continuum's @continuum-boot option
#/   installs. tmux.conf now sets @continuum-boot 'off' on every platform, so
#/   continuum stops re-arming it at the next tmux start — but it never deletes
#/   what it already wrote, so both platforms need an explicit sweep.
#/
#/   Linux: a systemd user unit with a booby-trapped ExecStop chain
#/   (`resurrect/scripts/save.sh` then `tmux kill-server`) that anyone could
#/   restart. That save runs against a dying server, writes a 0-byte snapshot,
#/   and resurrect still claims it as `last`, which is how a restored session
#/   comes back as one blank window.
#/
#/   Deliberately never stops an ACTIVE unit: `systemctl stop` would execute
#/   exactly that destructive ExecStop chain, including killing the tmux server
#/   the user may currently be attached to. An active unit is only disabled and
#/   left to expire at the next boot.
#/
#/   macOS: a `Tmux.Start.plist` LaunchAgent whose damage is in the START
#/   action. At every login it AppleScripts Terminal.app open and runs a bare
#/   `tmux`, creating a NEW session rather than attaching to the restored one;
#/   the next autosave then writes that stub over `last`. Unlike the Linux unit
#/   this has no stop action, so booting it out is safe and it is removed
#/   outright.
#/
#/ Options:
#/   --help:      Display this help message
{{ if eq .chezmoi.os "linux" -}}
UNIT_NAME="tmux.service"
UNIT_FILE="${HOME}/.config/systemd/user/${UNIT_NAME}"

remove_continuum_boot_unit() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi

  if [ ! -f "$UNIT_FILE" ]; then
    return 0
  fi

  log_step "tmux continuum boot unit (Linux, opt-out)"

  if systemctl --user is-enabled --quiet "$UNIT_NAME" 2>/dev/null; then
    systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
    log_detail "Disabled ${UNIT_NAME}"
  fi

  if systemctl --user is-active --quiet "$UNIT_NAME" 2>/dev/null; then
    log_warn "${UNIT_NAME} is active — leaving it in place; stopping it would run its destructive ExecStop (resurrect save against a dying server, then kill-server). It is disabled and will not return after the next boot."
    return 0
  fi

  rm -f "$UNIT_FILE"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  log_detail "Removed ${UNIT_FILE}"
}
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
AGENT_LABEL="Tmux.Start.plist"
AGENT_FILE="${HOME}/Library/LaunchAgents/${AGENT_LABEL}"

remove_continuum_boot_launchagent() {
  if [ ! -f "$AGENT_FILE" ]; then
    return 0
  fi

  log_step "tmux continuum boot LaunchAgent (macOS, opt-out)"

  # Safe to bootout: the agent's only action is ProgramArguments at load, so
  # unloading it cannot run a save against a dying server the way the Linux
  # unit's ExecStop does. A non-zero exit just means it was not loaded.
  launchctl bootout "gui/$(id -u)/${AGENT_LABEL}" >/dev/null 2>&1 || true

  rm -f "$AGENT_FILE"
  log_detail "Removed ${AGENT_FILE}"
}
{{- end }}

main() {
  bl_parse_help "$@"

  case "$(uname -s)" in
{{ if eq .chezmoi.os "linux" -}}
    Linux)  remove_continuum_boot_unit ;;
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
    Darwin) remove_continuum_boot_launchagent ;;
{{- end }}
    *)
      return 0
      ;;
  esac
}

main "$@"
