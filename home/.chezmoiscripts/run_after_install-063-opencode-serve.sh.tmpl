{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
# Runs every chezmoi apply. Manages the df-opencode-serve Pitchfork daemon
# lifecycle. Install is handled by mise; this script only manages the daemon,
# it does not touch apt or download anything.
set -euo pipefail

IFS=$'\n\t'

TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

source "${HOME}/.local/lib/bash-logging.sh"
source "${HOME}/.local/lib/pitchfork-lifecycle.sh"
setup_session_logging "$(basename "$0")" "opencode"

#/ Usage:
#/   run_after_install-063-opencode-serve.sh
#/
#/ Description:
#/   Manages the df-opencode-serve Pitchfork daemon lifecycle. Opt-in via the
#/   `openCodeServer` chezmoi flag.
#/
#/   When `openCodeServer` is true:
#/     - Verifies opencode is installed via mise
#/     - Verifies Pitchfork is installed
#/     - Starts the Pitchfork daemon
#/     - Performs a health probe against the opencode daemon's internal port
#/   When `openCodeServer` is false:
#/     - Stops the Pitchfork daemon (real opt-out, not just config removal)
#/
#/   Install of opencode itself is handled by mise (see
#/   home/private_dot_config/mise/config.toml.tmpl). This script does NOT
#/   download or apt-install anything.
#/
#/ Options:
#/   --help:      Display this help message
# Returns 0 when opencode is installed, 1 when mise is missing, 2 when
# opencode is missing from mise. Silent; the caller reports one line.
verify_opencode_installed() {
  command -v mise >/dev/null 2>&1 || return 1
  local opencode_path
  opencode_path=$(mise which opencode 2>/dev/null || echo "")
  if [ -z "$opencode_path" ] || [ ! -x "$opencode_path" ]; then
    return 2
  fi
}


{{- /* The daemon's bind port depends on nginxProxy: internal (loopback) when
      nginx is in front, external (0.0.0.0) when not. Health probes and the
      orphan reaper must target whichever port the daemon actually binds. */ -}}
{{- $ocPort := .ports.opencode.external -}}
{{- if dig "nginxProxy" false . -}}
{{-   $ocPort = .ports.opencode.internal -}}
{{- end }}

manage_service() {
  local enabled={{ dig "openCodeServer" false . }}

  if [ "$enabled" != "true" ]; then
    if pf_resolve; then
      if pf_is_registered df-opencode-serve; then
        log_step "Stopping OpenCode server"
        pf_stop df-opencode-serve
        log_detail "Stopped OpenCode server"
      fi
    else
      log_warn "Skipping daemon stop — Pitchfork not installed"
    fi
    return 0
  fi

  log_step "Restarting OpenCode server"

  local verify_rc=0
  verify_opencode_installed || verify_rc=$?
  case "$verify_rc" in
    1)
      log_warn "Skipping OpenCode server — mise not on PATH"
      return 0
      ;;
    2)
      log_warn "Skipping OpenCode server — opencode not installed (install with: mise install)"
      return 0
      ;;
  esac

  if ! pf_resolve; then
    log_warn "Skipping OpenCode server — Pitchfork not installed"
    return 0
  fi

  # Restart on every apply — picks up potential version bumps.
  # Pitchfork's start command is idempotent; stop first so a running
  # daemon is replaced cleanly.
  pf_stop df-opencode-serve

  # Reap any orphaned `opencode serve` still bound to the daemon's port. The
  # pitchfork supervisor can lose track of its child (e.g. across VM resumes /
  # kills) while the child keeps serving. A fresh `pitchfork start` then fails
  # with an opaque "Unexpected error" (EADDRINUSE) and crash-loops forever
  # because retry=true. Kill strays holding the port so the managed daemon
  # can bind. Targets the daemon's actual bind port (internal or external
  # depending on nginxProxy).
  if command -v ss >/dev/null 2>&1; then
    local _pids _pid
    # `grep -oE` exits 1 on no-match; under `set -euo pipefail` that would
    # abort the whole chezmoi apply when nothing holds the port. Append
    # `|| true` so an empty result is a normal (non-fatal) outcome.
    _pids=$(ss -ltnpH 2>/dev/null \
      | awk -v p=':{{ $ocPort }} ' '$0 ~ p {print $0}' \
      | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true)
    for _pid in $_pids; do
      if [ -n "$_pid" ] && [ "$_pid" != "$$" ]; then
        kill "$_pid" 2>/dev/null || true
      fi
    done
    sleep 1
  fi

  pf_start df-opencode-serve "Started OpenCode server"

  pf_probe_http {{ $ocPort }} "OpenCode server" || true   # warn but don't block
}

main() {
  bl_parse_help "$@"
  manage_service
}

main "$@"
{{- end }}
