#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

source "${HOME}/.local/lib/bash-logging.sh"
{{ if eq .chezmoi.os "linux" -}}
source "${HOME}/.local/lib/pitchfork-lifecycle.sh"
{{- end }}
setup_session_logging "$(basename "$0")"


#/ Usage:
#/   run_after_install-059-df-orca-server.sh
#/
#/ Description:
#/   Manages the df-orca-server Pitchfork daemon lifecycle on Linux Coder
#/   workspaces. Opt-in via the `orcaServer` chezmoi flag.
#/
#/   When `orcaServer` is true:
#/     - Retires the legacy systemd --user unit and `orca-serve` wrapper
#/     - Verifies orca is installed via mise (the AppImage resolved by
#/       `mise which orca`)
#/     - Verifies FUSE is available (AppImage requires it)
#/     - Clears a stale Electron single-instance lock
#/     - Starts the Pitchfork daemon (non-fatal: a failure warns, it does not
#/       abort the apply and take every later script with it)
#/   When `orcaServer` is false:
#/     - Retires the legacy systemd --user unit and `orca-serve` wrapper
#/     - Stops the Pitchfork daemon (real opt-out, not just config removal)
#/
#/   Install of orca itself is handled by mise's http: backend (see
#/   home/private_dot_config/mise/config.toml.tmpl). This script does NOT
#/   download or apt-install anything.
#/
#/   On macOS, false quits Orca.app and disables discovered login items and
#/   LaunchAgents without removing the app, pairing data, or session history.
#/
#/ Options:
#/   --help:      Display this help message
read_enabled() {
  local config="${HOME}/.config/chezmoi/chezmoi.toml"
  local enabled
  if ! command -v yq >/dev/null 2>&1; then
    log_warn "Treating orcaServer as disabled because yq is not on PATH"
    log_warn_cont "Inspect: command -v yq"
    printf 'false\n'
    return 0
  fi
  if [ ! -f "$config" ]; then
    log_warn "Treating orcaServer as disabled because ${config} does not exist"
    log_warn_cont "Inspect: ls -ld \"$(dirname "$config")\""
    printf 'false\n'
    return 0
  fi
  if ! enabled=$(yq -p=toml -o=json -r '.data.orcaServer // false' "$config" 2>/dev/null); then
    log_warn "Orca lifecycle aborted because yq could not read data.orcaServer from ${config}; config is unchanged"
    log_warn_cont "Inspect: yq -p=toml -o=json -r '.data.orcaServer // false' \"${config}\""
    return 1
  fi
  printf '%s\n' "$enabled"
}

{{ if eq .chezmoi.os "linux" -}}
verify_orca_installed() {
  if ! command -v mise >/dev/null 2>&1; then
    log_warn "Cannot resolve orca install — mise not on PATH"
    return 1
  fi
  local orca_path
  orca_path=$(mise which orca 2>/dev/null || echo "")
  if [ -z "$orca_path" ] || [ ! -x "$orca_path" ]; then
    log_warn "Missing orca — install with: mise install"
    return 1
  fi
}


verify_fuse() {
  # AppImages require FUSE2 to mount themselves at runtime.
  # On modern Ubuntu/Debian, libfuse2t64 (or libfuse2 on older releases)
  # provides this. We don't install it here — that's install-my-packages's
  # job — but we surface a clear warning if it's missing.
  if ! command -v fusermount >/dev/null 2>&1 && ! command -v fusermount3 >/dev/null 2>&1; then
    log_warn "FUSE not available; orca AppImage may fail to start"
    log_warn_cont "Install: sudo apt install -y libfuse2t64 (Ubuntu 24.04+) or libfuse2"
    return 1
  fi
}

# The pre-Pitchfork setup ran orca from a systemd --user unit invoking the
# since-renamed `orca-serve` wrapper. Left enabled it relaunches orca at every
# boot, and that instance owns the Electron single-instance lock on
# ~/.config/orca — so pitchfork's df-orca-server can never acquire it and
# crash-loops on exit 3. Because pitchfork knows the daemon only as
# df-orca-server, pf_stop cannot reap a process running under the old name.
#
# Retired in BOTH the opt-in and opt-out paths: a legacy unit left enabled keeps
# orca alive on a machine that has opted out, which is not a real opt-out.
# Mirrors the same teardown 056 performs for mcpproxy's legacy unit.
retire_legacy_orca_server() {
  local unit="orca-server.service"
  local failed=0
  local command_error

  if command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$unit" >/dev/null 2>&1; then
    if ! command_error=$(systemctl --user disable --now "$unit" 2>&1); then
      log_warn "systemctl could not retire legacy ${unit}: ${command_error:-no diagnostic output}"
      log_warn_cont "Inspect: systemctl --user status ${unit} --no-pager"
      failed=1
    else
      if systemctl --user is-active --quiet "$unit"; then
        log_warn "Legacy ${unit} remains active after systemctl reported successful retirement"
        log_warn_cont "Inspect: systemctl --user status ${unit} --no-pager"
        failed=1
      fi
      if systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        log_warn "Legacy ${unit} remains enabled after systemctl reported successful retirement"
        log_warn_cont "Inspect: systemctl --user is-enabled ${unit}"
        failed=1
      fi
      if [ "$failed" -eq 0 ]; then
        rm -f "${HOME}/.config/systemd/user/${unit}"
        if ! command_error=$(systemctl --user daemon-reload 2>&1); then
          log_warn "systemctl could not reload user units after retiring ${unit}: ${command_error:-no diagnostic output}"
          log_warn_cont "Inspect: systemctl --user status ${unit} --no-pager"
          failed=1
        else
          log_detail "Disabled legacy systemd --user $unit"
        fi
      fi
    fi
  fi

  # The wrapper is no longer in the chezmoi source, so chezmoi will never remove
  # it; delete it so nothing can relaunch it under the old name.
  if [ -e "${HOME}/.local/bin/orca-serve" ]; then
    rm -f "${HOME}/.local/bin/orca-serve"
    log_detail "Removed legacy orca-serve wrapper"
  fi
  return "$failed"
}

# Electron refuses to start when another instance owns the userData profile, and
# clears SingletonLock only on a CLEAN exit — so a killed or orphaned orca leaves
# a lock behind that makes every later start exit 3. Runs between stop and start:
# before the stop the lock is legitimately owned by the managed daemon.
reap_orca_lock() {
  local profile="${HOME}/.config/orca"
  local lock="${profile}/SingletonLock"
  local owner pid

  [ -L "$lock" ] || return 0

  # The symlink target is "<hostname>-<pid>". Take the PID after the LAST dash:
  # hostnames contain dashes, so `for-tasks-1-1287` must yield 1287.
  owner=$(readlink "$lock" 2>/dev/null || echo "")
  pid="${owner##*-}"

  if printf '%s' "$pid" | grep -qE '^[0-9]+$' && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 2
    log_detail "Reaped orphaned orca holding the single-instance lock (pid ${pid})"
  fi

  rm -f "${profile}/SingletonLock" "${profile}/SingletonCookie" "${profile}/SingletonSocket"
}

manage_linux() {
  local enabled
  local failed=0
  enabled=$(read_enabled)

  if [ "$enabled" != "true" ]; then
    log_step "orca server (Linux, opt-out)"

    retire_legacy_orca_server || failed=1

    if pf_resolve; then
      pf_stop df-orca-server
      if pf_is_running df-orca-server; then
        log_warn "Pitchfork still reports df-orca-server running after the stop request"
        log_warn_cont "Inspect: pitchfork list"
        failed=1
      else
        log_detail "Stopped df-orca-server daemon"
      fi
    else
      log_warn "Cannot stop df-orca-server because the Pitchfork executable could not be resolved"
      log_warn_cont "Inspect: mise which pitchfork"
      failed=1
    fi
    if pgrep -f '(^|[ /])df-orca-serve([[:space:]]|$)' >/dev/null 2>&1; then
      log_warn "A df-orca-serve process remains after the daemon stop request"
      log_warn_cont "Inspect: pgrep -af df-orca-serve"
      failed=1
    fi
    if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP -sTCP:LISTEN -c orca >/dev/null 2>&1; then
      log_warn "An orca process still has a listening TCP socket after opt-out"
      log_warn_cont "Inspect: lsof -nP -iTCP -sTCP:LISTEN -c orca"
      failed=1
    fi
    return "$failed"
  fi

  log_step "orca server (Linux, opt-in)"

  retire_legacy_orca_server || return 1

  if ! verify_orca_installed; then
    log_warn "Skipping daemon lifecycle — orca not installed"
    return 0
  fi

  if ! pf_resolve; then
    log_warn "Skipping daemon lifecycle — Pitchfork not installed"
    return 0
  fi

  verify_fuse || true   # warn but don't block; some boxes have FUSE preconfigured

  # Restart on every apply — picks up potential AppImage version bumps
  # (mise re-installs in place, but the running process holds the old
  # extracted squashfs view until restart). Stop first so a running daemon is
  # replaced cleanly, and clear the lock in between (see reap_orca_lock).
  pf_stop df-orca-server

  reap_orca_lock

  # An unstartable daemon must NOT abort the apply. chezmoi stops at the first
  # failing script, so a crash-looping orca previously took every later script
  # down with it — opencode-serve, the plugin cache bust, skill packing — leaving
  # the box half-converged. pf_start already warns with the log command to run.
  pf_start df-orca-server || true
}
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
manage_macos() {
  local enabled
  enabled=$(read_enabled)
  [ "$enabled" != "true" ] || return 0
  source "${HOME}/.local/lib/desktop-app-lifecycle.sh"
  log_step "orca desktop app (macOS, opt-out)"
  dal_disable_app "Orca" "orca"
}
{{- end }}

main() {
  bl_parse_help "$@"
  case "$(uname -s)" in
{{ if eq .chezmoi.os "linux" -}}
    Linux) manage_linux ;;
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
    Darwin) manage_macos ;;
{{- end }}
    *) return 0 ;;
  esac
}

main "$@"
