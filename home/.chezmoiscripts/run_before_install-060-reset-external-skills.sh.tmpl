#!/usr/bin/env bash
set -euo pipefail

IFS=$'\n\t'

# run_before scripts execute BEFORE chezmoi materialises any target, so
# ~/.local/lib holds the PREVIOUS apply's libs. Sourcing the installed copy
# means a script here can only use lib API that already shipped to every
# machine — and calling a newly added helper aborts the apply with exit 127
# (verified: log_step not found). Source from the chezmoi source tree instead,
# which is always the current version. bash-logging.sh is not a template, so
# the source file and the target are byte-identical.
source "{{ .chezmoi.sourceDir }}/private_dot_local/lib/bash-logging.sh"
setup_session_logging "$(basename "$0")"

#/ Usage:
#/   run_before_install-060-reset-external-skills.sh
#/
#/ Description:
#/   Resets patched external skills back to upstream names before chezmoi
#/   applies externals. Pairs with run_after_install-060-patch-external-skills
#/   which re-applies the patches. Without this reset, chezmoi sees a diff
#/   between rendered external and on-disk file and prompts.
#/
#/   Uses perl for in-place edits so the reset is portable across macOS
#/   (BSD sed) and Linux (GNU sed) without flag dancing.
usage() { grep '^#/' "$0" | cut -c4-; }

# (skill_dir, patched_name, original_name)
PATCHES=(
  "improve-codebase-architecture|lochy:coding:architecture|improve-codebase-architecture"
)

reset_skill_name() {
  local skill_dir="$1"
  local patched_name="$2"
  local original_name="$3"
  local skill_md="${HOME}/.agents/skills/${skill_dir}/SKILL.md"

  [ -f "$skill_md" ] || return 0

  if grep -q "^name: ${patched_name}$" "$skill_md" 2>/dev/null; then
    perl -i -pe "s/^name: \Q${patched_name}\E\$/name: ${original_name}/" "$skill_md"
    log_detail "Reset: ${patched_name} → ${original_name}"
  fi
}

main() {
  log_step "Resetting external skill names"
  for entry in "${PATCHES[@]}"; do
    IFS='|' read -r dir patched original <<< "$entry"
    reset_skill_name "$dir" "$patched" "$original"
  done
}

main "$@"
