#!/usr/bin/env bash
# Transitional every-apply retirement: retry failures until every machine has
# converged, then delete this script one release cycle later (like .chezmoiremove).
# Never remove the shared ~/.cache/dotfiles directory.
set -euo pipefail

IFS=$'\n\t'

TMPDIR="${TMPDIR:-/tmp}"
TMPDIR="${TMPDIR%/}"

if [ ! -r "${HOME}/.local/lib/bash-logging.sh" ]; then
  exit 0
fi
# These libraries are materialised under HOME before run_after scripts execute.
# shellcheck disable=SC1091
source "${HOME}/.local/lib/bash-logging.sh"
# shellcheck disable=SC1091
source "${HOME}/.local/lib/pitchfork-lifecycle.sh" 2>/dev/null || true

#/ Usage:
#/   run_after_install-062-retire-orca-paseo-drift.sh [--help]
#/
#/ Description:
#/   Retire orca, paseo and the drift notifier after their managed files leave
#/   the chezmoi source. Stops services, uninstalls tools and removes only their
#/   explicitly listed state. Retries on each apply; failures warn but do not
#/   interrupt chezmoi apply. Remove this script after fleet convergence.
#/
#/ Options:
#/   --help:      Display this help message
# bl_parse_help calls usage by name when this script is run with --help.
# shellcheck disable=SC2329
usage() { grep '^#/' "$0" | cut -c4-; }

announce_once() {
  if [ "${RETIRE_ANNOUNCED:-0}" != 1 ]; then
    setup_session_logging "$(basename "$0")" "retire" || true
    log_step "Retiring orca, paseo and drift state"
    RETIRE_ANNOUNCED=1
  fi
}

remove_path() {
  local path="$1"
  if [ -e "$path" ] || [ -L "$path" ]; then
    announce_once
    if rm -rf -- "$path"; then
      log_detail "Removed ${path}"
    else
      log_warn "Failed to remove ${path} — continuing"
    fi
  fi
}

retire_pitchfork() {
  local daemon="$1"
  if ! declare -f pf_resolve >/dev/null 2>&1; then
    log_warn "Missing Pitchfork lifecycle helper — cannot retire ${daemon}"
    return 0
  fi
  if ! pf_resolve >/dev/null 2>&1; then
    return 0
  fi
  # Do not touch stopped rows: Pitchfork clean is global, not per-daemon.
  if ! "$PITCHFORK_BIN" list --hide-header 2>/dev/null \
    | grep -Eq "(^|[[:space:]/])${daemon}[[:space:]]+running([[:space:]]|$)"; then
    return 0
  fi

  announce_once
  if "$PITCHFORK_BIN" stop "$daemon" >/dev/null 2>&1; then
    log_detail "Stopped Pitchfork daemon ${daemon}"
  else
    log_warn "Failed to stop Pitchfork daemon ${daemon} — continuing"
  fi
}

remove_drift_cache() {
  remove_path "${HOME}/.cache/dotfiles/drift.json"
  remove_path "${HOME}/.cache/dotfiles/.drift-login-shown"
}

{{ if eq .chezmoi.os "linux" -}}
retire_linux() {
  retire_pitchfork df-orca-server

  local unit="paseo-daemon.service"
  local unit_file="${HOME}/.config/systemd/user/${unit}"
  local link
  local -a wants_links=()
  local had_nullglob=0
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  wants_links=("${HOME}/.config/systemd/user/"*.wants/paseo-daemon.service)
  if [ "$had_nullglob" -eq 0 ]; then shopt -u nullglob; fi

  if command -v systemctl >/dev/null 2>&1; then
    if [ -e "$unit_file" ] || [ -L "$unit_file" ] \
      || [ "${#wants_links[@]}" -gt 0 ] \
      || systemctl --user is-active --quiet "$unit" 2>/dev/null \
      || [ "$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null)" = loaded ]; then
      announce_once
      if systemctl --user stop "$unit" >/dev/null 2>&1; then
        log_detail "Stopped ${unit}"
      else
        log_warn "Failed to stop ${unit} — continuing"
      fi
      if systemctl --user disable "$unit" >/dev/null 2>&1; then
        log_detail "Disabled ${unit}"
      else
        log_warn "Failed to disable ${unit} — continuing"
      fi
      for link in "${wants_links[@]+"${wants_links[@]}"}"; do remove_path "$link"; done
      remove_path "$unit_file"
      if systemctl --user daemon-reload >/dev/null 2>&1; then
        log_detail "Reloaded systemd user units"
      else
        log_warn "Failed to reload systemd user units — continuing"
      fi
      systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
    fi
  else
    for link in "${wants_links[@]+"${wants_links[@]}"}"; do remove_path "$link"; done
    remove_path "$unit_file"
  fi

  local tool install_dir
  install_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/installs"
  if command -v mise >/dev/null 2>&1; then
    for tool in http:orca npm:@getpaseo/cli; do
      case "$tool" in
        http:orca) [ -d "${install_dir}/http-orca" ] || continue ;;
        npm:@getpaseo/cli) [ -d "${install_dir}/npm-getpaseo-cli" ] || continue ;;
      esac
      if mise ls --installed --no-header "$tool" 2>/dev/null | grep -q '[^[:space:]]'; then
        announce_once
        if mise uninstall --all --yes "$tool" >/dev/null 2>&1; then
          log_detail "Uninstalled all mise versions of ${tool}"
        else
          log_warn "Failed to uninstall ${tool} — continuing"
        fi
      fi
    done
  fi

  remove_path "${HOME}/.config/orca"
  remove_path "${HOME}/.paseo"
  # A symlinked ~/.cache/dotfiles resolves this child path on its own; never
  # remove the directory or its symlink, which are shared with other tools.
  remove_path "${HOME}/.cache/dotfiles/orca-extracted"

  local orca_shim="${HOME}/.local/bin/orca"
  if [ -f "$orca_shim" ] && grep -qF 'orca-serve-bare-orca-dispatcher' "$orca_shim" 2>/dev/null; then
    remove_path "$orca_shim"
  fi
  remove_path "${HOME}/.local/bin/orca-ide"
  remove_path "${HOME}/.local/bin/orca-serve"
  remove_path "${HOME}/.local/bin/dotfiles-task-orca-install-deb"

  local name
  for name in cask check dotfiles notify omo; do
    remove_path "${HOME}/.local/bin/dotfiles-task-drift-${name}"
  done
}
{{ else if eq .chezmoi.os "darwin" -}}
quit_app() {
  local app="$1"
  if ! command -v pgrep >/dev/null 2>&1 || ! pgrep -x "$app" >/dev/null 2>&1; then
    return 0
  fi
  if command -v osascript >/dev/null 2>&1 && osascript -e "tell application \"${app}\" to quit" >/dev/null 2>&1; then
    announce_once
    log_detail "Asked ${app} to quit"
  else
    announce_once
    log_warn "Could not ask ${app} to quit — trying its app bundle"
  fi
  if pgrep -x "$app" >/dev/null 2>&1; then
    if command -v pkill >/dev/null 2>&1 && pkill -f "/${app}.app/Contents/MacOS/" >/dev/null 2>&1; then
      log_detail "Stopped ${app} app bundle"
    else
      log_warn "Failed to stop ${app} app bundle — continuing"
    fi
  fi
}

retire_darwin() {
  retire_pitchfork df-drift-notify

  local label="io.lochlan.dotfiles.drift"
  local domain
  domain="gui/$(id -u)"
  if command -v launchctl >/dev/null 2>&1 && launchctl print "${domain}/${label}" >/dev/null 2>&1; then
    announce_once
    if launchctl bootout "${domain}/${label}" >/dev/null 2>&1; then
      log_detail "Booted out retired launchd agent ${label}"
    else
      log_warn "Failed to boot out ${label} — continuing"
    fi
  fi
  remove_path "${HOME}/Library/LaunchAgents/${label}.plist"

  quit_app Orca
  quit_app Paseo
  local cask
  if command -v brew >/dev/null 2>&1; then
    for cask in orca paseo; do
      case "$cask" in
        orca) [ -e /Applications/Orca.app ] || continue ;;
        paseo) [ -e /Applications/Paseo.app ] || continue ;;
      esac
      if brew list --cask "$cask" >/dev/null 2>&1; then
        announce_once
        if brew uninstall --cask "$cask" >/dev/null 2>&1; then
          log_detail "Uninstalled ${cask} cask"
        else
          log_warn "Failed to uninstall ${cask} cask — continuing"
        fi
      fi
    done
    if { [ -d /opt/homebrew/Library/Taps/stablyai/homebrew-orca ] \
      || [ -d /usr/local/Homebrew/Library/Taps/stablyai/homebrew-orca ] \
      || [ -d /usr/local/Library/Taps/stablyai/homebrew-orca ]; } \
      && brew tap 2>/dev/null | grep -qxF 'stablyai/orca'; then
      announce_once
      if brew untap stablyai/orca >/dev/null 2>&1; then
        log_detail "Untapped stablyai/orca"
      else
        log_warn "Failed to untap stablyai/orca — continuing"
      fi
    fi
  fi

  remove_path "${HOME}/Library/Application Support/Orca"
  remove_path "${HOME}/Library/Application Support/Paseo"
  remove_path "${HOME}/Library/Application Support/paseo"
  remove_path "${HOME}/.paseo"
  local name
  for name in orca-updater @getpaseodesktop-updater com.stablyai.orca com.stablyai.orca.ShipIt sh.paseo.desktop sh.paseo.desktop.ShipIt; do
    remove_path "${HOME}/Library/Caches/${name}"
  done
  remove_path "${HOME}/Library/Preferences/com.stablyai.orca.plist"
  remove_path "${HOME}/Library/Preferences/sh.paseo.desktop.plist"
  remove_path "${HOME}/Library/Logs/Paseo"
  remove_path "${HOME}/Library/Logs/Orca"
}
{{ end -}}

main() {
  bl_parse_help "$@"
{{ if eq .chezmoi.os "linux" -}}
  retire_linux
{{ else if eq .chezmoi.os "darwin" -}}
  retire_darwin
{{ end -}}
  remove_drift_cache
}

main "$@" || log_warn "Retirement encountered an unexpected failure — continuing"
exit 0
