{{- $checkouts := dig "checkouts" (dict) . -}}
{{- if not (kindIs "map" $checkouts) -}}{{- fail "checkouts must be an object" -}}{{- end -}}
{{- if gt (len $checkouts) 0 -}}
#!/usr/bin/env bash
{{ includeTemplate "script-prelude" "checkouts" }}
source "${HOME}/.local/lib/checkout-sync.sh"
# Fast-forwards each machine-local [data.checkouts.<name>] checkout and builds
# it (see readme "Tracked Checkouts"). run_after_, not run_onchange_: the
# input is the remote branch tip, which no source hash can track.
# A skipped or failed checkout is reported and never fails the apply.

log_step "Syncing local checkouts"
{{- range $name := keys $checkouts | sortAlpha }}
{{-   $c := get $checkouts $name }}
{{-   if not (kindIs "map" $c) }}{{ fail (printf "checkouts.%s must be an object" $name) }}{{ end }}
{{-   $path := dig "path" "" $c }}
{{-   if or (not (kindIs "string" $path)) (eq $path "") }}{{ fail (printf "checkouts.%s.path must be a non-empty string" $name) }}{{ end }}
{{-   $path = replace "{homeDir}" $.chezmoi.homeDir $path }}
{{-   if not (hasPrefix "/" $path) }}{{ fail (printf "checkouts.%s.path must be absolute or start with {homeDir}" $name) }}{{ end }}
{{-   $busy := dig "busyWhen" (list) $c }}
{{-   if not (kindIs "slice" $busy) }}{{ fail (printf "checkouts.%s.busyWhen must be an array" $name) }}{{ end }}
{{-   $args := concat (list $name $path (dig "branch" "" $c) (dig "build" "" $c)) $busy }}
cs_sync{{ range $args }} '{{ replace "'" "'\\''" (toString .) }}'{{ end }} || true
{{- end }}
{{ end -}}
