{{/* v4 docs live in Effect-TS/effect, NOT Effect-TS/effect-smol. smol is the v4
     incubator and its main branch does not track published releases, so it
     serves docs older than the version the tools pin. Every path in the
     allowlist below must exist upstream — re-check them when editing. */ -}}
["v4-docs"]
    type = "archive"
    url = "https://codeload.github.com/Effect-TS/effect/tar.gz/refs/heads/main"
    stripComponents = 1
    refreshPeriod = "24h"
    include = [
        "*/LLMS.md",
        "*/MIGRATION.md",
        "*/migration",
        "*/migration/**",
        "*/ai-docs",
        "*/ai-docs/**",
        "*/packages",
        "*/packages/effect",
        "*/packages/effect/SCHEMA.md",
        "*/packages/effect/HTTPAPI.md",
        "*/packages/effect/MCP.md",
        "*/packages/effect/CONFIG.md",
        "*/packages/effect/OPTIC.md",
    ]
