{{- /* chezmoi:modify-template */ -}}
{{- /* Other tools (gh, git-lfs, IDEs) write to this file, so chezmoi owns only
       the marked section and preserves everything else. */ -}}
{{- includeTemplate "marked-section-tmpl" (dict
      "existing" .chezmoi.stdin
      "body" (includeTemplate "git-config-tmpl" .)
      "target" "~/.config/git/config"
      "adopt" false) -}}
