{{- /* Machine-local OpenCode 2 settings that the CLI wrapper needs before any
       session starts. Read by ~/.local/bin/opencode2 for `pair`; written by
       chezmoi from [data.opencode2.serve], which is the machine-local override
       (see .chezmoidata/opencode2.yaml). Empty means "no public URL known", and
       `pair` then behaves as before. Gated on openCode2Server: the URL points
       at the serve daemon, so it is only rendered where that daemon runs. */ -}}
{{- if dig "openCode2Server" false . -}}
{{-   $serve := dig "serve" (dict) (dig "opencode2" (dict) .) -}}
{{-   $url := dig "publicUrl" "" $serve -}}
{{-   if not (kindIs "string" $url) -}}
{{-     fail "opencode2.serve.publicUrl must be a string" -}}
{{-   end -}}
# Managed by chezmoi (private_dot_config/private_dotfiles). Read by opencode2 for `pair`.
OPENCODE2_PAIR_URL='{{ $url }}'
{{ end -}}
