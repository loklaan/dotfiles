{{- /* Settings for ~/.local/bin/df-opencode2-serve, the stable `run` command of
       the df-opencode2-serve Pitchfork daemon. Pitchfork watches this file and
       restarts the daemon when it changes, so a bind or port change needs no
       apply-time restart. Renders empty (not written) unless the daemon is
       enabled.

       The bind comes from .chezmoitemplates/opencode2-serve-bind, shared with
       the V2 config's `server` block: loopback behind nginx, 0.0.0.0 on Linux
       without one, overridable per machine under [data.opencode2.serve]. */ -}}
{{- if dig "openCode2Server" false . -}}
{{-   $bind := includeTemplate "opencode2-serve-bind" (dict "data" .) | fromJson -}}
# Managed by chezmoi (private_dot_config/private_dotfiles). Read by df-opencode2-serve.
OPENCODE2_SERVE_HOSTNAME={{ $bind.hostname }}
OPENCODE2_SERVE_PORT={{ $bind.port }}
{{ end -}}
