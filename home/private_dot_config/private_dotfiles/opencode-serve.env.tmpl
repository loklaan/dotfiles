{{- /* Settings for ~/.local/bin/df-opencode-serve, the stable `run` command of
       the df-opencode-serve Pitchfork daemon. Pitchfork watches this file
       and restarts the daemon when it changes, so a bind or port change
       needs no apply-time restart. Renders empty (not written) unless the
       daemon is enabled.

       Bind: loopback on macOS, and on Linux behind nginx (internal port);
       0.0.0.0 on Linux without nginx (external port). */ -}}
{{- if dig "openCodeServer" false . -}}
{{-   $bind := "127.0.0.1" -}}
{{-   $port := .ports.opencode.external -}}
{{-   if eq .chezmoi.os "linux" -}}
{{-     if dig "nginxProxy" false . -}}
{{-       $port = .ports.opencode.internal -}}
{{-     else -}}
{{-       $bind = "0.0.0.0" -}}
{{-     end -}}
{{-   end -}}
# Managed by chezmoi (private_dot_config/private_dotfiles). Read by df-opencode-serve.
OPENCODE_SERVE_HOSTNAME={{ $bind }}
OPENCODE_SERVE_PORT={{ $port }}
{{ end -}}
