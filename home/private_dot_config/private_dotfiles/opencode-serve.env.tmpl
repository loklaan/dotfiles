{{- /* Settings for ~/.local/bin/df-opencode-serve, the stable `run` command of
       the df-opencode-serve Pitchfork daemon. Pitchfork watches this file and
       restarts the daemon when it changes, so a bind or port change needs no
       apply-time restart. Renders empty (not written) unless the daemon is
       enabled.

       Default bind: loopback on macOS and on Linux behind nginx (internal
       port); 0.0.0.0 on Linux without nginx (external port).

       Machine overrides live under [data.opencode.serve] in the machine-local
       chezmoi config:

         [data.opencode.serve]
         hostname = "example.internal"
         port = 4098          # direct bind, no nginx front
         publicUrl = "https://host:4098"

       Setting `port` means "bind directly here": the daemon binds 0.0.0.0 on
       that port and the OpenCode nginx site renders empty (a proxy would
       collide with it). Use it when a machine's clients already talk to a
       dedicated port, as this host does.

       OPENCODE_PUBLIC_URL is the URL a human opens. It feeds
       `df-opencode-pair`; the nginx-fronted default rewrites its port to the
       external port, while a direct bind leaves it exactly as configured. */ -}}
{{- if dig "openCodeServer" false . -}}
{{-   $serve := dig "opencode" "serve" (dict) . -}}
{{-   $bind := "127.0.0.1" -}}
{{-   $port := .ports.opencode.external -}}
{{-   $direct := false -}}
{{-   if eq .chezmoi.os "linux" -}}
{{-     if dig "nginxProxy" false . -}}
{{-       $port = .ports.opencode.internal -}}
{{-     else -}}
{{-       $bind = "0.0.0.0" -}}
{{-     end -}}
{{-   end -}}
{{-   $portOverride := dig "port" 0 $serve -}}
{{-   if $portOverride -}}
{{-     $port = int $portOverride -}}
{{-     $direct = true -}}
{{-     $bind = "0.0.0.0" -}}
{{-   end -}}
{{-   $hostOverride := dig "hostname" "" $serve -}}
{{-   if ne "" $hostOverride -}}
{{-     $bind = $hostOverride -}}
{{-   end -}}
{{-   $publicUrl := dig "publicUrl" "" $serve -}}
{{-   if and (ne "" $publicUrl) (dig "nginxProxy" false .) (not $direct) -}}
{{-     $publicUrl = regexReplaceAll ":[0-9]+$" $publicUrl (printf ":%v" .ports.opencode.external) -}}
{{-   end -}}
# Managed by chezmoi (private_dot_config/private_dotfiles). Read by df-opencode-serve.
OPENCODE_SERVE_HOSTNAME={{ $bind }}
OPENCODE_SERVE_PORT={{ $port }}
OPENCODE_PUBLIC_URL={{ $publicUrl }}
{{ end -}}
