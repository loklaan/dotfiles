[tools]
# Global tools listed here will be automatically installed.
"github:bitwarden/sdk" = { version = "bws-v2.1.0", exe = "bws", tag_regex = "^bws" }
"github:psastras/sarif-rs" = { version = "sarif-fmt-v0.8.0", exe = "sarif-fmt", matching = "sarif-fmt", tag_regex = "^sarif-fmt" }
# RTK — Rust CLI that rewrites shell commands to compact output, saving 60-90%
# of token spend on common dev commands (git status, ls, cargo test, etc.).
# Installed on every machine; the opencode plugin lives in
# private_dot_config/opencode/plugins/rtk.ts (managed here, not via `rtk init`).
"github:rtk-ai/rtk" = { version = "v0.43.0", exe = "rtk" }
{{ if eq .chezmoi.os "linux" -}}
"github:smart-mcp-proxy/mcpproxy-go" = { version = "0.46.0", exe = "mcpproxy" }
{{ end -}}
{{ if and (eq .chezmoi.os "linux") (dig "paseoDaemon" false .) -}}
"npm:@getpaseo/cli" = "0.1.101"
{{ end -}}
# usage — jdx's CLI shell-completion runtime. Required by pitchfork's
# `completion` subcommand; kept next to pitchfork since they're paired.
usage = "3.5.5"
"github:jdx/pitchfork" = { version = "2.19.0", exe = "pitchfork" }
{{ if and (eq .chezmoi.os "linux") (dig "orcaServer" false .) -}}
# orca on Linux: AppImage via http: backend. mise downloads, makes executable,
# and symlinks into ~/.local/share/mise/installs/http-orca/<version>/orca.
# `df-orca-serve` wrapper points there. Pitchfork supervises the daemon lifecycle.
# (macOS uses the Homebrew cask, not mise — see install-my-packages.tmpl.)
"http:orca" = { version = "1.4.176", url = "https://github.com/stablyai/orca/releases/download/v{{ "{{version}}" }}/orca-linux.AppImage", bin = "orca" }
{{ end -}}
{{ if and (eq .chezmoi.os "linux") (dig "codeServer" false .) -}}
"npm:code-server" = "latest"
{{ end -}}
age = "latest"
ast-grep = "latest"
bitwarden = "2026.6.0"
bun = "1.3.14"
chezmoi = "2.70.5"
claude = "latest"
d2 = "0.7.1"
delta = "0.19.2"
deno = "2.9.0"
difftastic = "0.69.0"
fzf = "0.73.1"
gh = "latest"
go = "1.26.4"
jq = "latest"
yq = "latest"
node = "24.11.1"
opencode = "latest"
python = "3.13"
ripgrep = "latest"
rust = "1.96.0"
shellcheck = "0.11.0"
starship = "1.26.0"
tmux = "3.6b"
uv = "0.11.25"

[env]
DISABLE_AUTOUPDATER = "1"
DENO_NO_UPDATE_CHECK = "1"

[settings]
idiomatic_version_file_enable_tools = ["node"]
experimental = true
gix = false
# Shims in ~/.local/share/mise/shims are symlinks to the mise binary itself, and
# that dir is first on PATH. With auto-install enabled, a shim invoked for a
# not-yet-installed tool re-enters mise to install it — which deadlocks when the
# caller IS mise installing that same tool. A source build makes this reachable:
# CPython's ./configure probes `python3.13 -V` to bootstrap itself, PATH resolves
# that to the shim, the shim tries to install python@3.13, and it blocks forever
# on the tool-version flock its own grandparent build already holds. Its nested
# python-build then spawns another ./configure, so the cycle compounds. Observed
# on a Coder box: `mise install` hung 1h45m with no output, and because
# install-my-packages runs it via run_quiet under a non-TTY `chezmoi apply`, a
# fresh workspace wedges silently and permanently.
# Disabling this severs the cycle at its only active step. Shims for INSTALLED
# tools are unaffected; a shim for a missing tool now fails fast instead of
# self-installing, which is correct here — installs come from `mise install`
# during `chezmoi apply`, not from incidental shim calls.
not_found_auto_install = false

[settings.github]
credential_command = "gh auth token"

# ── Tasks ────────────────────────────────────────────────────────────────────
# Task bodies are hoisted into ~/.local/bin/dotfiles-task-* scripts so they
# follow the repo's standard script header pattern (set -euo pipefail, doc
# block, bash-logging) and can be debugged in isolation. Task entries here
# are thin dispatchers + dependency declarations.

[tasks.update]
description = "Upgrade mise tools, pull dotfiles source, then converge chezmoi state"
depends = ["mise:upgrade"]
depends_post = ["chezmoi:update"]
run = "true"

[tasks."mise:upgrade"]
description = "Refresh tools pinned to `latest` (explicit pins untouched)"
hide = true
run = "df-task-mise-upgrade"

[tasks."chezmoi:apply"]
description = "Apply chezmoi (converges dotfiles + lifecycle scripts)"
hide = true
run = "df-task-chezmoi-apply"

[tasks."chezmoi:update"]
description = "Pull source repo + apply (TTY-aware non-interactive fallback)"
hide = true
run = "df-task-chezmoi-update"

{{ if eq .chezmoi.os "darwin" -}}
# ── Drift detection (macOS only) ─────────────────────────────────────────────
# Surfaces version drift across managed tools without firing notifications on
# Coder boxes (which are non-interactive). Linux drift is visible by SSHing
# into the box and running df-setup.

[tasks."drift:check"]
description = "Aggregate version drift into ~/.cache/dotfiles/drift.json"
run = "df-drift check"

[tasks."prewarm:gh-auth"]
description = "Cache gh auth liveness into ~/.cache/dotfiles/prewarm.json"
run = "df-prewarm gh-auth"

[tasks."drift:notify"]
description = "Surface drift via macOS notification (debounced 24h)"
# Rides the daily launchd fire: refreshing gh-auth liveness here means the
# login.zsh setup reminder reads a fresh boolean from prewarm.json instead of
# forking `gh auth status` per login. Distinct cache + concern from drift, so
# it is a task-dependency edge, not a code merge.
depends = ["drift:check", "prewarm:gh-auth"]
run = "df-drift notify"

{{ end -}}

# ── Hooks ────────────────────────────────────────────────────────────────────
# No postinstall hook here. A `postinstall = { task = "chezmoi:apply" }` hook
# re-enters chezmoi apply from inside mise install/upgrade, which is itself
# invoked from `run_after_install-050-install-packages.sh` during an outer
# `chezmoi apply`. Chezmoi serializes apply via a persistent-state lock, so
# the nested apply deadlocks with "timeout obtaining persistent state lock".
# Convergence is already delivered by the outer apply: lifecycle scripts run
# later in the same chezmoi apply, after install-050 returns.
