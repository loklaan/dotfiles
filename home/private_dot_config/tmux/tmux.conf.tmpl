###--------------------------------------------------------------------------###
### Terminal Features

## Default Shell (login shell for proper zsh initialization)
set-option -g default-shell "{{ lookPath "zsh" }}"
set-option -g default-command "zsh -l"

## Available Colors
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

## Color Codes
set -sa terminal-overrides ',*:dim=\E[2m'
set -as terminal-overrides ',*:smxx=\E[9m'
set -as terminal-overrides ',*:sitm=\E[3m'

## Hyperlinks
set -as terminal-overrides ',*:Hls=\E]8;id=%p1%s;%p2%s\E\\:Hlr=\E]8;;\E\\'

## Mouse-controlled Cursor
set -g mouse on

## Window Names / Titles
set-option -g allow-rename off
set-option -g set-titles on
set-option -g set-titles-string '#T'

## Display timeout (extended)
set-option -g display-time 1750

## Bell Sounds
set-option -g visual-activity off
set-option -g visual-bell off
set-option -g visual-silence off
set-window-option -g monitor-activity off
set-option -g bell-action none

## Terminal Passthrough (tmux 3.3+)
# TODO: Remove version check once Ubuntu Jammy is deprecated for Coder
if-shell '[ "$(tmux -V | cut -d" " -f2 | tr -d "a-z")" \> "3.2" ]' \
  'set-option -g allow-passthrough on'

###--------------------------------------------------------------------------###
### Keybindings

## General key-bindings set e.g. vim-like (instead of emacs-like)
set -gw mode-keys vi

## Tmux prefix to ~ (Tilde)
unbind C-b
set -g prefix `
bind ` send-prefix

## Splitting Panes
bind-key - split-window -v -c "#{pane_current_path}"
bind-key | split-window -h -c "#{pane_current_path}"

## Mouse-mode
bind-key m set -g mouse \; display "Toggle mouse"

## Sync typing for panes
bind-key / set -w synchronize-panes \; display "Toggles synchronised panes"

## Move window position
bind-key < swap-window -t -1 \; select-window -t -1
bind-key > swap-window -t +1 \; select-window -t +1

## Mouse to copy highlighted text
# On macOS pipe to pbcopy; on other hosts (e.g. headless Coder devboxes, which
# have no pbcopy) rely on tmux's OSC52 emit so the copy reaches the local
# terminal's clipboard over SSH. set-clipboard=on is required for the OSC52 path.
set-option -g set-clipboard on
{{ if eq .chezmoi.os "darwin" -}}
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
{{- else -}}
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel
{{- end }}

###--------------------------------------------------------------------------###
### Theming / Layouts

## Theme
source-file "${HOME}/.tmux/_plugins/tmux-themepack/powerline/block/gray.tmuxtheme"

## Status Bar
set -g status-right 'Continuum status: #{continuum_status}'
set -g status-left ''
set -g status-style bg=colour234,fg=colour242
set-window-option -g window-status-current-style bg=colour240,fg=colour253
set -g pane-border-style fg=colour240
set -g pane-active-border-style fg=colour240

###--------------------------------------------------------------------------###
### Plugins

## History - panes, layouts & directories
# @continuum-boot is deliberately OFF on EVERY platform. Both of continuum's
# boot integrations lose real sessions, by different routes, and neither buys
# anything: sessions are always entered through `tmux new-session -A`, which
# starts the server itself and triggers @continuum-restore anyway.
#
# On Linux it installs a systemd user unit whose ExecStop chain is
# `resurrect/scripts/save.sh` and then `tmux kill-server`. On a Coder workspace
# shutdown the login session's cgroup is torn down first, so that save runs
# against an ALREADY-DEAD tmux server: it writes a 0-byte snapshot and
# resurrect still claims it as `last`. The next boot then "restores" an empty
# file and main-session comes back as a single blank window, with the real
# state stranded in the previous snapshot.
#
# On macOS it installs a `Tmux.Start.plist` LaunchAgent whose damage is in the
# START action, not a stop action. At every login it AppleScripts Terminal.app
# open, full-screens it, and runs a BARE `tmux` — which creates a brand-new
# session instead of attaching (`new-session -A`) to the restored one. The
# following autosave then writes that ~140-byte stub over `last`, and the real
# snapshot is only reachable by hand. guard-last.sh cannot catch this: the stub
# is non-empty, so it passes every "has content" test.
set -g @continuum-boot 'off'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

## Code agent session persistence across resurrect/continuum cycles
set -g @resurrect-hook-post-save-all 'bash {{ .chezmoi.homeDir }}/.local/lib/tmux-resurrect-code-agents/save.sh'
set -g @resurrect-hook-post-restore-all 'bash {{ .chezmoi.homeDir }}/.local/lib/tmux-resurrect-code-agents/restore.sh'

# Initialisation - managed by .chezmoiexternal.toml
run-shell "${HOME}/.tmux/_plugins/tmux-yank/yank.tmux"
run-shell "${HOME}/.tmux/_plugins/tmux-resurrect/resurrect.tmux"
# Must run before continuum, whose background auto-restore reads the `last`
# symlink this repairs.
run-shell "bash {{ .chezmoi.homeDir }}/.local/lib/tmux-resurrect-code-agents/guard-last.sh"
run-shell -b "${HOME}/.tmux/_plugins/tmux-continuum/continuum.tmux"
