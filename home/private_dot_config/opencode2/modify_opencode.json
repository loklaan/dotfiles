{{- /* chezmoi:modify-template */ -}}
{{- $base := fromJson (default "{}" .chezmoi.stdin) -}}

{{- /* OpenCode 2 (`opencode2`) global config — DELIBERATELY SEPARATE from
     OpenCode 1's ~/.config/opencode/opencode.json.

     V2 reads V1's config locations by default
     (https://opencode.ai/v2/docs/migrate-v1). The ~/.local/bin/opencode2
     wrapper sets OPENCODE_CONFIG_DIR=~/.config/opencode2 so this file is what
     V2 loads instead. Verified with `opencode2 debug config`.

     This file uses NATIVE V2 field names, which differ from V1: `plugins` not
     `plugin`, `agents` not `agent`, `providers` not `provider`, `snapshots` not
     `snapshot`, `mcp.servers` not `mcp`, `settings` not `options`, and an
     ordered `permissions` array instead of a per-tool `permission` map.

      Kept minimal on purpose. The compatible oh-my-opencode-slim plugin is
      registered below; the work LLM-proxy plugin remains absent because it is
      V1-only and has no V2 entry point.
      - `.agents` content. V2 discovers `.agents/skills` natively; instructions
        come only from AGENTS.md, rendered alongside this file.
*/ -}}

{{- $p := index .profiles (dig "machineProfile" "personal" .) -}}
{{- $config := $base -}}

{{- $config = $config | setValueAtPath "$schema" "https://opencode.ai/config.json" -}}

{{- /* Chezmoi owns the installed version (run_after_install-071 tracks the
     `beta` dist-tag). V2 auto-installs compatible non-major updates by default,
     which would fight that, so keep it off. */ -}}
{{- $config = $config | setValueAtPath "autoupdate" false -}}
{{- $config = $config | setValueAtPath "plugin" (list "oh-my-opencode-slim@3.0.1") -}}
{{- $config = $config | setValueAtPath "agent" (dict
      "explore" (dict "disable" true)
      "general" (dict "disable" true)) -}}
{{- $config = $config | setValueAtPath "lsp" true -}}
{{- $config = $config | setValueAtPath "references.effect-v4" (dict
      "path" (joinPath .chezmoi.homeDir ".local/share/mise/effect-v4-reference/current")
      "description" "Effect v4 APIs, migrations, examples, source, and tests"
) -}}
{{- /* V2 never resolves `instructions`; instructions are AGENTS.md-only. */ -}}
{{- $config = unset $config "instructions" -}}
{{- /* `.agents/skills` is discovered natively, so no entry is needed. */ -}}
{{- $config = unset $config "skills" -}}

{{- /* Snapshots: mirror the V1 behaviour of disabling them on Coder boxes when
     the profile opts out. V1's field is `snapshot`; V2's is `snapshots`. */ -}}
{{- if and (ne "" (env "CODER")) (not (dig "snapshot" true $p)) -}}
{{-   $config = $config | setValueAtPath "snapshots" false -}}
{{- end -}}

{{- /* Base `mp-codemode` entry, plus one `mp-<slug>` per profile read from
     mcpproxy's own config so the list cannot drift. `/mcp/p/<slug>` scopes
     that lane; V1 keeps its original `mcpproxy` name. */ -}}
{{- $v1Mcp := includeTemplate "mcp-servers-opencode-mcpproxy-json-tmpl" . | fromJson -}}
{{- $servers := dict -}}
{{- $origin := "" -}}
{{- range $name, $entry := $v1Mcp -}}
{{-   $server := dict "type" (dig "type" "remote" $entry) -}}
{{-   if hasKey $entry "url" -}}
{{-     $server = set $server "url" (get $entry "url") -}}
{{-     $origin = trimSuffix "/mcp/" (get $entry "url") | trimSuffix "/mcp" -}}
{{-   end -}}
{{-   if hasKey $entry "command" -}}
{{-     $server = set $server "command" (get $entry "command") -}}
{{-   end -}}
{{-   $server = set $server "disabled" (not (dig "enabled" true $entry)) -}}
{{-   $servers = set $servers "mp-codemode" $server -}}
{{- end -}}
{{- $mcpproxyConfig := joinPath .chezmoi.homeDir ".mcpproxy/mcp_config.json" -}}
{{- if and (ne "" $origin) (stat $mcpproxyConfig) -}}
{{-   $mcpproxy := include $mcpproxyConfig | fromJson -}}
{{-   range $profile := (dig "profiles" (list) $mcpproxy) -}}
{{-     $slug := dig "name" "" $profile -}}
{{-     if ne "" $slug -}}
{{-       $servers = set $servers (printf "mp-%s" $slug) (dict "type" "remote" "url" (printf "%s/mcp/p/%s" $origin $slug) "disabled" false) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if gt (len $servers) 0 -}}
{{-   $config = $config | setValueAtPath "mcp.servers" $servers -}}
{{- end -}}

{{- /* Providers. Only the opencode-family providers (`opencode` Zen and
     `opencode-go`) are portable to V2 today: they are built into V2's registry
     and authenticate with a single SKU-agnostic account key from BWS, so no
     plugin is involved.

     The work profile's proxied providers (amazon-bedrock and friends) are
     NOT portable. Their endpoint and credentials come entirely from the work
     LLM-proxy plugin — a rotating bearer token on VPN, SigV4 over IMDS on
     Coder — and that plugin is V1-API-only. There is no config-only equivalent,
     and a static apiKey would expire. So on a work-profile machine opencode2
     starts with free-tier models until that plugin ships a V2 entry point;
     `/connect` inside the TUI is the escape hatch.

     Key is embedded literally rather than via {env:OPENCODE_API_KEY} for the
     same reason as V1: that env var is only exported by zsh, so any
     bash-launched or service-spawned V2 process would see it empty. */ -}}
{{- $v1Providers := dig "provider_block" (dict) $p -}}
{{- $opencodeFamily := list "opencode-go" "opencode" -}}
{{- $portable := dict -}}
{{- range $id, $entry := $v1Providers -}}
{{-   if has $id $opencodeFamily -}}
{{-     $provider := dict -}}
{{-     if hasKey $entry "name" -}}
{{-       $provider = set $provider "name" (get $entry "name") -}}
{{-     end -}}
{{-     $portable = set $portable $id $provider -}}
{{-   end -}}
{{- end -}}

{{- if gt (len $portable) 0 -}}
{{-   $bwsToken := "" -}}
{{-   if and (lookPath "bws") (stat .bwsTokenPath) -}}
{{-     $bwsToken = include .bwsTokenPath | trim -}}
{{-   end -}}
{{-   $bwsGet := joinPath .chezmoi.homeDir ".local/lib/bws-get-or-empty" -}}
{{-   $apiKey := "" -}}
{{-   $bwsIdOpencodeApiKey := dig "bwsIdOpencodeApiKey" "" . -}}
{{-   if and (ne "" $bwsToken) (ne "" $bwsIdOpencodeApiKey) (stat $bwsGet) -}}
{{-     $apiKey = output $bwsGet $bwsIdOpencodeApiKey .bwsTokenPath | trim -}}
{{-   end -}}
{{-   if ne "" $apiKey -}}
{{-     $withKeys := dict -}}
{{-     range $id, $provider := $portable -}}
{{-       $withKeys = set $withKeys $id (set $provider "settings" (dict "apiKey" $apiKey)) -}}
{{-     end -}}
{{-     $portable = $withKeys -}}
{{-   end -}}
{{-   $config = $config | setValueAtPath "providers" $portable -}}
{{- else -}}
{{-   $config = unset $config "providers" -}}
{{- end -}}

{{- /* enabled_providers is LOAD-BEARING, not decoration. V2 treats it as a
     deny-by-default allowlist (the V1 syntax is normalized into V2's internal
     provider policy without warning), and it is the only lever that stops V2
     activating providers it inherits from V1.

     auth.json is SHARED with V1 — it lives in the XDG data dir, and V2 exposes
     no env var to move it (verified against the beta binary: there is no
     OPENCODE_AUTH_CONTENT). Isolating it would require overriding
     XDG_DATA_HOME, which every child process inherits and which breaks mise
     inside the agent's own shell.

     So V2 starts life holding V1's provider credentials. For the proxied
     providers those credentials are a placeholder key that only the V1 plugin
     can swap for a real bearer token, so V2 presents e.g. a Bedrock model and
     then fails every request with HTTP 403 — observed before this allowlist was
     added. Restricting enabled_providers renders the inherited credentials
     inert, which is what makes the separation real rather than nominal.

     The allowlist is DERIVED from the profile and never invented. An empty list
     is deny-all (verified: `enabled_providers: []` yields zero models), which is
     the correct state for a work machine before the plugin exists — V2 is
     installed and isolated but has no model until the plugin lands or the user
     runs `/connect` deliberately.

     Do NOT reintroduce a fallback to the built-in `opencode` provider here. The
     work profile deliberately enables only the proxied providers, so defaulting
     to OpenCode Zen would route work prompts to an external provider outside the
     org's proxy — a governance problem, not a convenience. */ -}}
{{- $enabled := list -}}
{{- range $id, $_ := $portable -}}
{{-   $enabled = append $enabled $id -}}
{{- end -}}

{{- /* The V2 work plugin, when one exists. `openCodeWorkPluginV2` is passed
     through verbatim so it accepts either form V2 can load: an ABSOLUTE bundle
     path (which bypasses resolution entirely — `isAbsolute(target)` short
     circuits to a file URL, the local-dev case) or a package spec (resolved by
     probing `exports` subpaths `["server", ""]`, so a published package must
     expose its V2 entry at `./server` — `./opencode2` is never probed).

     Loading the plugin and admitting the proxied providers are deliberately ONE
     lever. Widening the allowlist without the plugin resurrects the HTTP 403
     (inherited placeholder credentials, nothing to swap them); loading the
     plugin without widening leaves its injected models denied and invisible.
     Coupling them makes both failure modes unreachable. Their per-model limits
     follow the same lever; see below.

     Empty by default, so this is inert until the plugin ships a V2 entry
     point. */ -}}
{{- $workPluginV2 := dig "openCodeWorkPluginV2" "" . | trim -}}
{{- if ne "" $workPluginV2 -}}
{{-   $config = $config | setValueAtPath "plugins" (list $workPluginV2) -}}
{{-   range $id := (dig "enabled_providers" (list) $p) -}}
{{-     if not (has $id $enabled) -}}
{{-       $enabled = append $enabled $id -}}
{{-     end -}}
{{-   end -}}
{{- else -}}
{{-   $config = unset $config "plugins" -}}
{{- end -}}
{{- $enabled = $enabled | sortAlpha -}}
{{- $config = $config | setValueAtPath "enabled_providers" $enabled -}}

{{- /* Per-model limits, translated from the same profile provider_block that
     V1 copies verbatim, so a cap stays single-sourced in profiles.json. The
     load-bearing case is a cost cap: Haiku 5.5's context limit makes sessions
     compact before they cross the context size above which its price rises
     5x. V2 takes the same {context, input, output} shape at
     providers.<id>.models.<model>.limit and merges it over the catalogue
     entry. Only `limit` translates: V2's model schema has no `reasoning` flag
     and its providers have no `whitelist`.

     Emitted only for providers V2 admits. For the proxied providers that is
     the work plugin lever above, so with the lever empty nothing is written
     for Bedrock and its inherited credentials stay inert; a limit for a
     provider V2 denies would be dead config. Model IDs contain dots, so the
     path is a list rather than a dotted string. */ -}}
{{- range $id, $entry := $v1Providers -}}
{{-   if has $id $enabled -}}
{{-     range $modelId, $model := (dig "models" (dict) $entry) -}}
{{-       if hasKey $model "limit" -}}
{{-         $config = $config | setValueAtPath (list "providers" $id "models" $modelId "limit") (get $model "limit") -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* Only carry the profile's default model when its provider is enabled here;
     otherwise leave it unset so V2 picks a default from an enabled provider
     rather than resurrecting V1's last-used proxied model from the shared
     state dir (~/.local/state/opencode/model.json, also not isolatable). */ -}}
{{- $model := dig "model" "" $p -}}
{{- if and (ne "" $model) (has (index (splitList "/" $model) 0) $enabled) -}}
{{-   $config = $config | setValueAtPath "model" $model -}}
{{- else -}}
{{-   $config = unset $config "model" -}}
{{- end -}}

{{ $config | toPrettyJson }}
