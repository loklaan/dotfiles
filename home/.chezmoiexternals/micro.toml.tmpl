# "colorscheme" value in private_dot_config/micro/modify_settings.json.
[".config/micro/colorschemes/catppuccin-mocha.micro"]
    type = "archive-file"
    # renovate: datasource=git-refs depName=https://github.com/catppuccin/micro currentValue=main
    url = "https://github.com/catppuccin/micro/archive/015a2bb208f61a2d5a33121de2644bf4a059436b.tar.gz"
    stripComponents = 1
    path = "themes/catppuccin-mocha.micro"
