{{- $email := promptStringOnce . "email" "Email for you" -}}
{{- $emailWork := promptStringOnce . "emailWork" "Email for Canva" -}}
{{- $signingKey := promptStringOnce . "signingKey" "Your commit-signing key (e.g. public ssh/gpg key)" -}}
{{- $npmWorkRegistry := promptStringOnce . "npmWorkRegistry" "Work npm registry (or empty)" -}}
{{- $openCodeWorkPlugin := promptStringOnce . "openCodeWorkPlugin" "OpenCode work plugin (or empty)" -}}
{{- $openCodeWorkPluginLocalPath := promptStringOnce . "openCodeWorkPluginLocalPath" "OpenCode work plugin LOCAL dist path (or empty — overrides openCodeWorkPlugin when set)" -}}
{{- $openCodeWorkPluginV2 := promptStringOnce . "openCodeWorkPluginV2" "OpenCode 2 work plugin entry — absolute bundle path or package spec (or empty to leave opencode2 without proxied providers)" -}}
{{- $jetbrainsLicenseServer := promptStringOnce . "jetbrainsLicenseServer" "JetBrains license server (or empty)" -}}
{{- $workForkRemote := promptStringOnce . "workForkRemote" "Work fork remote URL for this dotfiles repo (or empty)" -}}
{{- $openCodeCostHosts := promptStringOnce . "openCodeCostHosts" "Hosts for df-opencode-cost, comma-separated (or empty)" -}}
{{- $machineProfile := promptStringOnce . "machineProfile" "Machine profile (work|personal)" "personal" -}}
{{- $openCodeServer := promptBoolOnce . "openCodeServer" "Run opencode serve as a pitchfork daemon?" false -}}
{{- $mcpproxyGate := promptBoolOnce . "mcpproxyGate" "Run mcpproxy on this machine?" true -}}
{{- $nginxProxy := promptBoolOnce . "nginxProxy" "Put nginx reverse proxy in front of services (gzip, loopback daemons)?" false -}}
{{- $ephemeralCache := promptBoolOnce . "ephemeralCache" "Use ephemeral storage for ~/.cache on this machine?" false -}}

[data]
  email = {{ $email | quote }}
  emailWork = {{ $emailWork | quote }}
  signingKey = {{ $signingKey | quote }}
  brewprefix = "{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}"
  bwsTokenPath = {{ joinPath .chezmoi.homeDir ".config/chezmoi/secrets/bws-access-token.txt" | quote }}
  bwsIdNpmAuthToken = "302ba3e1-8fde-4c5d-8a1c-b37c01600278"
  bwsIdGithubAuthToken = "13a3305b-0c71-411c-89e3-b37c016033b5"
  bwsIdContext7ApiKey = "607b390d-a45d-40a3-af41-b42b004d6a90"
  bwsIdExaApiKey = "5db599ed-4498-4f0a-b18d-b42b004cc9ac"
  bwsIdPushbulletAccessToken = "d6904136-a33f-4259-9355-b467007b53cc"
  bwsIdOpencodeApiKey = "155eca67-0b36-4907-8bf6-b484007ea888"
  npmWorkRegistry = {{ $npmWorkRegistry | quote }}
  openCodeWorkPlugin = {{ $openCodeWorkPlugin | quote }}
  openCodeWorkPluginLocalPath = {{ $openCodeWorkPluginLocalPath | quote }}
  openCodeWorkPluginV2 = {{ $openCodeWorkPluginV2 | quote }}
  openCodeWorkPluginRepo = {{ dig "openCodeWorkPluginRepo" "" . | quote }}
  jetbrainsLicenseServer = {{ $jetbrainsLicenseServer | quote }}
  workForkRemote = {{ $workForkRemote | quote }}
  openCodeCostHosts = {{ $openCodeCostHosts | quote }}
