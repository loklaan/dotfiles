  openCodeServer = {{ $openCodeServer }}
  mcpproxyGate = {{ $mcpproxyGate }}
  nginxProxy = {{ $nginxProxy }}
  ephemeralCache = {{ $ephemeralCache }}
{{- /* Machine-local tables have no prompt, so carry them across re-init whole.
       toToml renders each under its own name; prefix the headers with data.
       Init data holds only this file's values, not .chezmoidata defaults, so
       dictationArchive overrides are carried without freezing its defaults. */}}
{{- range $table := list "checkouts" "skillSources" "skillProviders" "skills" "dictationArchive" }}
{{-   with dig $table nil $ }}
{{ regexReplaceAll "(?m)^(\\s*\\[\\[?)" (toToml (dict $table .)) "${1}data." | trimSuffix "\n" }}
{{-   end }}
{{- end }}

# Environment for every script and hook. Homebrew must never self-update or
# print hints mid-apply; upgrades run from `mise run update`.
[scriptEnv]
  HOMEBREW_NO_AUTO_UPDATE = "1"
  HOMEBREW_NO_ENV_HINTS = "1"
  # Read by chezmoi-preflight.sh's setup reminder (hooks cannot read [data]).
  CHEZMOI_SIGNING_KEY_SET = "{{ if ne "" $signingKey }}1{{ else }}0{{ end }}"

# Session logging hooks. The bodies (chezmoi_hook_pre, chezmoi_session_post)
# live in home/private_dot_local/lib/chezmoi-session.sh so apply and update
# share one implementation; the hooks source it from the chezmoi source tree
# (always the current version, and available before targets are materialised
# on a fresh box). chezmoi_hook_pre runs preflight after the session exists so
# its warnings can land in the session log.
[hooks.apply.pre]
  command = "bash"
  args = ["-euo", "pipefail", "-c", '''
source "{{ .chezmoi.sourceDir }}/private_dot_local/lib/chezmoi-session.sh"
chezmoi_hook_pre apply
''']
[hooks.apply.post]
  command = "bash"
  args = ["-euo", "pipefail", "-c", '''
source "{{ .chezmoi.sourceDir }}/private_dot_local/lib/chezmoi-session.sh"
chezmoi_session_post
''']
[hooks.update.pre]
  command = "bash"
  args = ["-euo", "pipefail", "-c", '''
source "{{ .chezmoi.sourceDir }}/private_dot_local/lib/chezmoi-session.sh"
chezmoi_hook_pre update
''']
[hooks.update.post]
  command = "bash"
  args = ["-euo", "pipefail", "-c", '''
source "{{ .chezmoi.sourceDir }}/private_dot_local/lib/chezmoi-session.sh"
chezmoi_session_post
''']
